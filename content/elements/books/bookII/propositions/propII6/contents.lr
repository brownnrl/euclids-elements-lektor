            "AC;line;connect;A,C;0;0",
            "CB;line;connect;C,B;0;0",
            "BD;line;connect;B,D;0;0",
            "BG;line;connect;B,G;0;0",
            "KM;line;connect;K,M;0;0",
            "AK;line;connect;A,K;0;0",
            // Hover / highlight targets only — the elements above already draw
            // every one of these strokes.
            "AB;line;connect;A,B;0;0;0",
            "AD;line;connect;A,D;0;0;0",
            "CD;line;connect;C,D;0;0;0",
            "CE;line;connect;C,E;0;0;0",
            "DF;line;connect;D,F;0;0;0",
            "EF;line;connect;E,F;0;0;0",
            "CL;line;connect;C,L;0;0;0",
            "DM;line;connect;D,M;0;0;0",
            // The rectangles the proof names but Joyce's figure does not draw.
            // Fill-only, and initially hidden so the static figure keeps just
            // the regions he filled.
            "CBHL;polygon;quadrilateral;C,B,H,L;0;0;0;orange",
            "HMFG;polygon;quadrilateral;H,M,F,G;0;0;0;orange",
            "CDML;polygon;quadrilateral;C,D,M,L;0;0;0;green",
            // The containers. Explicit ";0" face: an omitted faceColor is a
            // near-white OPAQUE face (lighten(bgcolor)), and a highlighted
            // element is promoted within its draw pass — so left implicit,
            // each of these would white out the coloured regions beneath it on
            // exactly the slides that pay the proof off.
            "ADMK;polygon;quadrilateral;A,D,M,K;0;0;0;0",
            "CEFD;polygon;quadrilateral;C,E,F,D;0;0;0;0",
            // The gnomon as a region: the L-shape CM + HF, six corners.
            "NOP;polygon;hexagon;C,D,F,G,H,L;0;0;0;0"
        ],
        // The coloured regions Joyce's figure does not have. Hidden at rest,
        // revealed by the slide that introduces them (and by a {NAME} hover).
        initiallyHidden: ["CBHL","HMFG","CDML"],
        // No deferDraggables here: the draggables are A, B and D (lineSliders)
        // plus the invisible off-canvas carriers A0/A3, and slide 1 introduces
        // A, B and D. The derived points (C, E, F, G, H, K, L, M, N, O, P) are
        // the opposite case — not auto-unioned, so each is listed in every
        // slide it belongs to.
        aliases: { "AL": "ACLK", "CH": "CBHL", "HF": "HMFG", "CM": "CDML",
                   "AM": "ADMK", "LG": "LHGE", "CF": "CEFD", "BM": "BDMH",
                   "BA": "AB", "CA": "AC", "BC": "CB", "DB": "BD", "DA": "AD",
                   "DC": "CD", "EC": "CE", "FD": "DF", "FE": "EF", "LC": "CL",
                   "MD": "DM", "MK": "KM", "KA": "AK", "GB": "BG", "ED": "DE" },
        slides: [
            { text: "Let a straight line {AB} be bisected at the point {C}, and let a straight line {BD} be added to it in a straight line.",
              visible: BASE,
              highlighted: ["AB","C","BD"] },
            { text: "I say that the rectangle {AD} by {DB} together with the square on {CB} equals the square on {CD}.",
              visible: BASE,
              // Only the cut line exists yet, so the two sides of the
              // rectangle are all there is to light; {CB} and {CD} are left to
              // the caption's hover refs.
              highlighted: ["AD","BD"] },
            { text: "Describe the square {CEFD} on {CD}, and join {DE}.",
              visible: SQUARE,
              // DCEF and DE are this slide's animation targets, so they are
              // deliberately NOT highlighted (euclid#171) — SlateAnimator
              // hides an animated target until its cascade step starts, but
              // drawFace still draws a hidden element that is highlighted, so
              // listing them here would paint the square from t=0. CD, the
              // line the square is described on, is not a target.
              highlighted: ["CD"],
              transition: { mode: "cascade", animations: [
                  { elem: "DCEF", name: geomlib.A.Polygon.outline },
                  { elem: "DE",   name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ claim: "the square on CD", ref: "I.46" }] },
            { text: "Draw {BG} through the point {B} parallel to either {EC} or {DF}, draw {KM} through the point {H} parallel to either {AB} or {EF}, and further draw {AK} through {A} parallel to either {CL} or {DM}.",
              visible: DRAWN,
              highlighted: [],
              transition: { mode: "cascade", animations: [
                  { elem: "BG", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "KM", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "AK", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ claim: "parallels through B, H and A", ref: "I.31" }] },
            { text: "Then, since {AC} equals {CB}, {AL} also equals {CH}.",
              visible: PAIR,
