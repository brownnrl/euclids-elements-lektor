sections:

#### prop_section ####
kind: proposition
----
statement: If a straight line is bisected and a straight line is added to it in a straight line, then the rectangle contained by the whole with the added straight line and the added straight line together with the square on the half equals the square on the straight line made up of the half and the added straight line.
----
proof:

Let a straight line {AB} be bisected at the point {C}, and let a straight line {BD} be added to it in a straight line.

I say that the rectangle {AD} by {DB} together with the square on {CB} equals the square on {CD}.

<figure class="diagram">
<canvas id="canvas_0" width="370" height="240" tabindex="0"></canvas>
<noscript><img src="propII6.gif" alt="II.6"/></noscript>
<script type="text/javascript">
    // Joyce's figure draws three of the regions the proof pastes together —
    // AL, LG, and the un-named BM. The rest of the proof's magnitudes (CH,
    // HF, CM, the whole AM, the gnomon NOP, and the square CEFD itself) are
    // named throughout and none of them is a drawn element. They are added
    // below: fully transparent (;0;0;0;0) where they are only highlight
    // targets, and `initiallyHidden` where they carry a fill, so the static
    // figure is unchanged either way.
    //
    // Colour: the three rectangles the proof proves equal — AL, CH and HF —
    // share ORANGE; CM, the piece added to two of them, is GREEN; LG, the
    // square on CB, is CYAN. The containers (AM, the gnomon NOP, the square
    // CEFD) are left UNFILLED so their own parts fill them. That is the whole
    // argument in colour: AM is orange + green, the gnomon is green + orange.
    //
    // Joyce's two `random` fills are pinned (AL orange, LG cyan) — a fresh
    // pastel per page load cannot make AL agree with CH and HF. Same move as
    // I.46's square.
    var BASE   = ["A","B","C","D","AC","CB","BD","AB","AD","CD"];
    var SQUARE = BASE.concat(["DCEF","E","F","DE","CE","DF","EF","CEFD"]);
    var DRAWN  = SQUARE.concat(["BG","G","H","KM","K","L","M","AK","CL","DM"]);
    var PAIR   = DRAWN.concat(["ACLK","CBHL"]);
    var THREE  = DRAWN.concat(["ACLK","CBHL","HMFG"]);
    var ADDED  = DRAWN.concat(["ACLK","CDML","HMFG"]);
    var GNOMON = ADDED.concat(["ADMK","NOP","N","O","P","NOParc"]);
    var WHOLE  = GNOMON.concat(["LHGE"]);
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "II.6",
        elements: [
            "A0;point;free;-1000,40;0,0",
            "A3;point;free;1000,40;0,0",
            "A;point;lineSlider;A0,A3,40,0",
            "B;point;lineSlider;A0,A3,260,0",
            "C;point;midpoint;A,B",
            "D;point;lineSlider;A0,A3,330,0",
            "DCEF;polygon;square;D,C",
            "E;point;vertex;DCEF,3",
            "F;point;vertex;DCEF,4",
            "DE;line;connect;D,E",
            "G;point;parallelogram;B,D,F",
            "H;point;intersection;B,G,D,E",
            "M;point;parallelogram;H,B,D",
            "K;point;parallelogram;H,B,A",
            "L;point;intersection;K,M,C,E",
            "ACLK;polygon;quadrilateral;A,C,L,K;0;0;0,0,0;orange",
            "LHGE;polygon;quadrilateral;L,H,G,E;0;0;0,0,0;cyan",
            "BDMH;polygon;quadrilateral;B,D,M,H",
            "O';point;midpoint;H,M;0;0",
            "N;point;cutoff;H,K,H,O';black;lightGray",
            "O;point;cutoff;H,D,H,O';black;lightGray",
            "P;point;cutoff;H,G,H,O';black;lightGray",
            // The gnomon's marker arc. Renamed from NOP so the name can go to
