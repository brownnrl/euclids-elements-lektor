              transition: { mode: "cascade", animations: [
                  { elem: "ACLK", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "CBHL", name: geomlib.A.Polygon.outlineAndFill } ] },
              justifications: [{ claim: "equal bases, same parallels", ref: "I.36" }] },
            { text: "But {CH} equals {HF}. Therefore {AL} also equals {HF}.",
              visible: THREE,
              highlighted: ["ACLK","CBHL"],
              transition: { animations: [
                  { elem: "HMFG", name: geomlib.A.Polygon.outlineAndFill } ] },
              justifications: [{ claim: "complements about the diameter DE", ref: "I.43" }] },
            // CBHL drops out here: CM contains CH, and green takes over that
            // ground. CDML is declared after CBHL so it draws on top anyway,
            // but a highlighted element is promoted within its draw pass — so
            // the two never share a visible set.
            { text: "Add {CM} to each.",
              visible: ADDED,
              // "each" is AL and HF; CDML is the animation target (euclid#171).
              highlighted: ["ACLK","HMFG"],
              transition: { animations: [
                  { elem: "CDML", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "Therefore the whole {AM} equals the gnomon {NOP}.",
              visible: GNOMON,
              highlighted: [],
              transition: { mode: "cascade", animations: [
                  { elem: "ADMK", name: geomlib.A.Polygon.outline },
                  { elem: "NOP",  name: geomlib.A.Polygon.outline } ] },
              justifications: [{ claim: "NOP is the gnomon", ref: "II.Def.2" }] },
            { text: "But {AM} is the rectangle {AD} by {DB}, for {DM} equals {DB}. Therefore the gnomon {NOP} also equals the rectangle {AD} by {DB}.",
              visible: GNOMON,
              highlighted: ["NOP","AD","BD","DM"],
              justifications: [{ claim: "AM is contained by AD and DM", ref: "II.Def.1" }] },
            { text: "Add {LG}, which equals the square on {BC}, to each. Therefore the rectangle {AD} by {DB} together with the square on {CB} equals the gnomon {NOP} plus {LG}.",
              visible: WHOLE,
              highlighted: ["NOP"],
              transition: { animations: [
                  { elem: "LHGE", name: geomlib.A.Polygon.outlineAndFill } ] },
              justifications: [{ claim: "LG is the square on CB", ref: "I.34" }] },
            { text: "But the gnomon {NOP} and {LG} are the whole square {CEFD}, which is described on {CD}.",
              visible: WHOLE,
              // CEFD is the animation target (euclid#171); the two parts it is
              // made of are not, so they keep the gold.
              highlighted: ["NOP","LHGE"],
              transition: { animations: [
                  { elem: "CEFD", name: geomlib.A.Polygon.outline } ] } },
            { text: "Therefore the rectangle {AD} by {DB} together with the square on {CB} equals the square on {CD}.",
              visible: WHOLE,
              highlighted: ["ADMK","LHGE","CEFD"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
