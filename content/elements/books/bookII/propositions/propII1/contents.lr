            { text: "Now {BH} is the rectangle {A} by {BC}, for it is contained by {GB} and {BC}, and {BG} equals {A}.",
              visible: WHOLE,
              highlighted: ["BCHG","BG","BC","A"],
              justifications: [{ claim: "the rectangle contained by GB and BC", ref: "II.Def.1" }] },
            { text: "{BK} is the rectangle {A} by {BD}, and {DL} is the rectangle {A} by {DE}, since {DK} equals {BG}. Similarly {EH} is the rectangle {A} by {EC}.",
              visible: WHOLE,
              highlighted: ["DBGK","EDKL","CELH","BD","DE","EC","DK"],
              justifications: [
                  { claim: "opposite sides of a parallelogram are equal", ref: "I.34" },
                  { claim: "each part is contained by A and a segment",   ref: "II.Def.1" } ] },
            { text: "So the rectangle {A} by {BC} equals the sum of the rectangles {A} by {BD}, {A} by {DE}, and {A} by {EC}.",
