    // make up, and not the segments of BC — the proof names both. Everything
    // added here is fully transparent (;0;0;0;0), so the static figure is
    // unchanged; the names exist only so a slide can light them.
    //
    // Colour: the three parts keep their random fills, and the containing
    // rectangle BCHG stays unfilled so its own regions fill it.
    var GIVEN  = ["A1","A2","A","B","C","BC","D","E","BD","DE","EC"];
    var PERP   = GIVEN.concat(["F","BF","G","BG"]);
    var BUILT  = PERP.concat(["K","L","H","DBGK","EDKL","CELH","GH","DK","EL","CH"]);
    var WHOLE  = BUILT.concat(["BCHG"]);
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "II.1",
        elements: [
            "A0;point;free;-1000,40;0,0",
            "A3;point;free;1000,40;0,0",
            "A1;point;lineSlider;A0,A3,90,40;0",
            "A2;point;lineSlider;A0,A3,200,40;0",
            "A;line;connect;A1,A2;0,0,0",
            "B;point;free;40,70",
            "C';point;parallelogram;B,A;0;0",
            "C;point;lineSlider;B,C',290,70",
            "BC;line;connect;B,C",
            "D;point;lineSlider;BC,110,70",
            "E;point;lineSlider;BC,220,70",
            "BF';line;perpendicular;B,C;0;0;0",
            "F;point;lineSlider;BF',30,210",
            "BF;line;connect;B,F",
            "G;point;cutoff;BF,A",
            "DBGK;polygon;parallelogram;D,B,G;0;0;0,0,0;random",
            "K;point;vertex;DBGK,4",
            "EDKL;polygon;parallelogram;E,D,K;0;0;0,0,0;random",
            "L;point;vertex;EDKL,4",
            "CELH;polygon;parallelogram;C,E,L;0;0;0,0,0;random",
            "H;point;vertex;CELH,4",
            // Hover / highlight targets only — the lines above already draw
            // every one of these.
            "BD;line;connect;B,D;0;0;0",
            "DE;line;connect;D,E;0;0;0",
            "EC;line;connect;E,C;0;0;0",
            "BG;line;connect;B,G;0;0;0",
            "GH;line;connect;G,H;0;0;0",
            "DK;line;connect;D,K;0;0;0",
            "EL;line;connect;E,L;0;0;0",
