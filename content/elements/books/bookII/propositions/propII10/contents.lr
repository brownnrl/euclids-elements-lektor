                  { elem: "angFEB", name: geomlib.A.Sector.sweep } ] } },
            { text: "But straight lines produced from angles less than two right angles meet. Therefore {EB} and {FD}, if produced in the direction {B} and {D}, will meet.",
              visible: PARA,
              highlighted: ["BE","FD","B","D"],
              justifications: [{ ref: "I.Post.5" }] },
            { text: "Let them be produced and meet at {G}, and join {AG}.",
              visible: MET,
              highlighted: [],
              transition: { mode: "cascade", animations: [
                  { elem: "BG", name: geomlib.A.Line.straightEdgeExtend },
                  { elem: "DG", name: geomlib.A.Line.straightEdgeExtend },
                  { elem: "G",  name: geomlib.A.Point.appear },
                  { elem: "AG", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ ref: "I.Post.2" }, { ref: "I.Post.1" }] },
            { text: "Then, since {AC} equals {CE}, the angle {EAC} also equals the angle {AEC}.",
              visible: HALFA,
              highlighted: ["AC","CE"],
              transition: { mode: "parallel", animations: [
                  { elem: "angEAC", name: geomlib.A.Sector.sweep },
                  { elem: "angAEC", name: geomlib.A.Sector.sweep } ] },
              justifications: [
                  { claim: "the base angles of the isosceles triangle ACE", ref: "I.5" } ] },
            { text: "The angle at {C} is right, therefore each of the angles {EAC} and {AEC} is half of a right angle.",
              visible: HALFA,
              highlighted: ["angEAC","angAEC"],
              transition: { animations: [
                  { elem: "angACE", name: geomlib.A.Sector.sweep } ] },
              justifications: [
                  { claim: "the three angles sum to two right angles", ref: "I.32" } ] },
            { text: "For the same reason each of the angles {CEB} and {EBC} is also half of a right angle, therefore the angle {AEB} is right.",
              visible: HALFB,
              highlighted: [],
              transition: { mode: "cascade", animations: [
                  { elem: "angCEB", name: geomlib.A.Sector.sweep },
                  { elem: "angEBC", name: geomlib.A.Sector.sweep },
                  { elem: "angAEB", name: geomlib.A.Sector.sweep } ] },
              justifications: [
                  { claim: "the base angles of the isosceles triangle ECB", ref: "I.5" },
                  { claim: "each is half of a right angle",               ref: "I.32" } ] },
            { text: "And, since the angle {EBC} is half of a right angle, the angle {DBG} is also half of a right angle.",
              visible: CORNER,
              highlighted: ["angEBC"],
              transition: { animations: [
                  { elem: "angDBG", name: geomlib.A.Sector.sweep } ] },
              justifications: [
                  { claim: "vertical angles are equal", ref: "I.15" } ] },
            { text: "But the angle {BDG} is also right, for it equals the angle {DCE}, since they are alternate.",
              visible: CORNER,
              highlighted: [],
              transition: { mode: "cascade", animations: [
                  { elem: "angDCE", name: geomlib.A.Sector.sweep },
                  { elem: "angBDG", name: geomlib.A.Sector.sweep } ] },
              justifications: [
                  { claim: "alternate angles on the parallels CE and FD", ref: "I.29" } ] },
            { text: "Therefore the remaining angle {DGB} is half of a right angle. Therefore the angle {DGB} equals the angle {DBG}, so that the side {BD} also equals the side {GD}.",
              visible: CORNER,
              highlighted: ["angDBG","DB","DG"],
              transition: { animations: [
                  { elem: "angDGB", name: geomlib.A.Sector.sweep } ] },
              justifications: [
                  { claim: "the remaining angle of triangle DBG", ref: "I.32" },
                  { claim: "equal angles subtend equal sides",    ref: "I.6" } ] },
            { text: "Again, since the angle {EGF} is half of a right angle, and the angle at {F} is right, for it equals the opposite angle, the angle at {C}, the remaining angle {FEG} is half of a right angle. Therefore the angle {EGF} equals the angle {FEG}, so that the side {GF} also equals the side {EF}.",
              visible: ISOF,
              highlighted: ["angDGB","FG","EF","EFG"],
              transition: { mode: "cascade", animations: [
                  { elem: "angEFD", name: geomlib.A.Sector.sweep },
                  { elem: "angFEB", name: geomlib.A.Sector.sweep } ] },
              justifications: [
                  { claim: "opposite angles of the parallelogram ECDF", ref: "I.34" },
                  { claim: "the remaining angle of triangle EFG",       ref: "I.32" },
                  { claim: "equal angles subtend equal sides",          ref: "I.6" } ] },
            { text: "Now, since the square on {EC} equals the square on {CA}, the sum of the squares on {EC} and {CA} is double the square on {CA}. But the square on {EA} equals the sum of the squares on {EC} and {CA}, therefore the square on {EA} is double the square on {AC}.",
              visible: SQUARE.concat(["angACE"]),
              highlighted: ["CE","AC","AE","ACE"],
              justifications: [
                  { claim: "the square on EA, the hypotenuse of ACE", ref: "I.47" } ] },
            { text: "Again, since {FG} equals {EF}, the square on {FG} also equals the square on {FE}. Therefore the sum of the squares on {GF} and {FE} is double the square on {EF}. But the square on {EG} equals the sum of the squares on {GF} and {FE}, therefore the square on {EG} is double the square on {EF}.",
              visible: SQUARE.concat(["angEFD"]),
              highlighted: ["FG","EF","EG"],
              transition: { animations: [
                  { elem: "EFG", name: geomlib.A.Polygon.outline } ] },
              justifications: [
                  { claim: "the square on EG, the hypotenuse of EFG", ref: "I.47" } ] },
            { text: "And {EF} equals {CD}, therefore the square on {EG} is double the square on {CD}. But the square on {EA} was also proved to be double the square on {AC}, therefore the sum of the squares on {AE} and {EG} is double the sum of the squares on {AC} and {CD}.",
              visible: SQUARE,
              highlighted: ["EF","CD","EG","AE","AC"],
              justifications: [
                  { claim: "opposite sides of the parallelogram ECDF are equal", ref: "I.34" } ] },
            { text: "And the square on {AG} equals the sum of the squares on {AE} and {EG}, therefore the square on {AG} is double the sum of the squares on {AC} and {CD}.",
              visible: SQUARE.concat(["angAEB"]),
              highlighted: ["AG","AE","EG"],
              transition: { animations: [
                  { elem: "AEG", name: geomlib.A.Polygon.outline } ] },
              justifications: [
                  { claim: "the square on AG, the hypotenuse of AEG", ref: "I.47" } ] },
            { text: "But the sum of the squares on {AD} and {DG} equals the square on {AG}, therefore the sum of the squares on {AD} and {DG} is double the sum of the squares on {AC} and {CD}.",
              visible: SQUARE.concat(["angBDG"]),
              highlighted: ["AG","AD","DG"],
              transition: { animations: [
                  { elem: "ADG", name: geomlib.A.Polygon.outline } ] },
              justifications: [
                  { claim: "the square on AG, the hypotenuse of ADG", ref: "I.47" } ] },
            { text: "And {DG} equals {DB}, therefore the sum of the squares on {AD} and {DB} is double the sum of the squares on {AC} and {CD}.",
              visible: SQUARE,
              highlighted: ["DG","DB","AD","AC","CD"] },
            { text: "Therefore, if a straight line is bisected and a straight line is added to it in a straight line, the square on the whole with the added straight line and the square on the added straight line together are double the square on the half and the square on the straight line made up of the half and the added straight line.",
              visible: SQUARE,
              highlighted: ["AD","DB","AC","CD"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "I.3":       "/elements/books/bookI/propositions/propI3/",
        "I.5":       "/elements/books/bookI/propositions/propI5/",
        "I.6":       "/elements/books/bookI/propositions/propI6/",
        "I.11":      "/elements/books/bookI/propositions/propI11/",
        "I.15":      "/elements/books/bookI/propositions/propI15/",
        "I.29":      "/elements/books/bookI/propositions/propI29/",
        "I.31":      "/elements/books/bookI/propositions/propI31/",
        "I.32":      "/elements/books/bookI/propositions/propI32/",
        "I.34":      "/elements/books/bookI/propositions/propI34/",
        "I.47":      "/elements/books/bookI/propositions/propI47/",
        "I.Post.1":  "/elements/books/bookI/postulates/post1/",
        "I.Post.2":  "/elements/books/bookI/postulates/post2/",
