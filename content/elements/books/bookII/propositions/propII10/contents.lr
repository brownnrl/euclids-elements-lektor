title: Proposition 10
---
order: 10
---
short_label: II.10
---
sections:

#### prop_section ####
kind: proposition
----
statement: If a straight line is bisected, and a straight line is added to it in a straight line, then the square on the whole with the added straight line and the square on the added straight line both together are double the sum of the square on the half and the square described on the straight line made up of the half and the added straight line as on one straight line.
----
proof:

Let a straight line {AB} be bisected at {C}, and let a straight line {BD} be added to it in a straight line.

I say that the sum of the squares on {AD} and {DB} is double the sum of the squares on {AC} and {CD}.

<figure class="diagram">
<canvas id="canvas_0" width="280" height="250" tabindex="0"></canvas>
<noscript><img src="propII10.gif" alt="II.10"/></noscript>
<script type="text/javascript">
    // Unlike II.1 this is not a region-decomposition proof — nothing is
    // dissected. The argument is a chain of half-right angles that turns
    // three isosceles right triangles into three applications of I.47.
    // So the colour here carries ANGLE MAGNITUDE, not area: red for a
    // right angle, orange for half of one. That is the deck's one
    // authored colour decision; Joyce's figure has no fill at all (ECDF
    // is an outline, face 0), so nothing of his is recoloured.
    //
    // Joyce's figure draws neither the segments the proof names as parts
    // of longer lines (AB, AC, CB, CD, EF, FD, FG, EG) nor the five
    // triangles the Guide's outline names. Everything added here is
    // fully transparent (;0;0;0 lines, ;0;0;0;0 polygons), so the static
    // figure is unchanged; the names exist only so a slide or a {NAME}
    // hover can light them.
    //
    // Three markers carry two of Joyce's names each, because the rays
    // coincide: D lies on FG, so angle EFD = angle EFG; B lies on EG, so
    // angle FEB = angle FEG and angle DGB = angle EGF.
    //
    // The markers are phase-transitory — each group is dropped once its
    // step is done rather than accumulating, so this 280x250 canvas
    // never carries more than six at once. angEFD/angFEB come back on
    // slide 14 and angACE/angAEB/angBDG on the I.47 slides, where they
    // are the right angle each application needs.
    //
    // No deferDraggables: the only draggables are A, B (free) and D
    // (lineSlider), and slide 1 introduces all three. The opposite rule
    // bites instead — C (midpoint), E (last), F (vertex) and G
    // (intersection) are DERIVED, so they are not auto-unioned and are
    // listed explicitly in every slide they belong to.
    var GIVEN  = ["A","B","C","D","AB","AD","AC","CB","CD","DB"];
    var BUILT  = GIVEN.concat(["E","CE","AE","BE","F","ECDF","EF","FD"]);
    var PARA   = BUILT.concat(["angCEF","angEFD","angFEB"]);
    var MET    = BUILT.concat(["G","BG","DG","EG","FG","AG"]);
    var HALFA  = MET.concat(["angEAC","angAEC","angACE"]);
    var HALFB  = HALFA.concat(["angCEB","angEBC","angAEB"]);
    var CORNER = MET.concat(["angEBC","angDBG","angDCE","angBDG","angDGB"]);
    var ISOF   = MET.concat(["angDGB","angEFD","angFEB","EFG"]);
    var SQUARE = MET.concat(["ACE","ECB","EFG","AEG","ADG"]);
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "II.10",
        elements: [
            "A;point;free;30,150",
            "B;point;free;180,150",
            "C;point;midpoint;A,B",
            "D;point;lineSlider;A,B,240,150",
            "AD;line;connect;A,D",
            "CE;line;perpendicular;C,B",
            "E;point;last;CE",
            "AE;line;connect;A,E",
            "BE;line;connect;B,E",
            "ECDF;polygon;parallelogram;E,C,D;0;0;0,0,0;0",
            "F;point;vertex;ECDF,4",
            "G;point;intersection;E,B,F,D",
            "AG;line;connect;A,G",
            "BG;line;connect;B,G",
            "DG;line;connect;D,G",
            "DB;line;connect;D,B",
            // Hover / highlight targets only — the lines and the
            // rectangle above already draw every one of these.
            "AB;line;connect;A,B;0;0;0",
            "AC;line;connect;A,C;0;0;0",
            "CB;line;connect;C,B;0;0;0",
            "CD;line;connect;C,D;0;0;0",
            "EF;line;connect;E,F;0;0;0",
            "FD;line;connect;F,D;0;0;0",
            "FG;line;connect;F,G;0;0;0",
            "EG;line;connect;E,G;0;0;0",
            // The five triangles the Guide's outline of the proof names.
            // Explicit ;0 faces — an omitted faceColor is an OPAQUE
            // near-white face, and a highlighted polygon is promoted
            // within its draw pass (#140), so an implicit face here
            // would paint over the figure the moment one lit.
            "ACE;polygon;triangle;A,C,E;0;0;0;0",
            "ECB;polygon;triangle;E,C,B;0;0;0;0",
            "EFG;polygon;triangle;E,F,G;0;0;0;0",
            "AEG;polygon;triangle;A,E,G;0;0;0;0",
            "ADG;polygon;triangle;A,D,G;0;0;0;0",
            // red = a right angle, orange = half a right angle. Markers
            // are hidden in the static figure (showAngles defaults
            // false), so Euclid's arc-free diagram is untouched; the
