              transition: { mode: "cascade", animations: [
                  { elem: "CE",   name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "AE",   name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "BE",   name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "ECDF", name: geomlib.A.Polygon.outline } ] },
              justifications: [
                  { claim: "CE at right angles to AB", ref: "I.11" },
                  { claim: "CE equal to AC",           ref: "I.3" },
                  { ref: "I.Post.1" },
                  { claim: "EF parallel to AD, FD parallel to CE", ref: "I.31" } ] },
            { text: "Then, since a straight line {EF} falls on the parallel straight lines {EC} and {FD}, the sum of the angles {CEF} and {EFD} equals two right angles.",
              visible: PARA,
              highlighted: ["EF","CE","FD"],
              transition: { mode: "parallel", animations: [
                  { elem: "angCEF", name: geomlib.A.Sector.sweep },
                  { elem: "angEFD", name: geomlib.A.Sector.sweep } ] },
              justifications: [
                  { claim: "interior angles on the same side sum to two right angles", ref: "I.29" } ] },
            { text: "Therefore the sum of the angles {FEB} and {EFD} is less than two right angles.",
              visible: PARA,
              highlighted: ["angEFD"],
