                   "CEF": "angCEF", "FEC": "angCEF",
                   "EFD": "angEFD", "DFE": "angEFD",
                   "FEB": "angFEB", "BEF": "angFEB",
                   "FEG": "angFEB", "GEF": "angFEB",
                   "DBG": "angDBG", "GBD": "angDBG",
                   "BDG": "angBDG", "GDB": "angBDG",
                   "DGB": "angDGB", "BGD": "angDGB",
                   "EGF": "angDGB", "FGE": "angDGB" },
        slides: [
            { text: "Let a straight line {AB} be bisected at {C}, and let a straight line {BD} be added to it in a straight line.",
              visible: GIVEN,
              highlighted: ["AB","C","DB"] },
            { text: "I say that the sum of the squares on {AD} and {DB} is double the sum of the squares on {AC} and {CD}.",
              visible: GIVEN,
              highlighted: ["AD","DB","AC","CD"] },
            { text: "Draw {CE} from the point {C} at right angles to {AB} and equal to either {AC} or {CB}. Join {EA} and {EB}. Draw {EF} through {E} parallel to {AD}, and draw {FD} through {D} parallel to {CE}.",
              visible: BUILT,
              // Deliberately NOT highlighted: these are the animation's
              // own targets. SlateAnimator hides an animated target until
              // its own cascade step starts, but sets shouldHighlight at
