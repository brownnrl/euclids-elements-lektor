            // still on the default palette.
            "angEAC;sector;angleMarker;A,E,C;0;0;orange;orange",
            "angAEC;sector;angleMarker;E,A,C;0;0;orange;orange",
            "angACE;sector;angleMarker;C,A,E;0;0;red;red",
            "angDCE;sector;angleMarker;C,D,E;0;0;red;red",
            "angCEB;sector;angleMarker;E,C,B;0;0;orange;orange",
            "angEBC;sector;angleMarker;B,E,C;0;0;orange;orange",
            "angAEB;sector;angleMarker;E,A,B;0;0;red;red",
            "angCEF;sector;angleMarker;E,C,F;0;0;red;red",
            "angFEB;sector;angleMarker;E,F,B;0;0;orange;orange",
            "angEFD;sector;angleMarker;F,E,D;0;0;red;red",
            "angDBG;sector;angleMarker;B,D,G;0;0;orange;orange",
            "angBDG;sector;angleMarker;D,B,G;0;0;red;red",
            "angDGB;sector;angleMarker;G,D,B;0;0;orange;orange"
        ],
        // ACE, EFG and AEG are TRIANGLES here (the Guide names them), so
        // the triangle owns the name and the angle keeps its ang…
        // spelling — the name-collision rule. The proof prose never
