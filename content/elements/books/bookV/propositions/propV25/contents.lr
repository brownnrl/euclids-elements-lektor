            "C;point;lineSlider;W0,W1,30,100",
            "D;point;lineSlider;W0,W1,220,100",
            "CD;line;connect;C,D;0;0;green",
            "E1;point;lineSlider;V0,V1,30,60;0",
            "E2;point;lineSlider;V0,V1,170,60;0",
            "E;line;connect;E1,E2;black;0;green",
            "F1;point;lineSlider;X0,X1,30,130;0",
