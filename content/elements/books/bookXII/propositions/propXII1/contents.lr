            "ABCDE;polygon;pentagon;A,B,C,D,E;0;0;black;random",
            "FGHKL;polygon;pentagon;F,G,H,K,L;0;0;black;random",
            "ABCcenter;point;center;ABC;0;0",
            "M;point;extend;B,ABCcenter,B,ABCcenter",
            "FGHcenter;point;center;FGH;0;0",
            "N;point;extend;G,FGHcenter,G,FGHcenter",
            "BM;line;connect;B,M",
            "GN;line;connect;G,N",
            "AM;line;connect;A,M",
            "FN;line;connect;F,N",
