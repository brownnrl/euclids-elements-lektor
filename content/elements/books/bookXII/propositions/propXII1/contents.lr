            "D;point;circleSlider;ABC,200,180",
            "E;point;circleSlider;ABC,210,90",
            "F;point;free;308,50",
            "G;point;free;260,98",
            "H;point;similar;F,G,A,B,C",
            "K;point;similar;F,G,A,B,D",
            "L;point;similar;F,G,A,B,E",
            "FGH;circle;circumcircle;F,G,H;0;0;black;random",
            "ABCDE;polygon;pentagon;A,B,C,D,E;0;0;black;random",
            "FGHKL;polygon;pentagon;F,G,H,K,L;0;0;black;random",
            "ABCcenter;point;center;ABC;0;0",
            "M;point;extend;B,ABCcenter,B,ABCcenter",
            "FGHcenter;point;center;FGH;0;0",
            "N;point;extend;G,FGHcenter,G,FGHcenter",
            "BM;line;connect;B,M",
            "GN;line;connect;G,N",
            "AM;line;connect;A,M",
            "FN;line;connect;F,N",
            "BE;line;connect;B,E",
            "GL;line;connect;G,L"
        ],
    });
