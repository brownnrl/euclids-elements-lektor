            { text: "“Pyramids of the same height with triangular bases are to one another as their bases.”",
              visible: FIG,
              highlighted: PYRS.concat(BASES),
              justifications: [{ ref: "XII.5" }] },
            { text: "Let there be pyramids of the same height with triangular bases {ABC} and {DEF} and vertices {G} and {H}.",
              highlighted: BASES.concat(["G","H"]) },
            { text: "I say that the base {ABC} is to the base {DEF} as the pyramid {ABCG} is to the pyramid {DEFH}.",
              highlighted: BASES.concat(PYRS) },
            { text: "For, if the pyramid {ABCG} is not to the pyramid {DEFH} as the base {ABC} is to the base {DEF},",
              highlighted: PYRS.concat(BASES) },
            { text: "then the base {ABC} is to the base {DEF} as the pyramid {ABCG}",
              highlighted: BASES.concat(["ABCG"]) },
            { text: "is either to some solid less than the pyramid {DEFH} or to a greater solid.",
              highlighted: ["DEFH"] },
            { text: "Let it, first, be in that ratio to a less solid {W|Wf}.",
              visible: WFIG,
              highlighted: WBOX },
            { text: "Divide the pyramid {DEFH} into two pyramids equal to one another and similar to the whole",
              highlighted: ["pDQRS","pSTUH"] },
            { text: "and into two equal prisms.",
              highlighted: PRD },
            { text: "Then the two prisms are greater than the half of the whole pyramid.",
              highlighted: PRD,
              justifications: [{ claim: "the prisms exceed half the pyramid", ref: "XII.3" }] },
            { text: "Again, divide the pyramids arising from the division similarly, and let this be done repeatedly",
              highlighted: ["pDQRS","pSTUH"] },
            { text: "until there are left over from the pyramid {DEFH} some pyramids which are less than the excess",
              highlighted: ["DEFH"] },
            { text: "by which the pyramid {DEFH} exceeds the solid {W|Wf}.",
              highlighted: ["DEFH"].concat(WBOX),
              justifications: [{ ref: "X.1" }] },
            { text: "Let such be left, and let them be, for the sake of argument, {DQRS|pDQRS} and {STUH|pSTUH}.",
              highlighted: ["pDQRS","pSTUH"] },
            { text: "Therefore the remainders, the prisms in the pyramid {DEFH}, are greater than the solid {W|Wf}.",
              highlighted: PRD.concat(WBOX) },
            { text: "Divide the pyramid {ABCG} similarly, and a same number of times, with the pyramid {DEFH}.",
              highlighted: ["pAKLP","pPMNG"].concat(PRA) },
            { text: "Therefore the base {ABC} is to the base {DEF}",
              highlighted: BASES },
            { text: "as the prisms in the pyramid {ABCG} are to the prisms in the pyramid {DEFH}.",
              highlighted: PRA.concat(PRD),
              justifications: [{ claim: "bases as the prisms", ref: "XII.4" }] },
            { text: "But the base {ABC} is to the base {DEF} as the pyramid {ABCG} is to the solid {W|Wf},",
              highlighted: BASES.concat(["ABCG"]).concat(WBOX) },
            { text: "therefore the pyramid {ABCG} is to the solid {W|Wf}",
              highlighted: ["ABCG"].concat(WBOX) },
            { text: "as the prisms in the pyramid {ABCG} are to the prisms in the pyramid {DEFH}.",
              highlighted: PRA.concat(PRD),
              justifications: [{ claim: "ratios the same with the same ratio", ref: "V.11" }] },
            { text: "Therefore, alternately the pyramid {ABCG} is to the prisms in it",
              highlighted: ["ABCG"].concat(PRA) },
            { text: "as the solid {W|Wf} is to the prisms in the pyramid {DEFH}.",
              highlighted: WBOX.concat(PRD),
              justifications: [{ claim: "alternately", ref: "V.16" }] },
            { text: "But the pyramid {ABCG} is greater than the prisms in it,",
              highlighted: ["ABCG"].concat(PRA) },
            { text: "therefore the solid {W|Wf} is also greater than the prisms in the pyramid {DEFH}.",
              highlighted: WBOX.concat(PRD) },
            { text: "But it is also less, which is impossible.",
              highlighted: WBOX.concat(PRD) },
            // Case 1 refuted: W is withdrawn.
            // Joyce's slip, left literal: "the prism ABCG" (for pyramid).
            { text: "Therefore the prism {ABCG} is not to any solid less than the pyramid {DEFH}",
              visible: FIG,
              highlighted: PYRS },
            { text: "as the base {ABC} is to the base {DEF}.",
              highlighted: BASES },
            { text: "Similarly it can be proved that neither is the pyramid {DEFH} to any solid less than the pyramid {ABCG}",
              highlighted: PYRS },
            { text: "as the base {DEF} is to the base {ABC}.",
              highlighted: BASES },
            { text: "I say next that neither is the pyramid {ABCG} to any solid greater than the pyramid {DEFH}",
              highlighted: PYRS },
            { text: "as the base {ABC} is to the base {DEF}.",
              highlighted: BASES },
            { text: "For, if possible, let it be in that ratio to a greater solid {W|Wf}.",
              visible: WFIG,
              highlighted: WBOX },
            { text: "Therefore, inversely the base {DEF} is to the base {ABC} as the solid {W|Wf} is to the pyramid {ABCG}.",
              highlighted: BASES.concat(WBOX).concat(["ABCG"]) },
            { text: "But it was proved before that the solid {W|Wf} is to the solid {ABCG}",
              highlighted: WBOX.concat(["ABCG"]) },
            { text: "as the pyramid {DEFH} is to some solid less than the pyramid {ABCG}.",
              highlighted: PYRS,
              justifications: [{ ref: "XII.2,Lemma" }] },
            { text: "Therefore the base {DEF} is to the base {ABC}",
              highlighted: BASES },
            { text: "as the pyramid {DEFH} is to some solid less than the pyramid {ABCG}, which was proved absurd.",
              highlighted: PYRS,
              justifications: [{ claim: "ratios the same with the same ratio", ref: "V.11" }] },
            // Case 2 refuted: W is withdrawn again.
            { text: "Therefore the pyramid {ABCG} is not to any solid greater than the pyramid {DEFH}",
              visible: FIG,
              highlighted: PYRS },
            { text: "as the base {ABC} is to the base {DEF}.",
              highlighted: BASES },
            { text: "But it was proved that neither is it in that ratio to a less solid.",
              highlighted: PYRS },
            { text: "Therefore the base {ABC} is to the base {DEF} as the pyramid {ABCG} is to the pyramid {DEFH}.",
              highlighted: BASES.concat(PYRS) },
            { text: "Therefore, pyramids of the same height with triangular bases are to one another as their bases.",
              highlighted: PYRS.concat(BASES),
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "XII.5") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
