_model: proposition
---
title: Proposition 3
---
order: 3
---
short_label: XII.3
---
sections:

#### prop_section ####
kind: proposition
----
statement: Any pyramid with a triangular base is divided into two pyramids equal and similar to one another, similar to the whole, and having triangular bases, and into two equal prisms, and the two prisms are greater than half of the whole pyramid.
----
proof:

Let there be a pyramid of with the triangular base {ABC} and vertex {D}.

I say that the pyramid {ABCD} is divided into two pyramids equal to one another, having triangular bases and similar to the whole pyramid, and into two equal prisms, and the two prisms are greater than the half of the whole pyramid.

Bisect {AB}, {BC}, {CA}, {AD}, {DB}, and {DC} at the points {E}, {F}, {G}, {H}, {K}, and {L}. Join {HE}, {EG}, {GH}, {HK}, {KL}, {LH}, {KF}, and {FG}. [!just I.10]

<figure class="diagram">
<canvas id="canvas_0" width="280" height="300" tabindex="0"></canvas>
<noscript><img alt="XII.3 diagram" src="propXII3.gif"/></noscript>
<script type="text/javascript">
    // The six edges of ABCD are bisected at E..L and the eight joins drawn;
    // the walk then shows the two small pyramids equal and similar to each
    // other and to the whole, the two prisms equal, and each prism greater
    // than a small pyramid.
    //
    // Joyce's figure draws the edges in pieces (tetrahedron edges and the
    // lines CB, CG, EB, KB, CL), so the outline AB, CA, AD, DB, DC and the
    // eight joins are solid slide twins, hidden at rest (initiallyHidden).
    // A polyhedron draws no highlight, so each pyramid the prose names gets
    // a faceless wireframe twin: an octagon that walks all six edges
    // (ABCD, pAEGH, pHKLD, pEBFK). The prisms are lit through their faces.
    // HKFGt is a faceless twin of the shaded parallelogram HKFG. Everything
    // else added is transparent. EF is Joyce's line, kept back until the
    // proof joins it; EK, which his figure does not draw, is transparent.
    // Angle and triangle names collide (EHG, KDL): the triangles own them.
    // Draggables (checked against the bundle): D (lineSlider) and A, B, C
    // (planeSliders), all givens; every other point is a midpoint.
    var GIVEN = ["A","B","C","D","AB","CB","CA","AD","DB","DC"];
    var MIDS  = GIVEN.concat(["E","F","G","H","K","L"]);
    var JOINS = MIDS.concat(["HE","EG","GH","HK","KL","LH","KF","FG"]);
    var ORIG  = ["HKFG","AEGH","HKLD","CB","CG","EB","KB","CL"];
    var REST  = ["A","B","C","D","E","F","G","H","K","L","EF"].concat(ORIG);
    var FULL  = JOINS.concat(ORIG).concat(["AE","AH","HD","KD","DL","BF","FC",
                "ABCD","pAEGH","pHKLD","HEBK","ABC","AEH","HKD","AHG","HLD",
                "EHG","KDL","AEG","HKL","ADB","DHK","DBC","DKL","ADC","DLH"]);
    var A1    = FULL.concat(["angEAH","angKHD"]);
    var A2    = A1.concat(["angEHG","angKDL"]);
    var A3    = A2.concat(["angBAC","angKHL"]);
    // The angle markers have done their work once the prisms are reached.
    var PRISMS = FULL.concat(["EBFG","GFC","BKF","EBKH","HKFGt","KFCL","LCGH"]);
    var JOINED = PRISMS.concat(["EF","EK","EBF","pEBFK"]);
    var PRISM1 = ["EBFG","BKF","EHG","EBKH","HKFGt"];
    var PRISM2 = ["GFC","HKL","KFCL","LCGH","HKFGt"];
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "XII.3",
        pivot: "G,floor",
        elements: [
            "origin;point;fixed;90,250,0;0;0",
            "1X;point;fixed;342,250,-91;0;0",
            "1Y;point;fixed;-5,550,-120;0;0",
            "1Z;point;fixed;114,375,288;0;0",
            "floor;plane;3points;origin,1X,1Y;0;0;0;0",
            "D;point;lineSlider;origin,1Y,90,-20,0",
            "A;point;planeSlider;floor,40,179,0",
            "B;point;planeSlider;floor,175,280,0",
            "C;point;planeSlider;floor,241,212,0",
            "E;point;midpoint;A,B",
            "F;point;midpoint;B,C",
            "G;point;midpoint;A,C;black;green",
            "H;point;midpoint;A,D",
            "K;point;midpoint;B,D",
            "L;point;midpoint;C,D",
            "HKFG;polygon;quadrilateral;H,K,F,G;0;0;black;120,30,100",
            "AEGH;polyhedron;tetrahedron;A,E,G,H;0;0;black;random",
            "HKLD;polyhedron;tetrahedron;H,K,L,D;0;0;black;random",
            "CB;line;connect;C,B",
            "CG;line;connect;C,G",
            "EF;line;connect;E,F",
            "EB;line;connect;E,B",
            "KB;line;connect;K,B",
            "CL;line;connect;C,L",
            // Slide twins, hidden at rest: the outline, then the joins.
            "AB;line;connect;A,B",
            "CA;line;connect;C,A",
            "AD;line;connect;A,D",
            "DB;line;connect;D,B",
            "DC;line;connect;D,C",
            "HE;line;connect;H,E",
            "EG;line;connect;E,G",
            "GH;line;connect;G,H",
            "HK;line;connect;H,K",
            "KL;line;connect;K,L",
            "LH;line;connect;L,H",
            "KF;line;connect;K,F",
            "FG;line;connect;F,G",
            // Transparent highlight targets.
            "AE;line;connect;A,E;0;0;0",
            "AH;line;connect;A,H;0;0;0",
            "HD;line;connect;H,D;0;0;0",
            "KD;line;connect;K,D;0;0;0",
            "DL;line;connect;D,L;0;0;0",
            "BF;line;connect;B,F;0;0;0",
            "FC;line;connect;F,C;0;0;0",
            "EK;line;connect;E,K;0;0;0",
            "ABC;polygon;triangle;A,B,C;0;0;0;0",
            "AEH;polygon;triangle;A,E,H;0;0;0;0",
            "HKD;polygon;triangle;H,K,D;0;0;0;0",
            "AHG;polygon;triangle;A,H,G;0;0;0;0",
            "HLD;polygon;triangle;H,L,D;0;0;0;0",
            "EHG;polygon;triangle;E,H,G;0;0;0;0",
            "KDL;polygon;triangle;K,D,L;0;0;0;0",
            "AEG;polygon;triangle;A,E,G;0;0;0;0",
            "HKL;polygon;triangle;H,K,L;0;0;0;0",
            "ADB;polygon;triangle;A,D,B;0;0;0;0",
            "DHK;polygon;triangle;D,H,K;0;0;0;0",
            "DBC;polygon;triangle;D,B,C;0;0;0;0",
            "DKL;polygon;triangle;D,K,L;0;0;0;0",
            "ADC;polygon;triangle;A,D,C;0;0;0;0",
            "DLH;polygon;triangle;D,L,H;0;0;0;0",
            "GFC;polygon;triangle;G,F,C;0;0;0;0",
            "BKF;polygon;triangle;B,K,F;0;0;0;0",
            "EBF;polygon;triangle;E,B,F;0;0;0;0",
            "HEBK;polygon;quadrilateral;H,E,B,K;0;0;0;0",
            "EBFG;polygon;quadrilateral;E,B,F,G;0;0;0;0",
            "EBKH;polygon;quadrilateral;E,B,K,H;0;0;0;0",
            "HKFGt;polygon;quadrilateral;H,K,F,G;0;0;0;0",
            "KFCL;polygon;quadrilateral;K,F,C,L;0;0;0;0",
            "LCGH;polygon;quadrilateral;L,C,G,H;0;0;0;0",
            // Pyramid wireframes: each octagon walks the six edges.
            "ABCD;polygon;octagon;A,B,C,D,A,C,D,B;0;0;0;0",
            "pAEGH;polygon;octagon;A,E,G,H,A,G,H,E;0;0;0;0",
            "pHKLD;polygon;octagon;H,K,L,D,H,L,D,K;0;0;0;0",
            "pEBFK;polygon;octagon;E,B,F,K,E,F,K,B;0;0;0;0",
            "angEAH;sector;angleMarker;A,E,H;0;0;3b6ea5;9ec5e8",
            "angKHD;sector;angleMarker;H,K,D;0;0;3b6ea5;9ec5e8",
            "angEHG;sector;angleMarker;H,E,G;0;0;3f8e4f;a8dbb0",
            "angKDL;sector;angleMarker;D,K,L;0;0;3f8e4f;a8dbb0",
            "angBAC;sector;angleMarker;A,B,C;0;0;c06a1b;f3c590",
            "angKHL;sector;angleMarker;H,K,L;0;0;c06a1b;f3c590"
        ],
        initiallyHidden: ["AB","CA","AD","DB","DC",
                          "HE","EG","GH","HK","KL","LH","KF","FG"],
        aliases: { "BC": "CB", "AC": "CA", "BA": "AB", "DH": "HD", "EH": "HE",
