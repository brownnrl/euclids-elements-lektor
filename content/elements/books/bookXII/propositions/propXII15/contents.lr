                  { elem: "ACO", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "Lcirc", name: geomlib.A.Circle.compass },
                  { elem: "EGPR", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "Mcirc", name: geomlib.A.Circle.compass } ] } },
