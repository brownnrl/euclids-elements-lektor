            { text: "Let there be equal cones and cylinders with the circular bases {ABCD|circABCD} and {EFGH|circEFGH}.",
              highlighted: CONES },
            { text: "Let {AC} and {EG} be the diameters of the bases,",
              highlighted: ["AC","EG"] },
            // Joyce's sentence has no closing period; left literal.
            { text: "and {KL|LK} and {MN} the axes, which are also the heights of the cones or cylinders",
              highlighted: ["LK","MN"] },
            { text: "Complete the cylinders {AO|cylAO} and {EP|cylEP}.",
              visible: CYL,
