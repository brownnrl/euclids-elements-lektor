            "dB;point;extend;D,DEFcenter,DEFcenter,D;0;0",
            "d1';point;midpoint;D,F;0;0",
            "d1;point;cutoff;DEFcenter,d1',DEFcenter,D;0;0",
            "d2';point;midpoint;F,dB;0;0",
