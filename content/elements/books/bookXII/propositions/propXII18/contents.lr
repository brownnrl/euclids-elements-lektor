            "DEFsphere;circle;radius;DEFcenter,D;0;0;black;random",
            "H;point;lineSlider;B0,B3,380,0",
            "K;point;extend;H,DEFcenter,H,DEFcenter",
            "G;point;perpendicular;DEFcenter,K",
