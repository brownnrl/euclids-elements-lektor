            "M;point;lineSlider;M0,M3,180,0",
            "N;point;lineSlider;M0,M3,340,0",
            "LMNcenter;point;midpoint;M,N;0;0",
            "L;point;perpendicular;LMNcenter,N",
            "LMNsphere;circle;radius;LMNcenter,M;0;0;black;random",
            // Faceless twins of the four spheres.
            "ABC;circle;radius;ABCcenter,B;0;0;0;0",
            "DEF;circle;radius;DEFcenter,D;0;0;0;0",
            "GHK;circle;radius;DEFcenter,H;0;0;0;0",
            "LMN;circle;radius;LMNcenter,M;0;0;0;0",
