    var CYL   = PROD.concat(["Ncirc","CC'","DM","M","CM","FM"]);
    var CYL_EB = ["cG","AB","EB"];
    var CYL_FD = ["cK","CD","FD"];
    var CYL_CM = ["CD","Ncirc","CM"];
    var CYL_FM = ["cK","Ncirc","FM"];
    var CONE_ABG = ["AB","coneABG"];
    var CONE_CDK = ["CD","coneCDK"];
    geomlib.init({
