            "EAB;polygon;parallelogram;E,A,B;0;0;0;300,40,100",
            "Hcirc;circle;radius;H,A,Hplane;0;0;black;300,80,100",
            "ABG;polygon;triangle;A,B,G;0;0;0;300,80,100",
            "AE;line;connect;A,E",
            "AG;line;connect;A,G",
            "GH;line;connect;G,H",
            "GB;line;connect;G,B",
            "BB';line;parallel;B,H,G",
            "L;point;lineSlider;E',G,220,0,0",
            "C;point;cutoff;L,G,G,E",
            "D;point;extend;C,L,C,L",
            "L';point;parallelogram;L,G,Gy;0;0",
            "K;point;lineSlider;L,L',0,40,0",
            "F;point;parallelogram;K,L,C",
            "FC;line;connect;F,C",
            "CK;line;connect;C,K",
            "KL;line;connect;K,L",
            "KD;line;connect;K,D",
            "DD';line;parallel;D,L,K",
            "Kplane;plane;perpendicular;K,L;0;0;0;0",
            "Kcirc;circle;radius;K,F,Kplane;0;0;black;60,50,90",
            "FCD;polygon;parallelogram;F,C,D;0;0;0;60,50,90",
            "Lcirc;circle;radius;L,C,Gplane;0;0;black;70,90,90",
            "CDK;polygon;triangle;C,D,K;0;0;0;70,90,90",
            "N;point;extend;K,L,G,H",
            "M;point;parallelogram;N,L,D",
            "Ncirc;circle;radius;N,M,Hplane;0;0;black;0",
            "LN;line;connect;L,N",
            "DM;line;connect;D,M",
            "CC';line;extend;F,C,L,N",
