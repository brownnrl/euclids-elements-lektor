              highlighted: ["AX"] },
            { text: "therefore the remainder, the square on {BX}, equals the remainder, the square on {XK|KX}. Therefore {BX} equals {XK|KX}.",
              highlighted: ["BX","KX"] },
            { text: "Similarly we can prove that the straight lines joined from {X} to {P} and {S}",
              visible: XPS,
              highlighted: ["XP","XS"],
              transition: { mode: "parallel", animations: [
                  { elem: "XP", name: geomlib.A.Line.straightEdgeConnect },
