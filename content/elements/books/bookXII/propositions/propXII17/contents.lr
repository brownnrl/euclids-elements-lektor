            { text: "for the angle at {X} is right,",
              highlighted: ["angAXB"] },
            { text: "and the sum of the squares on {AX} and {XK|KX} equals the square on {AK|KA}.",
              highlighted: ["AX","KX","KA","angAXK"],
              justifications: [{ ref: "I.47" }] },
            { text: "Therefore the sum of the squares on {AX} and {XB|BX} equals the sum of the squares on {AX} and {XK|KX}.",
              highlighted: ["AX","BX","KX"] },
