            { text: "therefore the solid BGML equals the solid EHQP.",
              highlighted: BOXES },
            { text: "But in equal parallelepipedal solids the bases are reciprocally proportional to the heights,",
              highlighted: BOXES },
            { text: "therefore the base {BM} is to the base {EQ}",
              highlighted: ["BM","EQ"] },
            { text: "as the height of the solid EHQP is to the height of the solid BGML.",
