                  { elem: "BMrt", name: geomlib.A.Polygon.outline },
                  { elem: "BMtop", name: geomlib.A.Polygon.outline },
                  { elem: "BMbk", name: geomlib.A.Polygon.outline },
                  { elem: "EQ", name: geomlib.A.Polygon.outline },
                  { elem: "EQrt", name: geomlib.A.Polygon.outline },
                  { elem: "EQtop", name: geomlib.A.Polygon.outline },
                  { elem: "EQbk", name: geomlib.A.Polygon.outline } ] } },
            { text: "Now, since the pyramid {ABCG|pABCG} equals the pyramid {DEFH|pDEFH},",
              highlighted: PYRS },
