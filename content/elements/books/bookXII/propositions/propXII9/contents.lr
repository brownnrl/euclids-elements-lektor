        ],
        deferDraggables: ["M","a"],
        slides: [
            { text: "“In equal pyramids with triangular bases the bases are reciprocally proportional to the heights;”",
              visible: PYR,
              highlighted: PYRS,
              justifications: [{ ref: "XII.9" }] },
            { text: "“and those pyramids are equal in which the bases are reciprocally proportional to the heights.”",
              visible: PYR,
              highlighted: PYRS,
              justifications: [{ ref: "XII.9" }] },
            { text: "Let there be equal pyramids with triangular bases {ABC} and {DEF} and vertices {G} and {H}.",
              visible: PYR,
              highlighted: PYRS.concat(["ABC","DEF","G","H"]) },
            { text: "I say that in the pyramids {ABCG|pABCG} and {DEFH|pDEFH} the bases are reciprocally proportional to the heights,",
              visible: PYR,
              highlighted: PYRS },
