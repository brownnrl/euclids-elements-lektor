            "D0;point;free;-1000,110;0;0",
            "D3;point;free;1000,110;0;0",
            "E0;point;free;-1000,145;0;0",
            "E3;point;free;1000,145;0;0",
            "A1;point;lineSlider;A0,A3,100,30;0",
            "A2;point;lineSlider;A0,A3,160,30;0",
            "A;line;connect;A1,A2;black",
            "B1;point;lineSlider;B0,B3,100,30;0",
            "B2;point;lineSlider;B0,B3,180,30;0",
            "B;line;connect;B1,B2;black",
            "C1;point;lineSlider;A0,A3,30,30;0",
            "C2;point;lineSlider;A0,A3,70,30;0",
            "C;line;connect;C1,C2;black",
            "U1;point;lineSlider;A0,A3,1000,30;0;0",
            "U2;point;lineSlider;A0,A3,1015,30;0;0",
            "D1;point;lineSlider;D0,D3,30,110;0",
            "D2;point;proportion;U1,U2,C1,C2,A1,A2,D1,D3;0",
            "D;line;connect;D1,D2;black",
            "E1;point;lineSlider;E0,E3,30,110;0",
            "E2;point;proportion;U1,U2,C1,C2,B1,B2,E1,E3;0",
