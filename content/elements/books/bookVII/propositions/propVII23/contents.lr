            "P1;point;free;1000,10;0;0",
            "P2;point;free;1000,20;0;0",
            "P3;point;free;1000,30;0;0",
            "C2;point;proportion;P0,P3,A1,A2,P0,P1,C1,C3;0",
            "C;line;connect;C1,C2;black",
            "D2;point;proportion;A1,A2,B1,B2,C1,C2,D1,D3;0",
