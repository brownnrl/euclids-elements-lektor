        elements: [
            "A0;point;free;30,-1000;0;0",
            "A3;point;free;30,1000;0;0",
            "C0;point;free;65,-1000;0;0",
            "C3;point;free;65,1000;0;0",
            "E0;point;free;100,-1000;0;0",
            "E3;point;free;100,1000;0;0",
            "A;point;lineSlider;A0,A3,30,30",
            "C;point;lineSlider;C0,C3,60,30",
            "E1;point;lineSlider;E0,E3,30,30;0",
            "H;point;lineSlider;A0,A3,30,50",
            "C1;point;cutoff;C,C3,A,H;0;0",
            "G;point;cutoff;C1,C3,A,H",
            "F;point;cutoff;H,A3,C,G",
            "G1;point;cutoff;G,C3,A,F;0;0",
            "D;point;cutoff;G1,C3,A,F",
            "B;point;cutoff;F,A3,C,D",
            "AB;line;connect;A,B",
            "CD;line;connect;C,D",
