              visible: DIV2,
              highlighted: ["BG","GC","A"] },
            { text: "Therefore, the sum of {BC} and {EF} is the same multiple of the sum of {A} and {D}",
              visible: DIV2,
              highlighted: ["BC","EF","A","D"] },
            { text: "that {BC} is of {A}.",
              visible: DIV2,
              highlighted: ["BC","A"] },
            { text: "Therefore, the sum of {A} and {D} is the same part of the sum of {BC} and {EF}",
              visible: DIV2,
              highlighted: ["A","D","BC","EF"] },
            { text: "that {A} is of {BC}.",
              visible: DIV2,
              highlighted: ["A","BC"] },
            { text: "Therefore, if a number is part of a number, and another is the same part of another,",
              visible: DIV2,
              highlighted: ["A","BC","D","EF"] },
            { text: "then the sum is also the same part of the sum that the one is of the one.",
              visible: DIV2,
              highlighted: ["A","BC","D","EF"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
