            "B3;point;free;60,1000;0;0",
            "B;point;lineSlider;B0,B3,60,30",
            "D0;point;free;90,-1000;0;0",
            "D3;point;free;90,1000;0;0",
            "D1;point;lineSlider;D0,D3,90,30;0",
            "E0;point;free;120,-1000;0;0",
            "E3;point;free;120,1000;0;0",
            "E;point;lineSlider;E0,E3,120,30",
            "A2;point;lineSlider;A0,A3,30,110;0",
            "A;line;connect;A1,A2;black",
            "G;point;cutoff;B,B3,A1,A2",
            "C;point;cutoff;G,B3,A1,A2",
            "BC;line;connect;B,C",
            "D2;point;lineSlider;D0,D3,30,80;0",
            "D;line;connect;D1,D2;black",
            "H;point;cutoff;E,E3,D1,D2",
            "F;point;cutoff;H,E3,D1,D2",
            "EF;line;connect;E,F"
        ],
