            "C0;point;free;-1000,100;0;0",
            "C3;point;free;1000,100;0;0",
            "F0;point;free;-1000,135;0;0",
            "F3;point;free;1000,135;0;0",
            "A1;point;lineSlider;A0,A3,30,40;0",
            "A2;point;lineSlider;A0,A3,75,40;0",
            "A;line;connect;A1,A2;black",
            "B1;point;lineSlider;B0,B3,30,75;0",
            "B2;point;lineSlider;B0,B3,90,75;0",
            "B;line;connect;B1,B2;black",
            "C1;point;lineSlider;C0,C3,30,75;0",
            "C2;point;lineSlider;C0,C3,100,75;0",
            "C;line;connect;C1,C2;black",
            "F1;point;lineSlider;F0,F3,30,170;0",
            "F2;point;lineSlider;F0,F3,55,170;0",
            "F;line;connect;F1,F2;black",
            "D1;point;lineSlider;B0,B3,140,100;0",
            "D2;point;proportion;F1,F2,A1,A2,B1,B2,D1,B3;0",
            "D;line;connect;D1,D2;black",
            "E1;point;lineSlider;C0,C3,140,100;0",
