            "C3;point;free;1000,105;0;0",
            "D0;point;free;-1000,140;0;0",
            "D3;point;free;1000,140;0;0",
            "E0;point;free;-1000,175;0;0",
            "E3;point;free;1000,175;0;0",
            "U1;point;free;1000,0;0;0",
            "U2;point;free;1000,40;0;0",
            "A1;point;lineSlider;A0,A3,30,0;0",
            "A2;point;lineSlider;A0,A3,100,0;0",
