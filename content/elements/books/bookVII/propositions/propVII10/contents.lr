        // E and the end handles C1, F1 — all givens, standing from slide 1.
        // G and H are derived midpoints and follow the visible sets,
        // arriving with "Divide".
        aliases: { "BA": "AB", "ED": "DE", "GA": "AG", "BG": "GB",
