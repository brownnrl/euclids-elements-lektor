    // (cutoff) are derived and listed per slide.
    var GIVEN  = ["A","B"];
    var WITH_C = GIVEN.concat(["C","C1","C2"]);
    var WITH_D = WITH_C.concat(["D","D1","D2"]);
    geomlib.init({
