            "A1;point;lineSlider;A0,A3,30,40;0",
            "A2;point;lineSlider;A0,A3,65,40;0",
            "A;line;connect;A1,A2;black",
            "B;point;lineSlider;A0,A3,110,40",
            "G;point;cutoff;B,A3,A1,A2",
            "H;point;cutoff;G,A3,A1,A2",
            "C;point;cutoff;H,A3,A1,A2",
            "BC;line;connect;B,C",
            "D1;point;lineSlider;D0,D3,100,40;0",
            "D2;point;cutoff;D1,D3,B,H;0",
            "D;line;connect;D1,D2;black",
            "E;point;lineSlider;E0,E3,30,40",
            "K;point;cutoff;E,E3,D1,D2",
            "L;point;cutoff;K,E3,D1,D2",
