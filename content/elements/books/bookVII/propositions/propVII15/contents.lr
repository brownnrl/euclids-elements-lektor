    var GIVEN = ["A","BC","B","C","D","D2","EF","E","F"];
    var DIV1  = GIVEN.concat(["G","H","BG","GH","HC"]);
    var DIV2  = DIV1.concat(["K","L","EK","KL","LF"]);
