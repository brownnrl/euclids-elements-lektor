            "AE;line;connect;A,E;0;0;0",
            "EB;line;connect;E,B;0;0;0",
            "CF;line;connect;C,F;0;0;0",
            "FD;line;connect;F,D;0;0;0"
        ],
        slides: [
            { text: "“If a whole is to a whole as a subtracted number is to a subtracted number,”",
              visible: GIVEN,
              highlighted: ["AB","CD","AE","CF"] },
