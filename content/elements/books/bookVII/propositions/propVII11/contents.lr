title: Proposition 11
---
order: 11
---
short_label: VII.11
---
sections:

#### prop_section ####
kind: proposition
----
statement: If a whole is to a whole as a subtracted number is to a subtracted number, then the remainder is to the remainder as the whole is to the whole.
----
proof:

Let the whole {AB} be to the whole {CD} as {AE} subtracted is to {CF} subtracted.

<figure class="diagram">
<canvas id="canvas_0" width="100" height="210" tabindex="0"></canvas>
<noscript><img alt="VII.11 diagram" src="propVII11.gif"/></noscript>
<script type="text/javascript">
    // AB : CD = AE : CF, with F placed on CD by proportion. Line segments
    // only, so the walk is highlight beats; no animations.
    //
    // Added to Joyce's figure, all transparent (;0;0;0): the segments AE,
    // EB, CF and FD the proof names, so they can light.
    //
    // Draggables (checked against the bundle): the lineSliders A, B, C, D,
    // E and the colourless off-canvas rail ends. All are givens and stand
    // from slide 1. F is derived and is listed in the visible set.
    var GIVEN = ["A","B","E","AB","AE","EB","C","D","F","CD","CF","FD"];
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
