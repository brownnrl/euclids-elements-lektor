        elements: [
            "A0;point;free;30,-1000;0;0",
            "A3;point;free;30,1000;0;0",
            "A;point;lineSlider;A0,A3,30,30",
            "C0;point;free;60,-1000;0;0",
            "C3;point;free;60,1000;0;0",
            "C1;point;lineSlider;C0,C3,60,30;0",
            "D0;point;free;90,-1000;0;0",
            "D3;point;free;90,1000;0;0",
            "D;point;lineSlider;D0,D3,90,30",
            "F0;point;free;120,-1000;0;0",
            "F3;point;free;120,1000;0;0",
            "F1;point;lineSlider;F0,F3,120,30;0",
            "G;point;lineSlider;A0,A3,30,80",
            "B;point;cutoff;G,A3,A,G",
            "AB;line;connect;A,B",
            "C';point;cutoff;C1,C3,A,B;0;0",
            "C2;point;cutoff;C',C3,A,G;0",
            "C;line;connect;C1,C2;black",
            "H;point;lineSlider;D0,D3,30,70",
            "E;point;cutoff;H,D3,D,H",
            "DE;line;connect;D,E",
            "F';point;cutoff;F1,F3,D,E;0;0",
            "F2;point;cutoff;F',F3,D,H;0",
            "F;line;connect;F1,F2;black"
        ],
