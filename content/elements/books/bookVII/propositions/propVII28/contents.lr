            "A;point;lineSlider;A0,A3,30,0",
            "B;point;lineSlider;A0,A3,150,0",
            "C;point;lineSlider;A0,A3,220,0",
            "AC;line;connect;A,C",
            "M;point;midpoint;B,C;0;0",
            "D1;point;lineSlider;D0,D3,100,0;0",
