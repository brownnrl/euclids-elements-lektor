            "D2;point;cutoff;D',D3,E1,E2;0",
            "D;line;connect;D1,D2;black",
            "B';point;cutoff;B1,B3,D1,D2;0;0",
            "B2;point;cutoff;B',B3,D1,D2;0",
            "B;line;connect;B1,B2;black",
            "C';point;cutoff;C1,C3,D1,D2;0;0",
