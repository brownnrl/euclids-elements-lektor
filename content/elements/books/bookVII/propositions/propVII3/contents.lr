              highlighted: ["E","D","A","B"] },
            { text: "But it measures {C} also, therefore {E} measures {A}, {B}, and {C}.",
              visible: WITHE,
              highlighted: ["E","A","B","C"] },
            { text: "Therefore {E} is a common measure of {A}, {B}, and {C}.",
              visible: WITHE,
              highlighted: ["E"] },
            { text: "I say next that it is also the greatest.",
              visible: WITHE,
              highlighted: ["E"] },
            { text: "If {E} is not the greatest common measure of {A}, {B}, and {C},",
              visible: WITHE,
              highlighted: ["E","A","B","C"] },
            { text: "then some number {F}, greater than {E}, measures the numbers {A}, {B}, and {C}.",
              visible: WITHF,
              highlighted: ["F","A","B","C"],
              transition: { animations: [
                  { elem: "F", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Now, since {F} measures {A}, {B}, and {C}, it also measures {A} and {B},",
              visible: WITHF,
              highlighted: ["F","A","B"] },
            { text: "therefore it measures the greatest common measure of {A} and {B}.",
              visible: WITHF,
              highlighted: ["A","B"],
              justifications: [{ claim: "a common measure measures the GCM", ref: "VII.2,Cor." }] },
            { text: "But the greatest common measure of {A} and {B} is {D}, therefore {F} measures {D}.",
              visible: WITHF,
              highlighted: ["D","F"] },
            { text: "And it measures {C} also, therefore {F} measures {D} and {C}.",
              visible: WITHF,
              highlighted: ["F","D","C"] },
            { text: "Therefore it also measures the greatest common measure of {D} and {C}.",
              visible: WITHF,
              highlighted: ["D","C"],
              justifications: [{ claim: "a common measure measures the GCM", ref: "VII.2,Cor." }] },
            { text: "But the greatest common measure of {D} and {C} is {E}, therefore {F} measures {E},",
              visible: WITHF,
              highlighted: ["E","F"] },
            { text: "the greater the less, which is impossible.",
              visible: WITHF,
              highlighted: ["F","E"] },
            { text: "Therefore no number which is greater than {E} measures the numbers {A}, {B}, and {C}.",
              visible: WITHF,
              highlighted: ["E","A","B","C"] },
            { text: "Therefore {E} is the greatest common measure of {A}, {B}, and {C}.",
              visible: WITHF,
              highlighted: ["E","A","B","C"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "VII.3") return "#prop";
