            "B3;point;free;60,1000;0;0",
            "B1;point;lineSlider;B0,B3,60,30;0",
            "C0;point;free;90,-1000;0;0",
            "C3;point;free;90,1000;0;0",
            "C1;point;lineSlider;C0,C3,90,30;0",
