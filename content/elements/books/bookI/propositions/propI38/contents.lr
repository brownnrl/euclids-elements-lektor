_model: proposition
---
title: Proposition 38
---
order: 38
---
short_label: I.38
---
sections:

#### prop_section ####
kind: proposition
----
statement: Triangles which are on equal bases and in the same parallels equal one another.
----
proof:

Let {ABC} and {DEF} be triangles on equal bases {BC} and {EF} and in the same parallels {BF} and {AD}.

I say that the triangle {ABC} equals the triangle {DEF}.

<figure class="diagram">
<canvas id="canvas_0" width="310" height="210" tabindex="0"></canvas>
<noscript><img alt="I.38 diagram" src="propI38.gif"/></noscript>
<script type="text/javascript">
    // Same walk as I.37, one generalization on: the bases are equal rather
    // than shared, so the two parallelograms are equal by I.36 instead of
    // I.35. Gating matches I.37 — slide 3 drops the TRIANGLE fills so the two
    // parallelograms read cleanly, slides 4-5 bring each triangle back inside
    // its own parallelogram (the "half of" beat). Hiding a triangle also takes
    // its diagonal, so the diameters AB / DF appear only on the slide that
    // names them.
    var BASE = ["A","B","C","D","E","F",
                "BF","AD","BC","EF","AC","DE","AB","DF",
                "ABC","DEF"];
    var PROD = BASE.concat(["G","H","GH","BG","FH"]);
    var PARA = ["A","B","C","D","E","F","G","H",
                "BF","AD","GH","BG","FH","BC","EF","AC","DE","AB","DF",
                "GBCA","DEFH"];
    var HALF = PROD.concat(["GBCA","DEFH"]);
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "I.38",
        elements: [
            "B;point;free;60,170",
            "C;point;free;130,170",
            "A;point;free;120,40",
            // Invisible carrier: the parallel to BC through A, on which D slides.
            "AD';line;parallel;A,B,C;0;0;0",
            "D;point;lineSlider;AD',150,40",
            // E slides along BC produced; F completes the equal base EF = BC.
            // B, C, E, F are therefore collinear, so one BF line draws the
            // whole bottom parallel.
            "E;point;lineSlider;B,C,190,170",
            "F;point;parallelogram;C,B,E",
            // G and H are the fourth vertices of the two parallelograms, and
            // both land on AD produced. All four derived points stay on-canvas.
            "G;point;parallelogram;A,C,B",
            "H;point;parallelogram;D,E,F",
            // The two parallels: the bottom BF, the original top AD, and AD
            // produced to G and H.
            "BF;line;connect;B,F",
            "AD;line;connect;A,D",
            "GH;line;connect;G,H",
            // The two parallels drawn in the construction: BG ∥ CA, FH ∥ DE.
            "BG;line;connect;B,G",
            "FH;line;connect;F,H",
            // Parallelogram edges that are also triangle sides — drawn in their
            // own right so they survive slide 3, where the triangles are hidden.
            "AC;line;connect;A,C",
            "DE;line;connect;D,E",
            // The equal bases and the two diameters, as hover targets only;
            // BF and the triangles already draw these.
            "BC;line;connect;B,C;0;0;0",
            "EF;line;connect;E,F;0;0;0",
            "AB;line;connect;A,B;0;0;0",
            "DF;line;connect;D,F;0;0;0",
            // Regions, colour-matched to I.37: triangles cyan / pink keep
            // Joyce's black edges; the parallelograms are fill-only (their
            // boundaries are the lines above) and start hidden, since the
            // original figure draws no such regions.
            "ABC;polygon;triangle;A,B,C;0;0;0,0,0;cyan",
            "DEF;polygon;triangle;D,E,F;0;0;0,0,0;pink",
            "GBCA;polygon;quadrilateral;G,B,C,A;0;0;0;orange",
            "DEFH;polygon;quadrilateral;D,E,F,H;0;0;0;green"
        ],
        aliases: { "FED": "DEF", "BA": "AB", "FD": "DF", "CA": "AC", "ED": "DE",
                   "GB": "BG", "HF": "FH", "DA": "AD", "HG": "GH", "FB": "BF",
                   "CB": "BC", "FE": "EF" },
        initiallyHidden: ["GBCA","DEFH"],
        slides: [
            { text: "Let {ABC} and {DEF} be triangles on equal bases {BC} and {EF} and in the same parallels {BF} and {AD}. I say that {ABC} equals {DEF}.",
              visible: BASE,
              highlighted: ["ABC","DEF","BC","EF"] },
            { text: "Produce {AD} in both directions to {G} and {H}. Draw {BG} through {B} parallel to {CA}, and draw {FH} through {F} parallel to {DE}.",
              visible: PROD,
              highlighted: ["GH","BG","FH"],
              transition: { mode: "cascade", animations: [
                  { elem: "GH", name: geomlib.A.Line.straightEdgeExtend },
                  { elem: "BG", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "FH", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ ref: "I.Post.2" }, { ref: "I.31" }] },
            { text: "Then each of the figures {GBCA} and {DEFH} is a parallelogram, and {GBCA} equals {DEFH}, for they are on equal bases {BC} and {EF} and in the same parallels {BF} and {GH}.",
              visible: PARA,
              highlighted: ["GBCA","DEFH","BC","EF"],
              transition: { mode: "cascade", animations: [
                  { elem: "GBCA", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "DEFH", name: geomlib.A.Polygon.outlineAndFill } ] },
              justifications: [{ ref: "I.36" }] },
            { text: "Moreover the triangle {ABC} is half of the parallelogram {GBCA}, for the diameter {AB} bisects it.",
              visible: HALF,
              highlighted: ["ABC","GBCA","AB"],
              transition: { animations: [ { elem: "ABC", name: geomlib.A.Polygon.outlineAndFill } ] },
              justifications: [{ ref: "I.34" }] },
            { text: "And the triangle {FED} is half of the parallelogram {DEFH}, for the diameter {DF} bisects it.",
              visible: HALF,
              highlighted: ["DEF","DEFH","DF"],
              transition: { animations: [ { elem: "DEF", name: geomlib.A.Polygon.outlineAndFill } ] },
              justifications: [{ ref: "I.34" }] },
            { text: "The halves of equal magnitudes equal one another, therefore the triangle {ABC} equals the triangle {DEF}.",
              visible: HALF,
              highlighted: ["ABC","DEF"],
              justifications: [{ ref: "C.N." }] },
            { text: "So triangles which are on equal bases and in the same parallels equal one another.",
              visible: HALF,
              highlighted: ["ABC","DEF"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "I.Post.2": "/elements/books/bookI/postulates/post2/",
        "I.31":     "/elements/books/bookI/propositions/propI31/",
        "I.34":     "/elements/books/bookI/propositions/propI34/",
        "I.36":     "/elements/books/bookI/propositions/propI36/",
        "C.N.":     "/elements/books/bookI/commonnotions/"
    });
</script>
</figure>

Produce {AD} in both directions to {G} and {H}. Draw {BG} through {B} parallel to {CA}, and draw {FH} through {F} parallel to {DE}. [!just I.Post.2; I.31]

Then each of the figures {GBCA} and {DEFH} is a parallelogram, and {GBCA} equals {DEFH}, for they are on equal bases {BC} and {EF} and in the same parallels {BF} and {GH}. [!just I.36]

Moreover the triangle {ABC} is half of the parallelogram {GBCA}, for the diameter {AB} bisects it. And the triangle {FED} is half of the parallelogram {DEFH}, for the diameter {DF} bisects it. [!just I.34]

[!just C.N.]

Therefore the triangle {ABC} equals the triangle {DEF}.

Therefore *triangles which are on equal bases and in the same parallels equal one another.*

<div class="qed">Q.E.D.</div>
----
guide:

The idea of the argument is clear: since parallelograms on equal bases and in the same parallels are equal by @I.36, and the triangles are half the parallelograms by @I.34, therefore the triangles are also equal.

#### Use of Proposition 38

This proposition is used in @I.40, @I.42, and @VI.1.
