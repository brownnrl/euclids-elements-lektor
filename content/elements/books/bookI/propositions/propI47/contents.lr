            "GBfill;polygon;quadrilateral;B,A,G,F;0;0;0;orange",
            "HCfill;polygon;quadrilateral;A,C,K,H;0;0;0;green",
            "BL;polygon;quadrilateral;B,D,L,J;0;0;0;orange",
            "CL;polygon;quadrilateral;J,L,E,C;0;0;0;green",
            "ABD;polygon;triangle;A,B,D;0;0;0;yellow",
            "FBC;polygon;triangle;F,B,C;0;0;0;yellow",
            // Angles. The triangles own ABD and FBC, so the markers are angDBA
            // and angFBC, reached from the prose with a display override.
            "angBAC;sector;angleMarker;A,B,C,20;0;0;red;red",
            "angBAG;sector;angleMarker;A,B,G,20;0;0;red;red",
            "angDBC;sector;angleMarker;B,D,C,20;0;0;red;red",
            "angFBA;sector;angleMarker;B,F,A,20;0;0;red;red",
            "angABC;sector;angleMarker;B,A,C,20;0;0;yellow;yellow",
            "angDBA;sector;angleMarker;B,D,A,30;0;0;magenta;magenta",
            "angFBC;sector;angleMarker;B,F,C,38;0;0;magenta;magenta"
        ],
        aliases: { "BDEC": "A2", "GB": "B2", "HC": "C2",
                   "BA": "AB", "CA": "AC", "CB": "BC", "DB": "BD", "BF": "FB",
                   "GA": "AG", "HA": "AH", "FC": "CF", "CG": "GC", "EC": "CE",
                   "DA": "AD", "EA": "AE", "KB": "BK", "LA": "AL",
                   "BAC": "angBAC", "BAG": "angBAG", "DBC": "angDBC",
                   "FBA": "angFBA", "DBA": "angDBA" },
        initiallyHidden: ["GBfill","HCfill","BL","CL","ABD","FBC"],
        slides: [
            { text: "Let {ABC} be a right-angled triangle having the angle {BAC} right.",
              visible: GIVEN,
              highlighted: ["ABC","angBAC"],
              transition: { animations: [ { elem: "angBAC", name: geomlib.A.Sector.sweep } ] } },
            { text: "I say that the square on {BC} equals the sum of the squares on {BA} and {AC}.",
              visible: GIVEN,
              highlighted: ["BC","AB","AC"] },
            { text: "Describe the square {BDEC} on {BC}, and the squares {GB} and {HC} on {BA} and {AC}.",
              visible: SQ,
              highlighted: ["A2","B2","C2"],
              transition: { mode: "cascade", animations: [
                  { elem: "A2", name: geomlib.A.Polygon.outline },
                  { elem: "B2", name: geomlib.A.Polygon.outline },
                  { elem: "C2", name: geomlib.A.Polygon.outline } ] },
              justifications: [{ ref: "I.46" }] },
            { text: "Draw {AL} through {A} parallel to either {BD} or {CE}, and join {AD} and {FC}.",
              visible: LIN,
              highlighted: ["AL","AD","CF"],
              transition: { mode: "cascade", animations: [
                  { elem: "AL", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "AD", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "CF", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ ref: "I.31" }, { ref: "I.Post.1" }] },
            { text: "Since each of the angles {BAC} and {BAG} is right, the two straight lines {AC} and {AG} make adjacent angles equal to two right angles — therefore {CA} is in a straight line with {AG}.",
              visible: STR,
              highlighted: ["angBAC","angBAG","AC","AG"],
              transition: { animations: [ { elem: "angBAG", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ ref: "I.Def.22" }, { ref: "I.14" }] },
            { text: "For the same reason {BA} is also in a straight line with {AH}.",
              visible: STR,
              highlighted: ["AB","AH"],
              justifications: [{ ref: "I.14" }] },
            { text: "Since the angle {DBC} equals the angle {FBA}, for each is right, add the angle {ABC|angABC} to each — therefore the whole angle {DBA} equals the whole angle {FBC|angFBC}.",
              visible: ANGB,
              highlighted: ["angDBC","angFBA","angABC","angDBA","angFBC"],
              transition: { mode: "cascade", animations: [
                  { elem: "angDBC", name: geomlib.A.Sector.sweep },
                  { elem: "angFBA", name: geomlib.A.Sector.sweep },
                  { elem: "angABC", name: geomlib.A.Sector.sweep },
                  { elem: "angDBA", name: geomlib.A.Sector.sweep },
                  { elem: "angFBC", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ ref: "I.Def.22" }, { ref: "I.Post.4" }, { ref: "C.N.2" }] },
            { text: "Since {DB} equals {BC} and {FB} equals {BA}, the two sides {AB} and {BD} equal {FB} and {BC}, and the angle {ABD|angDBA} equals the angle {FBC|angFBC} — therefore the base {AD} equals the base {FC}, and the triangle {ABD} equals the triangle {FBC}.",
              visible: TRI,
              highlighted: ["ABD","FBC"],
              transition: { mode: "cascade", animations: [
                  { elem: "ABD", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "FBC", name: geomlib.A.Polygon.outlineAndFill } ] },
              justifications: [{ ref: "I.Def.22" }, { ref: "I.4" }] },
            { text: "Now the parallelogram {BL} is double the triangle {ABD}, for they have the same base {BD} and are in the same parallels {BD} and {AL}. And the square {GB} is double the triangle {FBC}, for they have the same base {FB} and are in the same parallels {FB} and {GC}.",
              visible: EQ1,
              highlighted: ["BL","ABD","B2","FBC"],
              transition: { mode: "cascade", animations: [
                  { elem: "BL",     name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "GBfill", name: geomlib.A.Polygon.outlineAndFill } ] },
              justifications: [{ ref: "I.41" }] },
            { text: "Therefore the parallelogram {BL} also equals the square {GB}.",
              visible: EQ1,
              highlighted: ["BL","B2"],
              justifications: [{ ref: "I.41" }] },
            { text: "Similarly, if {AE} and {BK} are joined, the parallelogram {CL} can also be proved equal to the square {HC}. Therefore the whole square {BDEC} equals the sum of the two squares {GB} and {HC}.",
              visible: EQ2,
              highlighted: ["CL","C2"],
              transition: { mode: "cascade", animations: [
                  { elem: "AE",     name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "BK",     name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "CL",     name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "HCfill", name: geomlib.A.Polygon.outlineAndFill } ] },
              justifications: [{ ref: "I.41" }] },
            { text: "And the square {BDEC} is described on {BC}, and the squares {GB} and {HC} on {BA} and {AC}.",
              visible: EQ2,
              highlighted: ["A2","B2","C2"],
              justifications: [{ ref: "C.N.2" }] },
            { text: "Therefore the square on {BC} equals the sum of the squares on {BA} and {AC}.",
              visible: EQ2,
              highlighted: ["A2","B2","C2"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
