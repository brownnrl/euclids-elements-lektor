    //
    // The circle is renamed BCcirc — Joyce's figure called it ABC, which
    // collides with the triangle ABC his guide prose names. It is invisible
    // either way; the rename just frees the name for the triangle.
    var L1 = ["A","B","C","BC","ABC"];
    var L2 = L1.concat(["M","AM","BM","CM","AB","AC"]);
    var L3 = L2.concat(["ABM","ACM"]);
