    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "I.Post.1": "/elements/books/bookI/postulates/post1/",
        "I.Post.4": "/elements/books/bookI/postulates/post4/",
        "I.4":      "/elements/books/bookI/propositions/propI4/",
        "I.14":     "/elements/books/bookI/propositions/propI14/",
        "I.31":     "/elements/books/bookI/propositions/propI31/",
        "I.41":     "/elements/books/bookI/propositions/propI41/",
        "I.46":     "/elements/books/bookI/propositions/propI46/",
