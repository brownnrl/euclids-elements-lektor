            "A;point;circleSlider;BCcirc,120,40",
            "M;point;foot;A,B,C",
            "ABC;polygon;triangle;A,B,C;0;0;black;0",
            "AM;line;connect;A,M",
            // The two sub-triangles, matched to canvas_0's BL and CL.
            "ABM;polygon;triangle;A,B,M;0;0;0;orange",
            "ACM;polygon;triangle;A,C,M;0;0;0;green",
            // Segments the guide names — the triangles already draw them.
            "BC;line;connect;B,C;0;0;0",
            "AB;line;connect;A,B;0;0;0",
            "AC;line;connect;A,C;0;0;0",
            "BM;line;connect;B,M;0;0;0",
            "CM;line;connect;C,M;0;0;0"
        ],
        aliases: { "AMC": "ACM", "CB": "BC", "BA": "AB", "CA": "AC",
                   "MB": "BM", "MC": "CM", "MA": "AM" },
        initiallyHidden: ["ABM","ACM"],
        slides: [
            { text: "Let {ABC} be a right-angled triangle with a right angle at {A}. Draw {AM} perpendicular to {BC}.",
              visible: L2,
              highlighted: ["ABC","AM"],
              transition: { animations: [ { elem: "AM", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "According to VI.8, the triangles {ABM} and {AMC} are similar both to the whole {ABC} and to one another.",
              visible: L3,
              highlighted: ["ABM","ACM","ABC"],
              transition: { mode: "cascade", animations: [
                  { elem: "ABM", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "ACM", name: geomlib.A.Polygon.outlineAndFill } ] },
              justifications: [{ ref: "VI.8" }, { ref: "VI.4" }] },
            { text: "Since triangle {ABC} is similar to triangle {ABM}, therefore, by the definition of similarity, {CB} is to {BA} as {BA} is to {BM}.",
              visible: L3,
              highlighted: ["ABC","ABM","BC","AB","BM"],
              justifications: [{ ref: "VI.Def.1" }] },
            { text: "Next VI.17 converts this proportion to a statement about areas: the rectangle {CB} by {BM} — which is the parallelogram BL in the proof of I.47 — equals the square on {AB}. For the same reason the rectangle {BC} by {CM} (the parallelogram CL) equals the square on {AC}.",
              visible: L3,
              highlighted: ["BM","CM","AB","AC"],
              justifications: [{ ref: "VI.17" }] },
            { text: "Therefore the sum of the two rectangles {CB} by {BM} and {BC} by {CM}, which is the square on {BC}, equals the sum of the squares on {AC} and {BC}.",
              visible: L3,
              highlighted: ["ABM","ACM","BC"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Merge into the page-wide citation lookup (shared with canvas_0).
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "VI.4":     "/elements/books/bookVI/propositions/propVI4/",
        "VI.8":     "/elements/books/bookVI/propositions/propVI8/",
        "VI.17":    "/elements/books/bookVI/propositions/propVI17/",
        "VI.Def.1": "/elements/books/bookVI/definitions/defVI1/"
    });
</script>
