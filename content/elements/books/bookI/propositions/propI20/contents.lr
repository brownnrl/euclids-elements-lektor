sections:

#### prop_section ####
kind: proposition
----
statement: In any triangle the sum of any two sides is greater than the remaining one.
----
proof:

Let {ABC} be a triangle.

I say that in the triangle {ABC} the sum of any two sides is greater than the remaining one, that is, the sum of {BA} and {AC} is greater than {BC}, the sum of {AB} and {BC} is greater than {AC}, and the sum of {BC} and {CA} is greater than {AB}.

<figure class="diagram">
<canvas id="canvas_0" width="220" height="220" tabindex="0"></canvas>
<noscript><img alt="I.20 diagram" src="propI20.gif"/></noscript>
<script type="text/javascript">
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "I.20",
        elements: [
            "A;point;free;70,130",
            "B;point;free;40,180",
            "C;point;free;180,180",
            "ABC;polygon;triangle;A,B,C;0;0;0,0,0;random",
            // BA produced beyond A by AC to D (so DB = BA + AC); DC joined.
            // △ACD is isosceles (DA = AC).
            "AD;line;extend;B,A,A,C",
            "D;point;last;AD",
            "CD;line;connect;C,D",
            "ACD;polygon;triangle;A,C,D;0;0;0;random",
            // △DCB (the one whose greater angle gives the longer side) +
            // the long side DB, all zero-color hover targets.
            "DCB;polygon;triangle;D,C,B;0;0;0;0",
            "DB;line;connect;D,B;0;0;0",
            "AB;line;connect;A,B;0;0;0",
            "BC;line;connect;B,C;0;0;0",
            "AC;line;connect;A,C;0;0;0",
            // Angle markers. ∠ADC = ∠BDC (D on line BA, A between B and D).
            // ∠ACD's marker is DCA — the name "ACD" already belongs to the
            // isosceles polygon, so prose uses {ACD|DCA}. At C, ∠ACD nests
            // inside ∠BCD (#103).
            "ADC;sector;angleMarker;D,A,C",
            "DCA;sector;angleMarker;C,D,A",
            "BCD;sector;angleMarker;C,B,D"
        ],
        aliases: {
            "BA":  "AB",
            "CA":  "AC",
            "DA":  "AD",
            "DC":  "CD",
            "BDC": "ADC"
        },
        slides: [
            { text: "Let {ABC} be a triangle.",
              visible: ["ABC"] },
