        "B;point;free;215,130",
        "AB;line;connect;A,B",
        // Circles named for the three labelled points they pass through
        // (BCD = the circle centred at A through B,C,D; ACE = centred at B
        // through A,C,E). Joyce's prose uses these three-point names; the
        // geometry is unchanged from the original Acirc / Bcirc.
        "BCD;circle;radius;A,B",
        "ACE;circle;radius;B,A",
        "CD;line;bichord;ACE,BCD;0;0;0",
        "C;point;first;CD;black;green",
