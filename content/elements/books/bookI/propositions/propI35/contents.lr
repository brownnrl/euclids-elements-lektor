            "A;point;free;30,40",
            "AB;line;connect;A,B",
            "D;point;parallelogram;A,B,C",
            "CD;line;connect;C,D",
            "E;point;lineSegmentSlider;A,D,120,40",
            "BE;line;connect;B,E",
            "F;point;parallelogram;E,B,C",
            "CF;line;connect;C,F",
            "DE;line;connect;D,E",
