            "ABC;polygon;triangle;A,B,C;0;0;0,0,0;random",
            "D1;point;free;45,25;0",
            "D2;point;free;30,75;0",
            "D3;point;free;80,75;0",
            "D1D2;line;connect;D1,D2",
            "D2D3;line;connect;D2,D3",
            "D;polygon;triangle;D1,D2,D3;0,0,0;0;0;0",
