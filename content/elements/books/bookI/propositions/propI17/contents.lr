        slides: [
            { text: "Let {ABC} be a triangle.",
              visible: ["ABC"] },
            { text: "I say that the sum of any two angles of the triangle {ABC} is less than two right angles.",
              visible: ["ABC","CBA","ACB","BAC"],
              highlighted: ["CBA","ACB","BAC"],
              transition: {
                  mode: "parallel",
                  animations: [
                      { elem: "CBA", name: geomlib.A.Sector.sweep },
                      { elem: "ACB", name: geomlib.A.Sector.sweep },
                      { elem: "BAC", name: geomlib.A.Sector.sweep }
