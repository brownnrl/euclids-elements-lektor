        "E;point;extend;D,C,D,C",
        "Dcirc;circle;radius;D,E",
        "Ecirc;circle;radius;E,D",
        "GF;line;bichord;Dcirc,Ecirc",
        "G;point;first;GF",
        "F;point;last;GF",
        "DE;line;connect;D,E"
    ],
    deferDraggables: ["D"],
    aliases: {
        "FG": "GF"
    },
    slides: [
        { text: "This and the next proposition both construct a perpendicular to a line through a given point. The difference is that the given point lies on the line in this proposition but doesn't in the next.",
