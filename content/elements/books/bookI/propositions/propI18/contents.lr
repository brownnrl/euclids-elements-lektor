sections:

#### prop_section ####
kind: proposition
----
statement: In any triangle the angle opposite the greater side is greater.
----
proof:

Let {ABC} be a triangle having the side {AC} greater than {AB}.

<figure class="diagram">
<canvas id="canvas_0" width="260" height="200" tabindex="0"></canvas>
<noscript><img alt="I.18 diagram" src="propI18.gif"/></noscript>
<script type="text/javascript">
    geomlib.init({
        canvasid: "canvas_0",
