            "C;point;lineSlider;AC',100,40",
            "ABC;polygon;triangle;A,B,C;0;0;0,0,0;random",
            "AD;line;extend;B,A,B,A",
            "D;point;last;AD",
            "CD;line;connect;C,D"
        ],
