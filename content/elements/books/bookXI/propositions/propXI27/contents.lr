                  { elem: "AH", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "H",  name: geomlib.A.Point.appear },
                  { elem: "AK", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "K",  name: geomlib.A.Point.appear },
                  { elem: "angBAH", name: geomlib.A.Sector.sweep },
                  { elem: "angKAH", name: geomlib.A.Sector.sweep },
                  { elem: "angBAK", name: geomlib.A.Sector.sweep } ] } },
            { text: "at the point {A} on the straight line {AB} equal to the solid angle {C}",
              visible: CON.concat(ANGA, ANGC),
              highlighted: ["A","AB","C"].concat(ANGA, ANGC),
              transition: { mode: "parallel", animations: [
                  { elem: "angECF", name: geomlib.A.Sector.sweep },
                  { elem: "angGCF", name: geomlib.A.Sector.sweep },
                  { elem: "angECG", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "solid angle at A = solid angle at C", ref: "XI.26" }] },
            { text: "so that the angle {BAH|angBAH} equals the angle {ECF|angECF},",
              visible: CON.concat(ANGA, ANGC),
              highlighted: ["angBAH","angECF"] },
            { text: "the angle {BAK|angBAK} equals the angle {ECG|angECG}, and the angle {KAH|angKAH} equals the angle {GCF|angGCF},",
