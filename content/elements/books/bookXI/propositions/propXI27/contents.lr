              visible: GIVEN,
              highlighted: CDF },
            { text: "Construct the solid angle contained by the angles {BAH|angBAH}, {HAK|angKAH}, and {KAB|angBAK}",
              visible: CON.concat(ANGA),
              highlighted: ANGA,
