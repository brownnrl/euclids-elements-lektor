_model: proposition
---
title: Proposition 27
---
order: 27
---
short_label: XI.27
---
statement: To describe a parallelepipedal solid similar and similarly situated to a given parallelepipedal solid on a given straight line.
---
red_highlight: yes
---
proof:

Let *AB* be the given straight line and *CD* the given parallelepipedal solid.

It is required to describe on the given straight line *AB* a parallelepipedal solid similar and similarly situated to the given parallelepipedal solid *CD.*

<figure class="diagram">
<canvas id="canvas_0" width="600" height="220" tabindex="0"></canvas>
<noscript><img alt="XI.27 diagram" src="propXI27.gif"/></noscript>
<script type="text/javascript">
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "XI.27",
        elements: [
            "C0;point;free;-1000,180;0;0",
            "C3;point;free;1000,180;0;0",
            "A;point;lineSlider;C0,C3,390,0",
            "B;point;lineSlider;C0,C3,500,0",
            "C;point;lineSlider;C0,C3,100,0",
            "E;point;lineSlider;C0,C3,240,0",
            "F;point;free;60,100",
            "G;point;free;120,120",
            "N;point;parallelogram;F,C,G;0",
            "O;point;parallelogram;F,C,E;0",
            "P;point;parallelogram;G,C,E;0",
            "D;point;parallelogram;N,G,P",
            "NFCG;polygon;quadrilateral;N,F,C,G;0;0;black;random",
            "NGPD;polygon;quadrilateral;N,G,P,D;0;0;black;random",
            "CEPG;polygon;quadrilateral;C,E,P,G;0;0;black;random",
            "FO;line;connect;F,O",
            "DO;line;connect;D,O",
            "EO;line;connect;E,O",
            "H;point;similar;B,A,E,C,F",
            "K;point;similar;B,A,E,C,G",
            "R;point;parallelogram;B,A,K;0",
            "M;point;parallelogram;B,A,H",
            "Q;point;parallelogram;H,A,K;0",
            "L;point;parallelogram;M,A,K",
            "QHAK;polygon;quadrilateral;Q,H,A,K;0;0;black;random",
            "ABRK;polygon;quadrilateral;A,B,R,K;0;0;black;random",
            "QKRL;polygon;quadrilateral;Q,K,R,L;0;0;black;random",
