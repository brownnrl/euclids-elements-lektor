            "angECF;sector;angleMarker;C,E,F;0;0;3b6ea5;9ec5e8",
            "angBAK;sector;angleMarker;A,B,K;0;0;3f8e4f;a8dbb0",
            "angECG;sector;angleMarker;C,E,G;0;0;3f8e4f;a8dbb0",
            "angKAH;sector;angleMarker;A,K,H;0;0;7a4fa3;cdb8e6",
            "angGCF;sector;angleMarker;C,G,F;0;0;7a4fa3;cdb8e6"
        ],
        initiallyHidden: ["AB","AH","AK"],
        aliases: { "EC": "CE", "GC": "CG", "BA": "AB", "KA": "AK",
                   "HAK": "angKAH", "KAB": "angBAK" },
