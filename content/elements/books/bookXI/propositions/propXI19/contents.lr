            "P2;point;free;270,120;0;0,75,100",
            "P1;point;intersection;P0,X,P2,Z;0;0",
            "P3;point;intersection;P2,X,P0,Z;0;0",
            "P;polygon;quadrilateral;P0,P1,P2,P3;0;0;lightGray;brighter",
            "A;point;lineSlider;P0,P1,60,240",
            "B;point;free;140,70",
            "C;point;lineSlider;P0,P1,190,240",
            "D;point;lineSlider;B,Y,140,180",
            "A1;point;intersection;A,D,P2,P3;0;0",
            "Aback;polygon;parallelogram;B,D,A1;0;0;lightGray;pink",
            "C1;point;intersection;C,D,P2,P3;0;0",
            "Cback;polygon;parallelogram;B,D,C1;0;0;lightGray;yellow",
            "Afront;polygon;parallelogram;B,D,A;0;0;lightGray;pink",
            "Cfront;polygon;parallelogram;B,D,C;0;0;lightGray;yellow",
            "A3;point;vertex;Afront,4;0;0",
            "E;point;lineSlider;B,A3,120,80",
            "DE;line;connect;D,E",
            "C3;point;vertex;Cfront,4;0;0",
            "F;point;lineSlider;B,C3,160,80",
            "DF;line;connect;D,F",
            "DB;line;connect;D,B"
        ],
