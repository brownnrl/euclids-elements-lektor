            "K;point;parallelogram;N,L,B",
            "E;point;parallelogram;N,L,C",
            "ACEG;polygon;quadrilateral;A,C,E,G;0;0;black;0",
            "LBKN;polygon;quadrilateral;L,B,K,N;0;0;black;0",
