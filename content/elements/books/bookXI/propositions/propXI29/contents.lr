            "AFDC;polygon;quadrilateral;A,F,D,C;0;0;black;60,75,100",
            "ALMF;polygon;quadrilateral;A,L,M,F;0;0;black;60,100,100",
            "HB;line;connect;H,B",
            "N;point;lineSlider;F,M,280,210,10",
