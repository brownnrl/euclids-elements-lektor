            "D;point;lineSlider;F,1Y,60,60,100",
            "A;point;lineSlider;F,1Z,210,210,180",
            "ceiling;plane;3points;F,M,D;0;0;black;60,50,100",
            "L;point;parallelogram;A,F,M",
            "C;point;parallelogram;A,F,D",
            "B;point;parallelogram;L,A,C",
            "H;point;parallelogram;M,F,D",
