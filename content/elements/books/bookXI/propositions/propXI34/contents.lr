              highlighted: ["sAB","sCD"] },
            { text: "that is the base {EH|pEH} is to the base {NQ|pNQ},",
              visible: GIVEN,
              highlighted: ["pEH","pNQ"] },
            { text: "so let the height of the solid {CD|sCD} be to the height of the solid {AB|sAB}.",
              visible: GIVEN,
              highlighted: ["CM","AG"] },
            { text: "I say that the solid {AB|sAB} equals the solid {CD|sCD}.",
              visible: GIVEN,
              highlighted: ["sAB","sCD"] },
            { text: "Let the sides which stand up be at right angles to the bases.",
              visible: HYP,
              highlighted: ["AG","EF","LB","HK","CM","NO","PD","QR"],
              transition: { mode: "parallel", animations: [
                  { elem: "rtA", name: geomlib.A.Sector.sweep },
                  { elem: "rtC", name: geomlib.A.Sector.sweep } ] } },
            { text: "Now, if the base {EH|pEH} equals the base {NQ|pNQ},",
              visible: HYP,
              highlighted: ["pEH","pNQ"] },
            { text: "and the base {EH|pEH} is to the base {NQ|pNQ} as the height of the solid {CD|sCD} is to the height of the solid {AB|sAB},",
              visible: HYP,
              highlighted: ["pEH","pNQ","CM","AG"] },
            { text: "therefore the height of the solid {CD|sCD} also equals the height of the solid {AB|sAB}.",
              visible: HYP,
              highlighted: ["CM","AG"] },
            { text: "But parallelepipedal solids on equal bases and of the same height equal one another,",
              visible: HYP,
              highlighted: ["pEH","pNQ","CM","AG"],
              justifications: [{ claim: "equal bases, same height", ref: "XI.31" }] },
            { text: "therefore the solid {AB|sAB} equals the solid {CD|sCD}.",
              visible: HYP,
              highlighted: ["sAB","sCD"] },
            { text: "Next, let the base {EH|pEH} not be equal to the base {NQ|pNQ}, but let {EH|pEH} be greater.",
              visible: HYP,
              highlighted: ["pEH","pNQ"] },
            { text: "Therefore the height of the solid {CD|sCD} is also greater than the height of the solid {AB|sAB},",
              visible: HYP,
              highlighted: ["CM","AG"] },
            { text: "that is, {CM} is greater than {AG}.",
              visible: HYP,
              highlighted: ["CM","AG"] },
            { text: "Make {CT} equal to {AG} again,",
              visible: CTd,
              highlighted: ["CT","AG"],
              transition: { animations: [
                  { elem: "T", name: geomlib.A.Point.appear } ] },
              justifications: [{ claim: "CT = AG", ref: "I.3" }] },
            { text: "and complete the solid {CV|sCV}.",
              visible: CVd,
              highlighted: ["sCV"],
              transition: { animations: [
                  { elem: "aTbV", name: geomlib.A.Polygon.outline } ] },
              justifications: [{ claim: "parallels completing CV", ref: "I.31" }] },
            { text: "Since the base {EH|pEH} is to the base {NQ|pNQ} as {MC|CM} is to {AG}, and {AG} equals {CT},",
              visible: CVd,
              highlighted: ["pEH","pNQ","CM","AG","CT"] },
            { text: "therefore the base {EH|pEH} is to the base {NQ|pNQ} as {CM} is to {CT}.",
              visible: CVd,
              highlighted: ["pEH","pNQ","CM","CT"] },
            { text: "But the base {EH|pEH} is to the base {NQ|pNQ} as the solid {AB|sAB} is to the solid {CV|sCV},",
              visible: CVd,
              highlighted: ["pEH","pNQ","sAB","sCV"] },
            { text: "for the solids {AB|sAB} and {CV|sCV} are of equal height,",
              visible: CVd,
              highlighted: ["AG","CT"],
              justifications: [{ claim: "EH : NQ = AB : CV", ref: "XI.32" }] },
            { text: "and {CM} is to {CT} as the base {MQ|pMQ} is to the base {QT|pTQ}",
              visible: CVd,
              highlighted: ["CM","CT","pMQ","pTQ"],
              justifications: [{ claim: "CM : CT = MQ : QT", ref: "VI.1" }] },
            { text: "and as the solid {CD|sCD} is to the solid {CV|sCV}.",
              visible: CVd,
              highlighted: ["sCD","sCV"],
              justifications: [{ claim: "MQ : QT = CD : CV", ref: "XI.25" }] },
            { text: "Therefore the solid {AB|sAB} is to the solid {CV|sCV} as the solid {CD|sCD} to the solid {CV|sCV}.",
              visible: CVd,
              highlighted: ["sAB","sCV","sCD"] },
            { text: "Therefore each of the solids {AB|sAB} and {CD|sCD} has to {CV|sCV} the same ratio.",
              visible: CVd,
              highlighted: ["sAB","sCD","sCV"] },
            { text: "Therefore the solid {AB|sAB} equals the solid {CD|sCD}.",
              visible: CVd,
              highlighted: ["sAB","sCD"],
              justifications: [{ claim: "solid AB = solid CD", ref: "V.9" }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "XI.34") return "#prop";
