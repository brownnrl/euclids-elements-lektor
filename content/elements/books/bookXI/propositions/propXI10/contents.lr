    // or plane frame, so none is deferred. D, F, P2, Q1-Q3 are derived and
    // listed per slide.
    var PLANES = ["P","P2","Q","Q1","Q2","Q3"];
    var GIVEN  = PLANES.concat(["A","B","C","D","E","F","AB","BC","DE","EF"]);
    var ANG    = GIVEN.concat(["angB","angE"]);
    var JOIN   = GIVEN.concat(["AD","CF","BE","AC","DF"]);
    var TRI    = JOIN.concat(["ABC","DEF"]);
