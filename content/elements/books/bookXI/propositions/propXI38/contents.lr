            { text: "Therefore the angle {EDT|angEDT} equals the angle {BGT|angBGT}, for they are alternate,",
              visible: W4.concat(["angEDT","angBGT"]),
              highlighted: ["angEDT","angBGT"],
              transition: { mode: "parallel", animations: [
                  { elem: "angEDT", name: geomlib.A.Sector.sweep },
                  { elem: "angBGT", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "angle EDT = angle BGT", ref: "I.29" }] },
            { text: "and the angle {DTU|angDTU} equals the angle {GTS|angGTS}.",
              visible: W4.concat(["angEDT","angBGT","angDTU","angGTS"]),
              highlighted: ["angDTU","angGTS"],
              transition: { mode: "parallel", animations: [
                  { elem: "angDTU", name: geomlib.A.Sector.sweep },
                  { elem: "angGTS", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "angle DTU = angle GTS", ref: "I.15" }] },
            { text: "Therefore {DTU} and {GTS} are two triangles which have two angles equal to two angles",
              visible: W5,
              highlighted: ["DTU","GTS","angEDT","angBGT","angDTU","angGTS"] },
            { text: "and one side equal to one side, namely that opposite one of the equal angles,",
              visible: W5,
              highlighted: ["DU","SG"] },
            { text: "that is, {DU} equals {GS|SG}, for they are the halves of {DE} and {BG},",
              visible: W5,
              highlighted: ["DU","SG","DE","BG"] },
            { text: "therefore the remaining sides equal the remaining sides.",
              visible: W5,
              highlighted: ["DTU","GTS"],
              justifications: [{ claim: "triangle DTU = triangle GTS", ref: "I.26" }] },
            { text: "Therefore {DT} equals {TG}, and {UT} equals {TS}.",
              visible: W5,
              highlighted: ["DT","TG","UT","TS"] },
            { text: "Therefore, if the sides of the opposite planes of a cube are bisected,",
              visible: W5,
              highlighted: ["pCF","pAH"] },
            { text: "and the planes are carried through the points of section,",
              visible: W5,
              highlighted: ["KLNM","OPRQ"] },
            { text: "then the intersection of the planes and the diameter of the cube bisect one another.",
              visible: W5,
              highlighted: ["SU","DG","T"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "XI.38") return "#prop";
