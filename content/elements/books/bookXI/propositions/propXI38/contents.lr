              visible: JN,
              highlighted: ["DU","UE","BS","SG"],
              transition: { animations: [
                  { elem: "DU", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "UE", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "BS", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "SG", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ ref: "I.Post.1" }] },
            { text: "Then, since {DO} is parallel to {PE},",
