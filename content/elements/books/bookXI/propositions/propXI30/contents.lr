_model: proposition
---
title: Proposition 30
---
order: 30
---
short_label: XI.30
---
statement: Parallelepipedal solids which are on the same base and of the same height, and in which the ends of their edges which stand up are not on the same straight lines, equal one another.
---
proof:

Let *CM* and *CN* be parallelepipedal solids on the same base *AB* and of the same height, and let the ends of their edges which stand up, namely *AF, AG, LM, LN, CD, CE, BH,* and *BK,* not be on the same straight lines.

<figure class="diagram">
<canvas id="canvas_0" width="320" height="310" tabindex="0"></canvas>
<noscript><img alt="XI.30 diagram" src="propXI30.gif"/></noscript>
<script type="text/javascript">
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "XI.30",
        elements: [
            "G;point;fixed;60,120,0;black;green",
            "1X;point;fixed;260,93,36;0;0",
            "1Y;point;fixed;15,0,160;0;0",
            "1Z;point;fixed;60,264,123;0;0",
            "E;point;lineSlider;G,1X,200,50,0",
            "N;point;lineSlider;G,1Y,50,50,100",
            "A;point;lineSlider;G,1Z,200,220,200",
            "ceiling;plane;3points;G,E,N;0;0;black;150,50,100",
            "C;point;parallelogram;A,G,E",
            "L;point;parallelogram;A,G,N",
            "B;point;parallelogram;C,A,L",
            "K;point;parallelogram;E,G,N",
            "floor;plane;3points;A,C,L;0;0;black;0",
            "AGNL;polygon;quadrilateral;A,G,N,L;0;0;black;150,75,100",
            "ACEG;polygon;quadrilateral;A,C,E,G;0;0;black;150,100,100",
            "KB;line;connect;K,B",
            "D;point;planeSlider;ceiling,280,190,10",
            "F;point;parallelogram;D,C,A",
            "H;point;parallelogram;D,C,B",
            "M;point;parallelogram;D,C,L",
            "ACDF;polygon;quadrilateral;A,C,D,F;0;0;black;0",
            "LBHM;polygon;quadrilateral;L,B,H,M;0;0;black;0",
            "O;point;intersection;G,E,F,M,ceiling",
            "P;point;intersection;N,K,F,M,ceiling",
            "Q;point;intersection;D,H,G,E,ceiling",
            "R;point;intersection;N,K,D,H,ceiling",
            "FP;line;connect;F,P",
            "DR;line;connect;D,R",
            "BRPL;polygon;quadrilateral;B,R,P,L;0;0;black;0",
            "CQOA;polygon;quadrilateral;C,Q,O,A;0;0;black;0"
        ],
