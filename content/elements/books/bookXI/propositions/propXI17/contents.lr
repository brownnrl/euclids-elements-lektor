                  { elem: "BD", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "AD", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Let {AD} meet the plane {KL|KLT} at the point {O}.",
              visible: JOIN.concat(["O"]),
              highlighted: ["AD","KLT","O"],
              transition: { animations: [
                  { elem: "O", name: geomlib.A.Point.appear } ] } },
            { text: "Join {EO} and {FO}.",
              visible: ALL,
              highlighted: ["EO","FO"],
              transition: { mode: "cascade", animations: [
                  { elem: "EO", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "FO", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Now, since the two parallel planes {KL|KLT} and {MN|MNT} are cut by the plane {EBDO|planeEBDO},",
              visible: ALL,
              highlighted: ["KLT","MNT","planeEBDO"],
              transition: { animations: [
                  { elem: "planeEBDO", name: geomlib.A.Polygon.outline } ] } },
            { text: "therefore their intersections {EO} and {BD} are parallel.",
              visible: ALL,
              highlighted: ["EO","BD"],
              justifications: [{ claim: "EO parallel to BD", ref: "XI.16" }] },
            { text: "For the same reason, since the two parallel planes {GH|GHT} and {KL|KLT} are cut by the plane {AOFC|planeAOFC},",
              visible: ALL,
              highlighted: ["GHT","KLT","planeAOFC"],
              transition: { animations: [
                  { elem: "planeAOFC", name: geomlib.A.Polygon.outline } ] } },
            { text: "their intersections {AC} and {OF|FO} are parallel.",
              visible: ALL,
              highlighted: ["AC","FO"],
              justifications: [{ claim: "AC parallel to OF", ref: "XI.16" }] },
            { text: "And, since the straight line {EO} is parallel to BC, one of the sides of the triangle {ABD},",
              visible: ALL,
              highlighted: ["EO","ABD"] },
            { text: "therefore proportionally {AE} is to {EB} as {AO} is to {OD}.",
              visible: ALL,
              highlighted: ["AE","EB","AO","OD"],
              justifications: [{ claim: "AE : EB = AO : OD", ref: "VI.2" }] },
            { text: "Again, since the straight line {FO} is parallel to {CA|AC}, one of the sides of the triangle {ADC},",
              visible: ALL,
              highlighted: ["FO","ADC"] },
            { text: "therefore proportionally {AO} is to {OD} as {CF} is to {FD}.",
              visible: ALL,
              highlighted: ["AO","OD","CF","FD"],
              justifications: [{ claim: "AO : OD = CF : FD", ref: "VI.2" }] },
            { text: "But it was prove that {AO} is to {OD} as {AE} is to {EB},",
              visible: ALL,
              highlighted: ["AO","OD","AE","EB"] },
            { text: "therefore {AE} is to {EB} as {CF} is to {FD}.",
              visible: ALL,
              highlighted: ["AE","EB","CF","FD"],
              justifications: [{ claim: "ratios the same as the same ratio", ref: "V.11" }] },
            { text: "Therefore, if two straight lines are cut by parallel planes, then they are cut in the same ratios.",
              visible: ALL,
              highlighted: ["AB","CD","GHT","KLT","MNT"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "XI.17") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
