            "MN;polygon;quadrilateral;M,M',N,N';0;0;lightGray;brighter",
            "A;point;free;130,40",
            "B;point;free;240,260",
            "C;point;free;60,70",
            "D;point;free;160,245",
            "AB;line;connect;A,B",
            "CD;line;connect;C,D",
            "E;point;lineSlider;AB,190,150",
            "O';point;parallelogram;D,B,E;0;0",
            "O;point;intersection;E,O',A,D",
            "F';point;parallelogram;C,A,O;0;0",
            "F;point;intersection;O,F',C,D",
            "AC;line;connect;A,C",
            "BD;line;connect;B,D",
            "AD;line;connect;A,D",
            "EO;line;connect;E,O",
            "FO;line;connect;F,O",
            // Transparent highlight targets.
            "GHT;polygon;quadrilateral;G,G',H,H';0;0;0;0",
            "KLT;polygon;quadrilateral;K,K',L,L';0;0;0;0",
            "MNT;polygon;quadrilateral;M,M',N,N';0;0;0;0",
            "planeEBDO;polygon;quadrilateral;E,B,D,O;0;0;0;0",
            "planeAOFC;polygon;quadrilateral;A,O,F,C;0;0;0;0",
            "ABD;polygon;triangle;A,B,D;0;0;0;0",
            "ADC;polygon;triangle;A,D,C;0;0;0;0",
            "AE;line;connect;A,E;0;0;0",
            "EB;line;connect;E,B;0;0;0",
            "CF;line;connect;C,F;0;0;0",
            "FD;line;connect;F,D;0;0;0",
            "AO;line;connect;A,O;0;0;0",
