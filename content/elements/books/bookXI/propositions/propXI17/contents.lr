            { text: "Let the two straight lines {AB} and {CD} be cut by the parallel planes {GH|GHT}, {KL|KLT}, and {MN|MNT}",
              visible: GIVEN,
              highlighted: ["AB","CD","GHT","KLT","MNT"] },
            { text: "at the points {A}, {E}, and {B}, and at the points {C}, {F}, and {D}, respectively.",
              visible: GIVEN,
              highlighted: ["A","E","B","C","F","D"] },
            { text: "I say that the straight line {AE} is to {EB} as {CF} is to {FD}.",
              visible: GIVEN,
              highlighted: ["AE","EB","CF","FD"] },
            { text: "Join {AC}, {BD}, and {AD}.",
              visible: JOIN,
              highlighted: ["AC","BD","AD"],
              transition: { mode: "cascade", animations: [
