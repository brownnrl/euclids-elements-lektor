            "E;point;planeSlider;baseplane,160,150,0",
            "B;point;extend;A,E,A,E",
            "C;point;planeSlider;baseplane,250,30,90",
            "D;point;extend;C,E,C,E",
            "Z;point;fixed;100,100000,0",
            "F;point;lineSlider;E,Z,160,40,0",
            "EF;line;connect;E,F",
            "ABCD;polygon;quadrilateral;A,B,C,D;0;0;black;random",
            "AF;line;connect;A,F",
            "BF;line;connect;B,F",
            "CF;line;connect;C,F",
            "DF;line;connect;D,F",
            "G;point;lineSlider;A,D,80,140,40",
