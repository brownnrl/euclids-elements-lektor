            "AB;line;connect;A,B",
            "CD;line;connect;C,D",
            "AD;line;connect;A,D",
            "CB;line;connect;C,B",
            "FA;line;connect;F,A",
            "FG;line;connect;F,G",
            "FD;line;connect;F,D",
            "FC;line;connect;F,C",
            "FH;line;connect;F,H",
            "FB;line;connect;F,B",
            // Transparent highlight targets.
            "AE;line;connect;A,E;0;0;0",
            "EB;line;connect;E,B;0;0;0",
            "CE;line;connect;C,E;0;0;0",
            "ED;line;connect;E,D;0;0;0",
            "GE;line;connect;G,E;0;0;0",
            "EH;line;connect;E,H;0;0;0",
            "AG;line;connect;A,G;0;0;0",
            "BH;line;connect;B,H;0;0;0",
            "AED;polygon;triangle;A,E,D;0;0;0;0",
            "CEB;polygon;triangle;C,E,B;0;0;0;0",
            "AGE;polygon;triangle;A,G,E;0;0;0;0",
            "BEH;polygon;triangle;B,E,H;0;0;0;0",
            // The plane of reference: baseplane's parallelogram as a faceless
            // polygon (a plane element draws no highlight stroke). P4 is its
            // fourth corner, P2 + P3 - P1.
            "P4;point;parallelogram;P2,P1,P3;0;0",
            "refplane;polygon;quadrilateral;P1,P2,P4,P3;0;0;0;0",
            "rtAEF;sector;angleMarkerRight;E,A,F,16;0;0;red;red",
            "rtBEF;sector;angleMarkerRight;E,B,F,16;0;0;red;red",
            "rtCEF;sector;angleMarkerRight;E,C,F,16;0;0;red;red",
            "rtDEF;sector;angleMarkerRight;E,D,F,16;0;0;red;red",
            "rtGEF;sector;angleMarkerRight;E,G,F,16;0;0;red;red",
            "rtHEF;sector;angleMarkerRight;E,H,F,16;0;0;red;red",
            "angAED;sector;angleMarker;E,A,D,20",
            "angCEB;sector;angleMarker;E,C,B,20",
            "angAEG;sector;angleMarker;E,A,G,20",
            "angBEH;sector;angleMarker;E,B,H,20",
            "angGEF;sector;angleMarker;E,G,F,20",
            "angHEF;sector;angleMarker;E,H,F,20",
            "angDAE;sector;angleMarker;A,D,E",
            "angEBC;sector;angleMarker;B,E,C",
            "angFAD;sector;angleMarker;A,F,D",
            "angFBC;sector;angleMarker;B,F,C"
        ],
