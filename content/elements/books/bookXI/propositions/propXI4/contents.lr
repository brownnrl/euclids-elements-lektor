              justifications: [{ ref: "I.Post.1" }] },
            { text: "and join {FA}, {FG}, {FD}, {FC}, {FH}, and {FB} from a point {F} taken at random on {EF}.",
              visible: FIG,
              highlighted: ["F"],
              transition: { mode: "cascade", animations: [
                  { elem: "FA", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "FG", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "FD", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "FC", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "FH", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "FB", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ ref: "I.Post.1" }] },
            { text: "Now, since the two straight lines {AE} and {ED} equal the two straight lines {CE} and {EB} and contain equal angles,",
              visible: VERT,
              highlighted: ["AE","ED","CE","EB"],
              transition: { mode: "parallel", animations: [
                  { elem: "angAED", name: geomlib.A.Sector.sweep },
                  { elem: "angCEB", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "vertical angles AED and CEB", ref: "I.15" }] },
            { text: "therefore the base {AD} equals the base {CB}, and the triangle {AED} equals the triangle {CEB},",
