            { text: "so that the angle {DAE|angDAE} equals the angle {EBC|angEBC}.",
              visible: BASEA,
              highlighted: ["angDAE","angEBC"],
              transition: { mode: "parallel", animations: [
                  { elem: "angDAE", name: geomlib.A.Sector.sweep },
                  { elem: "angEBC", name: geomlib.A.Sector.sweep } ] } },
            { text: "But the angle {AEG|angAEG} also equals the angle {BEH|angBEH},",
              visible: SMALL,
              highlighted: ["angAEG","angBEH"],
              transition: { mode: "parallel", animations: [
                  { elem: "angAEG", name: geomlib.A.Sector.sweep },
                  { elem: "angBEH", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "vertical angles AEG and BEH", ref: "I.15" }] },
            { text: "therefore {AGE} and {BEH} are two triangles which have two angles equal to two angles respectively,",
              visible: SMALL,
              highlighted: ["AGE","BEH","angDAE","angEBC","angAEG","angBEH"] },
            { text: "and one side equal to one side, namely that adjacent to the equal angles, that is to say, {AE} equals {EB}.",
              visible: SMALL,
              highlighted: ["AE","EB"] },
            { text: "Therefore they also have the remaining sides equals to the remaining sides,",
              visible: SMALL,
              highlighted: ["AGE","BEH"],
              justifications: [{ claim: "two angles and the side between them", ref: "I.26" }] },
            { text: "that is, {GE} equals {EH}, and {AG} equals {BH}.",
              visible: SMALL,
              highlighted: ["GE","EH","AG","BH"] },
            { text: "And, since {AE} equals {EB}, while {FE|EF} is common and at right angles,",
              visible: RT2,
              highlighted: ["AE","EB","EF","rtAEF","rtBEF"] },
            { text: "therefore the base {FA} equals the base {FB}.",
              visible: RT2,
              highlighted: ["FA","FB"],
              justifications: [{ claim: "two sides and the included right angle", ref: "I.4" }] },
            { text: "For the same reason, {FC} equals {FD}.",
              visible: RT4,
              highlighted: ["FC","FD","CE","ED","rtCEF","rtDEF"] },
            { text: "And, since {AD} equals {CB}, and {FA} also equals {FB},",
              visible: I8A,
              highlighted: ["AD","CB","FA","FB"] },
            { text: "the two sides {FA} and {AD} equal the two sides {FB} and {BC|CB} respectively,",
              visible: I8A,
              highlighted: ["FA","AD","FB","CB"] },
            { text: "and the base {FD} was proved equal to the base {FC},",
              visible: I8A,
              highlighted: ["FD","FC"] },
            { text: "therefore the angle {FAD|angFAD} also equals the angle {FBC|angFBC}.",
              visible: I8A,
              highlighted: ["angFAD","angFBC"],
              transition: { mode: "parallel", animations: [
                  { elem: "angFAD", name: geomlib.A.Sector.sweep },
                  { elem: "angFBC", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "three sides", ref: "I.8" }] },
            { text: "And since, again, {AG} was proved equal to {BH}, and further, {FA} also equal to {FB},",
              visible: I4B,
              highlighted: ["AG","BH","FA","FB"] },
            { text: "the two sides {FA} and {AG} equal the two sides {FB} and {BH},",
              visible: I4B,
              highlighted: ["FA","AG","FB","BH"] },
            // G lies on AD and H on CB, so FAG and FBH are the angles FAD, FBC.
            { text: "and the angle {FAG|angFAD} was proved equal to the angle {FBH|angFBC},",
              visible: I4B,
              highlighted: ["angFAD","angFBC"] },
            { text: "therefore the base {FG} equals the base {FH}.",
              visible: I4B,
              highlighted: ["FG","FH"],
              justifications: [{ claim: "two sides and the included angle", ref: "I.4" }] },
            { text: "Again, since {GE} was proved equal to {EH}, and {EF} is common,",
              visible: FILL,
              highlighted: ["GE","EH","EF"] },
            { text: "the two sides {GE} and {EF} equal the two sides {HE|EH} and {EF}, and the base {FG} equals the base {FH},",
              visible: FILL,
              highlighted: ["GE","EH","EF","FG","FH"] },
            { text: "therefore the angle {GEF|angGEF} equals the angle {HEF|angHEF}.",
              visible: I8B,
              highlighted: ["angGEF","angHEF"],
              transition: { mode: "parallel", animations: [
                  { elem: "angGEF", name: geomlib.A.Sector.sweep },
                  { elem: "angHEF", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "three sides", ref: "I.8" }] },
            { text: "Therefore each of the angles {GEF|rtGEF} and {HEF|rtHEF} is right.",
              visible: RIGHT,
              highlighted: ["rtGEF","rtHEF"],
              transition: { mode: "parallel", animations: [
                  { elem: "rtGEF", name: geomlib.A.Sector.sweep },
                  { elem: "rtHEF", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "equal adjacent angles are right", ref: "I.Def.10" }] },
            { text: "Therefore {FE|EF} is at right angles to {GH} drawn at random through {E}.",
              visible: RIGHT,
              highlighted: ["EF","GH","rtGEF","rtHEF"] },
            { text: "Similarly we can prove that {FE|EF} also makes right angles with all the straight lines",
              visible: RIGHT,
              highlighted: ["EF"] },
            { text: "which meet it and are in the {plane of reference|refplane}.",
              visible: PLANE,
              highlighted: ["refplane"] },
            { text: "But a straight line is at right angles to a plane when it makes right angles with all the straight lines",
              visible: PLANE,
              highlighted: [] },
            { text: "which meet it and are in that same plane,",
              visible: PLANE,
              highlighted: [] },
            { text: "therefore {FE|EF} is at right angles to the {plane of reference|refplane}.",
              visible: PLANE,
              highlighted: ["EF","refplane"],
              justifications: [{ claim: "at right angles to every line in the plane through E", ref: "XI.Def.3" }] },
            { text: "But the {plane of reference|refplane} is the plane through the straight lines {AB} and {CD}.",
              visible: PLANE,
              highlighted: ["refplane","AB","CD"] },
            { text: "Therefore {FE|EF} is at right angles to the plane through {AB} and {CD}.",
              visible: DONE,
              highlighted: ["EF","AB","CD"] },
            { text: "Therefore if a straight line is set up at right angles to two straight lines",
              visible: DONE,
              highlighted: ["EF","AB","CD","rtAEF","rtCEF"] },
            { text: "which cut one another at their common point of section,",
              visible: DONE,
              highlighted: ["AB","CD","E"] },
            { text: "then it is also at right angles to the plane passing through them.",
              visible: DONE,
              highlighted: ["EF","refplane"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "XI.4") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "I.Post.1":  "/elements/books/bookI/postulates/post1/",
        "I.Def.10":  "/elements/books/bookI/definitions/defI10/",
        "I.3":       "/elements/books/bookI/propositions/propI3/",
        "I.4":       "/elements/books/bookI/propositions/propI4/",
        "I.8":       "/elements/books/bookI/propositions/propI8/",
        "I.15":      "/elements/books/bookI/propositions/propI15/",
        "I.26":      "/elements/books/bookI/propositions/propI26/",
        "XI.2":      "/elements/books/bookXI/propositions/propXI2/",
        "XI.Def.3":  "/elements/books/bookXI/definitions/defXI3/"
