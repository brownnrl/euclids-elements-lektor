            "sXY;polygon;hexagon;R,Y,b,c,X,S;0;0;0;0",
            "sRI;polygon;hexagon;D,R,T,X,I,F;0;0;0;0",
            "sCI;polygon;hexagon;C,T,X,I,Q,P;0;0;0;0",
            "sYI;polygon;hexagon;Y,b,c,I,F,D;0;0;0;0",
            // Bases, faces and planes the proof names.
            "baseAB;polygon;quadrilateral;A,L,B,H;0;0;0;0",
            "baseCD;polygon;quadrilateral;C,P,D,R;0;0;0;0",
            "pRW;polygon;quadrilateral;R,T,W,U;0;0;0;0",
