              transition: { animations: [
                  { elem: "angEAC", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "angle DAC > angle EAC", ref: "I.25" }] },
            { text: "But the angle {BAE|angBAE} equals the angle {DAB|angDAB},",
              visible: ALL,
              highlighted: ["angBAE","angDAB"] },
            { text: "therefore the sum of the angles {DAB|angDAB} and {DAC|angCAD} is greater than the angle {BAC|angBAC}.",
              visible: ALL,
              highlighted: ["angDAB","angCAD","angBAC"] },
            { text: "Similarly we can prove that the sum of any two of the remaining angles is greater than the remaining one.",
              visible: ALL,
              highlighted: ["angBAC","angCAD","angDAB"] },
            { text: "Therefore, if a solid angle is contained by three plane angles,",
              visible: JOIN.concat(["angBAC","angCAD","angDAB"]),
              highlighted: ["A","angBAC","angCAD","angDAB"] },
            { text: "then the sum of any two is greater than the remaining one.",
              highlighted: ["angBAC","angCAD","angDAB"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "XI.20") return "#prop";
