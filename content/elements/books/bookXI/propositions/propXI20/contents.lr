                  { elem: "angCAD", name: geomlib.A.Sector.sweep },
                  { elem: "angDAB", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ ref: "XI.20" }] },
            { text: "“then the sum of any two is greater than the remaining one.”",
              visible: ANG,
              highlighted: ["angBAC","angCAD","angDAB"] },
            { text: "Let the solid angle at {A} be contained by the three plane angles {BAC|angBAC}, {CAD|angCAD}, and {DAB|angDAB}.",
