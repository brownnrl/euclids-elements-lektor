                  { elem: "hM", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "PM", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ claim: "parallels completing KP", ref: "I.31" }] },
            { text: "Now, since the two sides {KE|EK} and {EL} equal the two sides {CF} and {FN},",
              visible: KPd,
              highlighted: ["EK","EL","CF","FN"] },
            { text: "while the angle {KEL|angKEL} equals the angle {CFN|angCFN},",
