sections:

#### prop_section ####
kind: proposition
----
statement: To construct a solid angle equal to a given solid angle on a given straight line at a given point on it.
----
proof:

Let {A} be the given point on the given straight line {AB}, and let the angle at {D} be the given solid angle contained by the angles {EDC|angEDC}, {EDF|angEDF}, and {FDC|angFDC}.

It is required to construct at the point {A} on the straight line {AB} a solid angle equal to the solid angle at {D}.

Take a point {F} at random on {DF}, draw {FG} from {F} perpendicular to the plane through {ED} and {DC}, and let it meet the plane at {G}. Join {DG}. [!just XI.11]

<figure class="diagram">
<canvas id="canvas_0" width="360" height="320" tabindex="0"></canvas>
<noscript><img alt="XI.26 diagram" src="propXI26.gif"/></noscript>
<script type="text/javascript">
    // Joyce's figure: a 3-D scene (pivot on the plane of reference,
    // xyplane). At D the solid angle as the filled faces DCF, DEF over the
    // plane triangles DCG, DGE, with F above and G its foot; at A the copy,
    // ABK, AKL in the plane and the faces ALH, ABH, with KH perpendicular.
    //
    // Joyce draws DE, DC, DF, DG, AL, AK, HA and the joins HB, KB, FE, GE
    // only as triangle edges. The walk constructs them in order, so they
    // are solid slide twins, hidden at rest (initiallyHidden), stroked from
    // the end they are drawn from. The triangles trace and fill as the
    // proof reaches them: ABK, DGE at the first I.4, ABH, DEF and ALH, DCF
    // at the I.8 steps, AKL, DCG at the close.
    //
    // Added, all transparent: PT, a faceless quadrilateral over xyplane's
    // corners (a plane element draws no highlight); tEDC and tBAL, faceless
    // triangles for "the plane through ED and DC" / "through BA and AL"
    // (both lie in the plane of reference). Angle markers: the plane
    // angles at D and A, equal pairs sharing a colour (EDC/BAL blue,
    // EDG/BAK green, EDF/BAH purple, FDC/HAL orange); the right angles
    // FGD, FGE, HKA, HKB, which the text proves right, are angleMarkerRight.
    // Joyce's letter permutations are aliases.
    //
    // Draggables (checked against the bundle): origin, y, z (the scene's
    // frame), A, B, C, D, E, F, all named by the setting-out, so none is
    // deferred. G, K, L, H are derived and listed per slide.
    var GIVEN = ["xyplane","PT","Oz","tEDC","tBAL","A","B","AB",
                 "C","D","E","F","DE","DC","DF"];
    var DANG  = ["angEDC","angEDF","angFDC"];
    var FGv   = GIVEN.concat(["G","FG"]);
    var DGv   = FGv.concat(["DG"]);
    var ALv   = DGv.concat(["L","AL"]);
    var AKv   = ALv.concat(["K","AK"]);
    var KHv   = AKv.concat(["H","KH"]);
    var HAv   = KHv.concat(["HA"]);
    var JOIN  = HAv.concat(["HB","KB","FE","GE"]);
    var RT    = ["angFGD","angFGE","angHKA","angHKB"];
    var T1    = JOIN.concat(["ABK","DGE"]);
    var T2    = T1.concat(["ABH","DEF"]);
    var T3    = T2.concat(["ALH","DCF"]);
    var ALL   = T3.concat(["AKL","DCG"]);
    var AANG  = ["angBAL","angBAH","angHAL"];
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "XI.26",
        pivot: "A,xyplane",
        elements: [
            "origin;point;free;110,140;0;0,50,100",
            "x;point;fixed;330,210,100;0;120,50,100",
            "yzplane;plane;perpendicular;origin,x;0;0;0;0",
            "y;point;planeSlider;yzplane,-90,202,90;0;0,50,100",
            "xyplane;plane;3points;origin,x,y;0;0;lightGray",
            "z1;point;perpendicular;origin,y,yzplane;0;0",
            "z;point;lineSlider;origin,z1,40,40,100;0",
            "Oz;line;connect;origin,z;0;0;lightGray",
            "ceiling;plane;parallel;xyplane,z;0;0;0;0",
            "A;point;planeSlider;xyplane,180,240,150",
            "B;point;planeSlider;xyplane,220,220,210",
            "AB;line;connect;A,B",
            "C;point;planeSlider;xyplane,150,200,20",
            "D;point;planeSlider;xyplane,50,210,100",
            "E;point;planeSlider;xyplane,110,190,160",
            "F;point;planeSlider;ceiling,160,140,110",
            "G;point;foot;F,xyplane",
            "FG;line;connect;F,G",
            "DCG;polygon;triangle;D,C,G;0;0;black;270,70,100",
            "DGE;polygon;triangle;D,G,E;0;0;black;270,70,100",
            "DCF;polygon;triangle;D,C,F;0;0;black;random",
            "DEF;polygon;triangle;D,E,F;0;0;black;random",
            "L;point;similar;B,A,xyplane,E,D,C,xyplane",
            "K';point;similar;B,A,xyplane,E,D,G,xyplane;0;0",
            "K;point;cutoff;A,K',D,G",
            "ABK;polygon;triangle;A,B,K;0;0;black;270,70,100",
            "AKL;polygon;triangle;A,K,L;0;0;black;270,70,100",
            "KH;line;perpendicular;K,xyplane,F,G",
            "H;point;last;KH",
            "ALH;polygon;triangle;A,L,H;0;0;black;random",
            "ABH;polygon;triangle;A,B,H;0;0;black;random",
            // Slide twins, hidden at rest (see above).
            "DE;line;connect;D,E",
            "DC;line;connect;D,C",
            "DF;line;connect;D,F",
            "DG;line;connect;D,G",
            "AL;line;connect;A,L",
            "AK;line;connect;A,K",
            "HA;line;connect;H,A",
            "HB;line;connect;H,B",
            "KB;line;connect;K,B",
            "FE;line;connect;F,E",
            "GE;line;connect;G,E",
            // Transparent highlight targets. Explicit ;0 faces.
            "xyD;point;parallelogram;x,origin,y;0;0",
            "PT;polygon;quadrilateral;origin,x,xyD,y;0;0;0;0",
            "tEDC;polygon;triangle;D,E,C;0;0;0;0",
            "tBAL;polygon;triangle;A,B,L;0;0;0;0",
            "angEDC;sector;angleMarker;D,E,C;0;0;3b6ea5;9ec5e8",
            "angBAL;sector;angleMarker;A,B,L;0;0;3b6ea5;9ec5e8",
            "angEDG;sector;angleMarker;D,E,G;0;0;3f8e4f;a8dbb0",
            "angBAK;sector;angleMarker;A,B,K;0;0;3f8e4f;a8dbb0",
            "angEDF;sector;angleMarker;D,E,F;0;0;7a4fa3;cdb8e6",
            "angBAH;sector;angleMarker;A,B,H;0;0;7a4fa3;cdb8e6",
            "angFDC;sector;angleMarker;D,F,C;0;0;c06a1b;f3c590",
            "angHAL;sector;angleMarker;A,H,L;0;0;c06a1b;f3c590",
            "angFGD;sector;angleMarkerRight;G,F,D",
            "angFGE;sector;angleMarkerRight;G,F,E",
            "angHKA;sector;angleMarkerRight;K,H,A",
            "angHKB;sector;angleMarkerRight;K,H,B"
        ],
        initiallyHidden: ["DE","DC","DF","DG","AL","AK","HA","HB","KB","FE","GE"],
        aliases: { "ED": "DE", "GD": "DG", "FD": "DF", "KA": "AK", "BA": "AB",
                   "GF": "FG", "AH": "HA" },
        slides: [
            { text: "“To construct a solid angle equal to a given solid angle on a given straight line at a given point on it.”",
              visible: GIVEN.concat(DANG),
              highlighted: DANG.concat(["AB","A"]),
              justifications: [{ ref: "XI.26" }] },
            { text: "Let {A} be the given point on the given straight line {AB},",
