            "B;point;planeSlider;xyplane,220,220,210",
            "AB;line;connect;A,B",
            "C;point;planeSlider;xyplane,150,200,20",
            "D;point;planeSlider;xyplane,50,210,100",
            "E;point;planeSlider;xyplane,110,190,160",
