              highlighted: ["A","AB"] },
            { text: "and let the angle at {D} be the given solid angle contained by the angles {EDC|angEDC}, {EDF|angEDF}, and {FDC|angFDC}.",
              visible: GIVEN.concat(DANG),
              highlighted: DANG,
              transition: { mode: "parallel", animations: [
                  { elem: "angEDC", name: geomlib.A.Sector.sweep },
                  { elem: "angEDF", name: geomlib.A.Sector.sweep },
                  { elem: "angFDC", name: geomlib.A.Sector.sweep } ] } },
            { text: "It is required to construct at the point {A} on the straight line {AB}",
              visible: GIVEN.concat(DANG),
              highlighted: ["A","AB"] },
            { text: "a solid angle equal to the solid angle at {D}.",
              visible: GIVEN.concat(DANG),
              highlighted: DANG },
            { text: "Take a point {F} at random on {DF},",
              visible: GIVEN,
              highlighted: ["F","DF"] },
            { text: "draw {FG} from {F} perpendicular to the plane through {ED} and {DC}, and let it meet the plane at {G}.",
              visible: FGv,
              highlighted: ["FG","tEDC"],
