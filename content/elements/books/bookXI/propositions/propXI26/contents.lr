              highlighted: ["DG"],
              transition: { animations: [
                  { elem: "DG", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ ref: "I.Post.1" }] },
            { text: "At the point {A} on the straight line {AB} construct the angle {BAL|angBAL} equal to the angle {EDC|angEDC},",
              visible: ALv.concat(["angEDC","angBAL"]),
              highlighted: ["angBAL","angEDC"],
              transition: { mode: "cascade", animations: [
                  { elem: "AL",     name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "L",      name: geomlib.A.Point.appear },
                  { elem: "angBAL", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "angle BAL = angle EDC", ref: "I.23" }] },
            { text: "and construct the angle {BAK|angBAK} equal to the angle {EDG|angEDG}.",
              visible: AKv.concat(["angEDG","angBAK"]),
              highlighted: ["angBAK","angEDG"],
              transition: { mode: "cascade", animations: [
                  { elem: "angEDG", name: geomlib.A.Sector.sweep },
                  { elem: "AK",     name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "K",      name: geomlib.A.Point.appear },
                  { elem: "angBAK", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "angle BAK = angle EDG", ref: "I.23" }] },
            { text: "Make {AK} equal to {DG}.",
              visible: AKv,
              highlighted: ["AK","DG"],
              justifications: [{ claim: "AK = DG", ref: "I.3" }] },
            { text: "Set {KH} up from the point {K} at right angles to the plane through {BA} and {AL}.",
              visible: KHv,
              highlighted: ["KH","tBAL"],
              transition: { mode: "cascade", animations: [
                  { elem: "KH", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "H",  name: geomlib.A.Point.appear } ] },
              justifications: [{ claim: "KH at right angles to the plane", ref: "XI.12" }] },
            { text: "Make {KH} equal to {GF}, and join {HA}.",
              visible: HAv,
              highlighted: ["KH","FG","HA"],
              transition: { animations: [
                  { elem: "HA", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ claim: "KH = GF", ref: "I.3" }, { ref: "I.Post.1" }] },
            { text: "I say that the solid angle at {A} contained by the angles {BAL|angBAL}, {BAH|angBAH}, and {HAL|angHAL}",
              visible: HAv.concat(AANG),
              highlighted: AANG,
              transition: { mode: "parallel", animations: [
                  { elem: "angBAH", name: geomlib.A.Sector.sweep },
                  { elem: "angHAL", name: geomlib.A.Sector.sweep } ] } },
            { text: "equals the solid angle at {D} contained by the angles {EDC|angEDC}, {EDF|angEDF}, and {FDC|angFDC}.",
              visible: HAv.concat(AANG, DANG),
              highlighted: DANG },
            { text: "Cut {AB} and {DE} off equal to one another,",
              visible: HAv,
              highlighted: ["AB","DE"],
              justifications: [{ claim: "AB = DE", ref: "I.3" }] },
            { text: "and join {HB}, {KB}, {FE}, and {GE}.",
              visible: JOIN,
              highlighted: ["HB","KB","FE","GE"],
              transition: { mode: "cascade", animations: [
                  { elem: "HB", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "KB", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "FE", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "GE", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ ref: "I.Post.1" }] },
            { text: "Then, since {FG} is at right angles to the {plane of reference|PT},",
              visible: JOIN,
              highlighted: ["FG","PT"] },
            { text: "therefore it is also at right angles with all the straight lines which meet it and are in the {plane of reference|PT}.",
              visible: JOIN,
              highlighted: ["FG","DG","GE","PT"],
              justifications: [{ claim: "a line at right angles to a plane", ref: "XI.Def.3" }] },
            { text: "Therefore each of the angles {FGD|angFGD} and {FGE|angFGE} is right.",
              visible: JOIN.concat(["angFGD","angFGE"]),
              highlighted: ["angFGD","angFGE"],
              transition: { mode: "parallel", animations: [
                  { elem: "angFGD", name: geomlib.A.Sector.sweep },
                  { elem: "angFGE", name: geomlib.A.Sector.sweep } ] } },
            { text: "For the same reason each of the angles {HKA|angHKA} and {HKB|angHKB} is also right.",
              visible: JOIN.concat(RT),
              highlighted: ["angHKA","angHKB"],
              transition: { mode: "parallel", animations: [
                  { elem: "angHKA", name: geomlib.A.Sector.sweep },
                  { elem: "angHKB", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "a line at right angles to a plane", ref: "XI.Def.3" }] },
            { text: "And, since the two sides {KA} and {AB} equal the two sides {GD} and {DE} respectively,",
              visible: T1.concat(RT),
              highlighted: ["AK","AB","DG","DE"],
              transition: { mode: "parallel", animations: [
                  { elem: "ABK", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "DGE", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "and they contain equal angles, therefore the base {KB} equals the base {GE}.",
              visible: T1.concat(RT, ["angBAK","angEDG"]),
              highlighted: ["angBAK","angEDG","KB","GE"],
              justifications: [{ claim: "KB = GE", ref: "I.4" }] },
            { text: "But {KH} also equals {GF}, and they contain right angles, therefore {HB} also equals {FE}.",
              visible: T1.concat(RT),
              highlighted: ["KH","FG","angHKB","angFGE","HB","FE"],
              justifications: [{ claim: "HB = FE", ref: "I.4" }] },
            { text: "Again, since the two sides {AK} and {KH} equal the two sides {DG} and {GF},",
              visible: T1.concat(RT),
              highlighted: ["AK","KH","DG","FG"] },
            { text: "and they contain right angles, therefore the base {AH} equals the base {FD}.",
              visible: T1.concat(RT),
              highlighted: ["angHKA","angFGD","HA","DF"],
              justifications: [{ claim: "AH = FD", ref: "I.4" }] },
            { text: "But {AB} also equals {DE}, therefore the two sides {HA} and {AB} are equal to the two sides {DF} and {DE}.",
              visible: T2,
              highlighted: ["AB","DE","HA","DF"],
              transition: { mode: "parallel", animations: [
                  { elem: "ABH", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "DEF", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "And the base {HB} is equal to the base {FE}, therefore the angle {BAH|angBAH} equals the angle {EDF|angEDF}.",
              visible: T2.concat(["angBAH","angEDF"]),
              highlighted: ["HB","FE","angBAH","angEDF"],
              justifications: [{ claim: "angle BAH = angle EDF", ref: "I.8" }] },
            { text: "For the same reason the angle {HAL|angHAL} also equals the angle {FDC|angFDC}.",
              visible: T3.concat(["angHAL","angFDC"]),
              highlighted: ["angHAL","angFDC"],
              transition: { mode: "parallel", animations: [
                  { elem: "ALH", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "DCF", name: geomlib.A.Polygon.outlineAndFill } ] },
              justifications: [{ claim: "angle HAL = angle FDC", ref: "I.8" }] },
            { text: "And the angle {BAL|angBAL} also equals the angle {EDC|angEDC}.",
              visible: ALL.concat(["angBAL","angEDC"]),
              highlighted: ["angBAL","angEDC"],
              transition: { mode: "parallel", animations: [
                  { elem: "AKL", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "DCG", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "Therefore at the point {A} on the straight line {AB}",
              visible: ALL.concat(AANG, DANG),
              highlighted: ["A","AB"].concat(AANG) },
            { text: "a solid angle has been constructed equal to the given solid angle at {D}.",
              visible: ALL.concat(AANG, DANG),
              highlighted: AANG.concat(DANG),
              justifications: [{ ref: "Q.E.F." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "XI.26") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "I.Post.1": "/elements/books/bookI/postulates/post1/",
        "I.3":      "/elements/books/bookI/propositions/propI3/",
        "I.4":      "/elements/books/bookI/propositions/propI4/",
        "I.8":      "/elements/books/bookI/propositions/propI8/",
        "I.23":     "/elements/books/bookI/propositions/propI23/",
        "XI.Def.3": "/elements/books/bookXI/definitions/defXI3/",
        "XI.11":    "/elements/books/bookXI/propositions/propXI11/",
        "XI.12":    "/elements/books/bookXI/propositions/propXI12/"
    });
</script>
