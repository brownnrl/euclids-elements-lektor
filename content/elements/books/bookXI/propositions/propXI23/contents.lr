            { text: "For the same reason the angle {MRN|angMRN} equals the angle {DEF|angDEF},",
              visible: EQ.concat(["angLRM","angMRN"]),
              highlighted: ["angMRN","angDEF"],
              transition: { mode: "parallel", animations: [
                  { elem: "angDEF", name: geomlib.A.Sector.sweep },
                  { elem: "angMRN", name: geomlib.A.Sector.sweep } ] } },
            { text: "and the angle {LRN|angLRN} equals the angle {GHK|angGHK}.",
              visible: EQ.concat(RANG),
              highlighted: ["angLRN","angGHK"],
              transition: { mode: "parallel", animations: [
                  { elem: "angGHK", name: geomlib.A.Sector.sweep },
                  { elem: "angLRN", name: geomlib.A.Sector.sweep } ] } },
            { text: "Therefore, out of the three plane angles {LRM|angLRM}, {MRN|angMRN}, and {LRN|angLRN},",
              visible: EQ.concat(RANG),
              highlighted: RANG },
            { text: "which equal the three given angles {ABC|angABC}, {DEF|angDEF}, and {GHK|angGHK},",
              visible: EQ.concat(RANG),
              highlighted: ANG },
            { text: "the solid angle at {R} has been constructed, which is contained by the angles {LRM|angLRM}, {MRN|angMRN}, and {LRN|angLRN}.",
              visible: EQ.concat(RANG, ["pyr"]),
              highlighted: ["R"].concat(RANG),
              justifications: [{ ref: "Q.E.F." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "Lemma") return "#lemma";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
