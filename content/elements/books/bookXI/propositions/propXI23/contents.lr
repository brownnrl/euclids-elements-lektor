        slides: [
            { text: "Next set up {OR} from the point {O} at right angles to the plane of the circle {LMN|LMNcircT}",
              visible: RV,
              highlighted: ["OR","O","LMNcircT"],
              transition: { mode: "cascade", animations: [
                  { elem: "OR", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "R",  name: geomlib.A.Point.appear } ] },
              justifications: [{ claim: "OR at right angles to the plane", ref: "XI.12" }] },
            { text: "so that the square on {OR} equals the square on {AB} minus the square on {LO}.",
              visible: RV,
              highlighted: ["OR","AB","OL"],
