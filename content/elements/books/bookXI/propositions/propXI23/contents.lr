            { text: "Join {RL|RLs}, {RM|RMs}, and {RN|RNs}.",
              visible: JR,
              highlighted: ["RLs","RMs","RNs"],
              transition: { mode: "cascade", animations: [
                  { elem: "RLs", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "RMs", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "RNs", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Then, since {RO} is at right angles to the plane of the circle {LMN|LMNcircT},",
              visible: JR,
              highlighted: ["OR","LMNcircT"] },
            { text: "therefore {RO} is also at right angles to each of the straight lines {LO}, {MO}, and {NO}.",
              visible: RT,
              highlighted: ["OR","OL","OM","ON"],
              transition: { mode: "parallel", animations: [
                  { elem: "angLOR", name: geomlib.A.Sector.sweep },
                  { elem: "angMOR", name: geomlib.A.Sector.sweep },
                  { elem: "angNOR", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "at right angles to every line in the plane", ref: "XI.Def.3" }] },
            { text: "And, since {LO} equals {OM}, and {OR} is common and at right angles,",
              visible: RT,
              highlighted: ["OL","OM","OR","angLOR","angMOR"] },
            { text: "therefore the base {RL} equals the base {RM}.",
              visible: RT,
              highlighted: ["RL","RM"],
              justifications: [{ claim: "RL = RM", ref: "I.4" }] },
            { text: "For the same reason {RN} also equals each of the straight lines {RL} and {RM}.",
