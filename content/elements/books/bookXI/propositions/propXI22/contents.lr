              transition: { animations: [
                  { elem: "DEF", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "and the angle {GHL|angGHL} is greater than the angle {DEF|angE}, therefore the base {GL} is greater than the base {DF}.",
