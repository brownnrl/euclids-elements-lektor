              highlighted: ["AB","BC","HK","HL"],
              transition: { mode: "parallel", animations: [
                  { elem: "ABC", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "HKL", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "and the angle at {B|angB} equals the angle {KHL|angKHL}, therefore the base {AC} equals the base {KL}.",
