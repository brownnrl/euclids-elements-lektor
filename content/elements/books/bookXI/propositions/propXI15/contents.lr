              highlighted: ["AB","BC"] },
            { text: "“are parallel to two straight lines meeting one another not in the same plane,”",
              visible: GIVEN,
              highlighted: ["DE","EF"] },
            { text: "“then the planes through them are parallel.”",
              visible: GIVEN,
              highlighted: ["PT","QT"],
              justifications: [{ ref: "XI.15" }] },
            { text: "Let the two straight lines {AB} and {BC} meeting one another",
              visible: GIVEN,
              highlighted: ["AB","BC"] },
            { text: "be parallel to the two straight lines {DE} and {EF} meeting one another not in the same plane.",
              visible: GIVEN,
              highlighted: ["DE","EF"] },
            { text: "I say that the {plane|PT} produced through {AB} and {BC}",
              visible: GIVEN,
              highlighted: ["PT","AB","BC"] },
