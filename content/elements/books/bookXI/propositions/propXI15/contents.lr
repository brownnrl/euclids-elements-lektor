            "P2;point;free;180,20;0;0,75,100",
            "P1;point;intersection;P0,X,P2,Z;0;0",
            "P3;point;intersection;P2,X,P0,Z;0;0",
            "P;polygon;quadrilateral;P0,P1,P2,P3;0;0;gray;brighter",
            "Q0;point;free;30,280;0;0,75,100",
            "Q2;point;free;230,140;0;0,75,100",
            "Q1;point;intersection;Q0,X,Q2,Z;0;0",
            "Q3;point;intersection;Q2,X,Q0,Z;0;0",
            "Q;polygon;quadrilateral;Q0,Q1,Q2,Q3;0;0;gray;brighter",
            "A;point;free;70,80",
            "B;point;free;110,50",
            "C;point;free;140,70",
            "AB;line;connect;A,B",
            "BC;line;connect;B,C",
            "E;point;free;140,160",
            "D';point;parallelogram;A,B,E;0;0",
            "D;point;lineSlider;E,D',80,210",
            "F';point;parallelogram;C,B,E;0;0",
            "F;point;lineSlider;E,F',180,210",
            "DE;line;connect;D,E",
            "EF;line;connect;E,F",
            "G;point;lineSlider;B,Y,110,220",
            "BG;line;connect;B,G",
            "H';point;parallelogram;D,E,G;0;0",
            "H;point;lineSlider;G,H',80,250",
            "K';point;parallelogram;F,E,G;0;0",
            "K;point;lineSlider;G,K',160,250",
            "GH;line;connect;G,H",
            "GK;line;connect;G,K"
        ],
