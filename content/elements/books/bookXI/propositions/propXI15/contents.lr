            "PT;polygon;quadrilateral;P0,P1,P2,P3;0;0;0;0",
            "QT;polygon;quadrilateral;Q0,Q1,Q2,Q3;0;0;0;0",
            "angBGH;sector;angleMarkerRight;G,B,H",
            "angBGK;sector;angleMarkerRight;G,B,K",
            "angGBA;sector;angleMarkerRight;B,G,A",
            "angGBC;sector;angleMarkerRight;B,G,C",
            "angGBAs;sector;angleMarker;B,G,A,22;0;0;0;0"
