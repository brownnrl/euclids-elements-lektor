                  { elem: "G",  name: geomlib.A.Point.appear } ] },
              justifications: [{ claim: "BG perpendicular to the plane", ref: "XI.11" }] },
            { text: "to where it meets the {plane|QT} at the point {G}.",
              visible: PERP,
              highlighted: ["G","QT"] },
            { text: "Draw {GH} through {G} parallel to {ED}, and {GK} parallel to {EF}.",
              visible: PARS,
              highlighted: ["GH","GK","DE","EF"],
              transition: { mode: "cascade", animations: [
                  { elem: "GH", name: geomlib.A.Line.straightEdgeConnect },
