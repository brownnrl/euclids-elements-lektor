                  { elem: "angBGK", name: geomlib.A.Sector.sweep } ] } },
            { text: "And, since {BA} is parallel to {GH},",
              visible: RTG,
              highlighted: ["AB","GH"],
              justifications: [{ claim: "parallels to one line, not in one plane", ref: "XI.9" }] },
            { text: "therefore the sum of the angles {GBA|angGBAs} and {BGH} equals two right angles.",
              visible: RTG.concat(["angGBAs"]),
              highlighted: ["angGBAs","angBGH","AB","BG","GH"],
              justifications: [{ claim: "interior angles on the same side", ref: "I.29" }] },
            { text: "But the angle {BGH} is right, therefore the angle {GBA} is also right.",
              visible: RTB,
              highlighted: ["angBGH","angGBA"],
              transition: { animations: [
                  { elem: "angGBA", name: geomlib.A.Sector.sweep } ] } },
            { text: "Therefore {GB} is at right angles to {BA}.",
              visible: RTB,
              highlighted: ["BG","AB","angGBA"] },
            { text: "For the same reason {GB} is also at right angles to {BC}.",
              visible: FULL,
              highlighted: ["BG","BC","angGBC"],
              transition: { animations: [
                  { elem: "angGBC", name: geomlib.A.Sector.sweep } ] } },
            { text: "Since then the straight line {GB} is set up at right angles",
              visible: FULL,
              highlighted: ["BG","angGBA","angGBC"] },
            { text: "to the two straight lines {BA} and {BC} which cut one another,",
              visible: FULL,
              highlighted: ["AB","BC"] },
            { text: "therefore {GB} is also at right angles to the {plane|PT} through {BA} and {BC}.",
              visible: FULL,
              highlighted: ["BG","PT"],
              justifications: [{ claim: "at right angles to two lines at their section", ref: "XI.4" }] },
            { text: "But planes to which the same straight line is at right angles are parallel,",
              visible: FULL,
              highlighted: ["BG","PT","QT"],
              justifications: [{ ref: "XI.14" }] },
            { text: "therefore the {plane|PT} through {AB} and {BC} is parallel to the {plane|QT} through {DE} and {EF}.",
              visible: FULL,
              highlighted: ["PT","QT"] },
            { text: "Therefore, if two straight lines meeting one another",
              visible: FULL,
              highlighted: ["AB","BC"] },
            { text: "are parallel to two straight lines meeting one another not in the same plane,",
              visible: FULL,
              highlighted: ["DE","EF"] },
            { text: "then the planes through them are parallel.",
              visible: FULL,
              highlighted: ["PT","QT"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "XI.15") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "I.29":     "/elements/books/bookI/propositions/propI29/",
        "I.31":     "/elements/books/bookI/propositions/propI31/",
        "XI.Def.3": "/elements/books/bookXI/definitions/defXI3/",
        "XI.4":     "/elements/books/bookXI/propositions/propXI4/",
        "XI.9":     "/elements/books/bookXI/propositions/propXI9/",
        "XI.11":    "/elements/books/bookXI/propositions/propXI11/",
        "XI.14":    "/elements/books/bookXI/propositions/propXI14/"
