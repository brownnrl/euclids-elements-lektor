            { text: "and contain equal angles with the original straight lines respectively,",
              visible: MNd,
              highlighted: ["angNLO","angOLM","angDEG","angGEF"] },
            { text: "therefore the perpendiculars drawn from the points {G} and {O}",
              visible: MNd,
              highlighted: ["G","O"] },
            { text: "to the planes through {NL|LN} and {LM} and through {DE|ED} and {EF} equal one another,",
              visible: MNd,
              highlighted: ["pMN","pDF"],
              justifications: [{ claim: "the perpendiculars from G and O are equal", ref: "XI.35.Cor" }] },
            { text: "therefore the solids {LH|sLH} and {EK|sEK} are of the same height.",
