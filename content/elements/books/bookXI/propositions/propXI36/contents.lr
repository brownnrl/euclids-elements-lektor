              highlighted: ["pMN","pDF"],
              transition: { animations: [
                  { elem: "Mf", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "Nf", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ claim: "parallelogram MN = parallelogram DF", ref: "VI.4" }] },
            { text: "And, since the angles {DEF|angFED} and {NLM|angMLN} are two plane rectilinear angles,",
              visible: MNd,
              highlighted: ["angFED","angMLN"] },
            { text: "and on them the elevated straight lines {LO} and {EG} are set up which equal one an other",
              visible: MNd,
