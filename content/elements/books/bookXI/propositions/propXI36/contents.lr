                  { elem: "GEDe", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "GcKe", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "Fd", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "Dd", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "Kd", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Make {LM} equal to {A}.",
              visible: LMd,
              highlighted: ["LM","A"],
              transition: { animations: [
                  { elem: "LM", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ claim: "LM = A", ref: "I.3" }] },
            { text: "Construct a solid angle at the point {L} on the straight line {LM} equal to the solid angle at {E},",
              visible: Ld,
              highlighted: ["L","LM","E"],
              transition: { animations: [
                  { elem: "LO", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "LN", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "namely that contained by {NLO|angNLO}, {OLM|angOLM}, and {MLN|angMLN}.",
              visible: Ld,
              highlighted: ["angNLO","angOLM","angMLN"],
              transition: { animations: [
                  { elem: "angNLO", name: geomlib.A.Sector.sweep },
                  { elem: "angOLM", name: geomlib.A.Sector.sweep },
                  { elem: "angMLN", name: geomlib.A.Sector.sweep } ] } },
            { text: "Make {LO} equal to {B}, and {LN} equal to {C}.",
              visible: Ld,
              highlighted: ["LO","B","LN","C"],
              justifications: [{ claim: "LO = B, LN = C", ref: "I.3" }] },
            { text: "Now, since {A} is to {B} as {B} is to {C}, while {A} equals {LM},",
              visible: Ld,
              highlighted: ["A","B","C","LM"] },
            { text: "and {B} equals each of the straight lines {LO}, {ED}, and {C} to {LN},",
              visible: Ld,
              highlighted: ["B","LO","ED","C","LN"] },
            { text: "therefore {LM} is to {EF} as {DE|ED} is to {LN}.",
              visible: Ld,
              highlighted: ["LM","EF","ED","LN"] },
            { text: "Thus the sides about the equal angles {NLM|angMLN}, {DEF|angFED} are reciprocally proportional,",
              visible: Ld,
              highlighted: ["angMLN","angFED","LM","LN","ED","EF"] },
            { text: "therefore the parallelogram {MN|pMN} equals the parallelogram {DF|pDF}.",
