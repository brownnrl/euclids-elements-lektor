title: Proposition 13
---
order: 13
---
short_label: XI.13
---
sections:

#### prop_section ####
kind: proposition
----
statement: From the same point two straight lines cannot be set up at right angles to the same plane on the same side.
----
proof:

For, if possible, from the same point {A} let the two straight lines {AB} and {AC} be set up at right angles to the plane of reference and on the same side.

<figure class="diagram">
<canvas id="canvas_0" width="270" height="250" tabindex="0"></canvas>
<noscript><img alt="XI.13 diagram" src="propXI13.gif"/></noscript>
<script type="text/javascript">
    // Joyce's figure: the plane of reference P, the two perpendiculars AB
    // and AC from A on the same side, and DAE, the section of the plane
    // through BA and AC with the plane of reference.
    //
    // Added, all transparent: PT, a faceless twin of the filled plane P
    // (raised over the figure if highlighted, #140); planeBAC, the plane
    // through BA and AC, outlined D-B-C-E so it holds all three lines; and
    // the right-angle squares at A for CAE and BAE, right by hypothesis.
    // DE is Joyce's own line, stroked from D when the section is drawn.
    //
    // Draggables (checked against the bundle): X, Y, Y', Z, P0, A free;
    // P1, P3, B, C, D sliders. D arrives with DAE, so it is deferred.
    // P2 and E are derived and listed per slide.
    var GIVEN = ["P","PT","P0","P1","P2","P3","A","B","C","AB","AC"];
    var PLN   = GIVEN.concat(["planeBAC"]);
    var SEC   = PLN.concat(["D","E","DE"]);
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "XI.13",
        elements: [
            "X;point;free;100000,100",
            "Y;point;free;-10000,-100000",
            "Y';point;free;10000,-100000",
            "Z;point;free;50000,-100000",
            "P0;point;free;30,220;0;0,75,100",
            "P1;point;lineSlider;P0,X,180,220;0;30,75,100",
            "P3;point;lineSlider;P0,Z,100,120;0;30,75,100",
            "P2;point;parallelogram;P3,P0,P1;0;0",
            "P;polygon;quadrilateral;P0,P1,P2,P3;0;0;lightGray;brighter",
            "A;point;free;130,170",
            "B;point;lineSlider;A,Y,130,40",
