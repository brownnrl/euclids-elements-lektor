              visible: PLN,
              highlighted: ["planeBAC","AB","AC"],
              transition: { animations: [
                  { elem: "planeBAC", name: geomlib.A.Polygon.outline } ] } },
            { text: "It intersects the {plane of reference|PT} in a straight line through {A}. Let the line be {DAE|DE}.",
              visible: SEC,
              highlighted: ["PT","A","DE"],
              transition: { mode: "cascade", animations: [
                  { elem: "D",  name: geomlib.A.Point.appear },
                  { elem: "DE", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "E",  name: geomlib.A.Point.appear } ] },
              justifications: [{ claim: "two planes cut in a straight line", ref: "XI.3" }] },
            { text: "Therefore the straight lines {AB}, {AC}, and {DAE|DE} lie in one plane.",
              visible: SEC,
              highlighted: ["AB","AC","DE","planeBAC"] },
            { text: "And, since {CA|AC} is at right angles to the {plane of reference|PT},",
              visible: SEC,
              highlighted: ["AC","PT"] },
            { text: "it also makes right angles with all the straight lines which meet it and lie in the {plane of reference|PT}.",
              visible: SEC,
              highlighted: ["AC","PT"],
              justifications: [{ claim: "a line at right angles to a plane", ref: "XI.Def.3" }] },
            { text: "But {DAE|DE} meets it and lies in the {plane of reference|PT}, therefore the angle {CAE|angCAE} is right.",
              visible: SEC.concat(["angCAE"]),
              highlighted: ["DE","AC","angCAE"],
              transition: { animations: [
                  { elem: "angCAE", name: geomlib.A.Sector.sweep } ] } },
            { text: "For the same reason the angle {BAE|angBAE} is also right.",
              visible: SEC.concat(["angCAE","angBAE"]),
              highlighted: ["AB","angBAE"],
              transition: { animations: [
                  { elem: "angBAE", name: geomlib.A.Sector.sweep } ] } },
            { text: "Therefore the angle {CAE|angCAE} equals the angle {BAE|angBAE}.",
              visible: SEC.concat(["angCAE","angBAE"]),
              highlighted: ["angCAE","angBAE"] },
            { text: "And they lie in one plane, which is impossible.",
              visible: SEC.concat(["angCAE","angBAE"]),
              highlighted: ["angCAE","angBAE","planeBAC"] },
            { text: "Therefore, from the same point two straight lines cannot be set up",
              visible: GIVEN,
              highlighted: ["A","AB","AC"] },
            { text: "at right angles to the same plane on the same side.",
              visible: GIVEN,
              highlighted: ["AB","AC","PT"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "XI.13") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
