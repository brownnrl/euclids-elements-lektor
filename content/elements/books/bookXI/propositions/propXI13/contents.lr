            "AB;line;connect;A,B",
            "AC;line;connect;A,C",
            "D;point;lineSlider;P0,P3,40,140",
            "E;point;intersection;A,D,P1,P2",
            "DE;line;connect;D,E",
            // Transparent highlight targets.
            "PT;polygon;quadrilateral;P0,P1,P2,P3;0;0;0;0",
            "planeBAC;polygon;quadrilateral;D,B,C,E;0;0;0;0",
            "angCAE;sector;angleMarkerRight;A,C,E",
            "angBAE;sector;angleMarkerRight;A,B,E"
        ],
        deferDraggables: ["D"],
        aliases: { "BA": "AB", "CA": "AC", "DAE": "DE",
                   "CAE": "angCAE", "EAC": "angCAE",
                   "BAE": "angBAE", "EAB": "angBAE" },
        slides: [
            { text: "“From the same point two straight lines cannot be set up at right angles to the same plane on the same side.”",
              visible: GIVEN,
              highlighted: ["AB","AC","PT"],
              justifications: [{ ref: "XI.13" }] },
            { text: "For, if possible, from the same point {A} let the two straight lines {AB} and {AC} be set up",
              visible: GIVEN,
              highlighted: ["A","AB","AC"] },
            { text: "at right angles to the {plane of reference|PT} and on the same side.",
              visible: GIVEN,
              highlighted: ["AB","AC","PT"] },
