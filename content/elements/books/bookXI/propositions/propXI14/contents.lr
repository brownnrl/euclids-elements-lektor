                  { elem: "BK", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Now, since {AB} is at right angles to the plane {EF},",
              visible: JOIN,
              highlighted: ["AB","EF"] },
            { text: "therefore {AB} is also at right angle to {BK} which is a straight line in the plane {EF} produced.",
              visible: JOIN,
              highlighted: ["AB","BK","EF"],
              justifications: [{ claim: "a line at right angles to a plane", ref: "XI.Def.3" }] },
            { text: "Therefore the angle {ABK|angABK} is right.",
