            { text: "Let {ABCD} be the given circle.",
              visible: CIRC,
              highlighted: ["ABCDc"] },
            { text: "It is required to inscribe in the circle {ABCD} a fifteen-angled figure which shall be both equilateral and equiangular.",
              visible: CIRC,
              highlighted: ["ABCDc"] },
            { text: "Inscribe a side {AC} of an equilateral triangle",
              visible: TRI,
              highlighted: ["AC"],
              transition: { animations: [
                  { elem: "ACD", name: geomlib.A.Polygon.outlineAndFill } ] },
              justifications: [{ claim: "the equilateral triangle ACD", ref: "IV.2" }] },
            { text: "and a side {AB} of an equilateral pentagon in the circle {ABCD}.",
              visible: PENT,
              highlighted: ["AB"],
              transition: { mode: "parallel", animations: [
                  { elem: "pentagon", name: geomlib.A.Polygon.outline },
                  { elem: "duppent",  name: geomlib.A.Polygon.outlineAndFill } ] },
              justifications: [{ claim: "the equilateral and equiangular pentagon", ref: "IV.11" }] },
            { text: "Therefore, of the equal segments of which there are fifteen in the circle {ABCD},",
              visible: PENT,
              highlighted: ["ABCDc"] },
            { text: "there will be five in the circumference {ABC} which is one-third of the circle,",
              visible: THIRD,
              highlighted: ["ABC"],
              transition: { animations: [
                  { elem: "ABC", name: geomlib.A.Sector.sweep } ] } },
            { text: "and there will be three in the circumference {AB|arcAB} which is one-fifth of the circle.",
              visible: FIFTH,
              highlighted: ["arcAB"],
              transition: { animations: [
                  { elem: "arcAB", name: geomlib.A.Sector.sweep } ] } },
            { text: "Therefore in the remainder {BC|arcBC} there will be two of the equal segments.",
              visible: REM,
              highlighted: ["arcBC"],
              transition: { animations: [
                  { elem: "arcBC", name: geomlib.A.Sector.sweep } ] } },
            { text: "Bisect {BC|arcBC} at {E}.",
              visible: BIS,
              highlighted: ["arcBC","E"],
              transition: { animations: [
                  { elem: "E", name: geomlib.A.Point.appear } ] },
              justifications: [{ ref: "III.30" }] },
            { text: "Therefore each of the circumferences {BE|arcBE} and {EC|arcEC} is a fifteenth of the circle {ABCD}.",
              visible: ARCS,
              highlighted: ["arcBE","arcEC"],
              transition: { mode: "cascade", animations: [
                  { elem: "arcBE", name: geomlib.A.Sector.sweep },
                  { elem: "arcEC", name: geomlib.A.Sector.sweep } ] } },
            { text: "If therefore we join {BE} and {EC}",
              visible: JOIN,
              highlighted: ["BE","EC"],
              transition: { mode: "cascade", animations: [
                  { elem: "BE", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "EC", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ ref: "I.Post.1" }] },
            { text: "and continually fit into the circle {ABCD} straight lines equal to them,",
              visible: DONE,
              highlighted: ["fifteen"],
              transition: { animations: [
                  { elem: "fifteen", name: geomlib.A.Polygon.outline } ] },
              justifications: [{ claim: "each fitted equal to BE", ref: "IV.1" }] },
            { text: "a fifteen-angled figure which is both equilateral and equiangular will be inscribed in it.",
              visible: DONE,
              highlighted: ["fifteen"],
              justifications: [{ ref: "Q.E.F." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "IV.16") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
