#### prop_section ####
kind: proposition
----
----
statement: To inscribe an equilateral and equiangular fifteen-angled figure in a given circle.
----
----
proof:

Let {ABCD} be the given circle.

<figure class="diagram">
<canvas id="canvas_0" width="325" height="350" tabindex="0"></canvas>
<noscript><img alt="IV.16 diagram" src="propIV16.gif"/></noscript>
<script type="text/javascript">
    // The triangle side AC (IV.2) and the pentagon side AB (IV.11), the
    // circumferences ABC, AB and the remainder BC, its bisection at E
    // (III.30), then BE and EC joined and fitted round the circle (IV.1).
    //
    // Joyce's figure builds the triangle ACD through the hidden circle Acirc
    // and the pentagon on the unlabelled free points F and G; those stay
    // assumed (IV.2, IV.11 are cited, not re-shown). Everything added is
    // transparent or hidden at rest: ABCDc, a faceless twin of the circle
    // (the original has an opaque face that highlighting would promote over
    // the triangle and pentagon, #140); the sides AC and AB; the
    // circumferences ABC, AB, BC, BE, EC as faceless sectors on the centre
    // O, listed counter-clockwise on screen (the way an arc draws from its
    // first arm to its last); and BE, EC, solid black slide twins of the
    // fifteen-gon's first two sides, hidden at rest (initiallyHidden), so
    // the joins draw before the figure is fitted round. Circumference and
    // straight line share a name in the prose (AB, BC, BE, EC): the lines
    // own it, the circumferences take the display override {BE|arcBE}.
    var CIRC  = ["circ","ABCDc"];
    var TRI   = CIRC.concat(["ACD","A","C","D","AC"]);
    var PENT  = TRI.concat(["pentagon","duppent","F","G","B","AB"]);
    var THIRD = PENT.concat(["ABC"]);
    var FIFTH = THIRD.concat(["arcAB"]);
    var REM   = FIFTH.concat(["arcBC"]);
    var BIS   = PENT.concat(["arcBC","E"]);
    var ARCS  = PENT.concat(["E","arcBE","arcEC"]);
    var JOIN  = ARCS.concat(["BE","EC"]);
    var DONE  = PENT.concat(["E","BE","EC","fifteen"]);
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "IV.16",
        elements: [
            "F;point;free;90,300;0",
            "G;point;free;260,300;0",
            "pentagon;polygon;regularPolygon;F,G,5;0;0;black;0",
            "A;point;vertex;pentagon,4",
            "B;point;vertex;pentagon,5",
            "circ;circle;circumcircle;F,G,A;0;0;black;random",
            "duppent;polygon;regularPolygon;F,G,5;0;0;0;random",
            "O;point;center;circ;0;0",
            "Acirc;circle;radius;A,O;0;0;0;0",
            "PQ;line;bichord;circ,Acirc;0;0;0",
            "P;point;first;PQ;0;0",
            "C;point;extend;P,O,P,O",
            "Q;point;last;PQ;0;0",
            "D;point;extend;Q,O,Q,O",
            "ACD;polygon;triangle;A,C,D;0;0;black;random",
            "OE';line;angleBisector;B,O,C;0;0;0",
            "E';point;last;OE';0;0",
            "E;point;cutoff;O,E',O,A",
            "fifteen;polygon;regularPolygon;B,E,15;0;0;black;0",
            // Transparent twin of the circle (see above).
            "ABCDc;circle;circumcircle;F,G,A;0;0;0;0",
            "AC;line;connect;A,C;0;0;0",
            "AB;line;connect;A,B;0;0;0",
            // The circumferences.
            "ABC;sector;sector;O,A,C;0;0;0;0",
            "arcAB;sector;sector;O,A,B;0;0;0;0",
            "arcBC;sector;sector;O,B,C;0;0;0;0",
            "arcBE;sector;sector;O,B,E;0;0;0;0",
