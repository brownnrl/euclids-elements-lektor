        deferDraggables: ["F","G"],
        initiallyHidden: ["BE","EC"],
        aliases: { "ABCD": "ABCDc" },
        slides: [
            { text: "“To inscribe an equilateral and equiangular fifteen-angled figure in a given circle.”",
