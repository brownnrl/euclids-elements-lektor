            "C;point;midpoint;O,B",
            "AC;line;connect;A,C",
            "D;point;angleBisector;O,C,A",
            "CD;line;connect;C,D",
            "E';point;perpendicular;D,A;0;0",
            "EE';line;chord;D,E',AEB;0;0;0",
            "E;point;first;EE'",
            "DE;line;connect;D,E",
            "AE;line;connect;A,E",
            "F;point;similar;E,O,A,O,E;0;0",
            "EF;line;connect;E,F;0;0;gray",
            "G;point;similar;F,O,A,O,E;0;0",
            "FG;line;connect;F,G;0;0;gray",
            "H;point;similar;G,O,A,O,E;0;0",
            "GH;line;connect;G,H;0;0;gray",
            "HA;line;connect;H,A;0;0;gray",
