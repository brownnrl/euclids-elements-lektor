              highlighted: ["DE","DF","DG"] },
            { text: "Therefore the circle described with center {D} and radius one of the straight lines {DE}, {DF}, or {DG}",
              visible: CIRC,
              highlighted: ["D","DE"],
              transition: { animations: [
                  { elem: "EFG", name: geomlib.A.Circle.compass } ] } },
            { text: "also passes through the remaining points",
              visible: CIRC,
              highlighted: ["EFG","E","F","G"] },
            { text: "and touches the straight lines {AB}, {BC}, and {CA},",
