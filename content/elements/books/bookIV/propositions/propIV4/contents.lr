            "ABend;point;extend;A,B,L0,L1;0;0",
            "ACend;point;extend;A,C,L0,L1;0;0",
            "AB;line;connect;B,ABend",
            "AC;line;connect;C,ACend",
            "Bperp;line;angleBisector;ABend,B,C;0;0;0",
            "Cperp;line;angleBisector;ACend,C,B;0;0;0",
            "A';point;intersection;Bperp,Cperp;black;green",
            "F';point;foot;A',B,C",
            "E';point;foot;A',A,B",
            "G';point;foot;A',C,A",
            "AA'B;polygon;triangle;A,A',B;0;0;black;random",
            "CA'B;polygon;triangle;C,A',B;0;0;black;0",
            "CA'A;polygon;triangle;C,A',A;0;0;black;random",
            "E'A';line;connect;E',A'",
