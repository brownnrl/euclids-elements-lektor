            "CD;line;connect;C,D",
            "ED;line;connect;E,D",
            "FD;line;connect;F,D",
            "GD;line;connect;G,D",
            // The three sides.
            "AB;line;connect;A,B;0;0;0",
            "BC;line;connect;B,C;0;0;0",
            "CA;line;connect;C,A;0;0;0",
            // The perpendiculars, from D; hidden at rest (see above).
            "DE;line;connect;D,E",
            "DF;line;connect;D,F",
            "DG;line;connect;D,G",
            // The triangles of the two I.26 arguments.
            "EBD;polygon;triangle;E,B,D;0;0;0;0",
            "FBD;polygon;triangle;F,B,D;0;0;0;0",
            "GCD;polygon;triangle;G,C,D;0;0;0;0",
            "FCD;polygon;triangle;F,C,D;0;0;0;0",
            // The diameter through E, for the III.16 reductio.
            "Eopp;point;extend;E,D,D,E;0;0",
            "diamE;line;connect;E,Eopp;0;0;0",
            "angB;sector;angleMarker;B,A,C,34;0;0;c06a1b;f3c590",
            "angC;sector;angleMarker;C,B,A,34;0;0;c06a1b;f3c590",
            "angABD;sector;angleMarker;B,A,D,22;0;0;3b6ea5;9ec5e8",
            "angCBD;sector;angleMarker;B,C,D,22;0;0;3b6ea5;9ec5e8",
            "angACD;sector;angleMarker;C,A,D,22;0;0;3f8e4f;a8dbb0",
            "angBCD;sector;angleMarker;C,B,D,22;0;0;3f8e4f;a8dbb0",
            "rtBED;sector;angleMarkerRight;E,B,D,12;0;0;red;red",
            "rtBFD;sector;angleMarkerRight;F,B,D,12;0;0;red;red",
            "rtCFD;sector;angleMarkerRight;F,C,D,12;0;0;red;red",
            "rtCGD;sector;angleMarkerRight;G,C,D,12;0;0;red;red"
        ],
        // Draggables (checked against the bundle): A, B, C, free; they are
        // the given triangle and stand from slide 1. D (intersection), E, F,
        // G (foot) and Eopp (extend) are derived and listed per slide.
        // Nothing to defer.
        initiallyHidden: ["DE","DF","DG"],
        //
        // The triangle owns ABC; the angle ABC takes {ABC|angB}.
        aliases: { "BA": "AB", "CB": "BC", "AC": "CA",
                   "DB": "BD", "DC": "CD",
                   "ED": "DE", "FD": "DF", "GD": "DG",
                   "FGE": "EFG",
                   "ACB": "angC", "BCA": "angC",
                   "ABD": "angABD", "DBA": "angABD",
                   "CBD": "angCBD", "DBC": "angCBD",
                   "BED": "rtBED", "DEB": "rtBED",
                   "BFD": "rtBFD", "DFB": "rtBFD" },
        slides: [
            { text: "“To inscribe a circle in a given triangle.”",
              visible: GIVEN,
              highlighted: ["ABC"],
              justifications: [{ ref: "IV.4" }] },
            { text: "Let {ABC} be the given triangle.",
              visible: GIVEN,
              highlighted: ["ABC"] },
            { text: "It is required to inscribe a circle in the triangle {ABC}.",
              visible: GIVEN,
              highlighted: ["ABC"] },
            { text: "Bisect the angles {ABC|angB} and {ACB} by the straight lines {BD} and {CD},",
