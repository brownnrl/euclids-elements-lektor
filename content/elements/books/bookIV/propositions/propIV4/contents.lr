              highlighted: ["EBD","FBD"],
              transition: { mode: "parallel", animations: [
                  { elem: "EBD", name: geomlib.A.Polygon.outline },
                  { elem: "FBD", name: geomlib.A.Polygon.outline } ] } },
            { text: "namely that opposite one of the equal angles, which is {BD} common to the triangles,",
              visible: TRI,
              highlighted: ["BD","rtBED","rtBFD"] },
            { text: "therefore they will also have the remaining sides equal to the remaining sides, therefore {DE} equals {DF}.",
              visible: TRI,
              highlighted: ["DE","DF"],
              justifications: [{ claim: "two angles and a side opposite one of them", ref: "I.26" }] },
            { text: "For the same reason {DG} also equals {DF}.",
              visible: SAME,
              highlighted: ["DG","DF","GCD","FCD"],
