              highlighted: ["angB","angC"],
              transition: { mode: "cascade", animations: [
                  { elem: "angB", name: geomlib.A.Sector.sweep },
                  { elem: "BD",   name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "angC", name: geomlib.A.Sector.sweep },
                  { elem: "CD",   name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ claim: "angles ABC and ACB bisected", ref: "I.9" }] },
            { text: "and let these meet one another at the point {D}.",
              visible: MEET,
              highlighted: ["BD","CD","D"],
              transition: { animations: [
                  { elem: "D", name: geomlib.A.Point.appear } ] } },
            { text: "Draw {DE}, {DF}, and {DG} from {D} perpendicular to the straight lines {AB}, {BC}, and {CA}.",
              visible: PERP,
              highlighted: ["AB","BC","CA"],
              transition: { mode: "cascade", animations: [
                  { elem: "DE",    name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "E",     name: geomlib.A.Point.appear },
                  { elem: "DF",    name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "F",     name: geomlib.A.Point.appear },
                  { elem: "DG",    name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "G",     name: geomlib.A.Point.appear },
                  { elem: "rtBED", name: geomlib.A.Sector.sweep },
                  { elem: "rtBFD", name: geomlib.A.Sector.sweep },
                  { elem: "rtCGD", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "perpendiculars from D to the sides", ref: "I.12" }] },
            { text: "Now, since the angle {ABD} equals the angle {CBD},",
              visible: HALF,
              highlighted: ["angABD","angCBD"],
              transition: { mode: "parallel", animations: [
                  { elem: "angABD", name: geomlib.A.Sector.sweep },
                  { elem: "angCBD", name: geomlib.A.Sector.sweep } ] } },
            { text: "and the right angle {BED} also equals the right angle {BFD},",
              visible: HALF,
              highlighted: ["rtBED","rtBFD"] },
            { text: "{EBD} and {FBD} are two triangles having two angles equal to two angles and one side equal to one side,",
