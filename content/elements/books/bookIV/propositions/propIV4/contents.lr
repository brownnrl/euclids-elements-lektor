#### prop_section ####
kind: proposition
----
statement: To inscribe a circle in a given triangle.
----
proof:

Let {ABC} be the given triangle.

It is required to inscribe a circle in the triangle {ABC}.

<figure class="diagram">
<canvas id="canvas_0" width="320" height="260" tabindex="0"></canvas>
<noscript><img alt="IV.4 diagram" src="propIV4.gif"/></noscript>
<script type="text/javascript">
    // The two angle bisectors meeting at D, the three perpendiculars, the
    // I.26 argument on the triangles EBD and FBD ("for the same reason" on
    // GCD and FCD), the circle, and the III.16 argument that it touches
    // the three sides.
    //
    // Everything added leaves the resting figure as it was. The sides AB,
    // BC, CA, the triangles EBD, FBD, GCD, FCD and the diameter through E
    // (out to Eopp, the far end, for the reductio) are transparent
    // highlight targets with explicit ;0 faces. DE, DF and DG are solid
    // black lines over Joyce's ED, FD and GD, hidden at rest
    // (initiallyHidden) and used by the slides instead: they run from D,
    // the way the proof draws the perpendiculars.
    //
    // Angle markers: the halves at B (ABD, CBD) blue, the halves at C
    // (ACD, BCD) green, pinned at 22 px side by side; the whole angles ABC
    // and ACB orange at 34 px, outside the halves, shown only while they
    // are bisected. The right angles at E, F, G (two at F, one for each
    // pair of triangles) are red squares, pinned small side by side.
    var GIVEN = ["ABC","A","B","C","AB","BC","CA"];
    var BIS   = GIVEN.concat(["BD","CD"]);
    var MEET  = BIS.concat(["D"]);
    var PERP  = MEET.concat(["DE","DF","DG","E","F","G","rtBED","rtBFD","rtCGD"]);
    var HALF  = PERP.concat(["angABD","angCBD"]);
    var TRI   = HALF.concat(["EBD","FBD"]);
    var SAME  = TRI.concat(["angACD","angBCD","rtCFD","GCD","FCD"]);
    var CIRC  = SAME.concat(["EFG"]);
    var DIAM  = CIRC.concat(["diamE"]);
    // diamE was transitory: dropped once the reductio has been stated.
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "IV.4",
        pivot: "D",
        elements: [
            "A;point;free;210,40",
            "B;point;free;40,190",
            "C;point;free;280,220",
            "ABC;polygon;triangle;A,B,C;0;0;black;random",
            "BB';line;angleBisector;A,B,C;0;0;0",
            "CC';line;angleBisector;B,C,A;0;0;0",
            "D;point;intersection;BB',CC';black;green",
