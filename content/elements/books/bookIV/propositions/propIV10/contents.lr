        aliases: { "DB": "BD", "DC": "CD", "CA": "AC", "ADB": "ABD", "DBC": "BCD",
                   "CAD": "angA", "DAC": "angA",
                   "BDC": "angBDC", "CDA": "angCDA", "BDA": "angBDA" }
