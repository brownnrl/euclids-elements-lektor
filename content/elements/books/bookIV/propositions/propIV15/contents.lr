sections:

#### prop_section ####
kind: proposition
----
----
statement: To inscribe an equilateral and equiangular hexagon in a given circle.
----
----
proof:

Let {ABCDEF|ABCDEFc} be the given circle.

It is required to inscribe an equilateral and equiangular hexagon in the circle {ABCDEF|ABCDEFc}.

Draw the diameter {AD} of the circle {ABCDEF|ABCDEFc}.  Take the center {G} of the circle.  Describe the circle {EGCH} with center {D} and radius {DG}.  Join {EG} and {CG} and carry them through to the points {B} and {F}.  Join {AB}, {BC}, {CD}, {DE}, {EF}, and {FA}. [!just III.1]

I say that the hexagon {ABCDEF|hexagon} is equilateral and equiangular.

<figure class="diagram">
<canvas id="canvas_0" width="300" height="380" tabindex="0"></canvas>
<noscript><img alt="IV.15 diagram" src="propIV15.gif"/></noscript>
<script type="text/javascript">
    // The diameter AD, the centre G, the circle EGCH on D, the lines through
    // G, the six joins; then the equilateral triangle EGD (I.5, I.32), the
    // six equal angles at G (I.13, I.15) and their equal circumferences
    // (III.26, III.29), and the angles of the hexagon on equal
    // circumferences (III.27).
    //
    // Joyce's BE and CF are drawn whole from B and C. The proof joins EG
    // and CG and carries them through to B and F, so EG, CG, GB and GF are
    // solid black slide twins over them, hidden at rest (initiallyHidden),
    // as on IV.3; EB is a transparent target for "standing on EB".
    // Everything else added is transparent: DG, the six sides, the triangle
    // EGD (explicit ;0 face), the circumferences (faceless sectors on G,
    // listed counter-clockwise on screen, which is the way an arc draws from
    // its first arm to its last), and ABCDEFc, a faceless twin of the
    // circle. The circle ABCDEF has an opaque face declared below the
    // hexagon, so highlighting it would paint over the hexagon (#140): the
    // slides and the prose light the twin ({ABCDEF|ABCDEFc}) and leave the
    // original in `visible` only. The hexagon is also ABCDEF in the prose
    // and takes {ABCDEF|hexagon}.
    //
    // Angle markers: the six angles at G lie side by side and are pinned
    // at 22 (EGC, the sum of two of them, at 34 outside); equal angles share
    // a colour.
    var CIRC  = ["ABCDEF","ABCDEFc"];
    var DIAM  = CIRC.concat(["AD","A","D"]);
    var CEN   = DIAM.concat(["G"]);
    var SEC   = CEN.concat(["EGCH","DG","C","E","H"]);
    var JOIN  = SEC.concat(["EG","CG","GB","GF","B","F","EB"]);
    var HEX   = JOIN.concat(["hexagon","AB","BC","CD","DE","EF","FA"]);
    var TRI   = HEX.concat(["EGD"]);
    var TANG  = TRI.concat(["angEGD","angGDE","angDEG"]);
    var CEN1  = HEX.concat(["angEGD"]);
    var CEN2  = CEN1.concat(["angDGC"]);
    var ADJ   = CEN2.concat(["angEGC","angCGB"]);
    var CEN3  = CEN2.concat(["angCGB"]);
    var VERT  = CEN3.concat(["angBGA","angAGF","angFGE"]);
    var ARCS  = VERT.concat(["arcAB","arcBC","arcCD","arcDE","arcEF","arcFA"]);
    var EQA   = HEX.concat(["arcFA","arcDE"]);
    var ADD   = EQA.concat(["ABCD"]);
    var WHOLE = HEX.concat(["FABCD","EDCBA"]);
    var STAND = WHOLE.concat(["angFED"]);
    var STAND2 = STAND.concat(["angAFE"]);
    var ALLANG = HEX.concat(["angAFE","angFED","angA","angB","angC","angD"]);
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "IV.15",
        pivot: "G",
        elements: [
            "A;point;free;150,340",
            "D;point;free;150,140",
            "AD;line;connect;A,D",
            "G;point;midpoint;A,D;black;green",
            "ABCDEF;circle;radius;G,A;0;0;black;random",
            "EGCH;circle;radius;D,G;0;0;black;0",
            "CE;line;bichord;ABCDEF,EGCH;0;0;0",
            "C;point;first;CE",
            "E;point;last;CE",
            "B;point;extend;E,G,E,G",
            "F;point;extend;C,G,C,G",
            "H;point;extend;G,D,G,D;black;0",
            "BE;line;connect;B,E",
            "CF;line;connect;C,F",
            "hexagon;polygon;hexagon;A,B,C,D,E,F;0;0;black;random",
            // Transparent twin of the circle (see above).
            "ABCDEFc;circle;radius;G,A;0;0;0;0",
            "DG;line;connect;D,G;0;0;0",
            // Slide twins of BE and CF, hidden at rest (see above).
            "EG;line;connect;E,G",
            "GB;line;connect;G,B",
            "CG;line;connect;C,G",
            "GF;line;connect;G,F",
            "EB;line;connect;E,B;0;0;0",
            // The six sides and the triangle EGD.
            "AB;line;connect;A,B;0;0;0",
            "BC;line;connect;B,C;0;0;0",
            "CD;line;connect;C,D;0;0;0",
            "DE;line;connect;D,E;0;0;0",
            "EF;line;connect;E,F;0;0;0",
            "FA;line;connect;F,A;0;0;0",
            "EGD;polygon;triangle;E,G,D;0;0;0;0",
            // The circumferences: the six sixths, ABCD, and the two wholes.
            "arcAB;sector;sector;G,A,B;0;0;0;0",
            "arcBC;sector;sector;G,B,C;0;0;0;0",
            "arcCD;sector;sector;G,C,D;0;0;0;0",
            "arcDE;sector;sector;G,D,E;0;0;0;0",
            "arcEF;sector;sector;G,E,F;0;0;0;0",
            "arcFA;sector;sector;G,F,A;0;0;0;0",
            "ABCD;sector;sector;G,A,D;0;0;0;0",
            "FABCD;sector;sector;G,F,D;0;0;0;0",
            "EDCBA;sector;sector;G,A,E;0;0;0;0",
            "angEGD;sector;angleMarker;G,E,D,22;0;0;3b6ea5;9ec5e8",
            "angDGC;sector;angleMarker;G,D,C,22;0;0;3b6ea5;9ec5e8",
            "angCGB;sector;angleMarker;G,C,B,22;0;0;3b6ea5;9ec5e8",
            "angBGA;sector;angleMarker;G,B,A,22;0;0;3b6ea5;9ec5e8",
            "angAGF;sector;angleMarker;G,A,F,22;0;0;3b6ea5;9ec5e8",
            "angFGE;sector;angleMarker;G,F,E,22;0;0;3b6ea5;9ec5e8",
            "angEGC;sector;angleMarker;G,E,C,34;0;0;7a4fa3;cdb8e6",
            "angGDE;sector;angleMarker;D,G,E,22;0;0;3b6ea5;9ec5e8",
            "angDEG;sector;angleMarker;E,D,G,22;0;0;3b6ea5;9ec5e8",
            "angAFE;sector;angleMarker;F,A,E,22;0;0;c06a1b;f3c590",
            "angFED;sector;angleMarker;E,F,D,22;0;0;c06a1b;f3c590",
            "angA;sector;angleMarker;A,F,B,22;0;0;c06a1b;f3c590",
            "angB;sector;angleMarker;B,A,C,22;0;0;c06a1b;f3c590",
            "angC;sector;angleMarker;C,B,D,22;0;0;c06a1b;f3c590",
            "angD;sector;angleMarker;D,C,E,22;0;0;c06a1b;f3c590"
        ],
        // Draggables (checked against the bundle): A and D, free. They are
        // the diameter's ends, which slide 4 draws, so both are deferred;
        // without that the auto-union would stand them, lettered, on the
