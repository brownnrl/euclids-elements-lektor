              highlighted: ["AD"],
              transition: { mode: "cascade", animations: [
                  { elem: "A",  name: geomlib.A.Point.appear },
                  { elem: "AD", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "D",  name: geomlib.A.Point.appear } ] } },
            { text: "Take the center {G} of the circle.",
              visible: CEN,
              highlighted: ["G"],
              transition: { animations: [
                  { elem: "G", name: geomlib.A.Point.appear } ] },
              justifications: [{ ref: "III.1" }] },
            { text: "Describe the circle {EGCH} with center {D} and radius {DG}.",
              visible: SEC,
              highlighted: ["EGCH","DG"],
              transition: { mode: "cascade", animations: [
                  { elem: "EGCH", name: geomlib.A.Circle.compass },
                  { elem: "E",    name: geomlib.A.Point.appear },
                  { elem: "C",    name: geomlib.A.Point.appear },
                  { elem: "H",    name: geomlib.A.Point.appear } ] },
              justifications: [{ ref: "I.Post.3" }] },
            { text: "Join {EG} and {CG} and carry them through to the points {B} and {F}.",
              visible: JOIN,
              highlighted: ["EG","CG","GB","GF"],
              transition: { mode: "cascade", animations: [
                  { elem: "EG", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "CG", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "GB", name: geomlib.A.Line.straightEdgeExtend },
                  { elem: "B",  name: geomlib.A.Point.appear },
                  { elem: "GF", name: geomlib.A.Line.straightEdgeExtend },
                  { elem: "F",  name: geomlib.A.Point.appear } ] },
              justifications: [{ ref: "I.Post.1" }, { ref: "I.Post.2" }] },
            { text: "Join {AB}, {BC}, {CD}, {DE}, {EF}, and {FA}.",
              visible: HEX,
              highlighted: ["AB","BC","CD","DE","EF","FA"],
              transition: { animations: [
