                   "BGA": "angBGA", "AGB": "angBGA",
                   "AGF": "angAGF", "FGA": "angAGF",
                   "FGE": "angFGE", "EGF": "angFGE",
                   "EGC": "angEGC", "CGE": "angEGC",
                   "GDE": "angGDE", "EDG": "angGDE",
                   "DEG": "angDEG", "GED": "angDEG",
                   "FED": "angFED", "DEF": "angFED",
