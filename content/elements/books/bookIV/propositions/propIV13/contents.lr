                  { elem: "FG", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "G",  name: geomlib.A.Point.appear },
                  { elem: "FH", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "H",  name: geomlib.A.Point.appear },
                  { elem: "FK", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "K",  name: geomlib.A.Point.appear },
                  { elem: "FL", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "L",  name: geomlib.A.Point.appear },
                  { elem: "FM", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "M",  name: geomlib.A.Point.appear } ] } },
            { text: "perpendicular to the straight lines {AB}, {BC}, {CD}, {DE}, and {EA}.",
              visible: RT,
              highlighted: ["AB","BC","CD","DE","EA","rtG","rtH","rtK","rtL","rtM"],
              transition: { mode: "parallel", animations: [
                  { elem: "rtG", name: geomlib.A.Sector.sweep },
                  { elem: "rtH", name: geomlib.A.Sector.sweep },
                  { elem: "rtK", name: geomlib.A.Sector.sweep },
                  { elem: "rtL", name: geomlib.A.Sector.sweep },
                  { elem: "rtM", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "perpendiculars from F to the five sides", ref: "I.12" }] },
            { text: "Then, since the angle {HCF} equals the angle {KCF},",
              visible: EQ,
