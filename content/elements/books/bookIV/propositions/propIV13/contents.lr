              visible: EQ,
              highlighted: ["FC","rtH","rtK"] },
            { text: "therefore they also have the remaining sides equal to the remaining sides.",
              visible: EQ,
              highlighted: ["FHC","FKC"],
              justifications: [{ claim: "two angles and a side opposite one of them", ref: "I.26" }] },
            { text: "Therefore the perpendicular {FH} equals the perpendicular {FK}.",
              visible: EQ,
              highlighted: ["FH","FK"] },
            { text: "Similarly it can be proved that each of the straight lines {FL}, {FM}, and {FG}",
              visible: RT,
              highlighted: ["FL","FM","FG"] },
            { text: "also equals each of the straight lines {FH} and {FK},",
              visible: RT,
              highlighted: ["FL","FM","FG","FH","FK"] },
            { text: "therefore the five straight lines {FG}, {FH}, {FK}, {FL}, and {FM} equal one another.",
              visible: RT,
              highlighted: ["FG","FH","FK","FL","FM"] },
            { text: "Therefore the circle described with center {F} and radius one of the straight lines {FG}, {FH}, {FK}, {FL}, or {FM}",
              visible: HYP,
              highlighted: ["circT","F"],
              transition: { animations: [
                  { elem: "circT", name: geomlib.A.Circle.compass } ] } },
            { text: "also passes through the remaining points,",
              visible: HYP,
              highlighted: ["circT","G","H","K","L","M"] },
            { text: "and it touches the straight lines {AB}, {BC}, {CD}, {DE}, and {EA},",
              visible: HYP,
              highlighted: ["circT","AB","BC","CD","DE","EA"] },
            { text: "because the angles at the points {G}, {H}, {K}, {L}, and {M} are right.",
              visible: HYP,
              highlighted: ["rtG","rtH","rtK","rtL","rtM"] },
            { text: "For, if it does not touch them. but cuts them,",
              visible: HYP,
              highlighted: ["circT","AB","BC","CD","DE","EA"] },
            { text: "it will result that the straight line drawn at right angles to the diameter of the circle from its end",
              visible: HYP,
              highlighted: ["circT"] },
            { text: "falls within the circle, which was proved absurd.",
              visible: HYP,
              highlighted: ["circT"],
              justifications: [{ claim: "the line at right angles to a diameter at its end falls outside", ref: "III.16" }] },
            { text: "Therefore the circle described with center {F} and radius one of the straight lines {FG}, {FH}, {FK}, {FL}, or {FM}",
              visible: HYP,
              highlighted: ["circT","F"] },
            { text: "does not cut the straight lines {AB}, {BC}, {CD}, {DE}, and {EA}. Therefore it touches them.",
              visible: HYP,
              highlighted: ["circT","AB","BC","CD","DE","EA"] },
            { text: "Let it be described, as {GHKLM}.",
              visible: DONE,
              highlighted: ["circ"],
              transition: { animations: [
                  { elem: "circ", name: geomlib.A.Circle.compass } ] } },
            { text: "Therefore a circle has been inscribed in the given equilateral and equiangular pentagon.",
              visible: DONE,
              highlighted: ["circ","AB","BC","CD","DE","EA"],
              justifications: [
                  { claim: "the circumference touches each side", ref: "IV.Def.5" },
                  { ref: "Q.E.F." } ] }
        ],
        resolveJustification: function(ref) {
            if (ref === "IV.13") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
