            "angCBA;sector;angleMarker;B,C,A,32;0;0;7a4fa3;cdb8e6",
            "angBAE;sector;angleMarker;A,B,E,32;0;0;7a4fa3;cdb8e6",
            "angAED;sector;angleMarker;E,A,D,32;0;0;7a4fa3;cdb8e6",
            "angFCD;sector;angleMarker;C,F,D,20;0;0;3b6ea5;9ec5e8",
            "angCDF;sector;angleMarker;D,C,F,20;0;0;3b6ea5;9ec5e8"
