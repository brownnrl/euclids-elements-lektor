            { text: "Let it be circumscribed, and let it be {ABCDE|circ}.",
              visible: DONE,
              highlighted: ["circ"],
              transition: { animations: [
                  { elem: "circ", name: geomlib.A.Circle.compass } ] } },
            { text: "Therefore a circle has been circumscribed about the given equilateral and equiangular pentagon.",
              visible: DONE,
              highlighted: ["circ","A","B","C","D","E"],
