sections:

#### prop_section ####
kind: proposition
----
----
statement: To circumscribe a circle about a given triangle.
----
----
proof:

Let {ABC} be the given triangle.

It is required to circumscribe a circle about the given triangle {ABC}.

<figure class="diagram">
<canvas id="canvas_0" width="250" height="230" tabindex="0"></canvas>
<noscript><img alt="IV.5a diagram" src="propIV5a.gif"/></noscript>
<script type="text/javascript">
    // First case, F within the triangle. The two bisections, the two
    // perpendiculars at D and E, the joins from F, the I.4 argument on the
    // halves at D ("similarly" at E), and the circle.
    //
    // Everything added leaves the resting figure as it was. The sides AB,
    // AC, BC and the halves AD, DB, AE, EC are transparent highlight
    // targets. The right angles at D and E (two at each, one for each
    // triangle of the I.4 argument) are red squares, pinned small side by
    // side. angBAC is for the corollary's hover only; no slide shows it.
    var GIVEN = ["triABC","A","B","C","AB","AC","BC"];
    var BIS   = GIVEN.concat(["D","E","AD","DB","AE","EC"]);
    var PERP  = BIS.concat(["DF","EF","rtADF","rtAEF"]);
    var MEET  = PERP.concat(["F"]);
    var JOIN  = MEET.concat(["BF","CF","AF"]);
    var HALF1 = JOIN.concat(["rtBDF"]);
    var HALF2 = HALF1.concat(["rtCEF"]);
    var CIRC  = HALF2.concat(["circABC","circABCo"]);
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "IV.5a",
        pivot: "F",
        elements: [
            "A;point;free;140,40",
            "B;point;free;50,180",
            "C;point;free;200,180",
            "circABC;circle;circumcircle;A,B,C;0;0;black;random",
            "triABC;polygon;triangle;A,B,C;0;0;black;random",
            "D;point;midpoint;A,B",
            "E;point;midpoint;A,C",
            "F;point;center;circABC;black;green",
            "AF;line;connect;A,F",
            "BF;line;connect;B,F",
            "CF;line;connect;C,F",
            "DF;line;connect;D,F",
            "EF;line;connect;E,F",
            // A faceless twin of the circle for highlights and hovers: the
            // circle's own face is under the triangle at rest, and would
            // cover it if a highlight promoted it.
            "circABCo;circle;circumcircle;A,B,C;0;0;0;0",
            // The sides and the halves the proof argues over.
            "AB;line;connect;A,B;0;0;0",
            "AC;line;connect;A,C;0;0;0",
            "BC;line;connect;B,C;0;0;0",
            "AD;line;connect;A,D;0;0;0",
            "DB;line;connect;D,B;0;0;0",
            "AE;line;connect;A,E;0;0;0",
            "EC;line;connect;E,C;0;0;0",
            "rtADF;sector;angleMarkerRight;D,A,F,12;0;0;red;red",
            "rtBDF;sector;angleMarkerRight;D,B,F,12;0;0;red;red",
            "rtAEF;sector;angleMarkerRight;E,A,F,12;0;0;red;red",
            "rtCEF;sector;angleMarkerRight;E,C,F,12;0;0;red;red",
            "angBAC;sector;angleMarker;A,B,C;0;0;3b6ea5;9ec5e8"
        ],
        // Draggables (checked against the bundle): A, B, C, free; they are
        // the given triangle and stand from slide 1. D, E (midpoint) and F
        // (center) are derived and listed per slide. Nothing to defer.
        //
        // The triangle owns ABC in prose; the circle takes {ABC|circABCo}.
        aliases: { "ABC": "triABC", "BA": "AB", "CA": "AC", "CB": "BC",
                   "BD": "DB", "CE": "EC",
                   "FA": "AF", "FB": "BF", "FC": "CF",
                   "FD": "DF", "FE": "EF" },
        slides: [
            { text: "“To circumscribe a circle about a given triangle.”",
              visible: GIVEN,
              highlighted: ["triABC"],
              justifications: [{ ref: "IV.5" }] },
            { text: "Let {ABC} be the given triangle.",
              visible: GIVEN,
              highlighted: ["triABC"] },
            { text: "It is required to circumscribe a circle about the given triangle {ABC}.",
              visible: GIVEN,
              highlighted: ["triABC"] },
            { text: "Bisect the straight lines {AB} and {AC} at the points {D} and {E}.",
              visible: BIS,
              highlighted: ["AB","AC","D","E"],
              transition: { mode: "parallel", animations: [
                  { elem: "D", name: geomlib.A.Point.appear },
                  { elem: "E", name: geomlib.A.Point.appear } ] },
              justifications: [{ claim: "AB and AC bisected at D and E", ref: "I.10" }] },
            { text: "Draw {DF} and {EF} from the points {D} and {E} at right angles to {AB} and {AC}.",
              visible: PERP,
              highlighted: ["DF","EF"],
              transition: { mode: "cascade", animations: [
                  { elem: "DF",    name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "rtADF", name: geomlib.A.Sector.sweep },
                  { elem: "EF",    name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "rtAEF", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "at right angles to AB and AC", ref: "I.11" }] },
            { text: "They will then meet within the triangle {ABC}, or on the straight line {BC}, or outside {BC}.",
              visible: PERP,
              highlighted: ["triABC","BC"] },
            { text: "First let them meet within at {F}.",
              visible: MEET,
              highlighted: ["DF","EF","F"],
              transition: { animations: [
                  { elem: "F", name: geomlib.A.Point.appear } ] } },
            { text: "Join {FB}, {FC}, and {FA}.",
              visible: JOIN,
              highlighted: ["BF","CF","AF"],
              transition: { mode: "cascade", animations: [
                  { elem: "BF", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "CF", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "AF", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Then, since {AD} equals {DB}, and {DF} is common and at right angles,",
              visible: HALF1,
              highlighted: ["AD","DB","DF","rtADF","rtBDF"],
              transition: { animations: [
                  { elem: "rtBDF", name: geomlib.A.Sector.sweep } ] } },
            { text: "therefore the base {AF} equals the base {FB}.",
              visible: HALF1,
              highlighted: ["AF","BF"],
              justifications: [{ claim: "two sides and the included angle", ref: "I.4" }] },
            { text: "Similarly we can prove that {CF} also equals {AF},",
              visible: HALF2,
              highlighted: ["CF","AF","AE","EC","EF","rtAEF","rtCEF"],
              transition: { animations: [
                  { elem: "rtCEF", name: geomlib.A.Sector.sweep } ] } },
            { text: "so that {FB} also equals {FC},",
              visible: HALF2,
              highlighted: ["BF","CF"],
              justifications: [{ claim: "each equals AF", ref: "C.N.1" }] },
            { text: "therefore the three straight lines {FA} and {FB} and {FC} equal one another.",
              visible: HALF2,
              highlighted: ["AF","BF","CF"] },
            { text: "Therefore the circle described with center {F} and radius one of the straight lines {FA}, {FB}, or {FC}",
              visible: CIRC,
              highlighted: ["F","AF"],
              transition: { animations: [
                  { elem: "circABC", name: geomlib.A.Circle.compass } ] } },
            { text: "also passes through the remaining points, and the circle is circumscribed about the triangle {ABC}.",
              visible: CIRC,
              highlighted: ["circABCo","A","B","C"],
              justifications: [{ claim: "the circle passes through each angle of ABC", ref: "IV.Def.6" }] },
            { text: "Let it be circumscribed as {ABC|circABCo}.",
              visible: CIRC,
              highlighted: ["circABCo"] }
        ],
        resolveJustification: function(ref) {
            if (ref === "IV.5") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "C.N.1":    "/elements/books/bookI/commonnotions/cn1/",
        "I.4":      "/elements/books/bookI/propositions/propI4/",
        "I.10":     "/elements/books/bookI/propositions/propI10/",
        "I.11":     "/elements/books/bookI/propositions/propI11/",
        "IV.Def.6": "/elements/books/bookIV/definitions/defIV6/"
    });
</script>
</figure>

Bisect the straight lines {AB} and {AC} at the points {D} and {E}. Draw {DF} and {EF} from the points {D} and {E} at right angles to {AB} and {AC}. They will then meet within the triangle {ABC}, or on the straight line {BC}, or outside {BC}. [!just I.10; I.11]

First let them meet within at {F}. Join {FB}, {FC}, and {FA}.

Then, since {AD} equals {DB}, and {DF} is common and at right angles, therefore the base {AF} equals the base {FB}. [!just I.4]

Similarly we can prove that {CF} also equals {AF}, so that {FB} also equals {FC}, therefore the three straight lines {FA} and {FB} and {FC} equal one another.

