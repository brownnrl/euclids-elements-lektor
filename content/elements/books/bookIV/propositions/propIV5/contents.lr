            "circABCo;circle;radius;F,B;0;0;0;0",
            // The two sides the perpendiculars stand on.
            "AB;line;connect;A,B;0;0;0",
            "AC;line;connect;A,C;0;0;0",
            "rtADF;sector;angleMarkerRight;D,A,F;0;0;red;red",
            "rtAEF;sector;angleMarkerRight;E,A,F;0;0;red;red",
            "angBAC;sector;angleMarkerRight;A,B,C;0;0;red;red"
        ],
        // Draggables (checked against the bundle): B, C, free, and A, a
        // circleSlider on the circle; all three are the given triangle and
        // stand from slide 1. F, D, E (midpoint) are derived and listed per
        // slide. Nothing to defer.
        aliases: { "ABC": "triABC", "FA": "AF", "FD": "DF", "FE": "EF",
                   "CB": "BC" },
        slides: [
            { text: "Next, let {DF} and {EF} meet on the straight line {BC} at {F},",
              visible: PERP1,
              highlighted: ["DF","EF","BC","F"],
              transition: { mode: "cascade", animations: [
                  { elem: "DF",    name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "rtADF", name: geomlib.A.Sector.sweep },
                  { elem: "EF",    name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "rtAEF", name: geomlib.A.Sector.sweep },
                  { elem: "F",     name: geomlib.A.Point.appear } ] } },
            { text: "as is the case in the second figure.",
              visible: PERP1,
              highlighted: ["triABC","F"] },
            { text: "Join {AF}.",
              visible: JOIN1,
              highlighted: ["AF"],
              transition: { animations: [
                  { elem: "AF", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Then, similarly, we can prove that the point {F} is the center of the circle circumscribed about the triangle {ABC}.",
              visible: CIRC1,
              highlighted: ["F","circABCo"],
              transition: { animations: [
                  { elem: "circABC", name: geomlib.A.Circle.compass } ] } }
        ],
        resolveJustification: function(ref) {
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
