            { text: "“and from the point of contact a straight line is drawn at right angles to the tangent,”",
              visible: GIVEN,
              highlighted: [] },
            { text: "“the center of the circle will be on the straight line so drawn.”",
              visible: GIVEN,
              highlighted: [],
              justifications: [{ ref: "III.19" }] },
            { text: "For let a straight line {DE} touch the circle {ABC} at the point {C}.",
