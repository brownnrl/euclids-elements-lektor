              highlighted: ["C", "DE", "A", "AC", "angACE"],
              transition: { mode: "cascade", animations: [
                  { elem: "A",      name: geomlib.A.Point.appear },
                  { elem: "AC",     name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "angACE", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "CA at right angles to DE", ref: "I.11" }] },
            { text: "I say that the center of the circle is on {AC}.",
              visible: PERP,
              highlighted: ["AC","ABC"] },
            { text: "For suppose it is not, but, if possible, let {F} be the center, and join {CF}.",
              visible: SUPP,
              highlighted: [],
              transition: { mode: "cascade", animations: [
                  { elem: "F",  name: geomlib.A.Point.appear },
                  { elem: "CF", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ ref: "I.Post.1" }] },
            // His III.18 step is two sentences; the marker lands with the
            // second.
            { text: "Since a straight line {DE} touches the circle {ABC}, and {FC} has been joined from the center to the point of contact, {FC} is perpendicular to {DE}.",
              visible: SUPP,
              highlighted: ["DE","ABC","CF"],
              justifications: [{ claim: "FC perpendicular to DE", ref: "III.18" }] },
            { text: "Therefore the angle {FCE} is right.",
              visible: RT,
              highlighted: [],
              transition: { animations: [
                  { elem: "angFCE", name: geomlib.A.Sector.sweep } ] } },
            { text: "But the angle {ACE} is also right, therefore the angle {FCE} equals the angle {ACE}, the less equals the greater, which is impossible.",
              visible: RT,
              highlighted: ["angACE","angFCE"],
              justifications: [{ claim: "all right angles are equal", ref: "I.Post.4" }] },
            { text: "Therefore {F} is not the center of the circle {ABC}.",
              visible: RT,
              highlighted: ["F","ABC"] },
            { text: "Similarly we can prove that neither is any other point except a point on {AC}.",
              visible: RT,
              highlighted: ["AC"] },
            { text: "Therefore if a straight line touches a circle, and from the point of contact a straight line is drawn at right angles to the tangent, the center of the circle will be on the straight line so drawn.",
              visible: RT,
              highlighted: ["DE","AC","ABC"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "III.19") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "I.Post.1": "/elements/books/bookI/postulates/post1/",
        "I.Post.4": "/elements/books/bookI/postulates/post4/",
