<canvas id="canvas_0" width="270" height="250" tabindex="0"></canvas>
<noscript><img alt="III.19 diagram" src="propIII19.gif"/></noscript>
<script type="text/javascript">
    // The converse of III.18, by reductio: a center F off the perpendicular
    // CA would make FCE a right angle inside the right angle ACE. Joyce's
    // figure draws F and CF; the walk brings them on with their sentence.
    //
    // Only two angle markers are added, both right angles in red: ACE, the
    // constructed one, and FCE, the one III.18 forces. Both sit at C and
    // share the arm CE; auto radius-stepping nests FCE inside ACE. Nothing
    // else is added, so the static figure is unchanged. O, the midpoint
    // that centers Joyce's circle, is colourless in his figure and stays
    // out of every slide set.
    var GIVEN = ["D","E","DE","ABC","C","B"];
    var PERP  = GIVEN.concat(["A","AC","angACE"]);
    var SUPP  = PERP.concat(["F","CF"]);
    var RT    = SUPP.concat(["angFCE"]);
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "III.19",
        elements: [
            "D;point;free;40,220",
