        ],
        // Draggable, checked against the bundle: D, E, C, A, B, F. A is the
        // end of the perpendicular the second sentence draws and F the
        // supposed center, so both are deferred to follow `visible`. D, E
        // and C are the given tangent and its point of contact; B is a
        // letter of the given circle. O (midpoint) is derived and never
        // drawn. The resting figure is unaffected.
        deferDraggables: ["A","F"],
        aliases: { "CA": "AC", "FC": "CF", "ED": "DE",
                   "ACE": "angACE", "ECA": "angACE",
                   "FCE": "angFCE", "ECF": "angFCE" },
        slides: [
            // The deck opens on the proposition's statement over the givens
            // (process.md “Open on the statement”), split at its seams.
            { text: "“If a straight line touches a circle,”",
