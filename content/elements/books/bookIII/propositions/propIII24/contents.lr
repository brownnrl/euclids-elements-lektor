title: Proposition 24
---
order: 24
---
short_label: III.24
---
sections:

#### prop_section ####
kind: proposition
----
statement: Similar segments of circles on equal straight lines equal one another.
----
proof:

Let *AEB* and *CFD* be similar segments of circles on equal straight lines *AB* and *CD.*

I say that the segment *AEB* equals the segment *CFD.*

<figure class="diagram">
<canvas id="canvas_0" width="350" height="110" tabindex="0"></canvas>
<noscript><img alt="III.24 diagram" src="propIII24.gif"/></noscript>
<script type="text/javascript">
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "III.24",
        elements: [
            "A;point;free;40,80",
            "B;point;free;160,80",
            "AB;line;connect;A,B",
            "E;point;free;90,30;black;0",
            "BEA;sector;arc;B,E,A;0;0;black;0",
            "C;point;free;190,80",
            "Ccirc;circle;radius;C,AB;0;0;0;0",
            "D;point;circleSlider;Ccirc,310,80",
            "CD;line;connect;C,D",
            "F';point;similar;C,D,A,B,E;0;0",
            "CF'G;circle;circumcircle;D,F',C;0;0;0;0",
            "F;point;circleSlider;CF'G,230,35;black;0",
            "DFC;sector;arc;D,F,C;0;0;black;0",
            "G;point;circleSlider;CF'G,270,40",
            "GCH;polygon;equilateralTriangle;G,C;0;0;0;0",
            "H;point;vertex;GCH,3;0;0",
            "GC;sector;sector;H,G,C;0;0;black;0",
            "M;point;midpoint;D,G;0;0",
            "M';point;perpendicular;M,D;0;0",
            "K;point;intersection;M,M',H,G;0;0",
            "DG;sector;sector;K,D,G;0;0;black;0"
        ],
