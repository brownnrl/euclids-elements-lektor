---
title: Proposition 26
---
order: 26
---
short_label: III.26
---
sections:

#### prop_section ####
kind: proposition
----
statement: In equal circles equal angles stand on equal circumferences whether they stand at the centers or at the circumferences.
----
proof:

Let {ABC|ABCc} and {DEF|DEFc} be equal circles, and in them let there be equal angles, namely at the centers the angles {BGC} and {EHF}, and at the circumferences the angles {BAC|angBAC} and {EDF|angEDF}.

I say that the circumference {BKC} equals the circumference {ELF}.

<figure class="diagram">
<canvas id="canvas_0" width="465" height="240" tabindex="0"></canvas>
<noscript><img alt="III.26 diagram" src="propIII26.gif"/></noscript>
<script type="text/javascript">
    // Joyce's figure draws the two circles, the central angles as filled
    // sectors (GBC, HEF), the angles at the circumference as filled
    // triangles (triABC, triDEF), and K, L as bare labels on the lower arcs.
    // It does not draw the chords BC / EF as their own lines, the
    // circumferences BKC / ELF, the segments BAC / EDF, or the angles at A
    // and D as angles. Everything added here is fully transparent (;0;0;0
    // lines, ;0;0;0;0 sectors / circles) or an angle marker (hidden in the
    // static figure), so the resting figure is unchanged.
    //
    // The two circles ABC and DEF are 4-field elements as converted — no
    // colour fields, so an opaque near-white default face. They are left
    // exactly as they are (the resting figure is Joyce's) and NEVER named in
    // a highlighted set or a prose ref: a highlighted element is promoted
    // within its draw pass (#140), and the white disc would cover the
    // sectors and triangles. The transparent twins ABCc / DEFc carry the
    // name for highlight and hover ({ABC|ABCc}); the originals appear only in
    // `visible`, where they draw as they always did.
    //
    // Arcs: GBC (G,B,C) draws the minor arc, so BKC / ELF take the same arm
    // order; the segments BAC / EDF want the major arc through A / D, which
    // is the reversed order (never swept — euclid#172).
    var CIRC = ["G","A","ABC","B","C","H","DEF","D","E","F","ABCc","DEFc"];
    var ANG  = CIRC.concat(["GB","GC","HE","HF","GBC","HEF","AB","triABC","triDEF",
                            "angBAC","angEDF"]);
    var ARCS = ANG.concat(["K","L","BKC","ELF"]);
    var JOIN = ARCS.concat(["BC","EF"]);
    var SEG  = JOIN.concat(["segBAC","segEDF"]);
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "III.26",
        elements: [
            "G;point;free;120,115",
            "A;point;free;75,30",
            "ABC;circle;radius;G,A",
            "B;point;circleSlider;ABC,60,190",
            "C;point;circleSlider;ABC,180,190",
            "H;point;free;340,115",
            "DEF;circle;radius;H,G,A",
            "D;point;circleSlider;DEF,380,100",
            "E;point;circleSlider;DEF,280,190",
            "F;point;similar;H,E,G,B,C",
            "AB;line;connect;A,B",
            "triABC;polygon;triangle;A,B,C;0;0;black;random",
            "triDEF;polygon;triangle;D,E,F;0;0;black;random",
            "GBC;sector;sector;G,B,C;0;0;0;random",
            "HEF;sector;sector;H,E,F;0;0;0;random",
            "GB;line;connect;G,B",
            "GC;line;connect;G,C",
            "HF;line;connect;H,F",
            "HE;line;connect;H,E",
            "K;point;circleSlider;ABC,120,210;black;0",
            "L;point;circleSlider;DEF,340,210;black;0",
            // Transparent twins of the two 4-field circles (see above).
            "ABCc;circle;radius;G,A;0;0;0;0",
            "DEFc;circle;radius;H,G,A;0;0;0;0",
            // The chords the proof joins; the triangles already draw them.
            "BC;line;connect;B,C;0;0;0",
            "EF;line;connect;E,F;0;0;0",
            // The circumferences BKC and ELF (minor arcs, same arms as the
            // sectors) and the segments BAC and EDF (the major arcs).
            "BKC;sector;sector;G,B,C;0;0;0;0",
            "ELF;sector;sector;H,E,F;0;0;0;0",
            "segBAC;sector;sector;G,C,B;0;0;0;0",
            "segEDF;sector;sector;H,F,E;0;0;0;0",
            // The angles at the circumference.
            "angBAC;sector;angleMarker;A,B,C",
            "angEDF;sector;angleMarker;D,E,F"
        ],
        // K and L are circleSliders, so they would stand lettered on the
        // canvas from slide 1; the proof names them only at "I say that".
        // The other draggables (G, A, B, C, H, D, E) are givens of slide 1.
        deferDraggables: ["K","L"],
        aliases: { "BGC": "GBC", "EHF": "HEF", "BG": "GB", "CG": "GC",
                   "EH": "HE", "FH": "HF", "CB": "BC", "FE": "EF", "BA": "AB" },
        slides: [
            // The deck opens on the proposition's statement over the givens
            // (process.md “Open on the statement”).
            { text: "In equal circles equal angles stand on equal circumferences whether they stand at the centers or at the circumferences.",
              visible: CIRC,
              highlighted: [],
              justifications: [{ ref: "III.26" }] },
            { text: "Let {ABC|ABCc} and {DEF|DEFc} be equal circles,",
              visible: CIRC,
              highlighted: ["ABCc","DEFc"] },
            { text: "and in them let there be equal angles, namely at the centers the angles {BGC} and {EHF}, and at the circumferences the angles {BAC|angBAC} and {EDF|angEDF}.",
              visible: ANG,
              highlighted: ["GBC", "HEF", "triABC", "angBAC", "triDEF", "angEDF"],
              transition: { mode: "cascade", animations: [
                  { elem: "GBC",    name: geomlib.A.Sector.sweep },
                  { elem: "HEF",    name: geomlib.A.Sector.sweep },
                  { elem: "triABC", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "angBAC", name: geomlib.A.Sector.sweep },
                  { elem: "triDEF", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "angEDF", name: geomlib.A.Sector.sweep } ] } },
            { text: "I say that the circumference {BKC} equals the circumference {ELF}.",
              visible: ARCS,
              highlighted: ["BKC","ELF"] },
            { text: "Join {BC} and {EF}.",
              visible: JOIN,
              highlighted: [],
              transition: { mode: "cascade", animations: [
                  { elem: "BC", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "EF", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ ref: "I.Post.1" }] },
            { text: "Now, since the circles {ABC|ABCc} and {DEF|DEFc} are equal, the radii are equal.",
              visible: JOIN,
              highlighted: ["ABCc","DEFc","GB","GC","HE","HF"] },
            { text: "Thus the two straight lines {BG} and {GC} equal the two straight lines {EH} and {HF}, and the angle at {G|GBC} equals the angle at {H|HEF},",
              visible: JOIN,
              highlighted: ["GB","GC","HE","HF","GBC","HEF"] },
            { text: "therefore the base {BC} equals the base {EF}.",
              visible: JOIN,
              highlighted: ["BC","EF"],
              justifications: [{ claim: "two sides and the included angle", ref: "I.4" }] },
            { text: "And, since the angle at {A|angBAC} equals the angle at {D|angEDF}, the segment {BAC|segBAC} is similar to the segment {EDF|segEDF}, and they are upon equal straight lines.",
              visible: SEG,
              highlighted: ["angBAC","angEDF","segBAC","segEDF","BC","EF"],
              justifications: [{ claim: "similar segments admit equal angles", ref: "III.Def.11" }] },
            { text: "But similar segments of circles on equal straight lines equal one another, therefore the segment {BAC|segBAC} equals {EDF|segEDF}.",
              visible: SEG,
              highlighted: ["segBAC","segEDF"],
              justifications: [{ ref: "III.24" }] },
            { text: "But the whole circle {ABC|ABCc} also equals the whole circle {DEF|DEFc}, therefore the remaining circumference {BKC} equals the circumference {ELF}.",
              visible: SEG,
              highlighted: ["ABCc","DEFc","BKC","ELF"] },
            { text: "Therefore in equal circles equal angles stand on equal circumferences whether they stand at the centers or at the circumferences.",
              visible: SEG,
              highlighted: ["GBC","HEF","angBAC","angEDF","BKC","ELF"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "III.26") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "I.Post.1":   "/elements/books/bookI/postulates/post1/",
        "I.4":        "/elements/books/bookI/propositions/propI4/",
        "III.Def.11": "/elements/books/bookIII/definitions/defIII11/",
        "III.24":     "/elements/books/bookIII/propositions/propIII24/"
    });
</script>
</figure>

Join {BC} and {EF}.

Now, since the circles {ABC|ABCc} and {DEF|DEFc} are equal, the radii are equal.

Thus the two straight lines {BG} and {GC} equal the two straight lines {EH} and {HF}, and the angle at {G|GBC} equals the angle at {H|HEF}, therefore the base {BC} equals the base {EF}. [!just I.4]

And, since the angle at {A|angBAC} equals the angle at {D|angEDF}, the segment {BAC|segBAC} is similar to the segment {EDF|segEDF}, and they are upon equal straight lines. [!just III.Def.11]

But similar segments of circles on equal straight lines equal one another, therefore the segment {BAC|segBAC} equals {EDF|segEDF}.  But the whole circle {ABC|ABCc} also equals the whole circle {DEF|DEFc}, therefore the remaining circumference {BKC} equals the circumference {ELF}. [!just III.24]

Therefore *in equal circles equal angles stand on equal circumferences whether they stand at the centers or at the circumferences.*

<div class="qed">Q.E.D.</div>
