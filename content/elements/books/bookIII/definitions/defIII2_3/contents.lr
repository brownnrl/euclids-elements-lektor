<script type="text/javascript">
    geomlib.init({
        canvasid: "canvas_1",
        background: "0,0,100",
        title: "III.Def.2-3",
        pivot: "A",
        elements: [
            "A;point;free;135,125;black;green",
            "B;point;free;135,30",
