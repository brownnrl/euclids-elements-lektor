            "C;point;extend;B,A,B,A",
            "D;point;circleSlider;Acirc,40,40",
            "E;point;perpendicular;C,A",
            "F;point;extend;E,C,E,C",
            "EF;line;connect;E,F",
            "G;point;free;295,125",
            "H;point;cutoff;A,G,A,B",
            "Gcirc;circle;radius;G,H;0;0;black;random",
            "K;point;circleSlider;Gcirc,230,30",
            "L;point;extend;K,G,K,G",
            "M;point;lineSlider;A,D,110,110",
            "X;point;midpoint;D,M;0;0",
