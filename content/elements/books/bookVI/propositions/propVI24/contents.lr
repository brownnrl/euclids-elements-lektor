            "AC;line;connect;A,C",
            "F;point;lineSlider;A,C,120,120",
            "G';point;parallelogram;A,B,F;0;0",
            "G;point;intersection;A,D,F,G'",
            "E;point;parallelogram;A,G,F",
            "AGFE;polygon;quadrilateral;A,G,F,E;0;0;black;random",
