              highlighted: ["angAGB","angF"],
              transition: { animations: [
                  { elem: "angAGB", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "the angles of a triangle sum to two right angles", ref: "I.32" }] },
            { text: "Therefore the triangle {ABG} is equiangular with the triangle {DEF|DEFt}.",
              visible: REM,
              highlighted: ["ABG","DEFt"] },
            { text: "Therefore {AB} is to {BG} as {DE} is to {EF}.",
              visible: REM,
              highlighted: ["AB","BG","DE","EF"],
              justifications: [{ claim: "AB : BG = DE : EF", ref: "VI.4" }] },
            { text: "But, by hypothesis, {DE} is to {EF} as {AB} is to {BC},",
              visible: REM,
              highlighted: ["DE","EF","AB","BC"] },
            { text: "therefore {AB} has the same ratio to each of the straight lines {BC} and {BG}.",
