              highlighted: ["AB","BC","BG"],
              justifications: [{ claim: "AB : BC = AB : BG", ref: "V.11" }] },
            { text: "Therefore {BC} equals {BG},",
              visible: REM,
              highlighted: ["BC","BG"],
              justifications: [{ claim: "BC = BG", ref: "V.9" }] },
            { text: "so that the angle at {C|angC} also equals the angle {BGC|angBGC}.",
