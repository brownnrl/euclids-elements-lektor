              highlighted: ["angC","angBGC"],
              transition: { animations: [
                  { elem: "angBGC", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "base angles of the isosceles triangle BGC", ref: "I.5" }] },
            { text: "But, by hypothesis, the angle at {C|angC} is less than a right angle,",
              visible: ISO,
              highlighted: ["angC"] },
            { text: "therefore the angle {BGC|angBGC} is also less than a right angle,",
              visible: ISO,
              highlighted: ["angBGC"] },
            { text: "so that the angle {AGB|angAGB} adjacent to it is greater than a right angle.",
              visible: ISO,
              highlighted: ["angAGB","angBGC"],
              justifications: [{ claim: "angle AGB + angle BGC = 2rt", ref: "I.13" }] },
            { text: "And it was proved equal to the angle at {F|angF},",
              visible: ISO,
              highlighted: ["angAGB","angF"] },
            { text: "therefore the angle at {F|angF} is also greater than a right angle.",
              visible: ISO,
              highlighted: ["angF"] },
            { text: "But it is by hypothesis less than a right angle, which is absurd.",
              visible: ISO,
              highlighted: ["angF"] },
            // The supposed construction is withdrawn.
            { text: "Therefore the angle {ABC|angABC} is not unequal to the angle {DEF|angDEF}. Therefore it equals it.",
              visible: ACUTE,
              highlighted: ["angABC","angDEF"] },
            { text: "But the angle at {A|angA} also equals the angle at {D|angD},",
              visible: ACUTE,
              highlighted: ["angA","angD"] },
            { text: "therefore the remaining angle at {C|angC} equals the remaining angle at {F|angF}.",
              visible: ACUTE,
              highlighted: ["angC","angF"],
              justifications: [{ claim: "the angles of a triangle sum to two right angles", ref: "I.32" }] },
            { text: "Therefore the triangle {ABC|ABCt} is equiangular with the triangle {DEF|DEFt}.",
              visible: ACUTE,
              highlighted: ["ABCt","DEFt"] }
        ],
        resolveJustification: function(ref) {
            if (ref === "VI.7") return "#prop";
