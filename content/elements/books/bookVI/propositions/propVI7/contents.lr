                   "CBA": "angABC", "FED": "angDEF", "GBA": "angABG",
                   "CGB": "angBGC" },
        slides: [
            { text: "Next let each of the angles at {C|angC} and {F|angF} be supposed not less than a right angle.",
              visible: OBT,
              highlighted: ["angC","angF"],
