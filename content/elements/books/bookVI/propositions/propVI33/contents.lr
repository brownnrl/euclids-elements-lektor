              visible: EQ,
              highlighted: ["angBGC","angCGK","angKGL"],
              transition: { mode: "parallel", animations: [
                  { elem: "angCGK", name: geomlib.A.Sector.sweep },
                  { elem: "angKGL", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "equal circumferences, equal angles", ref: "III.27" }] },
            { text: "Therefore, whatever multiple the circumference {BL} is of {BC},",
              visible: MULT,
              highlighted: ["BL","BC"] },
            { text: "the angle {BGL|angBGL} is also that multiple of the angle {BGC|angBGC}.",
              visible: MULT,
