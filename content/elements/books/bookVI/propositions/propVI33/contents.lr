                  { elem: "GL",  name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "HM",  name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "HN",  name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "GCK", name: geomlib.A.Sector.sweep },
                  { elem: "GKL", name: geomlib.A.Sector.sweep },
                  { elem: "HFM", name: geomlib.A.Sector.sweep },
                  { elem: "HMN", name: geomlib.A.Sector.sweep } ] },
