            "L;line;connect;L1,L2;black",
            "M0;point;free;90,-1000;0;0",
            "M3;point;free;90,1000;0;0",
            "M1;point;lineSlider;M0,M3,0,50;0",
            "M2;point;proportion;D,C,C,E,L1,L2,M1,M3;0",
            "M;line;connect;M1,M2;black",
            // Slide twins, hidden at rest (see above).
            "DH;line;connect;D,H",
            "GH;line;connect;G,H",
            // Transparent highlight targets; explicit ;0 faces.
            "AC;polygon;quadrilateral;A,B,C,D;0;0;0;0",
            "CF;polygon;quadrilateral;F,E,C,G;0;0;0;0",
            "CH;polygon;quadrilateral;D,C,G,H;0;0;0;0",
            "BC;line;connect;B,C;0;0;0",
            "CG;line;connect;C,G;0;0;0",
            "DC;line;connect;D,C;0;0;0",
            "CE;line;connect;C,E;0;0;0",
            "angBCD;sector;angleMarker;C,B,D,20;0;0;3b6ea5;9ec5e8",
            "angECG;sector;angleMarker;C,E,G,20;0;0;3b6ea5;9ec5e8"
        ],
        deferDraggables: ["H","K1","K2","L1","M1"],
        initiallyHidden: ["DH","GH"],
        slides: [
            { text: "“Equiangular parallelograms have to one another the ratio compounded of the ratios of their sides.”",
              visible: GIVEN,
              highlighted: ["AC","CF"],
              justifications: [{ ref: "VI.23" }] },
            { text: "Let {AC} and {CF} be equiangular parallelograms having the angle {BCD|angBCD} equal to the angle {ECG|angECG}.",
              visible: ANG,
              highlighted: ["AC","CF","angBCD","angECG"],
              transition: { mode: "parallel", animations: [
                  { elem: "angBCD", name: geomlib.A.Sector.sweep },
                  { elem: "angECG", name: geomlib.A.Sector.sweep } ] } },
            { text: "I say that the parallelogram {AC} has to the parallelogram {CF} the ratio compounded of the ratios of the sides.",
              visible: ANG,
              highlighted: ["AC","CF"] },
            { text: "Let them be placed so that {BC} is in a straight line with {CG}.",
              visible: ANG,
              highlighted: ["BC","CG"] },
            { text: "Then {DC} is also in a straight line with {CE}.",
              visible: ANG,
              highlighted: ["DC","CE"],
              justifications: [{ claim: "DC, CE in a straight line", ref: "I.14" }] },
            { text: "Complete the parallelogram {DG|CH}.",
              visible: COMP,
              highlighted: ["CH"],
              transition: { mode: "cascade", animations: [
                  { elem: "DH", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "GH", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "H",  name: geomlib.A.Point.appear } ] },
              justifications: [{ claim: "the parallelogram DG", ref: "I.31" }] },
            { text: "Set out a straight line {K},",
              visible: SETK,
              highlighted: ["K"],
