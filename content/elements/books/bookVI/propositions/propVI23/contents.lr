    var GIVEN = ["A","B","C","D","E","F","G","ABCD","FECG"];
    var ANG   = GIVEN.concat(["angBCD","angECG"]);
    var COMP  = ANG.concat(["H","DH","GH"]);
    var DG    = ANG.concat(["H","DH","GH","DCGH"]);
