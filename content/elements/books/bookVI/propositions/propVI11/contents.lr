#### prop_section ####
kind: proposition
----
statement: To find a third proportional to two given straight lines.
----
proof:

Let {AB} and {AC} be the two given straight lines, and let them be placed so as to contain any angle.

<figure class="diagram">
<canvas id="canvas_0" width="250" height="220" tabindex="0"></canvas>
<noscript><img alt="VI.11 diagram" src="propVI11.gif"/></noscript>
<script type="text/javascript">
    // Joyce's figure draws the two triangles ADE and ABC (random faces);
    // D is AB produced by the length AC, E the point on AC produced where
    // the parallel to BC through D lands.
    //
    // The walk builds the figure line by line, so AB, AC, the produced
    // pieces BD, CE, the join BC and the parallel DE are solid slide twins
    // of the triangles' sides, hidden at rest (initiallyHidden), as on
    // IV.3 / IV.13; each strokes from the end the text names. The two
    // triangles come back on the closing slide. A highlighted filled
    // triangle is raised over the figure (#140), so "the triangle ADE"
    // goes to the faceless twin ADEt. The I.3 cut-off is one transitory
    // circle about B with radius AC (fatigue rule), dropped on the next
    // slide; angA marks "any angle" on its slide only. None is a right
    // angle.
    var GIVEN = ["A","B","C","AB","AC"];
    var PROD  = GIVEN.concat(["BD","CE","D","E"]);
    var JOIN  = PROD.concat(["BC"]);
    var PAR   = JOIN.concat(["DE"]);
    var DONE  = PAR.concat(["ADE","ABC"]);
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "VI.11",
        elements: [
            "A;point;free;80,30",
            "B;point;free;60,90",
            "C;point;free;135,100",
            "D;point;extend;A,B,A,C",
            "E;point;similar;A,D,A,B,C",
            "ADE;polygon;triangle;A,D,E;0;0;black;random",
            "ABC;polygon;triangle;A,B,C;0;0;black;random",
            // Slide twins, hidden at rest (see above).
            "AB;line;connect;A,B",
            "AC;line;connect;A,C",
            "BD;line;connect;B,D",
            "CE;line;connect;C,E",
            "BC;line;connect;B,C",
            "DE;line;connect;D,E",
            // Transparent: the triangle's faceless twin, the I.3 circle.
            "ADEt;polygon;triangle;A,D,E;0;0;0;0",
            "circD;circle;radius;B,A,C;0;0;0;0",
            "angA;sector;angleMarker;A,B,C;0;0;7a4fa3;cdb8e6"
        ],
        // Draggables (checked against the bundle): A, B, C, free — the
        // given lines, standing from slide 1. D, E are derived (extend /
        // similar) and listed per slide; nothing to defer.
        initiallyHidden: ["AB","AC","BD","CE","BC","DE"],
        aliases: { "BA": "AB", "CA": "AC", "DB": "BD", "EC": "CE",
                   "CB": "BC", "ED": "DE" },
        slides: [
            { text: "“To find a third proportional to two given straight lines.”",
              visible: GIVEN,
              highlighted: ["AB","AC"],
              justifications: [{ ref: "VI.11" }] },
            { text: "Let {AB} and {AC} be the two given straight lines,",
              visible: GIVEN,
              highlighted: ["AB","AC"] },
            { text: "and let them be placed so as to contain {any angle|angA}.",
              visible: GIVEN.concat(["angA"]),
              highlighted: ["angA"],
              transition: { animations: [
                  { elem: "angA", name: geomlib.A.Sector.sweep } ] } },
            { text: "It is required to find a third proportional to {AB} and {AC}.",
              visible: GIVEN,
              highlighted: ["AB","AC"] },
            { text: "Produce them to the points {D} and {E},",
              visible: PROD,
              highlighted: ["BD","CE","D","E"],
              transition: { mode: "cascade", animations: [
                  { elem: "BD", name: geomlib.A.Line.straightEdgeExtend },
                  { elem: "D",  name: geomlib.A.Point.appear },
                  { elem: "CE", name: geomlib.A.Line.straightEdgeExtend },
                  { elem: "E",  name: geomlib.A.Point.appear } ] } },
            { text: "and make {BD} equal to {AC}.",
              visible: PROD.concat(["circD"]),
              highlighted: ["BD","AC"],
              transition: { animations: [
                  { elem: "circD", name: geomlib.A.Circle.compass } ] },
              justifications: [{ claim: "BD equal to AC", ref: "I.3" }] },
            { text: "Join {BC},",
              visible: JOIN,
              highlighted: ["BC"],
              transition: { animations: [
                  { elem: "BC", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "and draw {DE} through {D} parallel to it.",
              visible: PAR,
              highlighted: ["DE","D","BC"],
              transition: { animations: [
                  { elem: "DE", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ claim: "DE parallel to BC", ref: "I.31" }] },
            { text: "Then since {BC} is parallel to a side {DE} of the triangle {ADE|ADEt},",
              visible: PAR,
              highlighted: ["BC","DE","ADEt"] },
            { text: "therefore, proportionally, {AB} is to {BD} as {AC} is to {CE}.",
              visible: PAR,
              highlighted: ["AB","BD","AC","CE"],
              justifications: [{ claim: "AB : BD = AC : CE", ref: "VI.2" }] },
            { text: "But {BD} equals {AC},",
              visible: PAR,
              highlighted: ["BD","AC"] },
            { text: "therefore {AB} is to {AC} as {AC} is to {CE}.",
              visible: PAR,
              highlighted: ["AB","AC","CE"],
              justifications: [{ claim: "equals have the same ratio", ref: "V.7" }] },
            { text: "Therefore a third proportional {CE} has been found to two given straight lines {AB} and {AC}.",
              visible: DONE,
              highlighted: ["CE","AB","AC"],
              justifications: [{ ref: "Q.E.F." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "VI.11") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "I.3":  "/elements/books/bookI/propositions/propI3/",
        "I.31": "/elements/books/bookI/propositions/propI31/",
        "V.7":  "/elements/books/bookV/propositions/propV7/",
        "VI.2": "/elements/books/bookVI/propositions/propVI2/"
    });
</script>
</figure>

It is required to find a third proportional to {AB} and {AC}.

Produce them to the points {D} and {E}, and make {BD} equal to {AC}. Join {BC}, and draw {DE} through {D} parallel to it. [!just I.3; I.31]

Then since {BC} is parallel to a side {DE} of the triangle {ADE|ADEt}, therefore, proportionally, {AB} is to {BD} as {AC} is to {CE}. [!just VI.2]

But {BD} equals {AC}, therefore {AB} is to {AC} as {AC} is to {CE}. [!just V.7]

Therefore a third proportional {CE} has been found to two given straight lines {AB} and {AC}.

<div class="qed">Q.E.F.</div>
<br clear="all">
----
guide:

If *a* and *b* are two magnitudes, then their third proportional is a magnitude *c* such that *a* : *b* = *b* : *c.* The third proportional is needed whenever a duplicate ratio is needed when the ratio itself is known. The duplicate ratio for *a* : *b* is *a* : *c.*

#### Use of this proposition

This construction is used in propositions @VI.19, @VI.22, and a few propositions in Book X.
