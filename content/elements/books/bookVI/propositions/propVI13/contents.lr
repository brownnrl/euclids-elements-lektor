#### prop_section ####
kind: proposition
----
statement: To find a mean proportional to two given straight lines.
----
proof:

Let {AB} and {BC} be the two given straight lines.

<figure class="diagram">
<canvas id="canvas_0" width="300" height="200" tabindex="0"></canvas>
<noscript><img alt="VI.13 diagram" src="propVI13.gif"/></noscript>
<script type="text/javascript">
    // Joyce's figure draws the semicircle ADC on AC (random face), the
    // perpendicular BD, and the triangle ACD (random face); B slides on AC.
    //
    // The walk opens on the two given lines before the semicircle exists,
    // so AB and BC are solid slide twins over the semicircle's diameter,
    // and AD, DC solid twins of the triangle's sides stroking from A and D;
    // all four hidden at rest (initiallyHidden). BD is Joyce's own line and
    // strokes from B. A highlighted filled sector or triangle is raised over
    // the figure (#140), so "the semicircle ADC" and "the triangle ADC" go
    // to the faceless twins semi and ACDt; AC is a transparent target.
    // Right angles: DBC (drawn at right angles, I.11) and ADC (III.31),
    // both red squares. Names collide on ADC (semicircle, angle, triangle):
    // the sector owns it, the others take display overrides.
    //
    // Draggables (checked against the bundle): A, C free and B a
    // lineSlider — the givens, on slide 1, so nothing is deferred. D is
    // derived and listed per slide.
    var GIVEN = ["A","B","C","AB","BC"];
    var SEMI  = GIVEN.concat(["ADC","AC"]);
    var PERP  = SEMI.concat(["BD","D","rtB"]);
    var JOIN  = PERP.concat(["AD","DC"]);
    var TRI   = JOIN.concat(["ACD","rtD"]);
