              visible: SEMI,
              highlighted: ["AC"],
              transition: { animations: [
                  { elem: "ADC", name: geomlib.A.Sector.sweep } ] } },
            { text: "Draw {BD} from the point {B} at right angles to the straight line {AC},",
              visible: PERP,
              highlighted: ["BD","B","AC"],
              transition: { mode: "cascade", animations: [
                  { elem: "BD",  name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "D",   name: geomlib.A.Point.appear },
                  { elem: "rtB", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "BD at right angles to AC", ref: "I.11" }] },
            { text: "and join {AD} and {DC}.",
              visible: JOIN,
              highlighted: ["AD","DC"],
              transition: { mode: "cascade", animations: [
                  { elem: "AD", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "DC", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Since the angle {ADC|rtD} is an angle in a semicircle, it is right.",
              visible: TRI,
              highlighted: ["rtD","semi"],
              transition: { animations: [
                  { elem: "rtD", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "the angle in a semicircle is right", ref: "III.31" }] },
            { text: "And, since, in the right-angled triangle {ADC|ACDt}, {BD} has been drawn from {the right angle|rtD}",
              visible: TRI,
              highlighted: ["ACDt","BD","rtD"] },
            { text: "perpendicular to {the base|AC},",
              visible: TRI,
              highlighted: ["BD","AC","rtB"] },
            { text: "therefore {BD} is a mean proportional between the segments of the base, {AB} and {BC}.",
              visible: TRI,
              highlighted: ["BD","AB","BC"],
              justifications: [{ claim: "AB : BD = BD : BC", ref: "VI.8.Cor" }] },
            { text: "Therefore a mean proportional {BD} has been found to the two given straight lines {AB} and {BC}.",
              visible: TRI,
