            "AC;line;connect;A,C;0;0;0",
            "semi;sector;sector;M,C,A;0;0;0;0",
            "ACDt;polygon;triangle;A,D,C;0;0;0;0",
            "rtB;sector;angleMarkerRight;B,C,D;0;0;red;red",
            "rtD;sector;angleMarkerRight;D,A,C;0;0;red;red"
        ],
        initiallyHidden: ["AB","BC","AD","DC"],
        aliases: { "BA": "AB", "CB": "BC", "CA": "AC", "DB": "BD",
