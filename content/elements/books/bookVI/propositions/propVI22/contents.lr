                  { elem: "P", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ claim: "third proportionals O and P", ref: "VI.11" }] },
            { text: "Then since {AB} is to {CD} as {EF} is to {GH},",
