              highlighted: ["MF","SR","NH"],
              justifications: [{ claim: "ratios the same with the same ratio", ref: "V.11" }] },
            { text: "Therefore {MF} has the same ratio to each of the figures {NH} and {SR},",
              visible: SRF,
              highlighted: ["MF","NH","SR"] },
            { text: "therefore {NH} equals {SR}.",
              visible: SRF,
              highlighted: ["NH","SR"],
              justifications: [{ claim: "same ratio to the same: equal", ref: "V.9" }] },
            { text: "But it is also similar and similarly situated to it, therefore {GH} equals {QR}.",
              visible: SRF,
              highlighted: ["NH","SR","GH","QR"] },
            { text: "And, since {AB} is to {CD} as {EF} is to {QR}, while {QR} equals {GH},",
              visible: SRF,
              highlighted: ["AB","CD","EF","QR","GH"] },
            { text: "therefore {AB} is to {CD} as {EF} is to {GH}.",
              visible: SRF,
              highlighted: ["AB","CD","EF","GH"] },
            { text: "Therefore, if four straight lines are proportional,",
              visible: FIG2,
              highlighted: ["AB","CD","EF","GH"] },
            { text: "then the rectilinear figures similar and similarly described upon them are also proportional;",
              visible: FIG2,
              highlighted: ["KAB","LCD","MF","NH"] },
            { text: "and, if the rectilinear figures similar and similarly described upon them are proportional,",
              visible: FIG2,
              highlighted: ["KAB","LCD","MF","NH"] },
            { text: "then the straight lines are themselves also proportional.",
              visible: FIG2,
              highlighted: ["AB","CD","EF","GH"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "VI.22") return "#prop";
