            "E;point;lineSlider;B,C,290,260",
            "D1;point;parallelogram;A,B,C;0;0",
            "D2;point;parallelogram;A,C,E;0;0",
            "D;point;intersection;C,D1,E,D2",
            "CDE;polygon;triangle;C,D,E;0;0;black;random",
            "F;point;intersection;B,A,E,D",
            "AF;line;connect;A,F",
            "DF;line;connect;D,F"
        ],
