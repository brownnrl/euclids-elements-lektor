            "E;point;midpoint;A,B",
            "C1;point;free;30,20;0",
            "C2;point;free;200,20;0",
            "C3;point;free;200,80;0",
            "C4;point;free;30,80;0",
            "C;polygon;quadrilateral;C1,C2,C3,C4;black;0;black;random",
            "F;point;perpendicular;E,B",
            "L;point;parallelogram;F,E,B",
            "FAA'F';polygon;application;C,E,F,A;0;0;0;0",
            "A';point;vertex;FAA'F',3;0;0",
            "M;point;meanProportional;L,A',B,L,F,L",
            "N;point;cutoff;F,E,F,M",
            "O;point;parallelogram;N,F,M",
            "FO;line;connect;F,O",
            "P;point;intersection;A,B,M,O",
            "Q;point;intersection;L,B,N,O",
            "AQ;polygon;parallelogram;A,B,Q;0;0;black;random",
            "PQ;polygon;parallelogram;P,B,Q;0;0;black;random",
            "MN;polygon;parallelogram;M,F,N;0;0;black;0",
            "BL;line;connect;B,L"
        ],
