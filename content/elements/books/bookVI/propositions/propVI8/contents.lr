            "ABCt;polygon;triangle;A,B,C;0;0;black;0",
            "AD;line;connect;A,D",
            // The sides, as transparent highlight targets.
            "AB;line;connect;A,B;0;0;0",
            "AC;line;connect;A,C;0;0;0",
            "BC;line;connect;B,C;0;0;0",
            "BD;line;connect;B,D;0;0;0",
            "CD;line;connect;C,D;0;0;0",
            // Faceless twins of the two small triangles. Explicit ;0 faces.
            "DBA;polygon;triangle;D,B,A;0;0;0;0",
            "DAC;polygon;triangle;D,A,C;0;0;0;0",
            "rtBAC;sector;angleMarkerRight;A,B,C,16;0;0;red;red",
            "rtBDA;sector;angleMarkerRight;D,B,A,16;0;0;red;red",
            "rtADC;sector;angleMarkerRight;D,A,C,16;0;0;red;red",
            "angB;sector;angleMarker;B,A,C;0;0;3b6ea5;9ec5e8",
            "angDAC;sector;angleMarker;A,D,C,26;0;0;3b6ea5;9ec5e8",
