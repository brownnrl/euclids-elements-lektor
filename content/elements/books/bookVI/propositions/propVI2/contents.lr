              visible: ALL,
              highlighted: ["BDE","CDE","ADE"],
              justifications: [{ claim: "ratios the same as the same ratio", ref: "V.11" }] },
            { text: "Therefore each of the triangles {BDE} and {CDE} has the same ratio to {ADE}.",
