              highlighted: ["BC","EF","BG"] },
            { text: "and, if three straight lines are proportional,",
              visible: ALL,
              highlighted: ["BC","EF","BG"] },
            { text: "the first has to the third a ratio duplicate of that which it has to the second,",
              visible: ALL,
              highlighted: ["BC","BG"],
              justifications: [{ claim: "duplicate ratio", ref: "V.Def.9" }] },
            { text: "therefore {BC} has to {BG} a ratio duplicate of that which {BC} has to {EF}.",
              visible: ALL,
              highlighted: ["BC","BG","EF"] },
            { text: "But {BC} is to {BG} as the triangle {ABC|ABCt} is to the triangle {ABG},",
              visible: ALL,
              highlighted: ["BC","BG","ABCt","ABG"],
              justifications: [{ claim: "triangles under the same height are as their bases", ref: "VI.1" }] },
            { text: "therefore the triangle {ABC|ABCt} also has to the triangle {ABG} a ratio duplicate of that which {BC} has to {EF}.",
              visible: ALL,
              highlighted: ["ABCt","ABG","BC","EF"],
              justifications: [{ claim: "ratios the same as the same ratio", ref: "V.11" }] },
            { text: "But the triangle {ABG} equals the triangle {DEF|DEFt},",
              visible: ALL,
              highlighted: ["ABG","DEFt"] },
            { text: "therefore the triangle {ABC|ABCt} also has to the triangle {DEF|DEFt} a ratio duplicate of that which {BC} has to {EF}.",
              visible: ALL,
              highlighted: ["ABCt","DEFt","BC","EF"],
              justifications: [{ claim: "equals have the same ratio to the same", ref: "V.7" }] },
            { text: "Therefore, similar triangles are to one another in the duplicate ratio of the corresponding sides.",
              visible: ALL,
              highlighted: ["ABCt","DEFt","BC","EF"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "VI.19") return "#prop";
