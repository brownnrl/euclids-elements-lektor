              justifications: [{ ref: "VI.19" }] },
            { text: "Let {ABC|ABCt} and {DEF|DEFt} be similar triangles having the angle at {B|angB} equal to the angle at {E|angE},",
              visible: GIVEN,
              highlighted: ["ABCt","DEFt","angB","angE"],
              transition: { mode: "parallel", animations: [
                  { elem: "angB", name: geomlib.A.Sector.sweep },
                  { elem: "angE", name: geomlib.A.Sector.sweep } ] } },
            { text: "and such that {AB} is to {BC} as {DE} is to {EF}, so that {BC} corresponds to {EF}.",
