_model: proposition
---
title: Proposition 21
---
order: 21
---
short_label: VI.21
---
sections:

#### prop_section ####
kind: proposition
----
statement: Figures which are similar to the same rectilinear figure are also similar to one another.
----
proof:

Let each of the rectilinear figures {A|At} and {B|Bt} be similar to {C|Ct}.

<figure class="diagram">
<canvas id="canvas_0" width="450" height="250" tabindex="0"></canvas>
<noscript><img alt="VI.21 diagram" src="propVI21.gif"/></noscript>
<script type="text/javascript">
    // Joyce's figure draws the three quadrilaterals A, B, C with random
    // faces; B and C are built similar to A on their bases (B1, B4, C1, C4
    // derived), so all three are similar to one another as drawn.
    //
    // Added, all hidden at rest: the four angles of each figure, coloured
    // by correspondence (the angle at A1, B1, C1 share a colour, and so
    // on), swept as each figure is shown equiangular with C; and the
    // faceless twins At, Bt, Ct, which carry the caption and prose refs
    // ({A|At}), since a highlighted filled polygon is raised over its
    // markers (#140). None of the angles is a right angle.
    //
    // Draggables (checked against the bundle): A1-A4, B2, B3, C2, C3, all
    // free and all givens on slide 1; nothing to defer.
    var FIG  = ["A","B","C","At","Bt","Ct"];
    var ANGA = ["angA1","angA2","angA3","angA4"];
    var ANGB = ["angB1","angB2","angB3","angB4"];
    var ANGC = ["angC1","angC2","angC3","angC4"];
    var AC   = FIG.concat(ANGA, ANGC);
