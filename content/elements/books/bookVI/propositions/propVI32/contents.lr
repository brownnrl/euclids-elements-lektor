    // Draggables (checked against the bundle): A, B, C free and the
    // lineSlider D — the two triangles, givens of slide 1. E is derived and
    // listed per slide.
    var GIVEN = ["A","B","C","D","E","ABC","CDE","ABCt","DCEt",
                 "AB","AC","BC","DC","DE","CE"];
    var ALT   = GIVEN.concat(["angBAC","angACD"]);
    var CDE3  = ALT.concat(["angCDE"]);
    var EQ    = CDE3.concat(["angABC","angDCE"]);
    var WHOLE = EQ.concat(["angACE"]);
