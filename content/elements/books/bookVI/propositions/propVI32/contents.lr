            "angBAC;sector;angleMarker;A,B,C;0;0;3b6ea5;9ec5e8",
            "angACD;sector;angleMarker;C,A,D;0;0;3b6ea5;9ec5e8",
            "angCDE;sector;angleMarker;D,C,E;0;0;3b6ea5;9ec5e8",
            "angABC;sector;angleMarker;B,A,C;0;0;3b8a4f;9ed8ae",
            "angDCE;sector;angleMarker;C,D,E;0;0;3b8a4f;9ed8ae",
            "angACE;sector;angleMarker;C,A,E",
            "angACB;sector;angleMarker;C,A,B"
        ],
        aliases: { "BA": "AB", "CA": "AC", "CB": "BC", "CD": "DC", "ED": "DE", "EC": "CE" },
        slides: [
            { text: "“If two triangles having two sides proportional to two sides are placed together at one angle”",
              visible: GIVEN,
