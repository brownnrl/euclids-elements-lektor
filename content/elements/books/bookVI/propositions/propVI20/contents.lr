            "D;point;free;180,220",
            "E;point;free;200,100",
            "H;point;free;280,200",
            "K;point;free;350,200",
            "F;point;similar;H,K,C,D,A",
            "G;point;similar;H,K,C,D,B",
            "L;point;similar;H,K,C,D,E",
            "ABCDE;polygon;pentagon;A,B,C,D,E;0;0;black;random",
            "FGHKL;polygon;pentagon;F,G,H,K,L;0;0;black;random",
            "AC;line;connect;A,C",
            "BD;line;connect;B,D",
            "BE;line;connect;B,E",
            "CE;line;connect;C,E",
            "FH;line;connect;F,H",
            "GL;line;connect;G,L",
            "GK;line;connect;G,K",
            "HL;line;connect;H,L",
            "M;point;intersection;AC,BE",
            "N;point;intersection;FH,GL"
        ],
