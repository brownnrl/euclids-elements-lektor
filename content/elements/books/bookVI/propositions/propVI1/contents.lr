            { text: "Let {ACB} and {ACD} be triangles, and let {CE} and {CF} be parallelograms under the same height.",
              visible: GIVEN,
              highlighted: ["ABC","ACD","CE","CF"] },
            { text: "I say that the base {CB} is to the base {CD} as the triangle {ACB} is to the triangle {ACD},",
              visible: GIVEN,
