            { text: "and as the parallelogram {CE} is to the parallelogram {CF}.",
              visible: GIVEN,
              highlighted: ["CE","CF"] },
            { text: "Produce {BD} in both directions to the points {H} and {L}.",
              visible: PROD,
              highlighted: ["BH","DL","H","L"],
              transition: { mode: "cascade", animations: [
                  { elem: "BH", name: geomlib.A.Line.straightEdgeExtend },
                  { elem: "H",  name: geomlib.A.Point.appear },
