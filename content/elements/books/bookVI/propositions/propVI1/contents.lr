    // E, F (vertex) and G, H, K, L (extend) are derived and listed per slide.
    var GIVEN = ["A","B","C","D","E","F","ACBE","ACDF","ABC","ACD","CE","CF","CB","CD"];
    var PROD  = GIVEN.concat(["BD","BH","DL","H","L"]);
    var CUTG  = PROD.concat(["G","BG","GH"]);
    var CUTK  = CUTG.concat(["K","DK","KL"]);
    var JOIN  = CUTK.concat(["AG","AH","AK","AL"]);
    var ALL   = JOIN.concat(["ABG","AGH","ACH","ACL","CH","CL"]);
    geomlib.init({
