                  { elem: "AGH", name: geomlib.A.Polygon.outline } ] },
              justifications: [{ claim: "triangles on equal bases and in the same parallels", ref: "I.38" }] },
            { text: "Therefore, whatever multiple the base {CH} is of the base {CB},",
              visible: ALL,
              highlighted: ["CH","CB"] },
            { text: "the triangle {ACH} is also that multiple of the triangle {ACB}.",
              visible: ALL,
              highlighted: ["ACH","ABC"],
              transition: { animations: [
                  { elem: "ACH", name: geomlib.A.Polygon.outline } ] } },
            { text: "For the same reason, whatever multiple the base {CL} is of the base {CD},",
              visible: ALL,
              highlighted: ["CL","CD"] },
            { text: "the triangle {ACL} is also that multiple of the triangle {ACD}.",
              visible: ALL,
              highlighted: ["ACL","ACD"],
              transition: { animations: [
                  { elem: "ACL", name: geomlib.A.Polygon.outline } ] } },
