        elements: [
            "A0;point;free;-1000,30;0;0",
            "A3;point;free;1000,30;0;0",
            "U1;point;free;1000,0;0;0",
            "U2;point;free;1000,20;0;0",
            "A;point;lineSlider;A0,A3,30,0",
            "B;point;lineSlider;A0,A3,200,0",
            "C;point;lineSlider;A0,A3,130,0",
            "D;point;cutoff;A,B,U1,U2",
            "AB;line;connect;A,B",
            // Highlight twins over AB (transparent).
            "BC;line;connect;B,C;0;0;0",
            "CA;line;connect;C,A;0;0;0",
            "AD;line;connect;A,D;0;0;0",
            "DB;line;connect;D,B;0;0;0",
            "CD;line;connect;C,D;0;0;0"
        ],
        slides: [
            { text: "“If an even number is subtracted from an odd number, then the remainder is odd.”",
              visible: GIVEN,
              highlighted: ["BC","AB"],
              justifications: [{ ref: "IX.27" }] },
            { text: "Let the even number {BC} be subtracted from the odd number {AB}.",
              visible: GIVEN,
              highlighted: ["BC","AB"] },
            { text: "I say that the remainder {CA} is odd.",
              visible: GIVEN,
              highlighted: ["CA"] },
            { text: "Subtract the unit {AD}, therefore {DB} is even.",
              visible: ALL,
              highlighted: ["AD","DB"],
              transition: { animations: [
                  { elem: "D", name: geomlib.A.Point.appear } ] },
              justifications: [{ claim: "odd less a unit is even", ref: "VII.Def.7" }] },
            { text: "But {BC} is also even, therefore the remainder {CD} is even.",
              visible: ALL,
              highlighted: ["DB","BC","CD"],
              justifications: [{ claim: "even less even is even", ref: "IX.24" }] },
            { text: "Therefore {CA} is odd.",
              visible: ALL,
              highlighted: ["CD","AD","CA"],
              justifications: [{ claim: "even plus a unit is odd", ref: "VII.Def.7" }] },
            { text: "Therefore, if an even number is subtracted from an odd number,",
              visible: ALL,
              highlighted: ["BC","AB"] },
            { text: "then the remainder is odd.",
              visible: ALL,
              highlighted: ["CA"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "IX.27") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
