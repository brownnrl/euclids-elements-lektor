short_label: IX.27
---
sections:

#### prop_section ####
kind: proposition
----
statement: If an even number is subtracted from an odd number, then the remainder is odd.
----
proof:

Let the even number {BC} be subtracted from the odd number {AB}.

I say that the remainder {CA} is odd.

<figure class="diagram">
<canvas id="canvas_0" width="230" height="60" tabindex="0"></canvas>
<noscript><img alt="IX.27 diagram" src="propIX27.gif"/></noscript>
<script type="text/javascript">
    // Numbers as lines: AB is Joyce's one drawn line. The parts BC, CA, AD,
    // DB, CD are transparent twins so each lights on its own. D, the end of
    // the unit AD cut off from A toward B, is derived and joins the visible
    // set when the unit is subtracted.
    var GIVEN = ["A","B","C","AB","BC","CA"];
    var ALL   = GIVEN.concat(["D","AD","DB","CD"]);
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
