        "I.31":      "/elements/books/bookI/propositions/propI31/",
        "I.47":      "/elements/books/bookI/propositions/propI47/",
        "II.11":     "/elements/books/bookII/propositions/propII11/",
        "V.15":      "/elements/books/bookV/propositions/propV15/",
        "VI.30":     "/elements/books/bookVI/propositions/propVI30/",
        "VI.32":     "/elements/books/bookVI/propositions/propVI32/",
        "XI.Def.28": "/elements/books/bookXI/definitions/defXI28/",
        "XI.1":      "/elements/books/bookXI/propositions/propXI1/",
        "XI.6":      "/elements/books/bookXI/propositions/propXI6/",
        "XI.11":     "/elements/books/bookXI/propositions/propXI11/",
        "XI.38":     "/elements/books/bookXI/propositions/propXI38/",
        "XIII.4":    "/elements/books/bookXIII/propositions/propXIII4/",
        "XIII.5":    "/elements/books/bookXIII/propositions/propXIII5/",
        "XIII.6":    "/elements/books/bookXIII/propositions/propXIII6/",
        "XIII.7":    "/elements/books/bookXIII/propositions/propXIII7/",
        "XIII.15":   "/elements/books/bookXIII/propositions/propXIII15/"
    });
</script>
