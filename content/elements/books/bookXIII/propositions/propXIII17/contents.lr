_model: proposition
---
title: Proposition 17
---
order: 17
---
short_label: XIII.17
---
red_highlight: yes
---
sections:

#### prop_section ####
kind: proposition
----
statement: To construct a dodecahedron and comprehend it in a sphere, like the aforesaid figures; and to prove that the square on the side of the dodecahedron is the irrational straight line called apotome.
----
proof:

Let {ABCD|ABCDt} and {CBEF|CBEFt}, two planes of the aforesaid cube at right angles to one another, be set out.  Bisect the sides {AB}, {BC}, {CD}, {DA}, {EF}, {EB}, and {FC} at {G}, {H}, {K}, {L}, {M}, {N}, and {O} respectively, and join {GK}, {HL}, {MH}, and {NO}.  Cut the straight lines {NP}, {PO}, and {HQ} in extreme and mean ratio at the points {R}, {S}, and {T} respectively, and let {RP}, {PS}, and {TQ} be their greater segments.  Set up {RU}, {SV}, and {TW} from the points {R}, {S}, and {T} at right angles to the planes of the cube towards the outside of the cube, and make them equal to {RP}, {PS}, and {TQ}.  Join {UB}, {BW}, {WC}, {CV}, and {VU}. [!just XIII.15; I.10; II.11, VI.30; XI.11; I.3]

I say that the pentagon {UBWCV|pentT} is equilateral, in one plane, and equiangular.

<figure class="diagram">
<canvas id="canvas_0" width="370" height="400" tabindex="0"></canvas>
<noscript><img alt="XIII.17 diagram" src="propXIII17.gif"/></noscript>
<script type="text/javascript">
    // Joyce's figure: two faces of the cube (ABCD front, BEFC top, both with
    // random faces) and the one pentagon VUBWC built on the edge BC. The
    // faces and the pentagon would be raised over the figure by a highlight
    // (#140), so the prose reaches them through faceless twins: the planes
    // as {ABCD|ABCDt} / {CBEF|CBEFt} (and "the plane BD / BF"), the pentagon
    // as {UBWCV|pentT} / {BUVCW|pentT}.
    //
    // His lines are held back until the proof draws them: GK, HL, HM, NO at
    // the joins, RU, SV, TW when set up, the pentagon at "Join UB, BW ...",
    // RB, SB, VB at their join, XW at "join XH and HW", XZ at "Produce XP"
    // and UZ at "Join UZ". PX has no line of its own (Joyce's XZ runs
    // through P), so PX is a solid twin hidden at rest (initiallyHidden),
    // drawn from P before XZ is produced.
    //
    // Transparent targets: the cube edges AB, BC, CD, DA, EF, EB, FC; the
    // segments NP, PO, HQ, RP, PS, TQ, NR, NB, RS, TH, NS, SO, HP, XH, HW,
    // XU, PZ; the pentagon sides BU, UV, BW, WC, CV; the triangles XPH and
    // HTW (explicit ;0 faces); AFd, a diameter of the cube for "the
    // diameter of the cube" that PZ meets at Z.
    //
    // Right angles (red squares): URP, VSP, WTQ (set up at right angles to
    // the planes), BNR (BN and NR are summed by I.47), BRU (RU is at right
    // angles to the plane through BR), VSB ("for the angle VSB is right"),
    // PHQ (HP and TH at right angles to the planes BD and BF), XPH (PX at
    // right angles to the plane BF), UXZ (UZ summed from ZX and XU).
    //
    // Draggables (checked against the bundle): B (free) and A (planeSlider),
    // both corners of the given face ABCD, standing from slide 1; every
    // other point is derived and listed per slide. Nothing to defer.
    var GIVEN = ["ABCD","BEFC","ABCDt","CBEFt","A","B","C","D","E","F",
                 "AB","BC","CD","DA","EF","EB","FC"];
    var BIS   = GIVEN.concat(["G","H","K","L","M","N","O"]);
    var JN    = BIS.concat(["GK","HL","HM","NO","P","Q","NP","PO","HQ","NB","HP"]);
    var CUT   = JN.concat(["R","S","T","RP","PS","TQ","NR","RS","TH","NS","SO"]);
    var UP    = CUT.concat(["RU","SV","TW","U","V","W"]);
    var PEN   = UP.concat(["VUBWC","pentT","BU","UV","BW","WC","CV"]);
    var RBV   = PEN.concat(["RB","SB","VB"]);
    var PXV   = RBV.concat(["PX","X","XU"]);
    var XHW   = PXV.concat(["XW","XH","HW","XPH","HTW"]);
    var PRO   = XHW.concat(["XZ","PZ","AFd"]);
    var ZV    = PRO.concat(["Z"]);
    var UZV   = ZV.concat(["UZ"]);
    var SETUP = ["rtURP","rtVSP","rtWTQ"];
    var ANG   = ["angBUV","angBWC","angUVC"];
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "XIII.17",
        elements: [
            "B;point;free;40,150",
            "C';point;fixed;250,190,100;0;0",
            "side;plane;perpendicular;B,C';0;0;0;0",
            "A;point;planeSlider;side,430,400,50",
            "front;plane;3points;B,A,C';0;0;0;0",
            "ABCD;polygon;square;A,B,front;0;0;black;random",
            "C;point;vertex;ABCD,3",
            "D;point;vertex;ABCD,4",
            "E;point;perpendicular;B,front,A,B",
            "top;plane;3points;B,C,E;0;0;0;0",
            "F;point;parallelogram;E,B,C",
            "BEFC;polygon;quadrilateral;B,E,F,C;0;0;black;random",
            "G;point;midpoint;A,B",
            "H;point;midpoint;B,C",
            "K;point;midpoint;C,D",
            "L;point;midpoint;A,D",
            "M;point;midpoint;E,F",
            "N;point;midpoint;B,E",
            "O;point;midpoint;C,F",
            "GK;line;connect;G,K",
            "HL;line;connect;H,L",
            "HM;line;connect;H,M",
            "NO;line;connect;N,O",
            "P;point;intersection;HM,NO,top",
            "Q;point;intersection;GK,HL,screen",
            "OPmid;point;midpoint;O,P;0;0",
            "R;point;cutoff;OPmid,P,OPmid,M",
            "S;point;cutoff;P,O,P,R",
            "T;point;cutoff;Q,H,P,R",
            "U';point;perpendicular;R,top,P,R;0;0",
            "U;point;extend;U',R,U',R",
            "RU;line;connect;R,U",
            "V;point;parallelogram;U,R,S",
            "SV;line;connect;S,V",
            "W';point;perpendicular;T,front,P,R;0;0",
            "W;point;extend;W',T,W',T",
            "TW;line;connect;T,W",
            "VUBWC;polygon;pentagon;V,U,B,W,C;0;0;black;random",
            "RB;line;connect;R,B",
            "SB;line;connect;S,B",
            "VB;line;connect;V,B",
            "X;point;midpoint;U,V",
            "XW;line;connect;X,W",
            "Z;point;midpoint;A,F",
            "XZ;line;connect;X,Z",
            "UZ;line;connect;U,Z",
            // Faceless twins of the faces and the pentagon (see above).
            "ABCDt;polygon;quadrilateral;A,B,C,D;0;0;0;0",
            "CBEFt;polygon;quadrilateral;B,E,F,C;0;0;0;0",
            "pentT;polygon;pentagon;V,U,B,W,C;0;0;0;0",
            // Slide twin, hidden at rest (see above).
            "PX;line;connect;P,X",
            // Transparent highlight targets.
            "AB;line;connect;A,B;0;0;0",
            "BC;line;connect;B,C;0;0;0",
            "CD;line;connect;C,D;0;0;0",
            "DA;line;connect;D,A;0;0;0",
            "EF;line;connect;E,F;0;0;0",
            "EB;line;connect;E,B;0;0;0",
            "FC;line;connect;F,C;0;0;0",
            "NP;line;connect;N,P;0;0;0",
            "PO;line;connect;P,O;0;0;0",
            "HQ;line;connect;H,Q;0;0;0",
            "RP;line;connect;R,P;0;0;0",
            "PS;line;connect;P,S;0;0;0",
            "TQ;line;connect;T,Q;0;0;0",
            "NR;line;connect;N,R;0;0;0",
            "NB;line;connect;N,B;0;0;0",
            "RS;line;connect;R,S;0;0;0",
            "TH;line;connect;T,H;0;0;0",
            "NS;line;connect;N,S;0;0;0",
            "SO;line;connect;S,O;0;0;0",
            "HP;line;connect;H,P;0;0;0",
            "BU;line;connect;B,U;0;0;0",
            "UV;line;connect;U,V;0;0;0",
            "BW;line;connect;B,W;0;0;0",
            "WC;line;connect;W,C;0;0;0",
            "CV;line;connect;C,V;0;0;0",
            "XH;line;connect;X,H;0;0;0",
            "HW;line;connect;H,W;0;0;0",
            "XU;line;connect;X,U;0;0;0",
            "PZ;line;connect;P,Z;0;0;0",
            "AFd;line;connect;A,F;0;0;0",
            "XPH;polygon;triangle;X,P,H;0;0;0;0",
            "HTW;polygon;triangle;H,T,W;0;0;0;0",
            // Angle markers.
            "rtURP;sector;angleMarkerRight;R,U,P,12;0;0;red;red",
            "rtVSP;sector;angleMarkerRight;S,V,P,12;0;0;red;red",
            "rtWTQ;sector;angleMarkerRight;T,W,Q,12;0;0;red;red",
            "rtBNR;sector;angleMarkerRight;N,B,R,12;0;0;red;red",
            "rtBRU;sector;angleMarkerRight;R,B,U,12;0;0;red;red",
            "rtVSB;sector;angleMarkerRight;S,V,B,12;0;0;red;red",
            "rtPHQ;sector;angleMarkerRight;H,P,Q,12;0;0;red;red",
            "rtXPH;sector;angleMarkerRight;P,X,H,12;0;0;red;red",
            "rtUXZ;sector;angleMarkerRight;X,U,Z,12;0;0;red;red",
            "angBUV;sector;angleMarker;U,B,V;0;0;3b6ea5;9ec5e8",
            "angBWC;sector;angleMarker;W,B,C;0;0;3b6ea5;9ec5e8",
            "angUVC;sector;angleMarker;V,U,C;0;0;3b6ea5;9ec5e8"
        ],
        initiallyHidden: ["PX"],
        aliases: { "MH": "HM", "PN": "NP", "PR": "RP", "SP": "PS", "QT": "TQ",
                   "UR": "RU", "VS": "SV", "WT": "TW", "UB": "BU", "VU": "UV",
                   "BR": "RB", "BS": "SB", "BV": "VB", "BN": "NB", "RN": "NR",
                   "SR": "RS", "XP": "PX", "SN": "NS", "ZX": "XZ", "ZP": "PZ",
                   "QH": "HQ", "PH": "HP", "HT": "TH", "CB": "BC" },
        slides: [
            { text: "“To construct a dodecahedron and comprehend it in a sphere, like the aforesaid figures;”",
              visible: GIVEN,
              highlighted: ["ABCDt","CBEFt"],
              justifications: [{ ref: "XIII.17" }] },
            { text: "“and to prove that the square on the side of the dodecahedron is the irrational straight line called apotome.”",
              visible: GIVEN },
            { text: "Let {ABCD|ABCDt} and {CBEF|CBEFt}, two planes of the aforesaid cube at right angles to one another, be set out.",
              visible: GIVEN,
              highlighted: ["ABCDt","CBEFt"],
              justifications: [{ claim: "the cube", ref: "XIII.15" }] },
            { text: "Bisect the sides {AB}, {BC}, {CD}, {DA}, {EF}, {EB}, and {FC}",
              visible: GIVEN,
              highlighted: ["AB","BC","CD","DA","EF","EB","FC"] },
            { text: "at {G}, {H}, {K}, {L}, {M}, {N}, and {O} respectively,",
              visible: BIS,
              highlighted: ["G","H","K","L","M","N","O"],
              transition: { mode: "parallel", animations: [
                  { elem: "G", name: geomlib.A.Point.appear },
                  { elem: "H", name: geomlib.A.Point.appear },
                  { elem: "K", name: geomlib.A.Point.appear },
                  { elem: "L", name: geomlib.A.Point.appear },
                  { elem: "M", name: geomlib.A.Point.appear },
                  { elem: "N", name: geomlib.A.Point.appear },
                  { elem: "O", name: geomlib.A.Point.appear } ] },
              justifications: [{ claim: "bisect the sides", ref: "I.10" }] },
            { text: "and join {GK}, {HL}, {MH}, and {NO}.",
              visible: JN,
              highlighted: ["GK","HL","HM","NO"],
              transition: { animations: [
                  { elem: "GK", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "HL", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "Q",  name: geomlib.A.Point.appear },
                  { elem: "HM", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "NO", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "P",  name: geomlib.A.Point.appear } ] } },
            { text: "Cut the straight lines {NP}, {PO}, and {HQ} in extreme and mean ratio",
              visible: JN,
              highlighted: ["NP","PO","HQ"] },
            { text: "at the points {R}, {S}, and {T} respectively,",
              visible: CUT,
              highlighted: ["NP","PO","HQ","R","S","T"],
              transition: { animations: [
                  { elem: "R", name: geomlib.A.Point.appear },
                  { elem: "S", name: geomlib.A.Point.appear },
                  { elem: "T", name: geomlib.A.Point.appear } ] },
              justifications: [{ claim: "extreme and mean ratio", ref: "II.11" },
                               { ref: "VI.30" }] },
            { text: "and let {RP}, {PS}, and {TQ} be their greater segments.",
              visible: CUT,
              highlighted: ["RP","PS","TQ"] },
            { text: "Set up {RU}, {SV}, and {TW} from the points {R}, {S}, and {T}",
              visible: UP.concat(SETUP),
              highlighted: ["RU","SV","TW","R","S","T"],
              transition: { animations: [
                  { elem: "RU",    name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "U",     name: geomlib.A.Point.appear },
                  { elem: "rtURP", name: geomlib.A.Sector.sweep },
                  { elem: "SV",    name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "V",     name: geomlib.A.Point.appear },
                  { elem: "rtVSP", name: geomlib.A.Sector.sweep },
                  { elem: "TW",    name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "W",     name: geomlib.A.Point.appear },
                  { elem: "rtWTQ", name: geomlib.A.Sector.sweep } ] } },
            { text: "at right angles to the planes of the cube towards the outside of the cube,",
              visible: UP.concat(SETUP),
              highlighted: ["RU","SV","TW","rtURP","rtVSP","rtWTQ","CBEFt","ABCDt"],
              justifications: [{ claim: "at right angles to the planes", ref: "XI.11" }] },
            { text: "and make them equal to {RP}, {PS}, and {TQ}.",
              visible: UP,
              highlighted: ["RU","SV","TW","RP","PS","TQ"],
              justifications: [{ claim: "RU = RP, SV = PS, TW = TQ", ref: "I.3" }] },
            { text: "Join {UB}, {BW}, {WC}, {CV}, and {VU}.",
              visible: PEN,
              highlighted: ["BU","BW","WC","CV","UV"],
              transition: { animations: [
                  { elem: "VUBWC", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "I say that the pentagon {UBWCV|pentT} is equilateral, in one plane, and equiangular.",
              visible: PEN,
              highlighted: ["pentT"] },
            { text: "Join {RB}, {SB}, and {VB}.",
              visible: RBV,
              highlighted: ["RB","SB","VB"],
              transition: { animations: [
                  { elem: "RB", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "SB", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "VB", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Then, since the straight line {NP} is cut in extreme and mean ratio at {R}, and {RP} is the greater segment,",
              visible: RBV,
              highlighted: ["NP","R","RP"] },
            { text: "therefore the sum of the squares on {PN} and {NR} is triple the square on {RP}.",
              visible: RBV,
              highlighted: ["NP","NR","RP"],
              justifications: [{ claim: "squares on NP, NR = 3 square on RP", ref: "XIII.4" }] },
            { text: "But {PN} equals {NB}, and {PR} equals {RU},",
              visible: RBV,
              highlighted: ["NP","NB","RP","RU"] },
            { text: "therefore the sum of the squares on {BN} and {NR} is triple the square on {RU}.",
              visible: RBV,
              highlighted: ["NB","NR","RU"] },
            { text: "But the square on {BR} equals the sum of the squares on {BN} and {NR},",
              visible: RBV.concat(["rtBNR"]),
              highlighted: ["RB","NB","NR","rtBNR"],
              transition: { animations: [
                  { elem: "rtBNR", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "square on BR = squares on BN, NR", ref: "I.47" }] },
            { text: "therefore the square on {BR} is triple the square on {RU}.",
              visible: RBV,
              highlighted: ["RB","RU"] },
            { text: "Hence the sum of the squares on {BR} and {RU} is quadruple the square on {RU}.",
              visible: RBV,
              highlighted: ["RB","RU"] },
            { text: "But the square on {BU} equals the sum of the squares on {BR} and {RU},",
              visible: RBV.concat(["rtBRU"]),
              highlighted: ["BU","RB","RU","rtBRU"],
              transition: { animations: [
                  { elem: "rtBRU", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "square on BU = squares on BR, RU", ref: "I.47" }] },
            { text: "therefore the square on {BU} is quadruple the square on {RU}. Therefore {BU} is double {RU}.",
              visible: RBV,
              highlighted: ["BU","RU"] },
            { text: "But {VU} is also double {UR}, for {SR} is also double {PR}, that is, of {RU},",
              visible: RBV,
              highlighted: ["UV","RU","RS","RP"] },
            { text: "therefore {BU} equals {UV}.",
              visible: RBV,
              highlighted: ["BU","UV"] },
            { text: "Similarly it can be proved that each of the straight lines {BW}, {WC}, and {CV}",
              visible: RBV,
              highlighted: ["BW","WC","CV"] },
            { text: "also equals each of the straight lines {BU} and {UV}.",
              visible: RBV,
              highlighted: ["BW","WC","CV","BU","UV"] },
            { text: "Therefore the pentagon {BUVCW|pentT} is equilateral.",
              visible: RBV,
              highlighted: ["pentT"] },
            { text: "I say next that it is also in one plane.",
              visible: RBV,
              highlighted: ["pentT"] },
            { text: "Draw {PX} from {P} parallel to each of the straight lines {RU} and {SV} and toward the outside of the cube,",
              visible: PXV,
              highlighted: ["PX","RU","SV"],
              transition: { animations: [
                  { elem: "PX", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "X",  name: geomlib.A.Point.appear } ] },
              justifications: [{ claim: "PX parallel to RU, SV", ref: "I.31" }] },
            { text: "and join {XH} and {HW}.",
              visible: XHW,
              highlighted: ["XH","HW"],
              transition: { animations: [
                  { elem: "XW", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "I say that {XHW|XW} is a straight line.",
              visible: XHW,
              highlighted: ["XW"] },
            { text: "Since {HQ} is cut in extreme and mean ratio at {T}, and {QT} is its greater segment,",
              visible: XHW,
              highlighted: ["HQ","T","TQ"] },
            { text: "therefore {HQ} is to {QT} as {QT} is to {TH}.",
              visible: XHW,
              highlighted: ["HQ","TQ","TH"] },
            { text: "But {HQ} equals {HP}, and {QT} equals each of the straight lines {TW} and {PX},",
              visible: XHW,
              highlighted: ["HQ","HP","TQ","TW","PX"] },
            { text: "therefore {HP} is to {PX} as {WT} is to {TH}.",
              visible: XHW,
              highlighted: ["HP","PX","TW","TH"] },
            { text: "And {HP} is parallel to {TW}, for each of them is at right angles to the plane {BD|ABCDt},",
              visible: XHW.concat(["rtPHQ","rtWTQ"]),
              highlighted: ["HP","TW","ABCDt","rtPHQ","rtWTQ"],
              transition: { mode: "parallel", animations: [
                  { elem: "rtPHQ", name: geomlib.A.Sector.sweep },
                  { elem: "rtWTQ", name: geomlib.A.Sector.sweep } ] } },
            { text: "and {TH} is parallel to {PX}, for each of them is at right angles to the plane {BF|CBEFt}.",
              visible: XHW.concat(["rtPHQ","rtXPH"]),
              highlighted: ["TH","PX","CBEFt","rtPHQ","rtXPH"],
              transition: { animations: [
                  { elem: "rtXPH", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "perpendiculars to one plane are parallel", ref: "XI.6" }] },
            { text: "But if two triangles {XPH} and {HTW}, which have two sides proportional to two sides",
              visible: XHW,
              highlighted: ["XPH","HTW"] },
            { text: "are placed together at one angle so that their corresponding sides are also parallel,",
              visible: XHW,
              highlighted: ["HP","TW","PX","TH"] },
            { text: "then the remaining straight lines are in a straight line,",
              visible: XHW,
              highlighted: ["XH","HW"] },
            { text: "therefore {XH} is in a straight line with {HW}.",
              visible: XHW,
              highlighted: ["XH","HW"],
              justifications: [{ claim: "XH, HW in a straight line", ref: "VI.32" }] },
            { text: "But every straight line is in one plane, therefore the pentagon {UBWCV|pentT} is in one plane.",
              visible: XHW,
              highlighted: ["XW","pentT"],
              justifications: [{ claim: "a straight line is in one plane", ref: "XI.1" }] },
            { text: "I say next that it is also equiangular.",
              visible: XHW,
              highlighted: ["pentT"] },
            { text: "Since the straight line {NP} is cut in extreme and mean ratio at {R}, and {PR} is the greater segment,",
              visible: XHW,
              highlighted: ["NP","R","RP"] },
            { text: "while {PR} equals {PS},",
              visible: XHW,
              highlighted: ["RP","PS"] },
            { text: "therefore {NS} is also cut in extreme and mean ratio at {P}, and {NP} is the greater segment.",
              visible: XHW,
              highlighted: ["NS","P","NP"],
              justifications: [{ claim: "NS cut in extreme and mean ratio at P", ref: "XIII.5" }] },
            { text: "Therefore the sum of the squares on {NS} and {SP} is triple the square on {NP}.",
              visible: XHW,
              highlighted: ["NS","PS","NP"],
              justifications: [{ claim: "squares on NS, SP = 3 square on NP", ref: "XIII.4" }] },
            { text: "But {NP} equals {NB}, and {PS} equals {SV},",
              visible: XHW,
              highlighted: ["NP","NB","PS","SV"] },
            { text: "therefore the squares on {NS} and {SV} is triple the square on {NB}.",
              visible: XHW,
              highlighted: ["NS","SV","NB"] },
            { text: "Hence the sum of the squares on {VS}, {SN}, and {NB} is quadruple the square on {NB}.",
              visible: XHW,
              highlighted: ["SV","NS","NB"] },
            { text: "But the square on {SB} equals the sum of the squares on {SN} and {NB},",
              visible: XHW.concat(["rtBNR"]),
              highlighted: ["SB","NS","NB","rtBNR"] },
            { text: "therefore the sum of the squares on {BS} and {SV}, that is, the square on {BV},",
              visible: XHW,
              highlighted: ["SB","SV","VB"] },
            { text: "for the angle {VSB|rtVSB} is right, is quadruple the square on {NB}. Therefore {VB} is double {BN}.",
              visible: XHW.concat(["rtVSB"]),
              highlighted: ["rtVSB","VB","NB"],
              transition: { animations: [
                  { elem: "rtVSB", name: geomlib.A.Sector.sweep } ] } },
            { text: "But {BC} is also double {BN}, therefore {BV} equals {BC}.",
              visible: XHW,
              highlighted: ["BC","NB","VB"] },
            { text: "And, since the two sides {BU} and {UV} equal the two sides {BW} and {WC},",
              visible: XHW,
              highlighted: ["BU","UV","BW","WC"] },
            { text: "and the base {BV} equals the base {BC},",
              visible: XHW,
              highlighted: ["VB","BC"] },
            { text: "therefore the angle {BUV|angBUV} equals the angle {BWC|angBWC}.",
              visible: XHW.concat(["angBUV","angBWC"]),
              highlighted: ["angBUV","angBWC"],
              transition: { mode: "parallel", animations: [
                  { elem: "angBUV", name: geomlib.A.Sector.sweep },
                  { elem: "angBWC", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "angle BUV = angle BWC", ref: "I.8" }] },
            { text: "Similarly we can prove that the angle {UVC|angUVC} also equals the angle {BWC|angBWC}.",
              visible: XHW.concat(ANG),
              highlighted: ["angUVC","angBWC"],
              transition: { animations: [
                  { elem: "angUVC", name: geomlib.A.Sector.sweep } ] } },
            { text: "Therefore the three angles {BWC|angBWC}, {BUV|angBUV}, and {UVC|angUVC} equal one another.",
              visible: XHW.concat(ANG),
              highlighted: ANG },
            { text: "But if in an equilateral pentagon three angles equal one another, then the pentagon is equiangular,",
              visible: XHW.concat(ANG),
              highlighted: ["pentT"].concat(ANG) },
            { text: "therefore the pentagon {BUVCW|pentT} is equiangular.",
              visible: XHW.concat(ANG),
              highlighted: ["pentT"],
              justifications: [{ claim: "three equal angles make it equiangular", ref: "XIII.7" }] },
            { text: "And it was also proved equilateral, therefore the pentagon {BUVCW|pentT} is equilateral and equiangular,",
              visible: XHW,
              highlighted: ["pentT"] },
            { text: "and it is on one side {BC} of the cube.",
              visible: XHW,
              highlighted: ["pentT","BC"] },
            { text: "Therefore, if we make the same construction in the case of each of the twelve sides of the cube,",
              visible: XHW,
              highlighted: ["ABCDt","CBEFt"] },
            { text: "a solid figure will be constructed which is contained by twelve equilateral and equiangular pentagons,",
              visible: XHW,
              highlighted: ["pentT"] },
            { text: "and which is called a dodecahedron.",
              visible: XHW,
              highlighted: ["pentT"],
              justifications: [{ claim: "the dodecahedron", ref: "XI.Def.28" }] },
            { text: "It is now required to comprehend it in the given sphere,",
              visible: XHW },
            { text: "and to prove that the side of the dodecahedron is the irrational straight line called apotome.",
              visible: XHW,
              highlighted: ["UV"] },
            { text: "Produce {XP}, and let the produced straight line be {XZ}.",
              visible: PRO,
              highlighted: ["XZ"],
              transition: { animations: [
                  { elem: "XZ", name: geomlib.A.Line.straightEdgeExtend } ] } },
            { text: "Therefore {PZ} meets {the diameter of the cube|AFd}, and they bisect one another,",
              visible: PRO,
              highlighted: ["PZ","AFd"] },
            { text: "for this has been proved in the next to the last theorem of the eleventh book.",
              visible: PRO,
              highlighted: ["PZ","AFd"],
              justifications: [{ claim: "PZ and the diameter bisect one another", ref: "XI.38" }] },
            { text: "Let them cut at {Z}. Therefore {Z} is the center of the sphere which comprehends the cube,",
              visible: ZV,
              highlighted: ["Z","AFd"],
              transition: { animations: [
                  { elem: "Z", name: geomlib.A.Point.appear } ] } },
            { text: "and {ZP} is half of the side of the cube.",
              visible: ZV,
              highlighted: ["PZ"] },
            { text: "Join {UZ}.",
              visible: UZV,
              highlighted: ["UZ"],
              transition: { animations: [
                  { elem: "UZ", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Now, since the straight line {NS} is cut in extreme and mean ratio at {P}, and {NP} is its greater segment,",
              visible: UZV,
              highlighted: ["NS","P","NP"] },
            { text: "therefore the sum of the squares on {NS} and {SP} is triple the square on {NP}.",
              visible: UZV,
              highlighted: ["NS","PS","NP"],
              justifications: [{ claim: "squares on NS, SP = 3 square on NP", ref: "XIII.4" }] },
            { text: "But {NS} equals {XZ}, for {NP} also equals {PZ}, and {XP} equals {PS}.",
              visible: UZV,
              highlighted: ["NS","XZ","NP","PZ","PX","PS"] },
            { text: "But {PS} also equals {XU}, since it also equals {RP}.",
              visible: UZV,
              highlighted: ["PS","XU","RP"] },
            { text: "Therefore the sum of the squares on {ZX} and {XU} is triple the square on {NP}.",
              visible: UZV,
              highlighted: ["XZ","XU","NP"] },
            { text: "But the square on {UZ} equals the sum of the squares on {ZX} and {XU},",
              visible: UZV.concat(["rtUXZ"]),
              highlighted: ["UZ","XZ","XU","rtUXZ"],
              transition: { animations: [
                  { elem: "rtUXZ", name: geomlib.A.Sector.sweep } ] } },
            { text: "therefore the square on {UZ} is triple the square on {NP}.",
              visible: UZV,
              highlighted: ["UZ","NP"] },
            { text: "But the square on the radius of the sphere which comprehends the cube",
              visible: UZV,
              highlighted: ["Z"] },
            { text: "is also triple the square on the half of the side of the cube,",
              visible: UZV,
              highlighted: ["NP"] },
            { text: "for it has previously been shown how to construct a cube and comprehend it in a sphere,",
              visible: UZV,
              highlighted: ["ABCDt","CBEFt"] },
            { text: "and to prove that the square on the diameter of the sphere",
              visible: UZV,
              highlighted: ["AFd"] },
            { text: "is triple the square on the side of the cube.",
              visible: UZV,
              highlighted: ["AFd","BC"],
              justifications: [{ claim: "square on the diameter = 3 square on the side", ref: "XIII.15" }] },
            { text: "But, if the whole is so related to the whole as the half to the half also,",
              visible: UZV },
            { text: "and {NP} is half of the side of the cube,",
              visible: UZV,
              highlighted: ["NP"] },
            { text: "therefore {UZ} equals the radius of the sphere which comprehends the cube.",
              visible: UZV,
              highlighted: ["UZ"] },
            { text: "And {Z} is the center of the sphere which comprehends the cube,",
              visible: UZV,
              highlighted: ["Z"] },
            { text: "therefore the point {U} is on the surface of the sphere.",
              visible: UZV,
              highlighted: ["U","UZ"] },
            { text: "Similarly we can prove that each of the remaining angles of the dodecahedron",
              visible: UZV,
              highlighted: ["V","B","W","C"] },
            { text: "is also on the surface of the sphere,",
              visible: UZV,
              highlighted: ["V","B","W","C"] },
            { text: "therefore the dodecahedron has been comprehended in the given sphere.",
              visible: UZV,
              highlighted: ["pentT"] },
            { text: "I say next that the side of the dodecahedron is the irrational straight line called apotome.",
              visible: UZV,
              highlighted: ["UV"] },
            { text: "Since, when {NP} is cut in extreme and mean ratio, {RP} is the greater segment,",
              visible: UZV,
              highlighted: ["NP","RP"] },
            { text: "and, when {PO} is cut in extreme and mean ratio, {PS} is the greater segment,",
              visible: UZV,
              highlighted: ["PO","PS"] },
            { text: "therefore, when the whole {NO} is cut in extreme and mean ratio, {RS} is the great er segment.",
              visible: UZV,
              highlighted: ["NO","RS"] },
            { text: "Thus, since {NP} is to {PR} as {PR} is to {RN}, the same is true of the doubles also,",
              visible: UZV,
              highlighted: ["NP","RP","NR"] },
            { text: "for parts have the same ratio as their equimultiples,",
              visible: UZV,
              highlighted: ["NO","RS"],
              justifications: [{ claim: "parts and equimultiples", ref: "V.15" }] },
            { text: "therefore {NO} is to {RS} as {RS} is to the sum of {NR} and {SO}.",
              visible: UZV,
              highlighted: ["NO","RS","NR","SO"] },
            { text: "But {NO} is greater than {RS}, therefore {RS} is also greater than the sum of {NR} and {SO},",
              visible: UZV,
              highlighted: ["NO","RS","NR","SO"] },
            { text: "therefore {NO} is cut in extreme and mean ratio, and {RS} is its greater segment.",
              visible: UZV,
              highlighted: ["NO","RS"] },
            { text: "But {RS} equals {UV}, therefore, when {NO} is cut in extreme and mean ratio, {UV} is the greater segment.",
              visible: UZV,
              highlighted: ["RS","UV","NO"] },
            { text: "And, since the diameter of the sphere is rational,",
              visible: UZV,
              highlighted: ["AFd"] },
            { text: "and the square on it is triple the square on the side of the cube,",
              visible: UZV,
              highlighted: ["AFd","NO"] },
            { text: "therefore {NO}, being a side of the cube, is rational.",
              visible: UZV,
              highlighted: ["NO"] },
            { text: "But if a rational line is cut in extreme and mean ratio, each of the segments is an irrational apotome.",
              visible: UZV,
              highlighted: ["NO","RS"] },
            { text: "Therefore {UV}, being a side of the dodecahedron, is an irrational apotome.",
              visible: UZV,
              highlighted: ["UV"],
              justifications: [{ claim: "segments of a rational line are apotomes", ref: "XIII.6" },
                               { ref: "Q.E.F." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "XIII.17") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "I.3":       "/elements/books/bookI/propositions/propI3/",
