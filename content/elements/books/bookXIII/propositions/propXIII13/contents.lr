            { text: "and join {DA}.",
              visible: JDA,
              highlighted: ["AD"],
              transition: { mode: "cascade", animations: [
                  { elem: "AD", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ ref: "I.Post.1" }] },
            { text: "Set out the circle {EFG|EFGc} with radius equal to {DC},",
              visible: CIRC,
              highlighted: ["EFGc","CD"],
              transition: { mode: "cascade", animations: [
                  { elem: "EFGc", name: geomlib.A.Circle.compass } ] },
              justifications: [{ ref: "I.1" }] },
            { text: "inscribe the equilateral triangle {EFG} in the circle {EFG|EFGc},",
              visible: TRI,
              highlighted: ["EFG"],
              transition: { mode: "cascade", animations: [
                  { elem: "EFG", name: geomlib.A.Polygon.outline } ] },
              justifications: [{ ref: "IV.2" }] },
            { text: "take the center {H} of the circle, and join {EH}, {HF}, and {HG}.",
