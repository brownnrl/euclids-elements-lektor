                  { elem: "angKHF", name: geomlib.A.Sector.sweep },
                  { elem: "angKHG", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ ref: "XI.Def.3" }] },
            { text: "And, since {AC} equals {HK}, and {CD} equals {HE}, and they contain right angles,",
              visible: RT,
              highlighted: ["AC","HK","CD","HE","angACD","angKHE"] },
            { text: "therefore the base {DA} equals the base {KE}.",
              visible: RT,
              highlighted: ["AD","KE"],
              justifications: [{ claim: "base DA = base KE", ref: "I.4" }] },
            { text: "For the same reason each of the straight lines {KF} and {KG} also equals {DA}.",
              visible: RT,
              highlighted: ["KF","KG","AD"] },
            { text: "Therefore the three straight lines {KE}, {KF}, and {KG} equal one another.",
              visible: RT,
              highlighted: ["KE","KF","KG"] },
            { text: "And, since {AC} is double {CB}, therefore {AB} is triple {BC}.",
              visible: RT,
              highlighted: ["AC","CB","AB"] },
            { text: "But that {AB} is to {BC} as the square on {AD} is to the square on {DC} will be proved afterwards.",
              visible: RT,
