                  { elem: "semi", name: geomlib.A.Sector.sweep } ] } },
            { text: "draw {CD} from the point {C} at right angles to {AB},",
              visible: PERP,
              highlighted: ["CD","angACD"],
              transition: { mode: "cascade", animations: [
