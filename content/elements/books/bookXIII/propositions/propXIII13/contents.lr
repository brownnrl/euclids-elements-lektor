            "D;point;last;Dch",
            "CD;line;connect;C,D",
            "AD;line;connect;A,D",
            "M;point;free;290,145;0",
            "Msphere;sphere;radius;M,ABmid,A;0;0;lightGray",
            "K;point;sphereSlider;Msphere,200,80,100",
            "L;point;extend;K,M,M,K",
            "H;point;cutoff;K,L,A,C",
            "KL;line;connect;K,L",
            "EFGplane;plane;perpendicular;H,K;0;0;0;0",
            "EFGcirc;circle;radius;H,D,C,EFGplane",
            "E;point;circleSlider;EFGcirc,260,30,-20",
            "N;point;extend;E,H,E,H;0;0",
            "Ncirc;circle;radius;N,H,EFGplane;0;0;0;0",
            "FG;line;bichord;EFGcirc,Ncirc;0;0;0",
            "F;point;first;FG",
            "G;point;last;FG",
            "EFGK;polyhedron;tetrahedron;E,F,G,K;0;0;black;random",
            "HE;line;connect;H,E",
            "HF;line;connect;H,F",
            "HG;line;connect;H,G",
            // Slide twins, hidden at rest (see above).
            "EFG;polygon;triangle;E,F,G;0;0;black;0",
            "HK;line;connect;H,K",
            "KE;line;connect;K,E",
            "KF;line;connect;K,F",
            "KG;line;connect;K,G",
            "HL;line;connect;H,L",
            "EFGc;circle;radius;H,D,C,EFGplane;0;0;black;0",
            // Transparent highlight targets.
            "semiT;sector;sector;ABmid,B,A;0;0;0;0",
                        "sphT;circle;radius;M,ABmid,A;0;0;0;0",
            "AC;line;connect;A,C;0;0;0",
            "CB;line;connect;C,B;0;0;0",
            "EF;line;connect;E,F;0;0;0",
            "GE;line;connect;G,E;0;0;0",
            "FL;line;connect;F,L;0;0;0",
            "LG;line;connect;L,G;0;0;0",
            "KEF;polygon;triangle;K,E,F;0;0;0;0",
            "KFG;polygon;triangle;K,F,G;0;0;0;0",
            "KEG;polygon;triangle;K,E,G;0;0;0;0",
            "HKE;polygon;triangle;H,K,E;0;0;0;0",
            "pEFGK;polygon;octagon;E,F,G,K,E,G,K,F;0;0;0;0",
            "KELpl;plane;3points;K,E,L;0;0;0;0",
            "KFLpl;plane;3points;K,F,L;0;0;0;0",
            "KGLpl;plane;3points;K,G,L;0;0;0;0",
            "KELc;circle;radius;M,K,KELpl;0;0;0;0",
            "KFLc;circle;radius;M,K,KFLpl;0;0;0;0",
            "KGLc;circle;radius;M,K,KGLpl;0;0;0;0",
            // Right angles.
            "angACD;sector;angleMarkerRight;C,A,D",
            "angKHE;sector;angleMarkerRight;H,K,E",
            "angKHF;sector;angleMarkerRight;H,K,F",
            "angKHG;sector;angleMarkerRight;H,K,G",
            "angEHL;sector;angleMarkerRight;H,E,L",
            "angKFL;sector;angleMarkerRight;F,K,L",
            "angKGL;sector;angleMarkerRight;G,K,L"
        ],
        initiallyHidden: ["EFGc","EFG","HK","KE","KF","KG","HL"],
        deferDraggables: ["M","K","E"],
        aliases: { "DA": "AD", "DC": "CD", "BA": "AB", "BC": "CB", "KH": "HK",
                   "EH": "HE", "FE": "EF",
                   "KHE": "angKHE", "EHL": "angEHL" },
        slides: [
            { text: "“To construct a pyramid,”",
              visible: REST,
              highlighted: ["pEFGK"],
              justifications: [{ ref: "XIII.13" }] },
            { text: "“to comprehend it in a given sphere;”",
              visible: REST,
              highlighted: ["pEFGK","sphT"] },
            { text: "“and to prove that the square on the diameter of the sphere”",
              visible: REST,
              highlighted: ["KL"] },
            { text: "“is one and a half times the square on the side of the pyramid.”",
              visible: REST,
              highlighted: ["KL","EF"] },
            { text: "Set out the diameter {AB} of the given sphere,",
              visible: GIVEN,
              highlighted: ["AB"] },
            { text: "cut it at the point {C} so that {AC} is double {CB},",
              visible: CUT,
              highlighted: ["AC","CB"],
