              highlighted: ["HK","EFGc"] },
            { text: "But each of the straight lines {HE}, {HF}, and {HG} meets it,",
              visible: JK,
              highlighted: ["HE","HF","HG","HK"] },
            { text: "therefore {HK} is at right angles to each of the straight lines {HE}, {HF}, and {HG}.",
              visible: RT,
              highlighted: ["HK","HE","HF","HG"],
              transition: { mode: "parallel", animations: [
