    var CEN   = GIVEN.concat(["F"]);
    var J1    = CEN.concat(["AF","FG","G","BF"]);
    var P1    = J1.concat(["FH","H","rtH"]);
    var P2    = P1.concat(["HK","K"]);
    var P3    = P2.concat(["AK","BK"]);
    var P4    = P3.concat(["FL","L","rtL"]);
    var CONS  = P4.concat(["LM","M","N","KN"]);
    var X1    = CONS.concat(["angAFK","angKFB"]);
    var X2    = X1.concat(["angGFB","angBFM"]);
    var X3    = X2.concat(["angFAB","angABF"]);
    var X4    = X3.concat(["angAFB","angBNF"]);
    // The second argument starts afresh at "Again": the first one's
    // markers are dropped so the small region round K and N stays legible.
    var Y1    = CONS.concat(["angLKN","angLAN"]);
    var Y2    = Y1.concat(["angKBN"]);
    var Y3    = Y2.concat(["angAKB","angKNA"]);
