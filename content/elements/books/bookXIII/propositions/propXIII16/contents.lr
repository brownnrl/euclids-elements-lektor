            "W;point;extend;V,a,V,a",
            "Vplane;plane;perpendicular;V,a;0;0;0;0",
            "Vcirc;circle;radius;V,D,B,Vplane;0;0;black;0",
            "E;point;circleSlider;Vcirc,240,30,-20",
            "ELcirc;circle;radius;E,W,Z,Vplane;0;0;0;0",
            "LP;line;bichord;Vcirc,ELcirc;0;0",
            "L;point;first;LP",
