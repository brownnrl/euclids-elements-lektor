    // Draggables (checked against the bundle): A and B, free — the given
    // pentagon's side, standing from slide 1. C, D, E, F are derived and
    // listed per slide; nothing to defer.
    var GIVEN = ["pentagon","pentT","A","B","C","D","E"];
    var CIRC  = GIVEN.concat(["circ","F"]);
    var RAD   = CIRC.concat(["AF","BF","CF","DF","EF"]);
    geomlib.init({
