            "EF;line;connect;E,F",
            // Faceless twin of the pentagon (see above).
            "pentT;polygon;pentagon;A,B,C,D,E;0;0;0;0",
            // Angle markers.
            "angAFB;sector;angleMarker;F,A,B;0;0;3b6ea5;9ec5e8",
            "angFAB;sector;angleMarker;A,F,B;0;0;3f8e4f;a8dbb0",
            "angABF;sector;angleMarker;B,A,F;0;0;3f8e4f;a8dbb0",
            "angFBC;sector;angleMarker;B,F,C;0;0;3f8e4f;a8dbb0",
            "angABC;sector;angleMarker;B,A,C;0;0;b5651d;f0c08a"
        ],
        aliases: { "FA": "AF", "FB": "BF", "FC": "CF", "FD": "DF", "FE": "EF" },
        slides: [
            { text: "But that the angle of the equilateral and equiangular pentagon is a right angle and a fifth",
              visible: GIVEN.concat(["angABC"]),
