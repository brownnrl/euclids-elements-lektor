            "D;point;vertex;BAEDC,4",
            "E;point;vertex;BAEDC,3",
            "circ;circle;circumcircle;A,B,D;0;0;black;0",
            "AC;line;connect;A,C",
            "BE;line;connect;B,E",
            "H;point;intersection;AC,BE",
