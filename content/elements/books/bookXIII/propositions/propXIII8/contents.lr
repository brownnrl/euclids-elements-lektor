            "pentT;polygon;regularPolygon;B,A,5;0;0;0;0",
            // Transparent highlight targets.
            "AB;line;connect;A,B;0;0;0",
            "BC;line;connect;B,C;0;0;0",
            "CD;line;connect;C,D;0;0;0",
            "DE;line;connect;D,E;0;0;0",
            "EA;line;connect;E,A;0;0;0",
            "HE;line;connect;H,E;0;0;0",
            "HB;line;connect;H,B;0;0;0",
            "AH;line;connect;A,H;0;0;0",
            "CH;line;connect;C,H;0;0;0",
            "ABE;polygon;triangle;A,B,E;0;0;0;0",
            "ABC;polygon;triangle;A,B,C;0;0;0;0",
            "ABH;polygon;triangle;A,B,H;0;0;0;0",
            "Oc;point;center;circ;0;0",
            "Mbc;point;midpoint;B,C;0;0",
            "Xcb;point;cutoff;Oc,Mbc,Oc,A;0;0",
            "arcEDC;sector;arc;E,D,C;0;0;0;0",
            "arcCB;sector;arc;C,Xcb,B;0;0;0;0",
