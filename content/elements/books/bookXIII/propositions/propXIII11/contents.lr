            "N4;point;free;40,1000;0;0",
            "N2;point;lineSlider;N1,N4,40,60;0",
            "N3;point;cutoff;N2,N4,B,W;0",
            "N;line;connect;N2,N3;black",
            // Faceless twin of the circle (see above).
            "circT;circle;circumcircle;C,D,A;0;0;0;0",
