                   "DC": "CD", "CA": "AC", "HB": "BH", "DA": "AD", "HA": "AH" },
        slides: [
            { text: "“If an equilateral pentagon is inscribed in a circle which has its diameter rational,”",
              visible: GIVEN,
              highlighted: ["CDEAB","circT"],
              justifications: [{ ref: "XIII.11" }] },
            { text: "“then the side of the pentagon is the irrational straight line called minor.”",
              visible: GIVEN,
              highlighted: ["AB"] },
            { text: "In the circle {ABCDE|circT} which has its diameter rational let the equilateral pentagon {ABCDE|CDEAB} be inscribed.",
              visible: GIVEN,
              highlighted: ["circT","CDEAB"] },
            { text: "I say that the side of the pentagon is the irrational straight line called minor.",
              visible: GIVEN,
              highlighted: ["AB"] },
            { text: "Take the center {F} of the circle,",
              visible: CEN,
              highlighted: ["F"],
              transition: { animations: [
                  { elem: "F", name: geomlib.A.Point.appear } ] },
              justifications: [{ claim: "the center F", ref: "III.1" }] },
            { text: "join {AF} and {FB} and carry them through to the points {G} and {H},",
              visible: DIAM,
              highlighted: ["AG","BH","G","H"],
              transition: { animations: [
                  { elem: "AG", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "BH", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "join {AC}, and make {FK} a fourth part of {AF}.",
              visible: SETK,
              highlighted: ["AC","FK","AF"],
              transition: { animations: [
                  { elem: "AC", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "K",  name: geomlib.A.Point.appear } ] },
              justifications: [{ claim: "FK a fourth part of AF", ref: "VI.9" }] },
            { text: "Now {AF} is rational, therefore {FK} is also rational.",
              visible: SETK,
              highlighted: ["AF","FK"] },
            { text: "But {BF} is also rational, therefore the whole {BK} is rational.",
              visible: SETK,
              highlighted: ["FB","BK"] },
            { text: "And, since the circumference {ACG|arcACG} equals the circumference {ADG|arcADG},",
              visible: ARCS,
              highlighted: ["arcACG","arcADG"] },
            { text: "and in them {ABC|arcABC} equals {AED|arcAED},",
              visible: ARCS,
              highlighted: ["arcABC","arcAED"] },
            { text: "therefore the remainder {CG|arcCG} equals the remainder {GD|arcGD}.",
              visible: ARCS,
              highlighted: ["arcCG","arcGD"] },
            { text: "And, if we join {AD},",
              visible: JAD,
              highlighted: ["AD"],
              transition: { animations: [
                  { elem: "AD", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "then we conclude that the angles at {L} are right, and {CD} is double {CL}.",
              visible: LR,
              highlighted: ["L","angALC","angALD","CD","CL"],
              transition: { mode: "parallel", animations: [
                  { elem: "angALC", name: geomlib.A.Sector.sweep },
                  { elem: "angALD", name: geomlib.A.Sector.sweep } ] } },
            { text: "For the same reason the angles at {M} are also right, and {AC} is double {CM}.",
              visible: MR,
              highlighted: ["M","angAMB","angAMF","AC","CM"],
              transition: { mode: "parallel", animations: [
                  { elem: "angAMB", name: geomlib.A.Sector.sweep },
                  { elem: "angAMF", name: geomlib.A.Sector.sweep } ] } },
            { text: "Since then the angle {ALC|angALC} equals the angle {AMF|angAMF},",
              visible: MR,
              highlighted: ["angALC","angAMF"] },
            { text: "and the angle {LAC|angLAC} is common to the two triangles {ACL} and {AMF},",
              visible: TRI,
              highlighted: ["angLAC","ACL","AMF"],
              transition: { mode: "parallel", animations: [
                  { elem: "angLAC", name: geomlib.A.Sector.sweep },
                  { elem: "ACL", name: geomlib.A.Polygon.outline },
                  { elem: "AMF", name: geomlib.A.Polygon.outline } ] } },
            { text: "therefore the remaining angle {ACL|angACL} equals the remaining angle {MFA|angMFA}.",
              visible: EQ,
              highlighted: ["angACL","angMFA"],
              transition: { mode: "parallel", animations: [
                  { elem: "angACL", name: geomlib.A.Sector.sweep },
                  { elem: "angMFA", name: geomlib.A.Sector.sweep } ] },
              justifications: [{ claim: "remaining angles of the triangles", ref: "I.32" }] },
            { text: "Therefore the triangle {ACL} is equiangular with the triangle {AMF}.",
              visible: EQ,
              highlighted: ["ACL","AMF"] },
            { text: "Therefore, proportionally {LC} is to {CA} as {MF} is to {FA}.",
              visible: EQ,
              highlighted: ["CL","AC","MF","AF"] },
            { text: "Taking the doubles of the antecedents, therefore double {LC} is to {CA} as double {MF} to {FA}.",
              visible: EQ,
              highlighted: ["CL","AC","MF","AF"] },
            { text: "But double {MF} is to {FA} as {MF} is to the half of {FA},",
              visible: EQ,
              highlighted: ["MF","AF"] },
            { text: "therefore also double {LC} is to {CA} as {MF} is to the half of {FA}.",
              visible: EQ,
              highlighted: ["CL","AC","MF","AF"] },
            { text: "Taking the halves of the consequents,",
              visible: EQ,
              highlighted: ["AC","AF"] },
            { text: "therefore double {LC} is to the half of {CA} as {MF} to the fourth of {FA}.",
              visible: EQ,
              highlighted: ["CL","AC","MF","AF"] },
            { text: "And {DC} is double {LC}, {CM} is half of {CA}, and {FK} is a fourth part of {FA},",
              visible: EQ,
              highlighted: ["CD","CL","CM","AC","FK","AF"] },
            { text: "therefore {DC} is to {CM} as {MF} to {FK}.",
              visible: EQ,
              highlighted: ["CD","CM","MF","FK"] },
            { text: "Taken together, the sum of {DC} and {CM} is to {CM} as {MK} to {KF}.",
              visible: EQ,
              highlighted: ["CD","CM","MK","FK"],
              justifications: [{ claim: "taken together", ref: "V.18" }] },
            { text: "Therefore the square on the sum of {DC} and {CM} is to the square on {CM}",
              visible: EQ,
              highlighted: ["CD","CM"] },
            { text: "as the square on {MK} is to the square on {KF}.",
              visible: EQ,
              highlighted: ["MK","FK"] },
            { text: "And since, when the straight line opposite two sides of the pentagon {AC} is cut in extreme and mean ratio,",
              visible: EQ,
              highlighted: ["AC"] },
            { text: "the greater segment equals the side of the pentagon, that is, {DC},",
              visible: EQ,
              highlighted: ["CD"],
              justifications: [{ claim: "greater segment = side of the pentagon", ref: "XIII.8" }] },
            { text: "while the square on the greater segment added to the half of the whole",
              visible: EQ,
              highlighted: ["CD"] },
            { text: "is five times the square on the half of the whole,",
              visible: EQ,
              highlighted: ["AC"],
              justifications: [{ ref: "XIII.1" }] },
            { text: "and {CM} is half of the whole {AC},",
              visible: EQ,
              highlighted: ["CM","AC"] },
            { text: "therefore the square on {DC} and {CM} taken as one straight line is five times the square on {CM}.",
              visible: EQ,
              highlighted: ["CD","CM"] },
            { text: "But it was proved that the square on {DC} and {CM} taken as one straight line",
              visible: EQ,
              highlighted: ["CD","CM"] },
            { text: "is to the square on {CM} as the square on {MK} to the square on {KF},",
              visible: EQ,
              highlighted: ["CM","MK","FK"] },
            { text: "therefore the square on {MK} is five times the square on {KF}.",
              visible: EQ,
              highlighted: ["MK","FK"] },
            { text: "But the square on {KF} is rational, for the diameter is rational,",
              visible: EQ,
              highlighted: ["FK","AG"] },
            { text: "therefore the square on {MK} is also rational. Therefore {MK} is rational.",
              visible: EQ,
              highlighted: ["MK"] },
            { text: "And, since {BF} is quadruple {FK}, therefore {BK} is five times {KF}.",
              visible: EQ,
              highlighted: ["FB","FK","BK"] },
            { text: "Therefore the square on {BK} is twenty-five times the square on {KF}.",
              visible: EQ,
              highlighted: ["BK","FK"] },
            { text: "But the square on {MK} is five times the square on {KF},",
              visible: EQ,
              highlighted: ["MK","FK"] },
            { text: "therefore the square on {BK} is five times the square on {KM}.",
              visible: EQ,
              highlighted: ["BK","MK"] },
            { text: "Therefore the square on {BK} has not to the square on {KM}",
              visible: EQ,
              highlighted: ["BK","MK"] },
            { text: "the ratio which a square number has to a square number.",
              visible: EQ,
              highlighted: ["BK","MK"] },
            { text: "Therefore {BK} is incommensurable in length with {KM}.",
              visible: EQ,
              highlighted: ["BK","MK"],
              justifications: [{ ref: "X.9" }] },
            { text: "And each of them is rational. Therefore {BK} and {KM} are rational straight lines commensurable in square only.",
              visible: EQ,
              highlighted: ["BK","MK"] },
            { text: "But, if from a rational straight line there is subtracted a rational straight line",
              visible: EQ,
              highlighted: ["BK","MK"] },
            { text: "which is commensurable with the whole in square only,",
              visible: EQ,
              highlighted: ["BK","MK"] },
            { text: "then the remainder is irrational, namely an apotome,",
              visible: EQ,
              highlighted: ["MB"],
              justifications: [{ ref: "X.73" }] },
            { text: "therefore {MB} is an apotome and {MK} the annex to it.",
              visible: EQ,
              highlighted: ["MB","MK"] },
            { text: "I say next that {MB} is also a fourth apotome.",
              visible: EQ,
              highlighted: ["MB"] },
            { text: "Let the square on {N} be equal to",
              visible: NN,
              highlighted: ["N"],
              transition: { animations: [
                  { elem: "N", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "that by which the square on {BK} is greater than the square on {KM}.",
              visible: NN,
              highlighted: ["BK","MK"] },
            { text: "Therefore the square on {BK} is greater than the square on {KM} by the square on {N}.",
              visible: NN,
              highlighted: ["BK","MK","N"] },
            { text: "And, since {KF} is commensurable with {FB}, taken together, {KB} is commensurable with {FB}.",
              visible: NN,
              highlighted: ["FK","FB","BK"],
              justifications: [{ ref: "X.15" }] },
            { text: "But {BF} is commensurable with {BH}, therefore {BK} is also commensurable with {BH}.",
              visible: NN,
              highlighted: ["FB","BH","BK"],
              justifications: [{ ref: "X.12" }] },
            { text: "And, since the square on {BK} is five times the square on {KM},",
              visible: NN,
              highlighted: ["BK","MK"] },
            { text: "therefore the square on {BK} has to the square on {KM} the ratio which 5 has to 1.",
              visible: NN,
              highlighted: ["BK","MK"] },
            { text: "Therefore, in conversion, the square on {BK} has to the square on {N} the ratio which 5 has to 4,",
              visible: NN,
              highlighted: ["BK","N"],
              justifications: [{ claim: "in conversion", ref: "V.19.Cor" }] },
            { text: "and this is not the ratio which a square number has to a square number.",
              visible: NN,
              highlighted: ["BK","N"] },
            { text: "Therefore {BK} is incommensurable with {N}.",
              visible: NN,
              highlighted: ["BK","N"],
              justifications: [{ ref: "X.9" }] },
            { text: "Therefore the square on {BK} is greater than the square on {KM}",
              visible: NN,
              highlighted: ["BK","MK"] },
            { text: "by the square on a straight line incommensurable with {BK}.",
              visible: NN,
              highlighted: ["N","BK"] },
            { text: "Since then the square on the whole {BK} is greater than the square on the annex {KM}",
              visible: NN,
              highlighted: ["BK","MK"] },
            { text: "by the square on a straight line incommensurable with {BK},",
              visible: NN,
              highlighted: ["N","BK"] },
            { text: "and the whole {BK} is commensurable with the rational straight line, {BH}, set out,",
              visible: NN,
              highlighted: ["BK","BH"] },
            { text: "therefore {MB} is a fourth apotome.",
              visible: NN,
              highlighted: ["MB"],
              justifications: [{ ref: "X.Def.III.4" }] },
            { text: "But the rectangle contained by a rational straight line and a fourth apotome is irrational,",
              visible: NN,
              highlighted: ["BH","MB"] },
            { text: "and its square root is irrational, and is called minor.",
              visible: NN,
              highlighted: ["BH","MB"],
              justifications: [{ ref: "X.94" }] },
            { text: "But the square on {AB} equals the rectangle {HB} by {BM},",
              visible: NN,
              highlighted: ["AB","BH","MB"] },
            { text: "because, when {AH} is joined,",
              visible: AHJ,
              highlighted: ["AH"],
              transition: { animations: [
                  { elem: "AH", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "the triangle {ABH} is equiangular with the triangle {ABM},",
              visible: AHJ,
              highlighted: ["ABH","ABM"],
              transition: { mode: "parallel", animations: [
                  { elem: "ABH", name: geomlib.A.Polygon.outline },
                  { elem: "ABM", name: geomlib.A.Polygon.outline } ] } },
            { text: "and {HB} is to {BA} as {AB} is to {BM}.",
              visible: AHJ,
              highlighted: ["BH","AB","MB"] },
            { text: "Therefore the side {AB} of the pentagon is the irrational straight line called minor.",
              visible: AHJ,
              highlighted: ["AB"] },
            { text: "Therefore, if an equilateral pentagon is inscribed in a circle which has its diameter rational,",
              visible: AHJ,
              highlighted: ["CDEAB","circT"] },
            { text: "then the side of the pentagon is the irrational straight line called minor.",
              visible: AHJ,
              highlighted: ["AB"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "XIII.11") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "I.32":        "/elements/books/bookI/propositions/propI32/",
        "III.1":       "/elements/books/bookIII/propositions/propIII1/",
        "V.18":        "/elements/books/bookV/propositions/propV18/",
        "V.19.Cor":    "/elements/books/bookV/propositions/propV19/#cor",
        "VI.9":        "/elements/books/bookVI/propositions/propVI9/",
        "X.Def.III.4": "/elements/books/bookX/definitions/defX.III.4/",
        "X.9":         "/elements/books/bookX/propositions/propX9/",
        "X.12":        "/elements/books/bookX/propositions/propX12/",
        "X.15":        "/elements/books/bookX/propositions/propX15/",
        "X.73":        "/elements/books/bookX/propositions/propX73/",
        "X.94":        "/elements/books/bookX/propositions/propX94/",
