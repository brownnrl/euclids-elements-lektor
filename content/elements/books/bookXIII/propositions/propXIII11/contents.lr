            "B;point;vertex;CDEAB,5",
            "circ;circle;circumcircle;C,D,A;0;0;black;random",
            "CDEABdup;polygon;regularPolygon;C,D,5;0;0;black;random",
            "F;point;center;circ",
            "G;point;extend;A,F,A,F",
            "AG;line;connect;A,G",
            "H;point;extend;B,F,B,F",
            "BH;line;connect;B,H",
            "AC;line;connect;A,C",
            "K';point;midpoint;F,H;0;0",
            "K;point;midpoint;F,K'",
            "L;point;intersection;A,G,C,D",
            "M;point;intersection;B,H,A,C",
            "Kcirc;circle;radius;K,M;0;0;0;0",
            "Z;point;midpoint;B,K;0;0",
            "Zcirc;circle;radius;Z,B;0;0;0;0",
            "WW';line;bichord;Kcirc,Zcirc;0;0;0;0",
            "W;point;first;WW';0;0",
