            "FK;line;connect;F,K;0;0;0",
            "BK;line;connect;B,K;0;0;0",
            "MK;line;connect;M,K;0;0;0",
            "MB;line;connect;M,B;0;0;0",
            "MF;line;connect;M,F;0;0;0",
            "CM;line;connect;C,M;0;0;0",
            "CL;line;connect;C,L;0;0;0",
            "CD;line;connect;C,D;0;0;0",
            "ACL;polygon;triangle;A,C,L;0;0;0;0",
            "AMF;polygon;triangle;A,M,F;0;0;0;0",
            "ABH;polygon;triangle;A,B,H;0;0;0;0",
            "ABM;polygon;triangle;A,B,M;0;0;0;0",
            "Mcg;point;midpoint;C,G;0;0",
            "Xcg;point;cutoff;F,Mcg,F,A;0;0",
            "Mgd;point;midpoint;G,D;0;0",
            "Xgd;point;cutoff;F,Mgd,F,A;0;0",
            "arcACG;sector;arc;A,C,G;0;0;0;0",
            "arcADG;sector;arc;A,D,G;0;0;0;0",
            "arcABC;sector;arc;A,B,C;0;0;0;0",
            "arcAED;sector;arc;A,E,D;0;0;0;0",
            "arcCG;sector;arc;C,Xcg,G;0;0;0;0",
            "arcGD;sector;arc;G,Xgd,D;0;0;0;0",
            // Angle markers.
            "angALC;sector;angleMarkerRight;L,A,C,12;0;0;red;red",
            "angALD;sector;angleMarkerRight;L,A,D,12;0;0;red;red",
            "angAMB;sector;angleMarkerRight;M,A,B,12;0;0;red;red",
            "angAMF;sector;angleMarkerRight;M,A,F,12;0;0;red;red",
            "angLAC;sector;angleMarker;A,L,C;0;0;3b6ea5;9ec5e8",
            "angACL;sector;angleMarker;C,A,L;0;0;3f8e4f;a8dbb0",
