        aliases: { "DE": "DEh", "DH": "DHh", "FE": "FEh", "GD": "DG" },
        slides: [
            { text: "“If from a straight line there is subtracted a straight line which is incommensurable in square with the whole",
              visible: ALL,
              highlighted: ["AB","BC"],
              justifications: [{ ref: "X.78" }] },
            { text: "and which with the whole makes the sum of the squares on them medial,",
