            { text: "Then, in conversion, {AB} is to {BC} as the square on {FG} is to the square on {H}.",
              visible: ALL,
              highlighted: ["AB","CB","FG","H"],
              justifications: [{ claim: "AB : BC = FG² : H²", ref: "V.19.Cor" }] },
            { text: "But {AB} has to {BC} the ratio which a square number has to a square number,",
              visible: ALL,
              highlighted: ["AB","CB"] },
            { text: "therefore the square on {FG} also has to the square on {H} the ratio which a square number has to a square number.",
              visible: ALL,
              highlighted: ["FG","H"] },
            { text: "Therefore {FG} is commensurable in length with {H},",
              visible: ALL,
              highlighted: ["FG","H"],
              justifications: [{ claim: "FG, H commensurable in length", ref: "X.9" }] },
            { text: "so that the square on {FG} is greater than the square on {FE} by the square on a straight line commensurable with {FG}.",
              visible: ALL,
              highlighted: ["FG","EF","H"] },
            { text: "And {FG} and {FE} are rational straight lines commensurable in square only,",
              visible: ALL,
              highlighted: ["FG","EF"] },
            { text: "and {EF}, the lesser term, is commensurable in length with the rational straight line {D} set out.",
              visible: ALL,
              highlighted: ["EF","D"] },
            { text: "Therefore {EG} is a second binomial straight line.",
              visible: ALL,
              highlighted: ["EG"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
