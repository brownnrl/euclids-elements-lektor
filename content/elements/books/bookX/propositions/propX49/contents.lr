            "FEcirc;circle;radius;F,E;0;0;0;0",
            "bich;line;bichord;FGcirc,FEcirc;0;0;0",
            "H';point;first;bich;0;0",
            "H1;point;lineSlider;H0,H3,0,50;0",
            "H2;point;cutoff;H1,H3,G,H';0",
