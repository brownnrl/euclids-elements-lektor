            "E;point;free;210,40",
            "E';point;parallelogram;X,O,E;0;0",
            "F;point;lineSlider;E,E',150,40",
            "G';point;parallelogram;Y,O,E;0;0",
            "G;point;proportion;E,F,C,D,A,D,E,G'",
            "FG;polygon;parallelogram;F,E,G;0;0;black;cyan",
            "K;point;vertex;FG,4",
            "H;point;proportion;E,F,C,D,A',B,E,G'",
            "HK;polygon;parallelogram;H,G,K;0;0;black;pink",
            // Slide twin, hidden at rest (see above).
            "FHs;polygon;parallelogram;F,E,H;0;0;black;pink",
            // Highlight targets only — the figure already draws these.
            "EF;line;connect;E,F;0;0;0",
            "EH;line;connect;E,H;0;0;0",
            "EG;line;connect;E,G;0;0;0",
            "GH;line;connect;G,H;0;0;0",
            "ABh;polygon;parallelogram;A,A',B;0;0;0;0",
            "ACh;polygon;parallelogram;A,A',C;0;0;0;0",
            "BDh;polygon;parallelogram;B,C,D;0;0;0;0",
            "FHh;polygon;parallelogram;F,E,H;0;0;0;0",
            "FGh;polygon;parallelogram;F,E,G;0;0;0;0",
            "KHh;polygon;parallelogram;H,G,K;0;0;0;0"
        ],
        initiallyHidden: ["FHs"],
        deferDraggables: ["E","F"],
        slides: [
            { text: "“A medial area does not exceed a medial area by a rational area.”",
              visible: GIVEN,
              highlighted: ["ABh","ACh"],
              justifications: [{ ref: "X.26" }] },
            { text: "If possible, let the medial area {AB|ABh} exceed the medial area {AC|ACh} by the rational area {DB|BDh}.",
              visible: GIVEN,
              highlighted: ["ABh","ACh","BDh"] },
            { text: "Set out a rational straight line {EF}.",
              visible: EFS,
              transition: { animations: [
                  { elem: "EF", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Apply to {EF} the rectangular parallelogram {FH|FHh} equal to {AB|ABh} producing {EH} as breadth.",
              visible: FHS,
              highlighted: ["EF","ABh","EH"],
              transition: { animations: [
                  { elem: "FHh", name: geomlib.A.Polygon.outline } ] } },
            { text: "Subtract the rectangle {FG|FGh} equal to {AC|ACh}.",
              visible: ALL,
              highlighted: ["ACh"],
              transition: { animations: [
                  { elem: "FGh", name: geomlib.A.Polygon.outline } ] } },
            { text: "Then the remainder {BD|BDh} equals the remainder {KH|KHh}.",
              visible: ALL,
              highlighted: ["BDh","KHh"] },
            { text: "But {DB|BDh} is rational, therefore {KH|KHh} is also rational.",
              visible: ALL,
              highlighted: ["BDh","KHh"] },
            { text: "Since each of the rectangles {AB|ABh} and {AC|ACh} is medial, and {AB|ABh} equals {FH|FHh} while {AC|ACh} equals {FG|FGh},",
              visible: ALL,
              highlighted: ["ABh","ACh","FHh","FGh"] },
            { text: "therefore each of the rectangles {FH|FHh} and {FG|FGh} is also medial.",
              visible: ALL,
              highlighted: ["FHh","FGh"] },
            { text: "They are applied to the rational straight line {EF},",
              visible: ALL,
              highlighted: ["FHh","FGh","EF"] },
            { text: "therefore each of the straight lines {HE|EH} and {EG} is rational and incommensurable in length with {EF}.",
              visible: ALL,
              highlighted: ["EH","EG","EF"],
