            "CGcirc;circle;radius;G,C;0;0;0;0",
            "bich;line;bichord;BGcirc,CGcirc;0;0;0",
            "H2';point;first;bich;0;0",
            "H2;point;cutoff;H1,H3,G,H2';0",
            "H;line;connect;H1,H2;black",
            // Slide-only twins and highlight targets — invisible at rest.
            "GC;line;connect;G,C",
            "GB;line;connect;G,B",
            "BC;line;connect;B,C;0;0;0",
            "EF;line;connect;E,F;0;0;0",
            "DF;line;connect;D,F;0;0;0"
