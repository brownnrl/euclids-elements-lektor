_model: proposition
---
title: Proposition 86
---
order: 86
---
short_label: X.86
---
statement: To find the second apotome.
---
red_highlight: yes
---
proof:

Set out a rational straight line *A*, and let *GC* be commensurable in length with *A*. Then *GC* is rational. Set out two square numbers *DE* and *EF*, and let their difference *DF* not be square.

Now let it be contrived that *FD* is to *DE* as the square on *CG* is to the square on *GB*. [!just X.6.Cor]

<figure class="diagram">
<canvas id="canvas_0" width="280" height="90" tabindex="0"></canvas>
<noscript><img alt="X.86 diagram" src="propX86.gif"/></noscript>
<script type="text/javascript">
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "X.86",
        elements: [
            "A0;point;free;-1000,30;0;0",
            "A3;point;free;1000,30;0;0",
            "H0;point;free;-1000,65;0;0",
            "H3;point;free;1000,65;0;0",
            "A1;point;lineSlider;A0,A3,30,0;0",
            "A2;point;lineSlider;A0,A3,100,0;0",
            "A;line;connect;A1,A2;black",
            "C;point;lineSlider;A0,A3,160,0",
            "G;point;lineSlider;A0,A3,240,0",
            "D;point;lineSlider;H0,H3,230,0",
            "E;point;lineSlider;H0,H3,160,0",
            "F;point;lineSlider;H0,H3,190,0",
            "DE;line;connect;D,E;0;0;blue",
            "B';point;proportion;F,D,D,E,C,G,G,C;0;0",
            "B;point;meanProportional;C,G,G,B',G,C",
            "BG;line;connect;B,G",
            "H1;point;lineSlider;H0,H3,30,0;0",
            "M;point;midpoint;B,G;0;0",
            "BGcirc;circle;radius;M,G;0;0;0;0",
            "CGcirc;circle;radius;G,C;0;0;0;0",
            "bich;line;bichord;BGcirc,CGcirc;0;0;0",
            "H2';point;first;bich;0;0",
            "H2;point;cutoff;H1,H3,G,H2';0",
            "H;line;connect;H1,H2;black"
        ],
