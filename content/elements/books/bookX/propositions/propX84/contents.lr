            { text: "Apply {EG}, equal to the sum of the squares on {AC} and {CB}, to {EF} producing {EM} as breadth.",
              visible: APP1,
              highlighted: ["EG","AC","CB","EM"],
              transition: { mode: "cascade", animations: [
                  { elem: "G",    name: geomlib.A.Point.appear },
                  { elem: "M",    name: geomlib.A.Point.appear },
                  { elem: "EFGM", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "Apply {HG}, equal to twice the rectangle {AC} by {CB}, to {EF} producing {HM} as breadth.",
              visible: APP2,
