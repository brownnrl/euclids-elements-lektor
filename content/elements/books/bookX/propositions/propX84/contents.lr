            "C;point;lineSlider;A0,A3,135,0",
            "D;point;lineSlider;A0,A3,160,0",
            "AD;line;connect;A,D",
            "F;point;lineSlider;F0,F3,40,0",
            "E;point;lineSlider;F0,F3,160,0",
            "G''';point;perpendicular;F,E;0;0",
            "G'';point;extend;G''',F,A0,A3;0;0",
            "G';point;proportion;F,E,A,C,A,C,F,G'';0;0",
