            "A3;point;free;1000,40;0;0",
            "A;point;lineSlider;A0,A3,40,0",
            "C;point;lineSlider;A0,A3,100,0",
            "CB';line;perpendicular;C,A;0;0;0",
            "B;point;lineSlider;CB',0,190",
            "AB;polygon;parallelogram;A,C,B;0;0;black;0,20,70",
            "D';point;parallelogram;B,A0,A3;0;0",
            "D;point;lineSlider;B,D',150,0",
            "CD;polygon;parallelogram;C,B,D;0;0;black;60,50,100",
            "E;point;free;190,60",
            "F';point;parallelogram;E,C,B;0;0",
            "F;point;lineSlider;E,F',0,170",
            "H';point;parallelogram;E,A0,A3;0;0",
            "H;point;proportion;E,F,B,C,A,C,E,H'",
            "G;point;parallelogram;H,E,F",
            "EFGH;polygon;quadrilateral;E,F,G,H;0;0;black;0,20,70",
            "K;point;proportion;E,F,B,C,B,D,H,H'",
