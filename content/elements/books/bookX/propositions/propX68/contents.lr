              justifications: [{ claim: "CD major", ref: "X.39" }] },
            { text: "Therefore a straight line commensurable with the major straight line is major.",
              visible: ALL,
              highlighted: ["AB","CD"] },
            { text: "Therefore, a straight line commensurable with a major straight line is itself also major.",
