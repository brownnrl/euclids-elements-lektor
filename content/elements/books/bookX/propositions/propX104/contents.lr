            "A;point;lineSlider;A0,A3,60,0",
            "B;point;lineSlider;A0,A3,130,0",
            "C;point;lineSlider;C0,C3,30,0",
            "D;point;lineSlider;C0,C3,150,0",
            "E;point;lineSlider;A0,A3,170,0",
