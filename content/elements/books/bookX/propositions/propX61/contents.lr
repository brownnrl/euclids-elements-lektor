            "A3;point;free;1000,180;0;0",
            "D0;point;free;40,-1000;0;0",
            "D3;point;free;40,1000;0;0",
            "A;point;lineSlider;A0,A3,50,0",
            "B;point;lineSlider;A0,A3,180,0",
            "C;point;lineSlider;A0,A3,120,0",
            "AB;line;connect;A,B",
            "D;point;lineSlider;D0,D3,0,40",
            "E;point;lineSlider;D0,D3,0,140",
            "G';point;parallelogram;D,A0,A3;0;0",
            "G;point;proportion;D,E,A,B,A,B,D,G'",
            "F;point;parallelogram;E,D,G",
            "EDGF;polygon;quadrilateral;E,D,G,F;0;0;black;random",
            "K;point;proportion;D,E,A,C,A,C,D,G'",
            "EDKH;polygon;parallelogram;E,D,K;0;0;black;random",
            "H;point;vertex;EDKH,4",
            "M;point;proportion;D,E,B,C,B,C,K,G'",
            "HKML;polygon;parallelogram;H,K,M;0;0;black;random",
            "L;point;vertex;HKML,4",
            "N;point;midpoint;M,G",
            "O;point;parallelogram;E,D,N",
            "NO;line;connect;N,O",
            // Slide-only twins and highlight targets.
            "DE;line;connect;D,E",
            "AC;line;connect;A,C;0;0;0",
            "CB;line;connect;C,B;0;0;0",
            "DG;line;connect;D,G;0;0;0",
            "DM;line;connect;D,M;0;0;0",
            "MG;line;connect;M,G;0;0;0",
            "ML;line;connect;M,L;0;0;0",
            "DK;line;connect;D,K;0;0;0",
            "KM;line;connect;K,M;0;0;0",
            "MN;line;connect;M,N;0;0;0",
            "DFh;polygon;quadrilateral;E,D,G,F;0;0;0;0",
            "DHh;polygon;quadrilateral;E,D,K,H;0;0;0;0",
            "KLh;polygon;quadrilateral;H,K,M,L;0;0;0;0",
            "DLh;polygon;quadrilateral;E,D,M,L;0;0;0;0",
            "MFh;polygon;quadrilateral;L,M,G,F;0;0;0;0"
        ],
        initiallyHidden: ["DE"],
        deferDraggables: ["C","D","E"],
        aliases: { "DF": "DFh", "DH": "DHh", "KL": "KLh", "DL": "DLh",
                   "MF": "MFh", "MD": "DM" },
        slides: [
            { text: "“The square on the first bimedial straight line applied to a rational straight line",
              visible: ALL,
              highlighted: ["AB","DE","DFh"],
              justifications: [{ ref: "X.61" }] },
            { text: "produces as breadth the second binomial.”",
              visible: ALL,
              highlighted: ["DG"] },
            { text: "Let {AB} be a first bimedial straight line",
              visible: GIVEN,
              highlighted: ["AB"] },
            { text: "divided into its medials at {C}, of which medials {AC} is the greater.",
              visible: MEDS,
              highlighted: ["C","AC"],
              transition: { animations: [
                  { elem: "C", name: geomlib.A.Point.appear } ] } },
            { text: "Let a rational straight line {DE} be set out,",
              visible: RAT,
              highlighted: ["DE"],
              transition: { mode: "cascade", animations: [
                  { elem: "D",  name: geomlib.A.Point.appear },
                  { elem: "DE", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "and let there be applied to {DE} the parallelogram {DF} equal to the square on {AB},",
              visible: APP,
              highlighted: ["DE","AB"],
              transition: { animations: [
                  { elem: "EDGF", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "producing {DG} as its breadth.",
              visible: APP,
              highlighted: ["DG"] },
            { text: "I say that {DG} is a second binomial straight line.",
              visible: APP,
              highlighted: ["DG"] },
            { text: "Make the same construction as before.",
              visible: ALL,
              transition: { mode: "cascade", animations: [
                  { elem: "K",    name: geomlib.A.Point.appear },
                  { elem: "EDKH", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "M",    name: geomlib.A.Point.appear },
                  { elem: "HKML", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "N",    name: geomlib.A.Point.appear },
                  { elem: "NO",   name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Then, since {AB} is a first bimedial divided at {C},",
              visible: ALL,
              highlighted: ["AB","C"] },
            { text: "therefore {AC} and {CB} are medial straight lines commensurable in square only, and containing a rational rectangle,",
              visible: ALL,
              highlighted: ["AC","CB"],
              justifications: [{ claim: "AB a first bimedial", ref: "X.37" }] },
            { text: "so that the squares on {AC} and {CB} are also medial.",
              visible: ALL,
              highlighted: ["AC","CB"],
              justifications: [{ ref: "X.21" }] },
            { text: "Therefore {DL} is medial.",
              visible: ALL,
              highlighted: ["DLh"],
              justifications: [{ ref: "X.15" }, { ref: "X.23.Cor" }] },
            { text: "And it was applied to the rational straight line {DE},",
              visible: ALL,
              highlighted: ["DLh","DE"] },
            { text: "therefore {MD} is rational and incommensurable in length with {DE}.",
              visible: ALL,
              highlighted: ["DM","DE"],
              justifications: [{ claim: "DM rational, incommensurable with DE", ref: "X.22" }] },
            { text: "Again, since twice the rectangle {AC} by {CB} is rational, therefore {MF} is also rational.",
              visible: ALL,
              highlighted: ["AC","CB","MFh"] },
            { text: "And it is applied to the rational straight line {ML},",
              visible: ALL,
              highlighted: ["MFh","ML"] },
            { text: "therefore {MG} is also rational and commensurable in length with {ML}, that is, {DE}.",
              visible: ALL,
              highlighted: ["MG","ML","DE"],
              justifications: [{ claim: "MG commensurable with ML", ref: "X.20" }] },
            { text: "Therefore {DM} is incommensurable in length with {MG}.",
              visible: ALL,
              highlighted: ["DM","MG"],
              justifications: [{ claim: "DM, MG incommensurable", ref: "X.13" }] },
            { text: "And they are rational, therefore {DM} and {MG} are rational straight lines commensurable in square only.",
              visible: ALL,
              highlighted: ["DM","MG"] },
            { text: "Therefore {DG} is binomial.",
              visible: ALL,
              highlighted: ["DG"],
              justifications: [{ claim: "DG binomial", ref: "X.36" }] },
            { text: "It is next to be proved that it is a second binomial straight line.",
              visible: ALL,
              highlighted: ["DG"] },
            { text: "Since the sum of the squares on {AC} and {CB} is greater than twice the rectangle {AC} by {CB},",
              visible: ALL,
              highlighted: ["AC","CB"] },
            { text: "therefore {DL} is also greater than {MF}, so that {DM} is also greater than {MG}.",
              visible: ALL,
              highlighted: ["DLh","MFh","DM","MG"],
              justifications: [{ claim: "DM greater than MG", ref: "VI.1" }] },
            { text: "Since the square on {AC} is commensurable with the square on {CB},",
              visible: ALL,
              highlighted: ["AC","CB"] },
            { text: "therefore {DH} is also commensurable with {KL}, so that {DK} is also commensurable with {KM}.",
              visible: ALL,
              highlighted: ["DHh","KLh","DK","KM"],
              justifications: [{ claim: "DH : KL = DK : KM", ref: "VI.1" },
                               { claim: "DK, KM commensurable", ref: "X.11" }] },
            { text: "And the rectangle {DK} by {KM} equals the square on {MN},",
              visible: ALL,
              highlighted: ["DK","KM","MN"] },
            { text: "therefore the square on {DM} is greater than the square on {MG}",
              visible: ALL,
              highlighted: ["DM","MG"] },
            { text: "by the square on a straight line commensurable with {DM}.",
              visible: ALL,
              highlighted: ["DM"],
              justifications: [{ claim: "excess commensurable with DM", ref: "X.17" }] },
            { text: "And {MG} is commensurable in length with {DE}.",
              visible: ALL,
              highlighted: ["MG","DE"] },
            { text: "Therefore {DG} is a second binomial straight line.",
              visible: ALL,
              highlighted: ["DG"],
              justifications: [{ claim: "second binomial", ref: "X.Def.II.2" }] },
            { text: "Therefore, the square on the first bimedial straight line applied to a rational straight line",
              visible: ALL,
              highlighted: ["AB","DE","DFh"] },
            { text: "produces as breadth the second binomial.",
              visible: ALL,
              highlighted: ["DG"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "X.61") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "VI.1":       "/elements/books/bookVI/propositions/propVI1/",
        "X.11":       "/elements/books/bookX/propositions/propX11/",
        "X.13":       "/elements/books/bookX/propositions/propX13/",
        "X.15":       "/elements/books/bookX/propositions/propX15/",
        "X.17":       "/elements/books/bookX/propositions/propX17/",
        "X.20":       "/elements/books/bookX/propositions/propX20/",
        "X.21":       "/elements/books/bookX/propositions/propX21/",
        "X.22":       "/elements/books/bookX/propositions/propX22/",
        "X.23.Cor":   "/elements/books/bookX/propositions/propX23/#cor",
        "X.36":       "/elements/books/bookX/propositions/propX36/",
        "X.37":       "/elements/books/bookX/propositions/propX37/",
        "X.Def.II.2": "/elements/books/bookX/definitions/defX.II.2/"
    });
</script>
</figure>

Then, since {AB} is a first bimedial divided at {C}, therefore {AC} and {CB} are medial straight lines commensurable in square only, and containing a rational rectangle, so that the squares on {AC} and {CB} are also medial. [!just X.37; X.21]

Therefore {DL} is medial. And it was applied to the rational straight line {DE}, therefore {MD} is rational and incommensurable in length with {DE}. [!just X.15; X.23.Cor; X.22]

Again, since twice the rectangle {AC} by {CB} is rational, therefore {MF} is also rational.

And it is applied to the rational straight line {ML}, therefore {MG} is also rational and commensurable in length with {ML}, that is, {DE}. Therefore {DM} is incommensurable in length with {MG}. [!just X.20; X.13]

And they are rational, therefore {DM} and {MG} are rational straight lines commensurable in square only. Therefore {DG} is binomial. [!just X.36]

It is next to be proved that it is a second binomial straight line.

Since the sum of the squares on {AC} and {CB} is greater than twice the rectangle {AC} by {CB}, therefore {DL} is also greater than {MF}, so that {DM} is also greater than {MG}. [!just VI.1]

Since the square on {AC} is commensurable with the square on {CB}, therefore {DH} is also commensurable with {KL}, so that {DK} is also commensurable with {KM}. [!just VI.1; X.11]

And the rectangle {DK} by {KM} equals the square on {MN}, therefore the square on {DM} is greater than the square on {MG} by the square on a straight line commensurable with {DM}. And {MG} is commensurable in length with {DE}. [!just X.17]

Therefore {DG} is a second binomial straight line. [!just X.Def.II.2]

Therefore, *the square on the first bimedial straight line applied to a rational straight line produces as breadth the second binomial.*

<div class="qed">Q.E.D.</div>
