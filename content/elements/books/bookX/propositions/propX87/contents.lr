            { text: "and {BC} is to {CD} as the square on {FG} is to the square on {GH}.",
              visible: GHS,
              highlighted: ["BC","CD","FG","GH"],
              transition: { animations: [
                  { elem: "GH", name: geomlib.A.Line.straightEdgeConnect } ] },
              justifications: [{ claim: "BC : CD = FG² : GH²", ref: "X.6.Cor" }] },
            { text: "Since {E} is to {BC} as the square on {A} is to the square on {FG},",
              visible: GHS,
              highlighted: ["E","BC","A","FG"] },
