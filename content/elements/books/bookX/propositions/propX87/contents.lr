              justifications: [{ claim: "A², FG² commensurable", ref: "X.6" }] },
            { text: "But the square on {A} is rational, therefore the square on {FG} is also rational, therefore {FG} is rational.",
              visible: GHS,
              highlighted: ["A","FG"] },
            { text: "Since {E} does not have to {BC} the ratio which a square number has to a square number,",
              visible: GHS,
              highlighted: ["E","BC"] },
