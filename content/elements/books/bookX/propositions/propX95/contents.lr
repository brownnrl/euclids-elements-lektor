                  { elem: "RMPL", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "and subtract the square {NO}, equal to {FK} and about the same angle, the angle {LPM}.",
              visible: SQ2A,
              highlighted: ["NO","IFGK","angLPM"],
              transition: { mode: "cascade", animations: [
                  { elem: "PNQO",   name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "angLPM", name: geomlib.A.Sector.sweep } ] } },
            { text: "Then the squares {LM} and {NO} are about the same diameter.",
              visible: SQ2A,
              highlighted: ["LM","NO"],
              justifications: [{ claim: "about the same diameter", ref: "VI.26" }] },
            { text: "Let {PR} be their diameter, and draw the figure.",
