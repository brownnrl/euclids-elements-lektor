              visible: PAR,
              highlighted: ["AK"],
              transition: { mode: "cascade", animations: [
                  { elem: "EH",   name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "DFIB", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "IFGK", name: geomlib.A.Polygon.outlineAndFill } ] },
              justifications: [{ claim: "AK medial", ref: "X.21" }] },
            { text: "Again, since {DG} is rational and commensurable in length with {AC}, therefore {DK} is rational.",
              visible: PAR,
