                  { elem: "TQ",  name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "UVW", name: geomlib.A.Sector.sweep } ] } },
            { text: "Similarly then we can prove that {LN} is the side of the area {AB}.",
              visible: ALL,
              highlighted: ["LN","AB"] },
            { text: "I say that {LN} is the straight line which produces with a rational area a medial whole.",
              visible: ALL,
              highlighted: ["LN"] },
            { text: "Since {AK} was proved medial and equals the sum of the squares on {LP} and {PN},",
              visible: ALL,
              highlighted: ["AK","LM","NO"] },
            { text: "therefore the sum of the squares on {LP} and {PN} is medial.",
              visible: ALL,
              highlighted: ["LM","NO"] },
            { text: "Again, since {DK} is rational and equals twice the rectangle {LP} by {PN},",
              visible: ALL,
              highlighted: ["DK","LPOSh","PMTNh"] },
            { text: "therefore the latter is itself also rational.",
              visible: ALL,
              highlighted: ["LPOSh","PMTNh"] },
            { text: "And, since {AI} is incommensurable with {FK},",
              visible: ALL,
              highlighted: ["AI","IFGK"] },
            { text: "therefore the square on {LP} is also incommensurable with the square on {PN}.",
              visible: ALL,
              highlighted: ["LM","NO"] },
            { text: "Therefore {LP} and {PN} are straight lines incommensurable in square",
              visible: ALL,
              highlighted: ["LP","PN"] },
            { text: "which make the sum of the squares on them medial but twice the rectangle contained by them rational.",
              visible: ALL,
              highlighted: ["LM","NO","LPOSh","PMTNh"] },
            { text: "Therefore the remainder {LN} is the irrational straight line called that which produces with a rational area a medial whole,",
              visible: ALL,
              highlighted: ["LN"] },
            { text: "and it is the side of the area {AB}.",
              visible: ALL,
              highlighted: ["LN","AB"],
              justifications: [{ claim: "produces with a rational area a medial whole", ref: "X.77" }] },
            { text: "Therefore the side of the area {AB} is a straight line which produces with a rational area a medial whole.",
              visible: ALL,
              highlighted: ["AB","LN"] },
            { text: "Therefore, if an area is contained by a rational straight line and a fifth apotome,",
              visible: ALL,
              highlighted: ["AB","AC","AD"] },
            { text: "then the side of the area is a straight line which produces with a rational area a medial whole.",
              visible: ALL,
              highlighted: ["LN"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
