              justifications: [{ claim: "AC·CB + EC² = EB²", ref: "II.5" }] },
            { text: "and, further, the rectangle {AD} by {DB} together with the square on {DE} equals the square on {EB},",
              visible: L_E,
              highlighted: ["AD","DB","DE","EB"],
              justifications: [{ claim: "AD·DB + DE² = EB²", ref: "II.5" }] },
            { text: "therefore the rectangle {AC} by {CB} together with the square on {EC}",
              visible: L_E,
