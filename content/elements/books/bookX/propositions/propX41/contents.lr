            "DC;line;connect;D,C;0;0;0",
            "AE;line;connect;A,E;0;0;0",
            "EB;line;connect;E,B;0;0;0",
            "DE;line;connect;D,E;0;0;0",
            "EC;line;connect;E,C;0;0;0"
        ],
        deferDraggables: ["C","D"],
        slides: [
            { text: "“And that the aforesaid irrational straight lines are divided only in one way",
              visible: L_E,
              highlighted: ["AB"],
              justifications: [{ ref: "Lemma" }] },
            { text: "into the straight lines of which they are the sum and which produce the types in question",
              visible: L_E,
              highlighted: ["AC","CB"] },
            { text: "we will now prove after premising the following lemma.”",
              visible: L_E,
              highlighted: ["AB"] },
            { text: "Set out the straight line {AB},",
              visible: L_AB,
              highlighted: ["AB"],
              transition: { animations: [
                  { elem: "AB", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "cut the whole into unequal parts at each of the points {C} and {D},",
              visible: L_CD,
              highlighted: ["C","D"],
              transition: { mode: "parallel", animations: [
                  { elem: "C", name: geomlib.A.Point.appear },
                  { elem: "D", name: geomlib.A.Point.appear } ] } },
            { text: "and let {AC} be supposed greater than {DB}.",
              visible: L_CD,
              highlighted: ["AC","DB"] },
            { text: "I say that the sum of the squares on {AC} and {CB} is greater than the sum of the squares on {AD} and {DB}.",
              visible: L_CD,
              highlighted: ["AC","CB","AD","DB"] },
            { text: "Bisect {AB} at {E}.",
              visible: L_E,
              highlighted: ["AB","E"],
              transition: { animations: [
                  { elem: "E", name: geomlib.A.Point.appear } ] } },
            { text: "Since {AC} is greater than {DB}, subtract {DC} from each,",
              visible: L_E,
              highlighted: ["AC","DB","DC"] },
            { text: "therefore the remainder {AD} is greater than the remainder {CB}.",
              visible: L_E,
              highlighted: ["AD","CB"] },
            { text: "But {AE} equals {EB}, therefore {DE} is less than {EC}.",
              visible: L_E,
              highlighted: ["AE","EB","DE","EC"] },
            { text: "Therefore the points {C} and {D} are not equidistant from the point of bisection.",
              visible: L_E,
              highlighted: ["C","D","E"] },
