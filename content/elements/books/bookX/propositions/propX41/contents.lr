            "D;point;lineSlider;A0,A3,100,0",
            "E;point;midpoint;A,B",
            // Highlight targets only — invisible at rest.
            "AC;line;connect;A,C;0;0;0",
            "CB;line;connect;C,B;0;0;0",
            "AD;line;connect;A,D;0;0;0",
