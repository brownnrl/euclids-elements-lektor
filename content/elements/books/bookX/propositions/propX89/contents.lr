            { text: "Since the square on {BG} is to the square on {GC} as {DE} is to {EF},",
              visible: ALL,
              highlighted: ["BG","CG","DE","FE"] },
            { text: "therefore, in conversion, {ED} is to {DF} as the square on {BG} is to the square on {H}.",
              visible: ALL,
              highlighted: ["DE","DF","BG","H"],
              justifications: [{ claim: "ED : DF = BG² : H²", ref: "V.19.Cor" }] },
            { text: "But {ED} does not have to {DF} the ratio which a square number has to a square number,",
              visible: ALL,
              highlighted: ["DE","DF"] },
            { text: "therefore neither has the square on {BG} to the square on {H}",
              visible: ALL,
              highlighted: ["BG","H"] },
            { text: "the ratio which a square number has to a square number.",
              visible: ALL,
              highlighted: ["BG","H"] },
            { text: "Therefore {BG} is incommensurable in length with {H}.",
              visible: ALL,
              highlighted: ["BG","H"],
              justifications: [{ claim: "BG, H incommensurable in length", ref: "X.9" }] },
            { text: "And the square on {BG} is greater than the square on {GC} by the square on {H},",
              visible: ALL,
              highlighted: ["BG","CG","H"] },
            { text: "therefore the square on {GB} is greater than the square on {GC}",
              visible: ALL,
              highlighted: ["GB","CG"] },
            { text: "by the square on a straight line incommensurable in length with {GB}.",
              visible: ALL,
              highlighted: ["H","GB"] },
            { text: "And the annex {CG} is commensurable in length with the rational straight line {A} set out,",
              visible: ALL,
              highlighted: ["CG","A"] },
            { text: "therefore {BC} is a fifth apotome.",
              visible: ALL,
              highlighted: ["BC"],
              justifications: [{ ref: "X.Def.III.5" }] },
            { text: "Therefore the fifth apotome {BC} has been found.",
              visible: ALL,
              highlighted: ["BC"],
              justifications: [{ ref: "Q.E.F." }] }
        ],
        resolveJustification: function(ref) {
