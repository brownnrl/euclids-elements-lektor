                  { elem: "GB", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "B",  name: geomlib.A.Point.appear } ] } },
            { text: "Then the square on {GB} is also rational. Therefore {BG} is also rational.",
              visible: BGS,
              highlighted: ["GB"],
              justifications: [{ ref: "X.6" }] },
            { text: "Now since {DE} is to {EF} as the square on {BG} is to the square on {GC},",
