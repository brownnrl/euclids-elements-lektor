            "GB;line;connect;G,B",
            "DF;line;connect;D,F;0;0;0",
            "FE;line;connect;F,E;0;0;0",
            "BC;line;connect;B,C;0;0;0"
        ],
        initiallyHidden: ["CG","GB"],
        deferDraggables: ["C","G","D","E","F","H1"],
        aliases: { "GC": "CG", "ED": "DE", "EF": "FE", "CB": "BC" },
        slides: [
            { text: "“To find the fifth apotome.”",
