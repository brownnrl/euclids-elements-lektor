    var NUM = RAT.concat(["E1","E2","E","B","C","D","BC","CD","BD"]);
    var TFG = NUM.concat(["F","G","FG"]);
    var TGH = TFG.concat(["H","GH"]);
    var APO = TGH.concat(["FH"]);
    var ALL = APO.concat(["K1","K2","K"]);
