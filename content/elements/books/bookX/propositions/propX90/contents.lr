              justifications: [{ claim: "E : BC = A² : FG²", ref: "X.6.Cor" }] },
            { text: "and {BC} is to {CD} as the square on {FG} is to the square on {GH}.",
              visible: TGH,
              highlighted: ["BC","CD","FG","GH"],
              transition: { animations: [
                  { elem: "H", name: geomlib.A.Point.appear } ] },
              justifications: [{ claim: "BC : CD = FG² : GH²", ref: "X.6.Cor" }] },
            { text: "Now since {E} is to {BC} as the square on {A} is to the square on {FG},",
              visible: TGH,
              highlighted: ["E","BC","A","FG"] },
            { text: "therefore the square on {A} is commensurable with the square on {FG}.",
              visible: TGH,
              highlighted: ["A","FG"],
