            "E1;point;lineSlider;E0,E3,110,0;0",
            "E2;point;lineSlider;E0,E3,175,0;0",
            "E;line;connect;E1,E2;black;0;blue",
            "B;point;lineSlider;B0,B3,90,0",
            "C;point;lineSlider;B0,B3,190,0",
            "D;point;lineSlider;B0,B3,130,0",
            "BC;line;connect;B,C;0;0;blue",
            "F;point;lineSlider;F0,F3,30,0",
            "G';point;proportion;E1,E2,B,C,A1,A2,F,F3;0;0",
