<noscript><img alt="X.55 diagram" src="propX54.gif"/></noscript>
<script type="text/javascript">
    // Joyce's figure (shared with X.54): the rectangle ABCD on the rational
    // AB and the binomial AD, divided at E, with F bisecting ED, G applied on
    // AE, the parallels GH, EK, FL, the rectangles AH and GK (HGEK), and the
    // squares SN (SPNM) and NQ (NOQR) inside the completed square SQ.
    // Added, all hidden at rest: solid twins GH, EK (initiallyHidden) so the
    // parallels stroke from G and E before the rectangles fill; transparent
    // targets AB, AD, CD, AE, ED, EF, AG, GE, MN, NO, MO, PN, NR (;0;0;0);
    // a faceless twin ABCDh of the random-faced rectangle, which would be
    // raised over AH and GK when lit (#140), reached as {ABCD|ABCDh} and the
    // alias AC; faceless targets EL (E,F,L,K) and MR (M,N,R and SQ's fourth
    // vertex SQ4). No angle is called right in the text, so no markers.
    //
    // Draggables (checked against the bundle): A, D, B (the givens), E and S
    // (line sliders), and the offscreen frees. E arrives with "divide it into
    // its terms at E" and S with the square SN, so both are deferred. F, G,
    // H, K, L, P, M, N, O, Q, R are derived and listed per slide.
    var GIVEN = ["A","B","C","D","ABCD","AB","AD","CD"];
    var TERMS = GIVEN.concat(["E","AE","ED"]);
    var BIS   = TERMS.concat(["F","EF"]);
    var APPL  = BIS.concat(["G","AG","GE"]);
    var PAR   = APPL.concat(["H","K","L","GH","EK","FL","AH","HGEK"]);
    var SQ1   = PAR.concat(["S","P","M","N","SPNM"]);
    var SQ2   = SQ1.concat(["O","Q","R","NOQR","MN","NO"]);
    var SQ3   = SQ2.concat(["PN","NR"]);
    var ALL   = SQ3.concat(["SQ","SQ4","MO","MR","EL"]);
