            "AH;polygon;quadrilateral;A,B,H,G;0;0;0;60,80,100",
            "S0;point;free;-1000,175;0;0",
            "S3;point;free;1000,175;0;0",
            "S;point;lineSlider;S0,S3,240,0",
            "P;point;meanProportional;A,G,G,H,S,S3",
            "SPNM;polygon;square;S,P;0;0;black;60,80,100",
            "M;point;vertex;SPNM,4",
            "N;point;vertex;SPNM,3",
            "T;point;meanProportional;G,E,E,K,P,S3;0",
            "O;point;parallelogram;M,S,T",
            "NOQR;polygon;square;N,O;0;0;black;240,80,100",
            "Q;point;vertex;NOQR,3",
            "R;point;vertex;NOQR,4",
            "SQ;polygon;parallelogram;S,T,Q;0;0;black;0",
            // Slide-only twins and highlight targets.
            "GH;line;connect;G,H",
            "EK;line;connect;E,K",
            "AB;line;connect;A,B;0;0;0",
            "AD;line;connect;A,D;0;0;0",
            "CD;line;connect;C,D;0;0;0",
            "AE;line;connect;A,E;0;0;0",
            "ED;line;connect;E,D;0;0;0",
            "EF;line;connect;E,F;0;0;0",
            "AG;line;connect;A,G;0;0;0",
            "GE;line;connect;G,E;0;0;0",
            "MN;line;connect;M,N;0;0;0",
            "NO;line;connect;N,O;0;0;0",
            "MO;line;connect;M,O;0;0;0",
            "PN;line;connect;P,N;0;0;0",
            "NR;line;connect;N,R;0;0;0",
            "SQ4;point;vertex;SQ,4;0;0",
            "ABCDh;polygon;quadrilateral;A,B,C,D;0;0;0;0",
            "EL;polygon;quadrilateral;E,F,L,K;0;0;0;0",
            "MR;polygon;quadrilateral;M,N,R,SQ4;0;0;0;0"
        ],
        initiallyHidden: ["GH","EK"],
        deferDraggables: ["E","S"],
        aliases: { "AC": "ABCDh", "BA": "AB", "DE": "ED", "EG": "GE",
                   "FE": "EF", "GK": "HGEK", "SN": "SPNM", "NQ": "NOQR",
                   "RN": "NR", "NP": "PN" },
        slides: [
            { text: "“If an area is contained by a rational straight line and the second binomial,",
              visible: ALL,
              highlighted: ["ABCDh","AB","AD"],
              justifications: [{ ref: "X.55" }] },
            { text: "then the side of the area is the irrational straight line which is called a first bimedial.”",
              visible: ALL,
              highlighted: ["MO"] },
            { text: "Let the area {ABCD|ABCDh} be contained by the rational straight line {AB} and the second binomial {AD}.",
              visible: GIVEN,
              highlighted: ["ABCDh","AB","AD"] },
            { text: "I say that the side of the area {AC} is a first bimedial straight line.",
              visible: GIVEN,
              highlighted: ["ABCDh"] },
            { text: "Since {AD} is a second binomial straight line,",
              visible: GIVEN,
              highlighted: ["AD"] },
            { text: "divide it into its terms at {E}, so that {AE} is the greater term.",
