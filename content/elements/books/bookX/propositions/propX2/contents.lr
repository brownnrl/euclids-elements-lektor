            "ABC;polygon;triangle;A,B,C;0;0;black;random",
            "D;point;similar;B,C,A,B,C",
            "BCD;polygon;triangle;B,C,D;0;0;black;random",
            "E;point;similar;C,D,B,C,D",
            "CDE;polygon;triangle;C,D,E;0;0;black;random",
            "F;point;similar;D,E,C,D,E",
            "DEF;polygon;triangle;D,E,F;0;0;black;random",
            "G;point;similar;E,F,D,E,F",
            "EFG;polygon;triangle;E,F,G;0;0;black;random",
            "H;point;similar;F,G,E,F,G;0",
            "FGH;polygon;triangle;F,G,H;0;0;black;random",
            // Highlight targets for the guide prose (transparent).
            "AB;line;connect;A,B;0;0;0",
            "BC;line;connect;B,C;0;0;0",
            "AC;line;connect;A,C;0;0;0",
            "CD;line;connect;C,D;0;0;0",
            "BD;line;connect;B,D;0;0;0",
            "DE;line;connect;D,E;0;0;0",
            "EF;line;connect;E,F;0;0;0"
        ],
