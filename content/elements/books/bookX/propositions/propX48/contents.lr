        slides: [
            { text: "“To find the first binomial line.”",
              visible: HS,
              highlighted: ["EG"],
              justifications: [{ ref: "X.48" }] },
            { text: "Set out two numbers {AC} and {CB} such that the sum of them {AB} has to {BC|CB}",
              visible: NUMS,
              highlighted: ["AC","CB","AB"],
              justifications: [{ claim: "the numbers AC, CB", ref: "X.28,Lemma1" }] },
            { text: "the ratio which a square number has to a square number,",
              visible: NUMS,
              highlighted: ["AB","CB"] },
            { text: "but does not have to {CA|AC} the ratio which a square number has to a square number.",
              visible: NUMS,
