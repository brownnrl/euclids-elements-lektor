    // arrive with "Set out any rational straight line D", E and F with EF,
    // H1 with H, so all five are deferred. G and H2 are derived and listed.
    var NUMS = ["A","B","C","AB","AC","CB"];
    var DS   = NUMS.concat(["D1","D2","D"]);
    var EFS  = DS.concat(["E","F","EF"]);
    var GS   = EFS.concat(["G","FG"]);
    var EGS  = GS.concat(["EG"]);
    var HS   = EGS.concat(["H1","H2","H"]);
