                  { elem: "D", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "EF", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Therefore {EF} is also rational.",
              visible: EFS,
              highlighted: ["EF"] },
            { text: "Let it be contrived that the number {BA|AB} is to {AC} as the square on {EF} is to the square on {FG}.",
              visible: GS,
              highlighted: ["AB","AC","EF","FG"],
              justifications: [{ claim: "BA : AC = EF² : FG²", ref: "X.6.Cor" }],
              transition: { animations: [
                  { elem: "FG", name: geomlib.A.Line.straightEdgeExtend } ] } },
            { text: "But {AB} has to {AC} the ratio which a number has to a number,",
              visible: GS,
              highlighted: ["AB","AC"] },
            { text: "therefore the square on {EF} also has to the square on {FG} the ratio which a number has to a number,",
              visible: GS,
              highlighted: ["EF","FG"] },
            { text: "so that the square on {EF} is commensurable with the square on {FG}.",
              visible: GS,
              highlighted: ["EF","FG"],
              justifications: [{ claim: "EF², FG² commensurable", ref: "X.6" }] },
            { text: "And {EF} is rational, therefore {FG} is also rational.",
              visible: GS,
              highlighted: ["EF","FG"] },
            { text: "And, since {BA|AB} does not have to {AC} the ratio which a square number has to a square number,",
              visible: GS,
              highlighted: ["AB","AC"] },
            { text: "neither, therefore, has the square on {EF} to the square on {FG}",
              visible: GS,
              highlighted: ["EF","FG"] },
            { text: "the ratio which a square number has to a square number.",
              visible: GS,
              highlighted: ["EF","FG"] },
            { text: "Therefore {EF} is incommensurable in length with {FG}.",
              visible: GS,
              highlighted: ["EF","FG"],
              justifications: [{ claim: "EF, FG incommensurable in length", ref: "X.9" }] },
            { text: "Therefore {EF} and {FG} are rational straight lines commensurable in square only.",
              visible: GS,
              highlighted: ["EF","FG"] },
            { text: "Therefore {EG} is binomial.",
              visible: EGS,
              highlighted: ["EG"],
              justifications: [{ claim: "EG binomial", ref: "X.36" }] },
            { text: "I say that it is also a first binomial straight line.",
              visible: EGS,
              highlighted: ["EG"] },
            { text: "Since the number {BA|AB} is to {AC} as the square on {EF} is to the square on {FG},",
              visible: EGS,
              highlighted: ["AB","AC","EF","FG"] },
            { text: "while {BA|AB} is greater than {AC}, therefore the square on {EF} is also greater than the square on {FG}.",
              visible: EGS,
              highlighted: ["AB","AC","EF","FG"] },
            { text: "Let then the sum of the squares on {FG} and {H} equal the square on {EF}.",
              visible: HS,
              highlighted: ["FG","H","EF"],
              transition: { animations: [
                  { elem: "H", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Now since {BA|AB} is to {AC} as the square on {EF} is to the square on {FG},",
              visible: HS,
              highlighted: ["AB","AC","EF","FG"] },
            { text: "therefore, in conversion, {AB} is to {BC|CB} as the square on {EF} is to the square on {H}.",
              visible: HS,
              highlighted: ["AB","CB","EF","H"],
              justifications: [{ claim: "AB : BC = EF² : H²", ref: "V.19.Cor" }] },
            { text: "But {AB} has to {BC|CB} the ratio which a square number has to a square number,",
              visible: HS,
              highlighted: ["AB","CB"] },
            { text: "therefore the square on {EF} also has to the square on {H}",
              visible: HS,
              highlighted: ["EF","H"] },
            { text: "the ratio which a square number has to a square number.",
              visible: HS,
              highlighted: ["EF","H"] },
            { text: "Therefore {EF} is commensurable in length with {H}.",
              visible: HS,
              highlighted: ["EF","H"],
              justifications: [{ claim: "EF, H commensurable in length", ref: "X.9" }] },
            { text: "Therefore the square on {EF} is greater than the square on {FG}",
              visible: HS,
              highlighted: ["EF","FG"] },
            { text: "by the square on {a straight line commensurable with EF|H}.",
              visible: HS,
              highlighted: ["H","EF"] },
            { text: "And {EF} and {FG} are rational, and {EF} is commensurable in length with {D}.",
              visible: HS,
              highlighted: ["EF","FG","D"] },
            { text: "Therefore EF is a first binomial straight line.",
              visible: HS,
              highlighted: ["EG"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "X.48") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "V.19.Cor":    "/elements/books/bookV/propositions/propV19/#cor",
        "X.6":         "/elements/books/bookX/propositions/propX6/",
        "X.6.Cor":     "/elements/books/bookX/propositions/propX6/#cor",
        "X.9":         "/elements/books/bookX/propositions/propX9/",
        "X.28,Lemma1": "/elements/books/bookX/propositions/propX29/#lemma1",
        "X.36":        "/elements/books/bookX/propositions/propX36/"
    });
</script>
</figure>

Let it be contrived that the number {BA|AB} is to {AC} as the square on {EF} is to the square on {FG}. [!just X.6.Cor]

But {AB} has to {AC} the ratio which a number has to a number, therefore the square on {EF} also has to the square on {FG} the ratio which a number has to a number, so that the square on {EF} is commensurable with the square on {FG}. [!just X.6]

And {EF} is rational, therefore {FG} is also rational. And, since {BA|AB} does not have to {AC} the ratio which a square number has to a square number, neither, therefore, has the square on {EF} to the square on {FG} the ratio which a square number has to a square number. Therefore {EF} is incommensurable in length with {FG}. [!just X.9]

Therefore {EF} and {FG} are rational straight lines commensurable in square only. Therefore {EG} is binomial. [!just X.36]

I say that it is also a first binomial straight line.

Since the number {BA|AB} is to {AC} as the square on {EF} is to the square on {FG}, while {BA|AB} is greater than {AC}, therefore the square on {EF} is also greater than the square on {FG}.

Let then the sum of the squares on {FG} and {H} equal the square on {EF}.

Now since {BA|AB} is to {AC} as the square on {EF} is to the square on {FG}, therefore, in conversion, {AB} is to {BC|CB} as the square on {EF} is to the square on {H}. [!just V.19.Cor]

But {AB} has to {BC|CB} the ratio which a square number has to a square number, therefore the square on {EF} also has to the square on {H} the ratio which a square number has to a square number.

Therefore {EF} is commensurable in length with {H}. Therefore the square on {EF} is greater than the square on {FG} by the square on a straight line commensurable with {EF}. [!just X.9]

And {EF} and {FG} are rational, and {EF} is commensurable in length with {D}.

Therefore *EF* is a first binomial straight line.

<div class="qed">Q.E.D.</div>
