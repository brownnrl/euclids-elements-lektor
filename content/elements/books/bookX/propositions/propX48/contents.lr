            "E;point;lineSlider;E0,E3,30,0",
            "F;point;lineSlider;E0,E3,110,0",
            "G';point;proportion;B,A,A,C,E,F,F,E3;0;0",
            "G;point;meanProportional;E,F,F,G',F,G'",
            "EG;line;connect;E,G",
            "M;point;midpoint;E,F;0;0",
            "EFcirc;circle;radius;M,E;0;0;0;0",
            "FGcirc;circle;radius;F,G;0;0;0;0",
            "bich;line;bichord;EFcirc,FGcirc;0;0;0",
