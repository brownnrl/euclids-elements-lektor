            "U1;point;free;0,1000;0;0",
            "U2;point;free;20,1000;0;0",
            "E;point;cutoff;D,B,U1,U2",
            "F;point;cutoff;E,B,U1,U2",
            "G';point;cutoff;A,B,U1,U2;0;0",
            "G;point;cutoff;G',B,U1,U2",
            "H';point;cutoff;A,B,D,F;0;0",
            "H;point;cutoff;H',B,D,F",
            // Highlight targets only — AB already draws these.
            "BC;line;connect;B,C;0;0;0",
            "AC;line;connect;A,C;0;0;0",
            "CD;line;connect;C,D;0;0;0",
            "BD;line;connect;B,D;0;0;0",
            "DE;line;connect;D,E;0;0;0",
            "CE;line;connect;C,E;0;0;0",
            "BE;line;connect;B,E;0;0;0",
            "AG;line;connect;A,G;0;0;0",
            "GC;line;connect;G,C;0;0;0",
            "GB;line;connect;G,B;0;0;0",
            "BF;line;connect;B,F;0;0;0",
            "DF;line;connect;D,F;0;0;0",
            "AH;line;connect;A,H;0;0;0",
            "HC;line;connect;H,C;0;0;0",
            "CF;line;connect;C,F;0;0;0",
            "HB;line;connect;H,B;0;0;0"
        ],
        slides: [
            { text: "“To find two square numbers such that their sum is not square.”",
              visible: L2_UNIT,
              highlighted: ["AB","BC","CE"],
              justifications: [{ ref: "Lemma 2" }] },
            { text: "Let the product of {AB} and {BC} we said, be square, and {CA|AC} even.",
              visible: L2_GIVEN,
              highlighted: ["AB","BC","AC"] },
            { text: "Bisect {CA|AC} by {D}.",
              visible: L2_BIS,
              highlighted: ["AC"],
              transition: { animations: [
                  { elem: "D", name: geomlib.A.Point.appear } ] } },
            { text: "It is then clear that the square product of {AB} and {BC} together with the square on {CD}",
              visible: L2_BIS,
              highlighted: ["AB","BC","CD"] },
            { text: "equals the square on {BD}.",
              visible: L2_BIS,
              highlighted: ["BD"],
              justifications: [{ claim: "AB·BC + CD² = BD²", ref: "Lemma 1" }] },
            { text: "Subtract the unit {DE}.",
              visible: L2_UNIT,
              highlighted: ["DE"],
              transition: { animations: [
                  { elem: "E", name: geomlib.A.Point.appear } ] } },
            { text: "Therefore the product of {AB} and {BC} together with the square on {CE} is less than the square on {BD}.",
              visible: L2_UNIT,
              highlighted: ["AB","BC","CE","BD"] },
            { text: "I say then that the product of {AB} and {BC} together with the square on {CE} is not square.",
              visible: L2_UNIT,
              highlighted: ["AB","BC","CE"] },
            { text: "If it is square, then it either equals the square on {BE}, or is less than the square on {BE},",
              visible: L2_BE,
              highlighted: ["BE"] },
            { text: "but cannot be greater lest {the unit|DE} be divided.",
              visible: L2_BE,
              highlighted: ["DE"] },
            { text: "First, if possible, let the product of {AB} and {BC} together with the square on {CE} equal the square on {BE},",
              visible: L2_BE,
              highlighted: ["AB","BC","CE","BE"] },
            { text: "and let {GA|AG} be double the unit {DE}.",
              visible: L2_G,
              highlighted: ["AG","DE"],
              transition: { animations: [
                  { elem: "G", name: geomlib.A.Point.appear } ] } },
            { text: "Since the whole {AC} is double the whole {CD}, and in them {AG} is double {DE},",
              visible: L2_G,
              highlighted: ["AC","CD","AG","DE"] },
            { text: "therefore the remainder {GC} is also double the remainder {EC|CE}. Therefore {GC} is bisected by {E}.",
              visible: L2_GC,
              highlighted: ["GC","CE","E"] },
            { text: "Therefore the product of {GB} and {BC} together with the square on {CE} equals the square on {BE}.",
              visible: L2_GB,
              highlighted: ["GB","BC","CE","BE"],
              justifications: [{ claim: "GB·BC + CE² = BE²", ref: "II.6" }] },
            { text: "But the product of {AB} and {BC} together with the square on {CE} also, by hypothesis, equals the square on {BE},",
