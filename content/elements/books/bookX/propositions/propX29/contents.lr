sections:

#### prop_section ####
kind: lemma
----
label: Lemma 1
----
anchor: lemma1
----
statement: To find two square numbers such that their sum is also square.
----
proof:

Set out two numbers {AB} and {BC}, and let them be either both even or both odd. Then since, whether an even number is subtracted from an even number, or an odd number from an odd number, the remainder is even, therefore the remainder {AC} is even. [!just IX.24; IX.26]

Bisect {AC} at {D}. Let {AB} and {BC} also be either similar plane numbers, or square numbers, which are themselves also similar plane numbers.

<figure class="diagram">
<canvas id="canvas_0" width="260" height="60" tabindex="0"></canvas>
<noscript><img alt="X.29 diagram" src="propX29l1.gif"/></noscript>
<script type="text/javascript">
    // Joyce's lemma figure: the number AB laid out as a line, with C and the
    // midpoint D of AC on it. The numbers the proof names (BC, AC, CD, BD)
    // are added as transparent highlight targets (;0;0;0), so the resting
    // figure is unchanged. The walk is highlight beats; D appears with
    // "Bisect AC at D".
    //
    // Draggables (checked against the bundle): A, B, C (lineSliders, the
    // numbers set out) and the offscreen frees. D is derived (midpoint) and
    // listed per slide.
    var L1_GIVEN = ["A","B","C","AB","BC"];
    var L1_EVEN  = L1_GIVEN.concat(["AC"]);
    var L1_BIS   = L1_EVEN.concat(["D","CD"]);
    var L1_ALL   = L1_BIS.concat(["BD"]);
    geomlib.init({
        canvasid: "canvas_0",
        background: "35,19,100",
        title: "Lemma 1",
        elements: [
            "A0;point;free;-1000,40;0;0",
            "A3;point;free;1000,40;0;0",
            "A;point;lineSlider;A0,A3,30,0",
            "B;point;lineSlider;A0,A3,230,0",
            "AB;line;connect;A,B;0;0;blue",
            "C;point;lineSlider;A0,A3,180,0",
            "D;point;midpoint;A,C",
            // Highlight targets only — AB already draws these.
            "BC;line;connect;B,C;0;0;0",
            "AC;line;connect;A,C;0;0;0",
            "CD;line;connect;C,D;0;0;0",
            "BD;line;connect;B,D;0;0;0"
        ],
        slides: [
            { text: "“To find two square numbers such that their sum is also square.”",
              visible: L1_ALL,
              highlighted: ["CD","BD"],
              justifications: [{ ref: "Lemma 1" }] },
            { text: "Set out two numbers {AB} and {BC}, and let them be either both even or both odd.",
              visible: L1_GIVEN,
              highlighted: ["AB","BC"] },
            { text: "Then since, whether an even number is subtracted from an even number, or an odd number from an odd number,",
              visible: L1_GIVEN,
              highlighted: ["AB","BC"] },
            { text: "the remainder is even, therefore the remainder {AC} is even.",
              visible: L1_EVEN,
              highlighted: ["AC"],
              justifications: [{ claim: "even from even leaves even", ref: "IX.24" },
                               { claim: "odd from odd leaves even", ref: "IX.26" }] },
            { text: "Bisect {AC} at {D}.",
              visible: L1_BIS,
              highlighted: ["AC"],
              transition: { animations: [
                  { elem: "D", name: geomlib.A.Point.appear } ] } },
            { text: "Let {AB} and {BC} also be either similar plane numbers, or square numbers, which are themselves also similar plane numbers.",
              visible: L1_BIS,
              highlighted: ["AB","BC"] },
            { text: "Now the product of {AB} and {BC} together with the square on {CD} equals the square on {BD}.",
              visible: L1_ALL,
              highlighted: ["AB","BC","CD","BD"],
              justifications: [{ claim: "AB·BC + CD² = BD²", ref: "II.6" }] },
            { text: "And the product of {AB} and {BC} is square,",
              visible: L1_ALL,
              highlighted: ["AB","BC"] },
            { text: "inasmuch as it was proved that, if two similar plane numbers multiplied by one another make some number, the product is square.",
              visible: L1_ALL,
              highlighted: ["AB","BC"],
              justifications: [{ claim: "AB·BC square", ref: "IX.1" }] },
            { text: "Therefore two square numbers, the product of {AB} and {BC}, and the square on {CD},",
              visible: L1_ALL,
              highlighted: ["AB","BC","CD"] },
            { text: "have been found which, when added together, make the square on {BD}.",
              visible: L1_ALL,
              highlighted: ["BD"] },
            { text: "And it is clear that two square numbers, the square on {BD} and the square on {CD}, have again been found",
              visible: L1_ALL,
              highlighted: ["BD","CD"] },
            { text: "such that their difference, the product of {AB} and {BC}, is a square, whenever {AB} and {BC} are similar plane numbers.",
              visible: L1_ALL,
              highlighted: ["AB","BC"] },
            { text: "But when they are not similar plane numbers, two square numbers, the square on {BD} and the square on {DC|CD}, have been found",
              visible: L1_ALL,
              highlighted: ["BD","CD"] },
            { text: "such that their difference, the product of {AB} and {BC}, is not square.",
              visible: L1_ALL,
              highlighted: ["AB","BC"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "Lemma 1") return "#lemma1";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification
    // (shared by the three canvases on this page).
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "I.47":      "/elements/books/bookI/propositions/propI47/",
        "II.6":      "/elements/books/bookII/propositions/propII6/",
        "III.31":    "/elements/books/bookIII/propositions/propIII31/",
        "V.19.Cor":  "/elements/books/bookV/propositions/propV19/#cor",
        "IX.1":      "/elements/books/bookIX/propositions/propIX1/",
        "IX.24":     "/elements/books/bookIX/propositions/propIX24/",
        "IX.26":     "/elements/books/bookIX/propositions/propIX26/",
        "X.6":       "/elements/books/bookX/propositions/propX6/",
        "X.6.Cor":   "/elements/books/bookX/propositions/propX6/#cor",
        "X.9":       "/elements/books/bookX/propositions/propX9/",
        "X.Def.I.4": "/elements/books/bookX/definitions/defX.I.4/"
    });
</script>
</figure>

Now the product of {AB} and {BC} together with the square on {CD} equals the square on {BD}. And the product of {AB} and {BC} is square, inasmuch as it was proved that, if two similar plane numbers multiplied by one another make some number, the product is square. Therefore two square numbers, the product of {AB} and {BC}, and the square on {CD}, have been found which, when added together, make the square on {BD}. [!just II.6; IX.1]

And it is clear that two square numbers, the square on {BD} and the square on {CD}, have again been found such that their difference, the product of {AB} and {BC}, is a square, whenever {AB} and {BC} are similar plane numbers. But when they are not similar plane numbers, two square numbers, the square on {BD} and the square on {DC|CD}, have been found such that their difference, the product of {AB} and {BC}, is not square.

<div class="qed">Q.E.D.</div>
#### prop_section ####
kind: lemma
----
red_highlight: yes
----
label: Lemma 2
----
anchor: lemma2
----
statement: To find two square numbers such that their sum is not square.
----
proof:

Let the product of {AB:canvas_1} and {BC:canvas_1} we said, be square, and {CA|AC:canvas_1} even. Bisect {CA|AC:canvas_1} by {D:canvas_1}.

It is then clear that the square product of {AB:canvas_1} and {BC:canvas_1} together with the square on {CD:canvas_1} equals the square on {BD:canvas_1}. <div class="just"><a href="/elements/books/bookX/propositions/propX29/#lemma1">Lemma 1</a></div>

Subtract the unit {DE:canvas_1}. Therefore the product of {AB:canvas_1} and {BC:canvas_1} together with the square on {CE:canvas_1} is less than the square on {BD:canvas_1}.

<figure class="diagram">
<canvas id="canvas_1" width="350" height="60" tabindex="0"></canvas>
<noscript><img alt="X.29 Lemma 2 diagram" src="propX29l2.gif"/></noscript>
<script type="text/javascript">
    // Joyce's lemma figure: AB as a line with C, the midpoint D of AC, the
    // unit DE (and DF, two units) cut off toward B, and G, H for the two
    // reductios (AG double DE, AH double DF). U1-U2 is the unit, offscreen.
    // Every number the proof names is added as a transparent highlight
    // target (;0;0;0); the resting figure is unchanged. The walk is
    // highlight beats with point-appears; each reductio's points and
    // segments are withdrawn once its absurdity is reached.
    //
    // Draggables (checked against the bundle): A, B, C (lineSliders, the
    // givens) and the offscreen frees U1, U2 (and A0, A3). D, E, F, G, H
    // are derived (midpoint / cutoff) and listed per slide.
    var L2_GIVEN = ["A","B","C","AB","BC","AC"];
    var L2_BIS   = L2_GIVEN.concat(["D","CD","BD"]);
    var L2_UNIT  = L2_BIS.concat(["E","DE","CE"]);
    var L2_BE    = L2_UNIT.concat(["BE"]);
    var L2_G     = L2_BE.concat(["G","AG"]);
    var L2_GC    = L2_G.concat(["GC"]);
