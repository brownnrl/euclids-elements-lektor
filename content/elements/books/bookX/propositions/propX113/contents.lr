                  { elem: "F", name: geomlib.A.Point.appear } ] } },
            { text: "Then the remainder {KF} is to {FH} as {KH} is to {HE}, that is {BC} is to {CD}.",
              visible: ALL,
              highlighted: ["KF","FH","KH","HE"],
              justifications: [{ claim: "KF : FH = KH : HE", ref: "V.19" }] },
            { text: "But {BC} and {CD} are commensurable in square only,",
              visible: ALL,
              highlighted: ["BC","DC"] },
            { text: "therefore {KF} and {FH} are also commensurable in square only.",
              visible: ALL,
              highlighted: ["KF","FH"],
