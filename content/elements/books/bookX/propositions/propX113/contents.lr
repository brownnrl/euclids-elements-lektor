    // arrive with their captions. H, G2, E, F are derived and listed.
    var GIV = ["A1","A2","A","B","D","BD"];
    var KHS = GIV.concat(["K","H","KH"]);
    var ANN = KHS.concat(["C","DC"]);
    var BCS = ANN.concat(["BC"]);
    var GS  = BCS.concat(["G1","G2","G"]);
    var ES  = GS.concat(["E","KE","HE"]);
