              visible: ALL,
              highlighted: ["AE","BE"] },
            { text: "by the square on a straight line incommensurable with {AE},",
              visible: ALL,
              highlighted: ["AE"] },
            { text: "then the square on {CF} is also greater than the square on {FD}",
              visible: ALL,
              highlighted: ["CF","DF"] },
            { text: "by the square on a straight line incommensurable with {CF}.",
              visible: ALL,
              highlighted: ["CF"],
              justifications: [{ claim: "CF² − FD² incommensurable with CF", ref: "X.14" }] },
            { text: "And, if {AE} is commensurable in length with the rational straight line set out, then {CF} is also;",
              visible: ALL,
              highlighted: ["AE","CF"],
              justifications: [{ claim: "CF commensurable with the rational", ref: "X.12" }] },
            { text: "if {BE}, then {DF} also;",
              visible: ALL,
              highlighted: ["BE","DF"],
              justifications: [{ claim: "DF commensurable with the rational", ref: "X.12" }] },
            { text: "and, if neither of the straight lines {AE} nor {EB}, then neither of the straight lines {CF} nor {FD}.",
              visible: ALL,
              highlighted: ["AE","BE","CF","DF"],
              justifications: [{ claim: "CF, FD incommensurable with the rational", ref: "X.13" }] },
            { text: "Therefore {CD} is an apotome and the same in order with {AB}.",
              visible: ALL,
              highlighted: ["CD","AB"] },
            { text: "Therefore, a straight line commensurable in length with an apotome is an apotome and the same in order.",
              visible: ALL,
              highlighted: ["CD","AB"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
