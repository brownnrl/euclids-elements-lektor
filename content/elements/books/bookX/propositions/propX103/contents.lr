            { text: "or by the square on a straight line incommensurable with it.",
              visible: ALL,
              highlighted: ["AE"] },
            { text: "If then the square on {AE} is greater than the square on {EB}",
              visible: ALL,
              highlighted: ["AE","BE"] },
            { text: "by the square on a straight line commensurable with {AE},",
              visible: ALL,
              highlighted: ["AE"] },
            { text: "then the square on {CF} is also greater than the square on {FD}",
