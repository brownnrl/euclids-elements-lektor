            "A;point;lineSlider;X0,X1,30,0",
            "B;point;lineSlider;X0,X1,100,0",
            "C;point;lineSlider;X0,X1,200,0",
            "AC;line;connect;A,C",
            // Slide-only highlight targets.
            "AB;line;connect;A,B;0;0;0",
            "BC;line;connect;B,C;0;0;0"
        ],
        slides: [
            { text: "“If two rational straight lines commensurable in square only are added together,",
              visible: ALL,
              highlighted: ["AB","BC"],
              justifications: [{ ref: "X.36" }] },
            { text: "then the whole is irrational; let it be called binomial.”",
              visible: ALL,
              highlighted: ["AC"] },
            { text: "Let two rational straight lines {AB} and {BC} commensurable in square only be added together.",
              visible: ALL,
              highlighted: ["AB","BC"] },
            { text: "I say that the whole {AC} is irrational.",
              visible: ALL,
              highlighted: ["AC"] },
            { text: "Since {AB} is incommensurable in length with {BC}, for they are commensurable in square only,",
              visible: ALL,
              highlighted: ["AB","BC"] },
            { text: "and {AB} is to {BC} as the rectangle {AB} by {BC} is to the square on {BC},",
              visible: ALL,
              highlighted: ["AB","BC"] },
            { text: "therefore the rectangle {AB} by {BC} is incommensurable with the square on {BC}.",
              visible: ALL,
              highlighted: ["AB","BC"],
              justifications: [{ claim: "AB·BC, BC² incommensurable", ref: "X.11" }] },
            { text: "But twice the rectangle {AB} by {BC} is commensurable with the rectangle {AB} by {BC},",
              visible: ALL,
              highlighted: ["AB","BC"],
              justifications: [{ claim: "2 AB·BC, AB·BC commensurable", ref: "X.6" }] },
            { text: "and the sum of the squares on {AB} and {BC} is commensurable with the square on {BC},",
              visible: ALL,
              highlighted: ["AB","BC"],
              justifications: [{ claim: "AB² + BC², BC² commensurable", ref: "X.15" }] },
            { text: "for {AB} and {BC} are rational straight lines commensurable in square only,",
              visible: ALL,
              highlighted: ["AB","BC"] },
            { text: "therefore twice the rectangle {AB} by {BC} is incommensurable with the sum of the squares on {AB} and {BC}.",
              visible: ALL,
              highlighted: ["AB","BC"],
              justifications: [{ claim: "2 AB·BC, AB² + BC² incommensurable", ref: "X.13" }] },
            { text: "And, taken jointly, twice the rectangle {AB} by {BC} together with the squares on {AB} and {BC},",
              visible: ALL,
              highlighted: ["AB","BC"] },
            { text: "that is, the square on {AC},",
              visible: ALL,
              highlighted: ["AC"],
              justifications: [{ claim: "AC² = AB² + BC² + 2 AB·BC", ref: "II.4" }] },
            { text: "is incommensurable with the sum of the squares on {AB} and {BC}.",
              visible: ALL,
              highlighted: ["AC","AB","BC"],
              justifications: [{ claim: "AC², AB² + BC² incommensurable", ref: "X.16" }] },
            { text: "But the sum of the squares on {AB} and {BC} is rational,",
              visible: ALL,
              highlighted: ["AB","BC"] },
            { text: "therefore the square on {AC} is irrational, so that {AC} is also irrational.",
              visible: ALL,
              highlighted: ["AC"] },
            { text: "Let it be called binomial.",
              visible: ALL,
              highlighted: ["AC"],
              justifications: [{ ref: "X.Def.I.4" }, { ref: "Q.E.D." }] }
        ],
