            "FG;line;connect;F,G",
            "FH;line;connect;F,H;0;0;0",
            "FK;line;connect;F,K;0;0;0",
            "KH;line;connect;K,H;0;0;0",
            "BC4;point;vertex;BC,4;0;0",
