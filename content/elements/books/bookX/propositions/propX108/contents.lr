              highlighted: ["EC"] },
            { text: "either an apotome or a minor straight line.",
              visible: GIVEN,
              highlighted: ["EC"] },
            { text: "Set out a rational straight line {FG},",
              visible: FGS,
              highlighted: ["FG"],
              transition: { animations: [
                  { elem: "FG", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "to {FG} apply the rectangular parallelogram {GH|GHf} equal to {BC|BCf},",
              visible: GHS,
