              transition: { mode: "cascade", animations: [
                  { elem: "H",  name: geomlib.A.Point.appear },
                  { elem: "GH", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "and subtract {GK|GFKL} equal to {DB|BD}.",
              visible: ALL,
              highlighted: ["GFKL","BD"],
              transition: { mode: "cascade", animations: [
                  { elem: "K",    name: geomlib.A.Point.appear },
                  { elem: "L",    name: geomlib.A.Point.appear },
                  { elem: "GFKL", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "Then the remainder {EC} equals {LH}.",
              visible: ALL,
              highlighted: ["EC","LH"] },
            { text: "Since, then, {BC|BCf} is rational, and {BD} medial,",
              visible: ALL,
              highlighted: ["BCf","BD"] },
            { text: "while {BC|BCf} equals {GH|GHf}, and {BD} equals {GK|GFKL},",
