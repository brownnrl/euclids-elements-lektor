              justifications: [{ claim: "KH an apotome", ref: "X.73" }] },
            { text: "Now the square on {HF|FH} is greater than the square on {FK}",
              visible: ALL,
              highlighted: ["FH","FK"] },
            { text: "by the square on a straight line either commensurable with {HF|FH} or not commensurable.",
              visible: ALL,
              highlighted: ["FH"] },
            { text: "First, let the square on it be greater by the square on a straight line commensurable with it.",
              visible: ALL,
              highlighted: ["FH"] },
            { text: "Now the whole {HF|FH} is commensurable in length with the rational straight line {FG} set out,",
              visible: ALL,
              highlighted: ["FH","FG"] },
            { text: "therefore {KH} is a first apotome.",
              visible: ALL,
              highlighted: ["KH"],
              justifications: [{ claim: "KH a first apotome", ref: "X.Def.III.1" }] },
            { text: "But the side of the rectangle contained by a rational straight line and a first apotome is an apotome.",
              visible: ALL,
              highlighted: ["LH"] },
            { text: "Therefore the side of {LH}, that is, of {EC}, is an apotome.",
              visible: ALL,
              highlighted: ["LH","EC"],
              justifications: [{ claim: "side of LH an apotome", ref: "X.91" }] },
            { text: "But, if the square on {HF|FH} is greater than the square on {FK}",
              visible: ALL,
              highlighted: ["FH","FK"] },
            { text: "by the square on a straight line incommensurable with {HF|FH},",
              visible: ALL,
              highlighted: ["FH"] },
            { text: "while the whole {FH} is commensurable in length with the rational straight line {FG} set out,",
              visible: ALL,
              highlighted: ["FH","FG"] },
            { text: "then {KH} is a fourth apotome.",
              visible: ALL,
              highlighted: ["KH"],
              justifications: [{ claim: "KH a fourth apotome", ref: "X.Def.III.4" }] },
            { text: "But the side of the rectangle contained by a rational straight line and a fourth apotome is minor.",
              visible: ALL,
              highlighted: ["LH","EC"],
              justifications: [{ claim: "side of LH minor", ref: "X.94" }] },
            { text: "Therefore, if a medial area is subtracted from a rational area,",
              visible: ALL,
              highlighted: ["BCf","BD"] },
            { text: "then the side of the remaining area becomes one of two irrational straight lines,",
              visible: ALL,
              highlighted: ["EC"] },
            { text: "either an apotome or a minor straight line.",
              visible: ALL,
              highlighted: ["EC"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "X.108") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "X.13":        "/elements/books/bookX/propositions/propX13/",
        "X.20":        "/elements/books/bookX/propositions/propX20/",
        "X.22":        "/elements/books/bookX/propositions/propX22/",
        "X.73":        "/elements/books/bookX/propositions/propX73/",
        "X.91":        "/elements/books/bookX/propositions/propX91/",
        "X.94":        "/elements/books/bookX/propositions/propX94/",
        "X.Def.III.1": "/elements/books/bookX/definitions/defX.III.1/",
        "X.Def.III.4": "/elements/books/bookX/definitions/defX.III.4/"
