              visible: P_ALL,
              highlighted: ["C","D"] },
            { text: "“by the square on {a third line incommensurable with the third|F}.”",
              visible: P_ALL,
              highlighted: ["F","C"],
              justifications: [{ ref: "X.14" }] },
            { text: "Let {A}, {B}, {C}, and {D} be four straight lines in proportion, so that {A} is to {B} as {C} is to {D},",
              visible: P_ALL,
              highlighted: ["A","B","C","D"] },
            { text: "and let the square on {A} be greater than the square on {B} by the square on {E},",
              visible: P_ALL,
              highlighted: ["A","B","E"],
              justifications: [{ claim: "E found", ref: "Lemma" }] },
            { text: "and let the square on {C} be greater than the square on {D} by the square on {F}.",
