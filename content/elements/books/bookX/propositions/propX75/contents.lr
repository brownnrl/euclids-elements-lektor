            { text: "But {DI} is rational,",
              visible: ALL,
              highlighted: ["DI"] },
            { text: "and the rectangle contained by a rational and an irrational straight line is irrational, and its side is irrational.",
              visible: ALL,
              highlighted: ["FEh"],
              justifications: [{ claim: "FE irrational, its side irrational", ref: "X.20" }] },
            { text: "And {AC} is the side of {FE|FEh}, therefore {AC} is irrational.",
              visible: ALL,
              highlighted: ["AC","FEh"] },
            { text: "Let it be called a second apotome of a medial straight line.",
