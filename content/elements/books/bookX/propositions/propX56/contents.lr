              highlighted: ["EF","EK"] },
            { text: "Therefore {EL}, that is, {MR}, is medial.",
              visible: ALL,
              highlighted: ["EL","MR"],
              justifications: [{ claim: "EL medial", ref: "X.21" }] },
            { text: "And it is contained by {MN} and {NO}, therefore the rectangle {MN} by {NO} is medial.",
              visible: ALL,
              highlighted: ["MR","MN","NO"] },
            { text: "Therefore {MO} is a second bimedial straight line.",
              visible: ALL,
              highlighted: ["MO"],
              justifications: [{ claim: "second bimedial", ref: "X.38" }] },
            { text: "Therefore, if an area is contained by a rational straight line and the third binomial,",
              visible: ALL,
              highlighted: ["ABCDh","AB","AD"] },
            { text: "then the side of the area is the irrational straight line called a second bimedial.",
              visible: ALL,
              highlighted: ["MO"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "X.56") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "X.Def.II.3": "/elements/books/bookX/definitions/defX.II.3/",
