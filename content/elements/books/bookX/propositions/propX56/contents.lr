            "B';point;perpendicular;A,D;0;0",
            "B;point;lineSlider;A,B',0,150",
            "C;point;parallelogram;B,A,D",
            "ABCD;polygon;quadrilateral;A,B,C,D;0;0;black;random",
            "E;point;lineSlider;A,D,120,0",
            "F;point;midpoint;E,D",
            "AEmid;point;midpoint;A,E;0;0",
            "AEquar;point;midpoint;E,AEmid;0;0",
            "EFcirc;circle;radius;E,F;0;0;0;0",
            "EAcirc;circle;radius;AEquar,E;0;0;0;0",
