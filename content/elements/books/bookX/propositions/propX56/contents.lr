            "G';point;first;bich;0;0",
            "G;point;cutoff;AEmid,D,AEmid,G'",
            "H;point;parallelogram;B,A,G",
            "K;point;parallelogram;B,A,E",
            "L;point;parallelogram;B,A,F",
            "HGEK;polygon;quadrilateral;H,G,E,K;0;0;black;0,80,100",
