            { text: "as the square on {CF} is to the rectangle {CF} by {FD},",
              visible: ALL,
              highlighted: ["CF","DF"] },
            { text: "while the square on {AE} is commensurable with the square on {CF},",
              visible: ALL,
              highlighted: ["AE","CF"] },
            { text: "therefore the rectangle {AE} by {EB} is also commensurable with the rectangle {CF} by {FD}.",
              visible: ALL,
              highlighted: ["AE","BE","CF","DF"] },
            { text: "But the rectangle {AE} by {EB} is medial,",
              visible: ALL,
              highlighted: ["AE","BE"] },
            { text: "therefore the rectangle {CF} by {FD} is also medial.",
              visible: ALL,
              highlighted: ["CF","DF"],
              justifications: [
                  { claim: "AB minor", ref: "X.76" },
                  { claim: "commensurable with a medial area", ref: "X.23.Cor" } ] },
            { text: "Therefore {CF} and {FD} are straight lines incommensurable in square",
              visible: ALL,
              highlighted: ["CF","DF"] },
            { text: "which make the sum of the squares on them rational, but the rectangle contained by them medial.",
              visible: ALL,
              highlighted: ["CF","DF"] },
            { text: "Therefore {CD} is minor.",
              visible: ALL,
              highlighted: ["CD"],
              justifications: [{ claim: "CD minor", ref: "X.76" }] },
            { text: "Therefore, a straight line commensurable with a minor straight line is minor.",
              visible: ALL,
              highlighted: ["CD","AB"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
