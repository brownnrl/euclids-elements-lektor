            "D;point;lineSlider;C0,C3,150,0",
            "E;point;lineSlider;A0,A3,170,0",
            "AE;line;connect;A,E",
            "F;point;proportion;A,B,C,D,B,E,D,C3",
            "CF;line;connect;C,F",
