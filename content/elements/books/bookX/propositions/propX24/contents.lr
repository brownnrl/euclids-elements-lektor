sections:

#### prop_section ####
kind: proposition
----
statement: The rectangle contained by medial straight lines commensurable in length is medial.
----
proof:

Let the rectangle {AC|ACh} be contained by the medial straight lines {AB} and {BC} which are commensurable in length.

<figure class="diagram">
<canvas id="canvas_0" width="170" height="250" tabindex="0"></canvas>
<noscript><img alt="X.24 diagram" src="propX24.gif"/></noscript>
<script type="text/javascript">
    // Joyce's figure: the rectangle AC on AB with the square AD on AB on
    // the other side (both random faces). The proof talks about the sides
    // AB, BC, BD, so those are transparent highlight targets (;0;0;0). The
    // square and the rectangle are lit through faceless, strokeless twins
    // ADh / ACh, so a highlight never raises a face over the figure (#140);
    // prose and captions reach them with the display override ({AD|ADh},
    // {DA|ADh}, {AC|ACh}). Resting figure unchanged.
    //
    // Draggables (checked against the bundle): A, B, C (given) and the
    // offscreen frees. D is a derived vertex, so the square and D simply
    // stay out of the visible sets until "Describe the square".
    var GIVEN = ["A","B","C","AC","ACh","AB","BC"];
    var SQ    = GIVEN.concat(["AD","ADh","D","BD"]);
    geomlib.init({
        canvasid: "canvas_0",
