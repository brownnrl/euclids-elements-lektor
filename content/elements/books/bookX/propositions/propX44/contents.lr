            "E;point;lineSlider;E0,E3,0,80",
            "F;point;lineSlider;E0,E3,0,170",
            "N';point;parallelogram;B,A,E;0;0",
            "N;point;proportion;E,F,A,B,A,B,E,N'",
            "K;point;parallelogram;F,E,N",
            "F,E,N,K;polygon;quadrilateral;F,E,N,K;0;0;black;random",
            "H';point;proportion;E,F,A,C,A,C,E,N;0;0",
            "H;point;proportion;E,F,C,B,C,B,H',N",
            "G;point;parallelogram;F,E,H",
            "M';point;proportion;E,F,A,D,A,D,E,N;0;0",
            "M;point;proportion;E,F,D,B,D,B,M',N",
            "L;point;parallelogram;F,E,M",
            "GHML;polygon;quadrilateral;G,H,M,L;0;0;black;random",
