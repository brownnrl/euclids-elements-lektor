                  { elem: "GH", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Then the remainder {HK} equals twice the rectangle {AC} by {CB}.",
              visible: SUB,
              highlighted: ["HK","AC","CB"],
              justifications: [{ claim: "AB² = AC² + CB² + 2 AC·CB", ref: "II.4" }] },
            { text: "Again, subtract {EL}, equal to the sum of the squares on {AD} and {DB},",
