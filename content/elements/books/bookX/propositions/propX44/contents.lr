            { text: "It is then clear that the sum of the squares on {AD} and {DB} is also, as we proved above,",
              visible: DIV,
              highlighted: ["AD","DB"],
              justifications: [{ claim: "AD² + DB² < AC² + CB²", ref: "X.41.Lemma" }] },
            { text: "less than the sum of the squares on {AC} and {CB}.",
              visible: DIV,
              highlighted: ["AC","CB"] },
            { text: "Suppose that {AD} and {DB} are medial straight lines commensurable in square only and containing a medial rectangle.",
              visible: DIV,
              highlighted: ["AD","DB"] },
            { text: "Set out a rational straight line {EF},",
              visible: RAT,
              highlighted: ["EF"],
              transition: { mode: "cascade", animations: [
                  { elem: "E",  name: geomlib.A.Point.appear },
                  { elem: "F",  name: geomlib.A.Point.appear },
