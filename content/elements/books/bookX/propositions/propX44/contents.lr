    // divided at D", E and F with "Set out a rational straight line EF", so
    // all three are deferred. N, K, H, G, M, L are derived and listed per
    // slide. The closing slide withdraws the supposition and the rectangles.
    var SET  = ["A","B","AB","C","AC","CB"];
    var DIV  = SET.concat(["D","AD","DB"]);
    var RAT  = DIV.concat(["E","F","EF"]);
    var APP  = RAT.concat(["N","K","F,E,N,K","EK","EN"]);
    var SUB  = APP.concat(["H","G","GH","EG","HK","EH","HN"]);
    var ALL  = SUB.concat(["M","L","ML","GHML","EL","MK","EM","MN"]);
