    var RAT   = GIVEN.concat(["D","E","DE"]);
    var APPL  = RAT.concat(["G","F","EDGF","DFh","DG"]);
    var ALL   = APPL.concat(["K","H","EDKH","M","L","HKML","N","O","NO",
