            "E;point;lineSlider;D0,D3,0,130",
            "G';point;parallelogram;D,A0,A3;0;0",
            "G;point;proportion;D,E,A,B,A,B,D,G'",
            "F;point;parallelogram;E,D,G",
            "EDGF;polygon;quadrilateral;E,D,G,F;0;0;black;random",
            "K;point;proportion;D,E,A,C,A,C,D,G'",
            "EDKH;polygon;parallelogram;E,D,K;0;0;black;random",
            "H;point;vertex;EDKH,4",
            "M;point;proportion;D,E,B,C,B,C,K,G'",
            "HKML;polygon;parallelogram;H,K,M;0;0;black;random",
            "L;point;vertex;HKML,4",
            "N;point;midpoint;M,G",
            "O;point;parallelogram;E,D,N",
            "NO;line;connect;N,O",
            // Slide-only twin and highlight targets.
            "DE;line;connect;D,E",
            "AC;line;connect;A,C;0;0;0",
            "CB;line;connect;C,B;0;0;0",
            "DG;line;connect;D,G;0;0;0",
            "DM;line;connect;D,M;0;0;0",
            "MG;line;connect;M,G;0;0;0",
            "DK;line;connect;D,K;0;0;0",
