              highlighted: ["AC","CB"],
              justifications: [{ claim: "AB a major", ref: "X.39" }] },
            { text: "Since the sum of the squares on {AC} and {CB} is rational, therefore {DL} is rational.",
              visible: ALL,
              highlighted: ["AC","CB","DL"] },
            { text: "Therefore {DM} is also rational and commensurable in length with {DE}.",
              visible: ALL,
              highlighted: ["DM","DE"],
              justifications: [{ claim: "DM rational, commensurable with DE", ref: "X.20" }] },
            { text: "Again, since twice the rectangle {AC} by {CB}, that is, {MF}, is medial,",
              visible: ALL,
              highlighted: ["AC","CB","MF"] },
            { text: "and it is applied to the rational straight line {ML},",
              visible: ALL,
              highlighted: ["MF","ML"] },
            { text: "therefore {MG} is also rational and incommensurable in length with {DE}.",
              visible: ALL,
              highlighted: ["MG","DE"],
              justifications: [{ claim: "MG rational, incommensurable with DE", ref: "X.22" }] },
            { text: "Therefore {DM} is also incommensurable in length with {MG}.",
              visible: ALL,
              highlighted: ["DM","MG"],
              justifications: [{ claim: "DM, MG incommensurable", ref: "X.13" }] },
            { text: "Therefore {DM} and {MG} are rational straight lines commensurable in square only. Therefore {DG} is binomial.",
              visible: ALL,
              highlighted: ["DM","MG","DG"],
              justifications: [{ claim: "DG binomial", ref: "X.36" }] },
            { text: "It is to be proved that it is a fourth binomial straight line.",
              visible: ALL,
              highlighted: ["DG"] },
            { text: "In manner similar to the foregoing we can prove that {DM} is greater than {MG},",
              visible: ALL,
              highlighted: ["DM","MG"] },
            { text: "and that the rectangle {DK} by {KM} equals the square on {MN}.",
              visible: ALL,
              highlighted: ["DK","KM","MN"] },
            { text: "Since the square on {AC} is incommensurable with the square on {CB},",
              visible: ALL,
              highlighted: ["AC","CB"] },
            { text: "therefore {DH|EDKH} is also incommensurable with {KL|HKML},",
              visible: ALL,
              highlighted: ["EDKH","HKML"] },
            { text: "so that {DK} is also incommensurable with {KM}.",
              visible: ALL,
              highlighted: ["DK","KM"],
              justifications: [{ claim: "DK, KM incommensurable", ref: "VI.1" }, { ref: "X.11" }] },
            { text: "But, if there are two unequal straight lines, and to {the greater|DM} there is applied a parallelogram",
              visible: ALL,
              highlighted: ["DM"] },
            { text: "equal to the fourth part of the square on {the less|MG} and deficient by a square figure,",
              visible: ALL,
              highlighted: ["MG","DK","KM"] },
            { text: "and if it divides it into incommensurable parts,",
              visible: ALL,
              highlighted: ["DK","KM"] },
            { text: "then the square on {the greater|DM} is greater than the square on {the less|MG}",
              visible: ALL,
              highlighted: ["DM","MG"] },
            { text: "by the square on a straight line incommensurable in length with {the greater|DM},",
              visible: ALL,
              highlighted: ["DM"] },
            { text: "therefore the square on {DM} is greater than the square on {MG}",
              visible: ALL,
              highlighted: ["DM","MG"] },
            { text: "by the square on a straight line incommensurable with {DM}.",
              visible: ALL,
              highlighted: ["DM"],
              justifications: [{ ref: "X.18" }] },
            { text: "And {DM} and {MG} are rational straight lines commensurable in square only,",
              visible: ALL,
              highlighted: ["DM","MG"] },
            { text: "and {DM} is commensurable with the rational straight line {DE} set out.",
              visible: ALL,
              highlighted: ["DM","DE"] },
            { text: "Therefore {DG} is a fourth binomial straight line.",
              visible: ALL,
              highlighted: ["DG"],
              justifications: [{ claim: "fourth binomial", ref: "X.Def.II.4" }] },
            { text: "Therefore, the square on the major straight line applied to a rational straight line",
              visible: ALL,
              highlighted: ["AB","DE","DFh"] },
            { text: "produces as breadth the fourth binomial.",
              visible: ALL,
              highlighted: ["DG"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "X.63") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "VI.1":       "/elements/books/bookVI/propositions/propVI1/",
        "X.11":       "/elements/books/bookX/propositions/propX11/",
        "X.13":       "/elements/books/bookX/propositions/propX13/",
        "X.18":       "/elements/books/bookX/propositions/propX18/",
        "X.20":       "/elements/books/bookX/propositions/propX20/",
        "X.22":       "/elements/books/bookX/propositions/propX22/",
        "X.36":       "/elements/books/bookX/propositions/propX36/",
        "X.39":       "/elements/books/bookX/propositions/propX39/",
        "X.Def.II.4": "/elements/books/bookX/definitions/defX.II.4/"
