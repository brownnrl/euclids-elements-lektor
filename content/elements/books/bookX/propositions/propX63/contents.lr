            "ML;line;connect;M,L;0;0;0",
            "DFh;polygon;quadrilateral;E,D,G,F;0;0;0;0",
            "DL;polygon;quadrilateral;D,M,L,E;0;0;0;0",
            "MF;polygon;quadrilateral;M,G,F,L;0;0;0;0"
        ],
