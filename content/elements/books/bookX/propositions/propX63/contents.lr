        deferDraggables: ["D","E"],
        aliases: { "DF": "DFh", "DH": "EDKH", "KL": "HKML" },
        slides: [
            { text: "“The square on the major straight line applied to a rational straight line",
              visible: ALL,
              highlighted: ["AB","DE","DFh"],
              justifications: [{ ref: "X.63" }] },
            { text: "produces as breadth the fourth binomial.”",
              visible: ALL,
              highlighted: ["DG"] },
            { text: "Let {AB} be a major straight line divided at {C}, so that {AC} is greater than {CB},",
              visible: GIVEN,
              highlighted: ["AB","C","AC","CB"] },
            { text: "let {DE} be a rational straight line,",
              visible: RAT,
              highlighted: ["DE"],
              transition: { animations: [
                  { elem: "DE", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "and to {DE} let there be applied the parallelogram {DF|DFh} equal to the square on {AB}",
              visible: APPL,
              highlighted: ["DE","DFh","AB"],
              transition: { animations: [
                  { elem: "EDGF", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "and producing {DG} as its breadth.",
              visible: APPL,
              highlighted: ["DG"] },
            { text: "I say that {DG} is a fourth binomial straight line.",
              visible: APPL,
              highlighted: ["DG"] },
            { text: "Make the same construction as shown before.",
              visible: ALL,
              transition: { mode: "cascade", animations: [
                  { elem: "EDKH", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "HKML", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "N",    name: geomlib.A.Point.appear },
                  { elem: "NO",   name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Since {AB} is a major straight line divided at {C},",
              visible: ALL,
              highlighted: ["AB","C"] },
            { text: "therefore {AC} and {CB} are straight lines incommensurable in square",
              visible: ALL,
              highlighted: ["AC","CB"] },
            { text: "which make the sum of the squares on them rational, but the rectangle contained by them medial.",
