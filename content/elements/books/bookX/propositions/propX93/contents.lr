              justifications: [{ claim: "AF : EG = AI : EK", ref: "VI.1" },
                               { claim: "AI, EK incommensurable", ref: "X.11" }] },
            { text: "Now construct the square {LM} equal to {AI},",
              visible: SQ1,
              highlighted: ["LM","AI"],
              transition: { mode: "cascade", animations: [
                  { elem: "R",    name: geomlib.A.Point.appear },
                  { elem: "RMPL", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "and subtract {NO}, equal to {FK}, about the same angle with {LM}.",
              visible: SQ2,
              highlighted: ["NO","FK","LM"],
              transition: { animations: [
                  { elem: "PNQO", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "Then {LM} and {NO} are about the same diameter.",
              visible: SQ2,
              highlighted: ["LM","NO"],
              justifications: [{ claim: "about the same diameter", ref: "VI.26" }] },
            { text: "Let {PR} be their diameter,",
              visible: DIAM,
              highlighted: ["RP"],
              transition: { animations: [
                  { elem: "RP", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "and draw the figure.",
              visible: ALL,
              transition: { mode: "cascade", animations: [
                  { elem: "SQ", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "TQ", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Now, since the rectangle {AF} by {FG} equals the square on {EG},",
              visible: ALL,
              highlighted: ["AF","FG","EG"] },
            { text: "therefore {AF} is to {EG} as {EG} is to {FG}.",
              visible: ALL,
              highlighted: ["AF","EG","FG"],
              justifications: [{ claim: "AF : EG = EG : FG", ref: "VI.17" }] },
            { text: "But {AF} is to {EG} as {AI} is to {EK}, and {EG} is to {FG} as {EK} is to {FK},",
              visible: ALL,
              highlighted: ["AI","EK","FK"] },
            { text: "therefore {AI} is to {EK} as {EK} is to {FK}.",
              visible: ALL,
              highlighted: ["AI","EK","FK"] },
            { text: "Therefore {EK} is a mean proportional between {AI} and {FK}.",
              visible: ALL,
              highlighted: ["EK","AI","FK"],
              justifications: [{ claim: "AF : EG = AI : EK, EG : FG = EK : FK", ref: "VI.1" },
                               { claim: "AI : EK = EK : FK", ref: "VI.11" }] },
            { text: "But {MN} is also a mean proportional between the squares {LM} and {NO},",
              visible: ALL,
              highlighted: ["MN","LM","NO"] },
            { text: "and {AI} equals {LM}, and {FK} equals {NO}, therefore {EK} also equals {MN}.",
              visible: ALL,
              highlighted: ["AI","LM","FK","NO","EK","MN"] },
            { text: "But {MN} equals {LO}, and {EK} equals {DH},",
              visible: ALL,
              highlighted: ["MN","LO","EK","DH"] },
            { text: "therefore the whole {DK} also equals the gnomon {UVW|UVWg} and {NO}.",
              visible: ALL,
              highlighted: ["DK","UVWg","NO"] },
            { text: "But {AK} equals the sum of {LM} and {NO},",
              visible: ALL,
              highlighted: ["AK","LM","NO"] },
            { text: "therefore the remainder {AB} equals {ST}, that is, to the square on {LN}.",
              visible: ALL,
              highlighted: ["ABh","ST","LN"] },
            { text: "Therefore {LN} is the side of the area {AB}.",
              visible: ALL,
              highlighted: ["LN","ABh"] },
            { text: "I say that {LN} is a second apotome of a medial straight line.",
              visible: ALL,
              highlighted: ["LN"] },
            { text: "Since {AI} and {FK} were proved medial, and equal the squares on {LP},",
              visible: ALL,
              highlighted: ["AI","FK","LM","NO"] },
            { text: "therefore each of the squares on {LP} and {PN} is also medial.",
              visible: ALL,
              highlighted: ["LP","PN","LM","NO"] },
            { text: "Therefore each of the straight lines {LP} and {PN} is medial.",
              visible: ALL,
              highlighted: ["LP","PN"] },
            { text: "Since {AI} is commensurable with {FK}, therefore the square on {LP} is also commensurable with the square on {PN}.",
              visible: ALL,
              highlighted: ["AI","FK","LM","NO"],
              justifications: [{ ref: "VI.1" },
                               { claim: "squares on LP, PN commensurable", ref: "X.11" }] },
            { text: "Again, since {AI} was proved incommensurable with {EK}, therefore {LM} is also incommensurable with {MN},",
              visible: ALL,
              highlighted: ["AI","EK","LM","MN"] },
            { text: "that is, the square on {LP} with the rectangle {LP} by {PN},",
              visible: ALL,
              highlighted: ["LM","MN","LP","PN"] },
            { text: "so that {LP} is also incommensurable in length with {PN}.",
              visible: ALL,
              highlighted: ["LP","PN"],
              justifications: [{ claim: "LM : MN = LP : PN", ref: "VI.1" },
                               { claim: "LP, PN incommensurable", ref: "X.11" }] },
            { text: "Therefore {LP} and {PN} are medial straight lines commensurable in square only.",
              visible: ALL,
              highlighted: ["LP","PN"] },
            { text: "I say next that they also contain a medial rectangle.",
              visible: ALL,
              highlighted: ["MN"] },
            { text: "Since {EK} was proved medial, and equals the rectangle {LP} by {PN},",
              visible: ALL,
              highlighted: ["EK","MN","LP","PN"] },
            { text: "therefore the rectangle {LP} by {PN} is also medial,",
              visible: ALL,
              highlighted: ["MN","LP","PN"] },
            { text: "so that {LP} and {PN} are medial straight lines commensurable in square only which contain a medial rectangle.",
              visible: ALL,
              highlighted: ["LP","PN","MN"] },
            { text: "Therefore {LN} is a second apotome of a medial straight line, and it is the side of the area {AB}.",
              visible: ALL,
              highlighted: ["LN","ABh"],
              justifications: [{ claim: "LN a second apotome of a medial", ref: "X.75" }] },
            { text: "Therefore the side of the area {AB} is a second apotome of a medial straight line.",
              visible: ALL,
              highlighted: ["ABh","LN"] },
            { text: "Therefore, if an area is contained by a rational straight line and a third apotome,",
              visible: ALL,
              highlighted: ["ABh","AC","AD"] },
            { text: "then the side of the area is a second apotome of a medial straight line.",
              visible: ALL,
              highlighted: ["LN"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "X.93") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
