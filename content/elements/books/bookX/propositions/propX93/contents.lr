              highlighted: ["DG","DE","EG"],
              justifications: [{ claim: "DG commensurable with DE, EG", ref: "X.15" }] },
            { text: "But {GD} is rational and incommensurable in length with {AC},",
              visible: PAR,
              highlighted: ["DG","AC"] },
            { text: "therefore each of the straight lines {DE} and {EG} is also rational and incommensurable in length with {AC}.",
