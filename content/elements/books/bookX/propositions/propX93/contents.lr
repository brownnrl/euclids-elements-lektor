            { text: "and let it be the rectangle {AF} by {FG}.",
              visible: APPL,
              highlighted: ["AF","FG"],
              transition: { animations: [
                  { elem: "F", name: geomlib.A.Point.appear } ] } },
            { text: "Draw {EH}, {FI}, and {GK} through the points {E}, {F}, and {G} parallel to {AC}.",
