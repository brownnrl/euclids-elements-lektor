                  { elem: "DFIB", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "IFGK", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "Then {AF} and {FG} are commensurable.",
              visible: PAR,
              highlighted: ["AF","FG"] },
            { text: "Therefore {AI} is also commensurable with {FK}.",
