            { text: "so that {AC} and {CB} are incommensurable in square",
              visible: GIVEN,
              highlighted: ["AC","CB"] },
            { text: "and let the sum of the squares on {AC} and {CB} be medial, but twice the rectangle {AC} by {CB} rational.",
              visible: GIVEN,
              highlighted: ["AC","CB"],
              justifications: [{ ref: "X.40" }] },
            { text: "I say that {AB} is not so divided at another point.",
              visible: GIVEN,
              highlighted: ["AB"] },
            { text: "If possible, let it be divided at {D} also,",
              visible: ALL,
