    // let it be divided at D also", so it is deferred.
    //
    // A reductio: D rests on the supposition, so the closing slides withdraw
    // it and leave AB divided at C.
    var GIVEN = ["A","B","C","AB","AC","CB"];
    var ALL   = GIVEN.concat(["D","AD","DB"]);
