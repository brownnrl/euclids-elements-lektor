              visible: ALL,
              highlighted: ["HK","FG"] },
            { text: "then {KH|HK} and {HM} are rational straight lines commensurable in square only, and therefore {HN|MKh} is medial.",
              visible: ALL,
              highlighted: ["HK","HM","MKh"],
              justifications: [{ claim: "HN medial", ref: "X.21" }] },
            { text: "Therefore {HN|MKh} is either rational or medial.",
              visible: ALL,
              highlighted: ["MKh"] },
            { text: "But {HN|MKh} equals {AC|ACh}, therefore {AC|ACh} is either rational or medial.",
              visible: ALL,
              highlighted: ["MKh","ACh"] },
            { text: "Therefore, the rectangle contained by medial straight lines commensurable in square only is either rational or medial.",
              visible: ALL,
              highlighted: ["ACh","AB","BC"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
