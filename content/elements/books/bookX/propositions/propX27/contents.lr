            "A0;point;free;30,-1000;0;0",
            "A3;point;free;30,1000;0;0",
            "A1;point;lineSlider;A0,A3,30,30;0",
            "A2;point;lineSlider;A0,A3,30,170;0",
            "A;line;connect;A1,A2;black",
            "B0;point;free;60,-1000;0;0",
            "B3;point;free;60,1000;0;0",
            "B1;point;lineSlider;B0,B3,60,30;0",
            "B2;point;lineSlider;B0,B3,60,140;0",
            "B;line;connect;B1,B2;black",
            "C0;point;free;90,-1000;0;0",
            "C3;point;free;90,1000;0;0",
            "C1;point;lineSlider;C0,C3,90,30;0",
            "C2;point;meanProportional;A1,A2,B1,B2,C1,C3;0",
            "C;line;connect;C1,C2;black",
            "D0;point;free;120,-1000;0;0",
            "D3;point;free;120,1000;0;0",
            "D1;point;lineSlider;D0,D3,120,30;0",
            "D2;point;proportion;A1,A2,B1,B2,C1,C2,D1,D3;0",
            "D;line;connect;D1,D2;black"
        ],
    });
