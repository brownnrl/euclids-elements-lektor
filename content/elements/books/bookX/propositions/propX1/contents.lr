            "AHmid;point;midpoint;A,H;0;0",
            "K;point;lineSegmentSlider;A,AHmid,55,0",
            // Highlight targets only — the lines above already draw them.
            "DF;line;connect;D,F;0;0;0",
            "FG;line;connect;F,G;0;0;0",
            "GE;line;connect;G,E;0;0;0",
            "GD;line;connect;G,D;0;0;0",
            "BH;line;connect;B,H;0;0;0",
