            "GAcirc;circle;radius;AGquar,G;0;0;0;0",
            "bich;line;bichord;GEcirc,GAcirc;0;0;0",
            "F';point;first;bich;0;0",
            "F;point;cutoff;AGmid,G,AGmid,F'",
            "H;point;parallelogram;C,A,E",
            "I;point;parallelogram;C,A,F",
            "K;point;parallelogram;C,A,G",
            "DFIB;polygon;quadrilateral;D,F,I,B;0;0;black;random",
            "EH;line;connect;E,H",
            "IFGK;polygon;quadrilateral;I,F,G,K;0;0;black;240,80,100",
            "R0;point;free;-1000,160;0;0",
            "R3;point;free;1000,160;0;0",
            "R;point;lineSlider;R0,R3,240,0",
            "M;point;meanProportional;A,F,F,I,R,R3",
            "RMPL;polygon;square;R,M;0;0;black;random",
            "P;point;vertex;RMPL,3",
            "L;point;vertex;RMPL,4",
