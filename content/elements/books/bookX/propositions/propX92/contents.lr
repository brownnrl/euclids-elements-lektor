            "D;point;lineSlider;A0,A3,80,0",
            "C';point;perpendicular;A,D;0;0",
            "C;point;lineSlider;A,C',0,140",
            "B;point;parallelogram;C,A,D",
            "ACBD;polygon;quadrilateral;A,C,B,D;0;0;black;random",
            "G;point;lineSlider;A0,A3,200,0",
            "E;point;midpoint;G,D",
            "AGmid;point;midpoint;A,G;0;0",
            "AGquar;point;midpoint;G,AGmid;0;0",
