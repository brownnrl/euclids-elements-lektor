                  { elem: "angP", name: geomlib.A.Sector.sweep } ] } },
            { text: "Then the squares {LM} and {NO} are about the same diameter.",
              visible: SQ2,
              highlighted: ["LM","NO"],
              justifications: [{ claim: "about the same diameter", ref: "VI.26" }] },
            { text: "Let {PR|RP} be their diameter, and draw the figure.",
              visible: ALL,
              highlighted: ["RP"],
              transition: { mode: "cascade", animations: [
                  { elem: "RP", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "SQ", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "TQ", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Since {AI} and {FK} are medial and equal the squares on {LP} and {PN},",
              visible: ALL,
              highlighted: ["AI","FK","LP","PN"] },
            { text: "the squares on {LP} and {PN} are also medial,",
              visible: ALL,
              highlighted: ["LM","NO"] },
            { text: "therefore {LP} and {PN} are also medial straight lines commensurable in square only.",
              visible: ALL,
              highlighted: ["LP","PN"] },
            { text: "Since the rectangle {AF} by {FG} equals the square on {EG},",
              visible: ALL,
              highlighted: ["AF","FG","EG"] },
            { text: "therefore {AF} is to {EG} as {EG} is to {FG},",
              visible: ALL,
              highlighted: ["AF","EG","FG"],
              justifications: [{ claim: "AF : EG = EG : FG", ref: "VI.17" }] },
            { text: "while {AF} is to {EG} as {AI} is to {EK}, and {EG} is to {FG} as {EK} is to {FK}.",
              visible: ALL,
              highlighted: ["AI","EK","FK"],
              justifications: [{ claim: "AF : EG = AI : EK, EG : FG = EK : FK", ref: "VI.1" }] },
            { text: "Therefore {EK} is a mean proportional between {AI} and {FK}.",
              visible: ALL,
              highlighted: ["EK","AI","FK"],
              justifications: [{ claim: "AI : EK = EK : FK", ref: "V.11" }] },
            { text: "But {MN} is also a mean proportional between the squares {LM} and {NO},",
              visible: ALL,
              highlighted: ["MN","LM","NO"] },
            { text: "and {AI} equals {LM} while {FK} equals {NO}, therefore {MN} also equals {EK}.",
              visible: ALL,
              highlighted: ["AI","LM","FK","NO","MN","EK"] },
            { text: "But {DH} equals {EK}, and {LO} equals {MN},",
              visible: ALL,
              highlighted: ["DH","EK","LO","MN"] },
            { text: "therefore the whole {DK} equals the gnomon {UVW|UVWg} and {NO}.",
              visible: ALL,
              highlighted: ["DK","UVWg","NO"],
              transition: { animations: [
                  { elem: "UVWg", name: geomlib.A.Polygon.outline } ] } },
            { text: "Since, then, the whole {AK} equals {LM} and {NO},",
              visible: ALL,
              highlighted: ["AK","LM","NO"] },
            { text: "and, in these, {DK} equals the gnomon {UVW|UVWg} and {NO},",
              visible: ALL,
              highlighted: ["DK","UVWg","NO"] },
            { text: "therefore the remainder {AB} equals {TS}.",
              visible: ALL,
              highlighted: ["AB","TS"] },
            { text: "But {TS} is the square on {LN}, therefore the square on {LN} equals the area {AB}.",
              visible: ALL,
              highlighted: ["TS","LN","AB"] },
            { text: "Therefore {LN} is the side of the area {AB}.",
              visible: ALL,
              highlighted: ["LN","AB"] },
            { text: "I say that {LN} is a first apotome of a medial straight line.",
              visible: ALL,
              highlighted: ["LN"] },
            { text: "Since {EK} is rational and equals {LO}, therefore {LO}, that is, the rectangle {LP} by {PN}, is rational.",
              visible: ALL,
              highlighted: ["EK","LO","LP","PN"] },
            { text: "But {NO} was proved medial, therefore {LO} is incommensurable with {NO}.",
              visible: ALL,
              highlighted: ["NO","LO"] },
            { text: "But {LO} is to {NO} as {LP} is to {PN}, therefore {LP} and {PN} are incommensurable in length.",
              visible: ALL,
              highlighted: ["LO","NO","LP","PN"],
              justifications: [{ claim: "LO : NO = LP : PN", ref: "VI.1" },
                               { claim: "LP, PN incommensurable", ref: "X.11" }] },
            { text: "Therefore {LP} and {PN} are medial straight lines commensurable in square only, which contain a rational rectangle.",
              visible: ALL,
              highlighted: ["LP","PN","LO"] },
            { text: "Therefore {LN} is a first apotome of a medial straight line.",
              visible: ALL,
              highlighted: ["LN"],
              justifications: [{ claim: "LN a first apotome of a medial", ref: "X.74" }] },
            { text: "And it is the side of the area {AB}.",
              visible: ALL,
              highlighted: ["LN","AB"] },
            { text: "Therefore the side of the area {AB} is a first apotome of a medial straight line.",
              visible: ALL,
              highlighted: ["AB","LN"] },
            { text: "Therefore, if an area is contained by a rational straight line and a second apotome,",
              visible: ALL,
              highlighted: ["AB","AC","AD"] },
            { text: "then the side of the area is a first apotome of a medial straight line.",
              visible: ALL,
              highlighted: ["AB","LN"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "X.92") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

