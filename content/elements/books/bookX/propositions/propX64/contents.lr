            { text: "Therefore {DM} and {MG} are rational straight lines commensurable in square only. Therefore {DG} is binomial.",
              visible: ALL,
              highlighted: ["DM","MG","DG"],
              justifications: [{ claim: "DG binomial", ref: "X.36" }] },
            { text: "I say next that it is also a fifth binomial straight line.",
              visible: ALL,
              highlighted: ["DG"] },
            { text: "For it can be proved similarly that the rectangle {DK} by {KM} equals the square on {MN},",
              visible: ALL,
              highlighted: ["DK","KM","MN"] },
            { text: "and that {DK} is incommensurable in length with {KM}.",
              visible: ALL,
              highlighted: ["DK","KM"] },
            { text: "Therefore the square on {DM} is greater than the square on {MG}",
              visible: ALL,
              highlighted: ["DM","MG"] },
            { text: "by the square on a straight line incommensurable with {DM}.",
              visible: ALL,
              highlighted: ["DM"],
              justifications: [{ ref: "X.18" }] },
            { text: "And {DM} and {MG} are commensurable in square only,",
              visible: ALL,
              highlighted: ["DM","MG"] },
            { text: "and the less, {MG}, is commensurable in length with {DE}.",
              visible: ALL,
              highlighted: ["MG","DE"] },
            { text: "Therefore {DG} is a fifth binomial.",
              visible: ALL,
              highlighted: ["DG"] },
            { text: "Therefore, the square on the side of a rational plus a medial area applied to a rational straight line",
              visible: ALL,
              highlighted: ["AB","DE","DFh"] },
            { text: "produces as breadth the fifth binomial.",
              visible: ALL,
              highlighted: ["DG"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
