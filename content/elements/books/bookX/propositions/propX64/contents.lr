              transition: { animations: [
                  { elem: "EDGF", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "producing {DG} as its breadth.",
              visible: APPL,
              highlighted: ["DG"] },
            { text: "I say that {DG} is a fifth binomial straight line.",
              visible: APPL,
              highlighted: ["DG"] },
            { text: "Make the same construction as before.",
              visible: ALL,
              transition: { mode: "cascade", animations: [
                  { elem: "EDKH", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "HKML", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "N",    name: geomlib.A.Point.appear },
                  { elem: "NO",   name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Since {AB} is the side of a rational plus a medial area, divided at {C},",
