              highlighted: ["AG","EG"] },
            { text: "and let it be the rectangle {AF} by {FG}.",
              visible: APPL,
              highlighted: ["AF","FG"],
              transition: { animations: [
                  { elem: "F", name: geomlib.A.Point.appear } ] } },
            { text: "Then {AF} is incommensurable in length with {FG}.",
              visible: APPL,
              highlighted: ["AF","FG"] },
            { text: "Draw {EH}, {FI}, and {GK} through {E}, {F}, and {G} parallel to {AC} and {BD}.",
              visible: PAR,
              highlighted: ["EH","FI","GK","AC","BD"],
              transition: { mode: "cascade", animations: [
                  { elem: "EH",   name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "FI",   name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "GK",   name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "DFIB", name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "IFGK", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "Since {AG} is rational and commensurable in length with {AC}, therefore the whole {AK} is rational.",
              visible: PAR,
              highlighted: ["AG","AC","AK"],
              justifications: [{ claim: "AK rational", ref: "X.19" }] },
            { text: "Again, since {DG} is incommensurable in length with {AC}, and both are rational, therefore {DK} is medial.",
              visible: PAR,
              highlighted: ["DG","AC","DK"],
              justifications: [{ claim: "DK medial", ref: "X.21" }] },
            { text: "Again, since {AF} is incommensurable in length with {FG}, therefore {AI} is incommensurable with {FK}.",
