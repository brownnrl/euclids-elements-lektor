                               { claim: "AI, FK incommensurable", ref: "X.11" }] },
            { text: "Now construct the square {LM} equal to {AI},",
              visible: SQ1,
              highlighted: ["LM","AI"],
              transition: { mode: "cascade", animations: [
                  { elem: "R",    name: geomlib.A.Point.appear },
                  { elem: "RMPL", name: geomlib.A.Polygon.outlineAndFill } ] } },
            { text: "and subtract {NO}, equal to {FK}, about the same angle, the angle {LPM|angLPM}.",
              visible: SQ2,
              highlighted: ["NO","FK","angLPM"],
              transition: { mode: "cascade", animations: [
                  { elem: "PNQO",   name: geomlib.A.Polygon.outlineAndFill },
                  { elem: "angLPM", name: geomlib.A.Sector.sweep } ] } },
            { text: "Therefore the squares {LM} and {NO} are about the same diameter.",
              visible: SQ2,
              highlighted: ["LM","NO"],
              justifications: [{ claim: "about the same diameter", ref: "VI.26" }] },
            { text: "Let {PR} be their diameter,",
              visible: DIAM,
              highlighted: ["RP"],
              transition: { animations: [
                  { elem: "RP", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "and draw the figure.",
              visible: ALL,
              transition: { mode: "cascade", animations: [
                  { elem: "SQ", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "TQ", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Since the rectangle {AF} by {FG} equals the square on {EG},",
              visible: ALL,
              highlighted: ["AF","FG","EG"] },
            { text: "therefore, {AF} is to {EG} as {EG} is to {FG}.",
              visible: ALL,
              highlighted: ["AF","EG","FG"],
              justifications: [{ claim: "AF : EG = EG : FG", ref: "VI.17" }] },
            { text: "But {AF} is to {EG} as {AI} is to {EK}, and {EG} is to {FG} as {EK} is to {FK},",
              visible: ALL,
              highlighted: ["AI","EK","FK"] },
            { text: "therefore {EK} is a mean proportional between {AI} and {FK}.",
              visible: ALL,
              highlighted: ["EK","AI","FK"],
              justifications: [{ claim: "AF : EG = AI : EK, EG : FG = EK : FK", ref: "VI.1" },
                               { claim: "AI : EK = EK : FK", ref: "V.11" }] },
            { text: "But {MN} is also a mean proportional between the squares {LM} and {NO},",
              visible: ALL,
              highlighted: ["MN","LM","NO"] },
            { text: "and {AI} equals {LM}, and {FK} equals {NO} therefore {EK} also equals {MN}.",
              visible: ALL,
              highlighted: ["AI","LM","FK","NO","EK","MN"] },
            { text: "But {DH} equals {EK}, and {LO} equals {MN},",
              visible: ALL,
              highlighted: ["DH","EK","LO","MN"] },
            { text: "therefore the whole {DK} equals the gnomon {UVW|UVWg} and {NO}.",
              visible: ALL,
              highlighted: ["DK","UVWg","NO"] },
            { text: "Since, then, the whole {AK} equals the sum of the squares {LM} and {NO},",
              visible: ALL,
              highlighted: ["AK","LM","NO"] },
            { text: "and, in these, {DK} equals the gnomon {UVW|UVWg} and the square {NO},",
              visible: ALL,
              highlighted: ["DK","UVWg","NO"] },
            { text: "therefore the remainder {AB} equals {ST}, that is, to the square on {LN}.",
              visible: ALL,
              highlighted: ["ABh","ST","LN"] },
            { text: "Therefore {LN} is the side of the area {AB}.",
              visible: ALL,
              highlighted: ["LN","ABh"] },
            { text: "I say that {LN} is the irrational straight line called minor.",
              visible: ALL,
              highlighted: ["LN"] },
            { text: "Since {AK} is rational and equals the sum of the squares on {LP} and {PN},",
              visible: ALL,
              highlighted: ["AK","LP","PN","LM","NO"] },
            { text: "therefore the sum of the squares on {LP} and {PN} is rational.",
              visible: ALL,
              highlighted: ["LP","PN","LM","NO"] },
            { text: "Again, since {DK} is medial, and {DK} equals twice the rectangle {LP} by {PN},",
              visible: ALL,
              highlighted: ["DK","LP","PN","MN","LO"] },
            { text: "therefore twice the rectangle {LP} by {PN} is medial.",
              visible: ALL,
              highlighted: ["LP","PN","MN","LO"] },
            { text: "And, since {AI} was proved incommensurable with {FK},",
              visible: ALL,
              highlighted: ["AI","FK"] },
            { text: "therefore the square on {LP} is also incommensurable with the square on {PN}.",
              visible: ALL,
              highlighted: ["LP","PN","LM","NO"] },
            { text: "Therefore {LP} and {PN} are straight lines incommensurable in square",
              visible: ALL,
              highlighted: ["LP","PN"] },
            { text: "which make the sum of the squares on them rational, but twice the rectangle contained by them medial.",
              visible: ALL,
              highlighted: ["LM","NO","MN","LO"] },
            { text: "Therefore {LN} is the irrational straight line called minor, and it is the side of the area {AB}.",
              visible: ALL,
              highlighted: ["LN","ABh"],
              justifications: [{ claim: "LN minor", ref: "X.76" }] },
            { text: "Therefore the side of the area {AB} is minor.",
              visible: ALL,
              highlighted: ["ABh","LN"] },
            { text: "Therefore, if an area is contained by a rational straight line and a fourth apotome,",
              visible: ALL,
              highlighted: ["ABh","AC","AD"] },
            { text: "then the side of the area is minor.",
              visible: ALL,
              highlighted: ["LN"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
            if (ref === "X.94") return "#prop";
            return (window.eucrefs && window.eucrefs[ref]) || null;
        }
    });

    // Per-page citation lookup for the slideshow's resolveJustification.
    window.eucrefs = (window.eucrefs || {});
    Object.assign(window.eucrefs, {
        "V.11":        "/elements/books/bookV/propositions/propV11/",
        "VI.1":        "/elements/books/bookVI/propositions/propVI1/",
        "VI.17":       "/elements/books/bookVI/propositions/propVI17/",
        "VI.26":       "/elements/books/bookVI/propositions/propVI26/",
        "X.Def.III.4": "/elements/books/bookX/definitions/defX.III.4/",
        "X.11":        "/elements/books/bookX/propositions/propX11/",
        "X.18":        "/elements/books/bookX/propositions/propX18/",
        "X.19":        "/elements/books/bookX/propositions/propX19/",
        "X.21":        "/elements/books/bookX/propositions/propX21/",
        "X.76":        "/elements/books/bookX/propositions/propX76/"
    });
