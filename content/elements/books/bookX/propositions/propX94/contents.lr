            "K;point;parallelogram;C,A,G",
            "DFIB;polygon;quadrilateral;D,F,I,B;0;0;black;random",
            "EH;line;connect;E,H",
            "IFGK;polygon;quadrilateral;I,F,G,K;0;0;black;140,80,100",
            "R0;point;free;-1000,160;0;0",
            "R3;point;free;1000,160;0;0",
            "R;point;lineSlider;R0,R3,240,0",
            "M;point;meanProportional;A,F,F,I,R,R3",
