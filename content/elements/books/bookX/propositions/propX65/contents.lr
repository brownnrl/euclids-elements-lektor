              highlighted: ["DK","KM","MN"] },
            { text: "and that {DK} is incommensurable in length with {KM},",
              visible: ALL,
              highlighted: ["DK","KM"] },
            { text: "and, for the same reason, the square on {DM} is greater than the square {MG}",
              visible: ALL,
              highlighted: ["DM","MG"] },
            { text: "by the square on a straight line incommensurable in length with {DM}.",
              visible: ALL,
              highlighted: ["DM"] },
            { text: "And neither of the straight lines {DM} nor {MG} is commensurable in length",
              visible: ALL,
              highlighted: ["DM","MG"] },
            { text: "with the rational straight line {DE} set out.",
              visible: ALL,
              highlighted: ["DM","MG","DE"] },
            { text: "Therefore {DG} is a sixth binomial straight line.",
              visible: ALL,
              highlighted: ["DG"],
              justifications: [{ claim: "DG a sixth binomial", ref: "X.Def.II.6" }] },
            { text: "Therefore, the square on the side of the sum of two medial areas applied to a rational straight line",
              visible: ALL,
              highlighted: ["AB","DE","DF"] },
            { text: "produces as breadth the sixth binomial.",
              visible: ALL,
              highlighted: ["DG"],
              justifications: [{ ref: "Q.E.D." }] }
        ],
        resolveJustification: function(ref) {
