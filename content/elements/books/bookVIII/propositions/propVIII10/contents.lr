              visible: ALL,
              highlighted: ["D","F","E","H"],
              justifications: [{ claim: "D : F = E : H", ref: "VII.17" }] },
            { text: "For the same reason also {D} is to {F} as {H} is to {G}.",
              visible: ALL,
              highlighted: ["D","F","H","G"],
