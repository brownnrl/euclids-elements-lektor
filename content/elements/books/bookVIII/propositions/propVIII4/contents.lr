        slides: [
            { text: "Next, let {E} not measure {K}.",
              visible: GIVEN1,
              highlighted: ["E","K"] },
            { text: "Take {M}, the least number measured by {E} and {K}.",
              visible: Mv,
              highlighted: ["M","E","K"],
              transition: { animations: [ { elem: "M", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "Let {H} and {G} measure {N} and {O} as many times as {K} measures {M}, respectively,",
              visible: NOv,
              highlighted: ["H","G","N","O","K","M"],
              transition: { animations: [ { elem: "N", name: geomlib.A.Line.straightEdgeConnect },
                  { elem: "O", name: geomlib.A.Line.straightEdgeConnect } ] } },
            { text: "and let {F} measure {P} as many times as {E} measures {M}.",
              visible: Pv,
              highlighted: ["F","P","E","M"],
