            "C0;point;free;-1000,105;0;0",
            "C3;point;free;1000,105;0;0",
            "E0;point;free;-1000,140;0;0",
            "E3;point;free;1000,140;0;0",
            "U1;point;free;1000,0;0;0",
            "U2;point;free;1000,25;0;0",
