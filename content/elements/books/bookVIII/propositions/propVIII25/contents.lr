            "F2;point;proportion;A1,A2,E1,E2,E1,E2,F1,B3;0",
            "F;line;connect;F1,F2;black",
            "B1;point;lineSlider;B0,B3,30,0;0",
            "B2;point;proportion;A1,A2,E1,E2,F1,F2,B1,B3;0",
