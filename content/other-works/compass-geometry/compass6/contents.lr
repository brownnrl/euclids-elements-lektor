            "Q;point;free;200,50",
            "R;point;free;250,190",
            "Pcirc;circle;radius;P,Q;0;0;black;random",
            "R';point;invert;R,Pcirc",
            "Qcirc;circle;radius;Q,P;0;0;gray;0",
            "R'circ;circle;radius;R',P;0;0;gray;0",
            "PO';line;bichord;Qcirc,R'circ;0;0;0",
            "PO'mid;point;midpoint;PO';0;0",
            "O';point;extend;P,PO'mid,P,PO'mid",
            "O;point;invert;O',Pcirc",
        ],
