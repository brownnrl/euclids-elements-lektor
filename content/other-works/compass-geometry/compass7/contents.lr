            "D2;point;invert;A2,B;0;0",
            "D3;point;invert;A3,B;0;0",
            "D;circle;circumcircle;D1,D2,D3;black;0;black;0",
            "E1;point;invert;A1,C;0;0",
            "E2;point;invert;A2,C;0;0",
            "E3;point;invert;A3,C;0;0",
            "E;circle;circumcircle;E1,E2,E3;black;0;black;0",
