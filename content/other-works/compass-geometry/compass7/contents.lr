            "B2;point;free;29,160;0",
            "B3;point;free;150,340;0",
            "B;circle;circumcircle;B1,B2,B3;black;0;black;random",
            "C1;point;free;240,80;0",
            "C2;point;free;210,240;0",
            "C3;point;free;245,340;0",
            "C;circle;circumcircle;C1,C2,C3;black;0;black;random",
