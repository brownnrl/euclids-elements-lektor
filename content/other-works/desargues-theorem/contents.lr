            "B*;point;circleSlider;210,220,AB",
            "CA;circle;circumcircle;C,A,A*;0;0;red;0",
            "BC;circle;circumcircle;B,C,B*;0;0;red;0",
            "BCcenter;point;center;BC;0;0",
            "CAcenter;point;center;CA;0;0",
            "Cfoot;point;foot;C,CAcenter,BCcenter;0;0",
            "C*;point;extend;C,Cfoot,C,Cfoot;0",
            "P;point;free;80,110;black;green",
            "AP;circle;circumcircle;A,A*,P;0;0;black;0",
            "BP;circle;circumcircle;B,B*,P;0;0;black;0",
            "CP;circle;circumcircle;C,C*,P;0;0;black;0",
            "PP*;line;bichord;AP,BP;0;0;0",
            "PP*mid;point;midpoint;PP*;0;0",
            "P*;point;extend;P,PP*mid,P,PP*mid;0",
            "D;point;circleSlider;AP,200,160",
            "E;point;circleSlider;BP,140,160",
            "F;point;circleSlider;CP,170,100",
            "BD;circle;circumcircle;B,D,B*;0;0;0;0",
            "DD*;line;bichord;AP,BD;0;0;0",
            "DD*mid;point;midpoint;DD*;0;0",
            "D*;point;extend;D,DD*mid,D,DD*mid;0",
            "DE;circle;circumcircle;D,E,D*;0;0;green;0",
            "FD;circle;circumcircle;F,D,D*;0;0;green;0",
            "EE*;line;bichord;BP,DE;0;0;0",
            "EE*mid;point;midpoint;EE*;0;0",
            "E*;point;extend;E,EE*mid,E,EE*mid;0",
            "EF;circle;circumcircle;E,F,E*;0;0;green;0",
            "GG*;line;bichord;AB,DE;0;0;0",
            "HH*;line;bichord;BC,EF;0;0;0",
            "KK*;line;bichord;CA,FD;0;0;0",
            "G;point;last;GG*",
            "H;point;last;HH*",
            "K;point;first;KK*",
            "GHK;circle;circumcircle;G,H,K;0;0;blue;0",
        ],
    });
</script>
</figure>

#### Desargues' theorem in Hyperbolic Geometry

The version of Desargue's theorem in Round Geometry specializes to one in hyperbolic geometry, and also one in Elliptic geometry.

<figure class="diagram block">
<canvas id="canvas_2" width="500" height="320" tabindex="0"></canvas>
<noscript><img alt="Desargues Theorem in Hyperbolic Geometry" src="des3.gif"/></noscript>
<script type="text/javascript">
    geomlib.init({
        canvasid: "canvas_2",
        background: "0,0,100",
        title: "Desargues Theorem in Hyperbolic Geometry",
        pivot: "diskcenter",
        elements: [
            "diskcenter;point;fixed;200,160;0;orange",
            "diskradius;point;free;355,150;0;orange",
            "disk;circle;radius;diskcenter,diskradius;0;0;random;random",
            "A;point;free;200,210",
            "B;point;free;290,190",
            "C;point;free;275,130",
            "A*;point;invert;A,disk",
            "B*;point;invert;B,disk",
            "C*;point;invert;C,disk",
            "AB;circle;circumcircle;A,B,A*;0;0;red;0",
            "BC;circle;circumcircle;B,C,B*;0;0;red;0",
            "CA;circle;circumcircle;C,A,C*;0;0;red;0",
            // P is the centre of perspectivity, and free — the reader can drag
            // it anywhere. Its DEFAULT was (100,130), where P sits within ~1° of
            // the line through B and B* (= invert;B,disk). A circumcircle through
            // near-collinear points is unbounded, so BP came out with radius
            // ~11300 on this 500x320 canvas and figureBounds ran to ~22600x23100.
            // Maximizing then centred on that and pushed the whole figure off
            // screen — a blank canvas. Moved to a well-conditioned spot (still
            // inside the disk, >=55px from every vertex): worst circumradius
            // drops 11300 -> 504 and the bounds to ~1770x1300.
            // INTERIM ONLY — the real fix is euclid#162 (centring should not
            // follow an outlier element, however legitimately it paints).
            "P;point;free;155,245",
            "P*;point;invert;P,disk;0;0",
            "AP;circle;circumcircle;A,A*,P;0;0;black;0",
            "BP;circle;circumcircle;B,B*,P;0;0;black;0",
            "CP;circle;circumcircle;C,C*,P;0;0;black;0",
            "D;point;circleSlider;AP,200,160",
            "D*;point;invert;D,disk;0;0",
            "E;point;circleSlider;BP,140,160",
            "E*;point;invert;E,disk;0;0",
            "F;point;circleSlider;CP,170,160",
            "F*;point;invert;F,disk;0;0",
            "DE;circle;circumcircle;D,E,D*;0;0;green;0",
            "EF;circle;circumcircle;E,F,E*;0;0;green;0",
            "FD;circle;circumcircle;F,D,F*;0;0;green;0",
            "GG*;line;bichord;AB,DE;0;0;0",
            "HH*;line;bichord;BC,EF;0;0;0",
            "KK*;line;bichord;CA,FD;0;0;0",
            "G*;point;first;GG*",
            "G;point;last;GG*",
            "H*;point;first;HH*",
            "H;point;last;HH*",
            "K;point;first;KK*",
            "K*;point;last;KK*",
            "GHK;circle;circumcircle;G,H,K;0;0;blue;0",
        ],
    });
</script>
</figure>

