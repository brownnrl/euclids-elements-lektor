            "EF;circle;circumcircle;E,F,E*;0;0;green;0",
            "FD;circle;circumcircle;F,D,F*;0;0;green;0",
            "GG*;line;bichord;AB,DE;0;0;0",
            "HH*;line;bichord;BC,EF;0;0;0",
            "KK*;line;bichord;CA,FD;0;0;0",
            "G*;point;first;GG*",
            "G;point;last;GG*",
            "H*;point;first;HH*",
            "H;point;last;HH*",
            "K;point;first;KK*",
            "K*;point;last;KK*",
            "GHK;circle;circumcircle;G,H,K;0;0;blue;0",
