# Lektor's local config + caches
/.lektor/

# Lektor plugins installed locally
/packages/

# Per-project venv (optional — README documents both per-project and ~/venvs/lektor)
/.venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Editor / OS noise
*.swp
.DS_Store
.idea/
